@{
    ViewData["Title"] = ViewResources.MenuManagement;
}
@section Styles {
    <environment include="Development">
        <link rel="stylesheet" href="~/css/dev/pages/function/index.chunk.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/pro/pages/function/index.chunk.css" asp-append-version="true" />
    </environment>
}
@section Scripts{
    @if (Model)
    {
        <script>
            window.hasHostPermissionOnMenu = true;
        </script>
    }
    else
    {
        <script>
            window.hasHostPermissionOnMenu = false;
        </script>
    }

    <environment include="Development">
        <script src="~/js/dev/pages/menu/index.chunk.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/pro/pages/menu/index.chunk.js" asp-append-version="true"></script>
    </environment>
}
@section Breadcrumb {
    <ol class="breadcrumb">
        <li class="breadcrumb-item active">@ViewResources.MenuManagement</li>
    </ol>
}
<div id="app-container"></div>