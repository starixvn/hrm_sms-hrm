@model string
@{
    ViewData["Title"] = ViewResources.UserManagement;
}
@section Styles {
    <environment include="Development">
        <link rel="stylesheet" href="~/css/dev/pages/user/index.chunk.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/pro/pages/user/index.chunk.css" asp-append-version="true" />
    </environment>
}
@section Scripts {
    @if ((bool)ViewBag.isHost)
    {
        <script>window.hasHostPermissionOnUser = true;</script>
    }
    else
    {
        <script>window.hasHostPermissionOnUser = false;</script>
    }
    <environment include="Development">
        <script src="~/js/dev/pages/user/index.chunk.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/pro/pages/user/index.chunk.js" asp-append-version="true"></script>
    </environment>
}
@section Breadcrumb {
    <ol class="breadcrumb">
        <li class="breadcrumb-item active">@ViewResources.UserManagement</li>
    </ol>
}
<input type="hidden" id="token" value="@Model" />
<div id="app-container"></div>