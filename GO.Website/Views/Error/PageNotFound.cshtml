@{
    ViewData["Title"] = "Page Not Found";
}
@section Styles {
    <link href="~/css/pro/error.chunk.css" rel="stylesheet" />
}

<div class="page-error page-error-404">
    <div class="page-content vertical-align-middle">
        <header>
            <div class="img-block">
                <img class="img-main" src="~/css/images/404/404.svg" alt="404.svg" />
                <img class="balloon" src="~/css/images/404/balloon.svg" alt="balloon.svg" />
                <img class="small-cloud" src="~/css/images/404/cloud-small.svg" alt="cloud-small.svg" />
                <img class="big-cloud" src="~/css/images/404/cloud-big.svg" alt="cloud-big.svg" />
                <img class="wind-bottom" src="~/css/images/404/wind.svg" alt="wind.svg" />
                <img class="wind-top" src="~/css/images/404/wind.svg" alt="wind.svg" />
            </div>
        </header>
        <p class="error-advise">Oops. The page you are looking for doesn't exist.</p>
    </div>
</div>