@{
    ViewData["Title"] = "Access Denied";
}
@section Styles {
    <link href="~/css/pro/error.chunk.css" rel="stylesheet" />
}
<div class="page-error page-error-405">
    <div class="page-content vertical-align-middle">
        <div class="img-block">
            <img class="door" src="~/css/images/405/door.svg" alt="door.svg" />
            <div class="seal-slideshow">
                <div class="mover-1"></div>
            </div>

            <img class="signage" src="~/css/images/405/signage.svg" alt="signage.svg" />
        </div>
        <p class="error-advise">Oops. 405, ACCESS DENIED</p>
        <p class="small-text">
            Sorry about that, but you don't have permission to access this page.
        </p>
    </div>
</div>