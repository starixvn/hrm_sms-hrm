@model JsonResult
@{
    ViewData["Title"] = "Annual Manpower Forecast Request Form";
}
@section Breadcrumb {
    <ol class="breadcrumb">
        <li class="breadcrumb-item">Manpower Forecast</li>
        <li class="breadcrumb-item">Annual Request</li>
        <li class="breadcrumb-item active">Summary</li>
    </ol>
}
@section Styles {
    <environment include="Development">
        <link rel="stylesheet" href="~/css/dev/pages/manpower/annual-request/summary.chunk.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/pro/pages/manpower/annual-request/summary.chunk.css" asp-append-version="true" />
    </environment>
}
@section Scripts {
    <environment include="Development">
        <script src="~/js/dev/pages/manpower/annual-request/summary.chunk.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/pro/pages/manpower/annual-request/summary.chunk.js" asp-append-version="true"></script>
    </environment>
}
<div id="app-container"></div>