@model bool
@{
    ViewData["Title"] = "Annual Manpower Forecast Request Form";
}
@section Breadcrumb {
    <ol class="breadcrumb">
        <li class="breadcrumb-item">Manpower</li>
        <li class="breadcrumb-item active">Forecast Request</li>
    </ol>
}
@section Styles {
    <environment include="Development">
        <link rel="stylesheet" href="~/css/dev/pages/manpower/forecast/index.chunk.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/pro/pages/manpower/forecast/index.chunk.css" asp-append-version="true" />
    </environment>
}
@section Scripts {
    @if (Model)
    {
        <script>window.hasHostPermissionOnPeriod = true;</script>
    }
    else
    {
        <script>window.hasHostPermissionOnPeriod = false;</script>
    }
    <environment include="Development">
        <script src="~/js/dev/pages/manpower/forecast/index.chunk.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/pro/pages/manpower/forecast/index.chunk.js" asp-append-version="true"></script>
    </environment>
}
<div id="app-container"></div>