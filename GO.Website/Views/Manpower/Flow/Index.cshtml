@model bool
@{
    ViewData["Title"] = "Manpower - Flow Management";
}
@section Breadcrumb {
    <ol class="breadcrumb">
        <li class="breadcrumb-item">Manpower</li>
        <li class="breadcrumb-item active">Flow Management</li>
    </ol>
}
@section Styles {
    <environment include="Development">
        <link rel="stylesheet" href="~/css/dev/pages/manpower/flow/index.chunk.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/pro/pages/manpower/flow/index.chunk.css" asp-append-version="true" />
    </environment>
}
@section Scripts {
    @if (Model)
    {
        <script>window.hasHostPermissionOnFlow = true;</script>
    }
    else
    {
        <script>window.hasHostPermissionOnFlow = false;</script>
    }
    <environment include="Development">
        <script src="~/js/dev/pages/manpower/flow/index.chunk.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/pro/pages/manpower/flow/index.chunk.js" asp-append-version="true"></script>
    </environment>
}
<div id="app-container"></div>