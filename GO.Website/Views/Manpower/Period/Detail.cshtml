@model int
@{
    ViewData["Title"] = "Manpower - Period Management";
}
@section Breadcrumb {
    <ol class="breadcrumb">
        <li class="breadcrumb-item">Manpower</li>
        <li class="breadcrumb-item">Period Management</li>
        <li class="breadcrumb-item active">Detail</li>
    </ol>
}
@section Styles {
    <environment include="Development">
        <link rel="stylesheet" href="~/css/dev/pages/manpower/period/detail.chunk.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/pro/pages/manpower/period/detail.chunk.css" asp-append-version="true" />
    </environment>
}
@section Scripts {
    <script>window.periodId = @Model;</script>
    <environment include="Development">
        <script src="~/js/dev/pages/manpower/period/detail.chunk.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/pro/pages/manpower/period/detail.chunk.js" asp-append-version="true"></script>
    </environment>
}
<div id="detail-app-container"></div>