@{
    ViewData["Title"] = "Role Assignment";
}
@section Breadcrumb {
    <ol class="breadcrumb">
        <li class="breadcrumb-item">Admin Center</li>
        <li class="breadcrumb-item active">Role Assignment</li>
    </ol>
}
@section Styles {
    <environment include="Development">
        <link rel="stylesheet" href="~/css/dev/pages/admin/role-assignment.chunk.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/pro/pages/admin/role-assignment.chunk.css" asp-append-version="true" />
    </environment>
}
@section Scripts {
    <environment include="Development">
        <script src="~/js/dev/pages/admin/role-assignment.chunk.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/pro/pages/admin/role-assignment.chunk.js" asp-append-version="true"></script>
    </environment>
}
<div id="app-container"></div>