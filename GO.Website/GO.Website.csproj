<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net5.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="App_Data\SpNames.xml" />
    <None Remove="logs\log.txt" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="App_Data\SpNames.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="logs\log.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Fanex.Data" Version="4.2.2" />
    <PackageReference Include="Fanex.Data.Repository" Version="4.2.2" />
    <PackageReference Include="Fanex.Data.SqlServer" Version="4.2.2" />
    <PackageReference Include="HRM.UserControl.Client.AspNetCore" Version="1.0.3" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="6.0.1" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="3.1.0" />
    <PackageReference Include="Serilog.Sinks.Async" Version="1.5.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Views\Auth\Login.cshtml" />
    <None Include="Views\Error\AccessDenied.cshtml" />
    <None Include="Views\Error\InternalError.cshtml" />
    <None Include="Views\Error\PageNotFound.cshtml" />
  </ItemGroup>

</Project>
