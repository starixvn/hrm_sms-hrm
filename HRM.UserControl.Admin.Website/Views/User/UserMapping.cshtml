@using HRM.UserControl.Client.Core.Models.User
@model User
@{
    ViewData["Title"] = ViewResources.UserMapping;
}
@section Styles {
    <environment include="Development">
        <link rel="stylesheet" href="~/css/dev/pages/user/user-mapping.chunk.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/pro/pages/user/user-mapping.chunk.css" asp-append-version="true" />
    </environment>
}
@section Scripts{
    @if ((bool)ViewBag.isHost)
    {
        <script>
            window.selectedUser = @Json.Serialize(Model);
            window.hasHostPermissionOnUser = true;
        </script>
    }
    else
    {
        <script>
            window.selectedUser = @Json.Serialize(Model);
            window.hasHostPermissionOnUser = false;
        </script>
    }
    <environment include="Development">
        <script src="~/js/dev/pages/user/user-mapping.chunk.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/pro/pages/user/user-mapping.chunk.js" asp-append-version="true"></script>
    </environment>
}
@section Breadcrumb {
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="index">@ViewResources.UserManagement</a></li>
        <li class="breadcrumb-item active">@ViewResources.UserMapping</li>
    </ol>
}
<div id="app-container"></div>