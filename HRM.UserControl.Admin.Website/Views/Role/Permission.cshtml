@model short?
@{
    ViewData["Title"] = ViewResources.RolePermission;
}
@section Styles {
    <environment include="Development">
        <link rel="stylesheet" href="~/css/dev/pages/role/permission.chunk.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/pro/pages/role/permission.chunk.css" asp-append-version="true" />
    </environment>
}
@section Scripts{
    <script>
        window.selectedSiteId = @Model;
    </script>
    <environment include="Development">
        <script src="~/js/dev/pages/role/permission.chunk.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/pro/pages/role/permission.chunk.js" asp-append-version="true"></script>
    </environment>
}
@section Breadcrumb {
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="index">@ViewResources.RoleManagement</a></li>
        <li class="breadcrumb-item active">@ViewResources.RolePermission</li>
    </ol>
}
<div id="app-container"></div>