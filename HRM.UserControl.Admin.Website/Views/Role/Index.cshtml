@model bool
@{
    ViewData["Title"] = ViewResources.RoleManagement;
}
@section Styles {
    <environment include="Development">
        <link rel="stylesheet" href="~/css/dev/pages/role/index.chunk.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/pro/pages/role/index.chunk.css" asp-append-version="true" />
    </environment>
}
@section Scripts {
    @if (Model)
    {
        <script>window.hasHostPermissionOnRole = true;</script>
    }
    else
    {
        <script>window.hasHostPermissionOnRole = false;</script>
    }
    <environment include="Development">
        <script src="~/js/dev/pages/role/index.chunk.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/pro/pages/role/index.chunk.js" asp-append-version="true"></script>
    </environment>
}
@section Breadcrumb {
    <ol class="breadcrumb">
        <li class="breadcrumb-item active">@ViewResources.RoleManagement</li>
    </ol>
}
<div id="app-container"></div>