<?xml version="1.0" encoding="utf-8" ?>
<siteMap xmlns="http://schemas.microsoft.com/AspNet/SiteMap-File-1.0">
  <siteMapNode title="Root"  changeFrequency="Always"  updatePriority="Normal">
    <siteMapNode title="Personal">
      <siteMapNode title="My dashboard" controller="employee" action="myspace" icon="news" />
      <siteMapNode title="Leave request" controller="leave" action="employeeview" icon="calendar7" hoverController="leave" hoverAction="create" hoverIcon="plus" />
      <siteMapNode title="Change shift" controller="changeshift" action="employeeview" icon="clock3" hoverController="changeshift" hoverAction="create" hoverIcon="plus" />
      <siteMapNode title="Late in - Early out" controller="lateinearlyout" action="employeeview" icon="clock2" hoverController="lateinearlyout" hoverAction="create" hoverIcon="plus" />
      <siteMapNode title="Check in - Check out" controller="checkinout" action="employeeview" icon="clock1" hoverController="checkinout" hoverAction="create" hoverIcon="plus" />
      <siteMapNode title="Keep in view" controller="keepinview" action="employeeview" icon="keepinview" hoverController="keepinview" hoverAction="create" hoverIcon="plus" />
      <siteMapNode title="My overtime" controller="overtime" action="employeeview" icon="calendar1" />
      <siteMapNode title="My Timesheet" controller="report" action="timesheet" icon="calendar8" />
      <siteMapNode title="My calendar" controller="calendar" action="myworkingschedule" icon="calendar" />
      <siteMapNode title="Members' request" controller="request" action="member" icon="user1" roles="Approver, Verifier"/>
      <siteMapNode title="Members' overtimes" controller="overtime" action="memberovertime" icon="user1" roles="Approver, Verifier"/>
      <siteMapNode title="Requests statistic" controller="report" action="LeaderRequestMonitoring" icon="search" roles="Approver, Verifier" id="1"/>
      <siteMapNode title="Schedule Arrange" controller="Calendar" action="ArrangeSchedule" icon="schedule1" roles="ShiftManager"/>
      <siteMapNode title="Shift Statistic" controller="Calendar" action="ShiftStatistic" icon="schedule" roles="ShiftManager, HR"/>
      <siteMapNode title="My profile" controller="account" action="index" icon="user" />
	  <siteMapNode title="My messages" controller="message" action="viewMessageOfEmployee" icon="message1" />
    </siteMapNode>
    <siteMapNode title="HR space" roles="HR" >
      <siteMapNode title="Employees' request" controller="request" action="hrview" icon="user1" roles="HR" />
      <siteMapNode title="Employees' Overtimes" controller="overtime" action="EmployeeOvertime" icon="user1" roles="HR" />
      <siteMapNode title="Requests Statistics" controller="report" action="HRRequestMonitoring" icon="search" roles="HR"/>
      <siteMapNode title="User management" controller="employee" action="UserManagement" icon="users" />
      <siteMapNode title="Section management" controller="team" action="index" icon="setting" />
      <siteMapNode title="Job title management" controller="jobtitle" action="jobtitlemanagement" icon="user" />
      <siteMapNode title="Time Record" controller="report" action="timerecord" icon="finger" roles="HR"/>
      <siteMapNode title="Reports" controller="report" action="index" icon="search" roles="HR"/>
      <siteMapNode title="Message" controller="message" action="index" icon="message1" roles="HR"/>
    </siteMapNode>
    <siteMapNode title="Company space">
      <siteMapNode title="Contact list" controller="employee" action="index" icon="users" />
      <siteMapNode title="Working calendars" controller="calendar" action="workingcalendars" icon="calendar" />
      <siteMapNode title="Daily request" controller="request" action="dailyview"  icon="user1"/>
      <siteMapNode title="Attendance report" controller="report" action="attendance" icon="calendar1" />
      <siteMapNode title="Annual leave balance" controller="annualleavebalance" action="index" icon="calendar6"/>
      <siteMapNode title="Unpaid leave" controller="report" action="UnpaidLeaveSummary" icon="calendar7"/>
      <siteMapNode title="Extension numbers" controller="ExtensionNumber" action="Index" icon="mobile" />
      <siteMapNode title="Company memo" controller="memo" action="index" icon="memo" />
    </siteMapNode>
    <siteMapNode title="SA space" roles="SystemAdmin">
      <siteMapNode title="Create account" controller="employee" action="create" icon="adduser" roles="SystemAdmin"/>
      <siteMapNode title="Void request" controller="request" action="voidrequest" icon="user1" roles="SystemAdmin"/>
      <siteMapNode title="Division" controller="department" action="index" icon="setting" roles="SystemAdmin"/>
    </siteMapNode>
  </siteMapNode>
</siteMap>
