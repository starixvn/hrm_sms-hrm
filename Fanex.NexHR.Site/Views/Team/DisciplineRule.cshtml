@using Fanex.NexHR.Models.Section
@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels.Section
@model DisciplineRuleViewModel
@{
    ViewBag.Title = Labels.DisciplineRule;
    var disabled = Model.IsHost ? string.Empty : "disabled";
}
@section css{
    <link href="~/wwwroot/dist/styles/team.discipline.rule.css" rel="stylesheet" />
}
@section js{
    <script src="~/wwwroot/dist/js/team.discipline.rule.js"></script>
}
@section Breadcrumb {
    <a class="step">@Labels.HRSpace</a>
    <a class="step" href="@Url.Action("index", "team")">@Labels.SectionManagement</a>
    <span class="step">@ViewBag.Title</span>
}
<h2 class="page-title">@Labels.DisciplineRule for @Model.Section</h2>
@Html.HiddenFor(model => model.SectionId)
<table id="tabledata" class="table table-custom" style="width: auto; min-width: 500px;">
    <thead>
        <tr>
            <th>@Labels.DisciplineType</th>
            <th>@Labels.Local</th>
            <th>@Labels.Expat</th>
        </tr>
    </thead>
    <tbody>
        @foreach (DisciplineRule discipline in Model.DisciplineRules)
        {
            <tr data-disciplinetypeid="@discipline.DisciplineTypeId">
                <td class="align-left">@discipline.Name</td>
                <td>
                    <div class="checkbox">
                        <input type="checkbox" class="checkbox-custom" name="local" id="local@(discipline.DisciplineTypeId)"
                               @(discipline.IsApplyForLocal ? "checked" : string.Empty) @disabled />
                        <label for="local@(discipline.DisciplineTypeId)"></label>
                    </div>
                </td>
                <td>
                    <div class="checkbox">
                        <input type="checkbox" class="checkbox-custom" name="expat" id="expat@(discipline.DisciplineTypeId)"
                               @(discipline.IsApplyForExpat ? "checked" : string.Empty) @disabled />
                        <label for="expat@(discipline.DisciplineTypeId)"></label>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.IsHost)
{
    <button type="button" id="btnSubmit" class="btn btn-primary">@Labels.Save</button>
}
    <button type="button" class="btn btn-default" onclick="window.history.back()">@Labels.Back</button>