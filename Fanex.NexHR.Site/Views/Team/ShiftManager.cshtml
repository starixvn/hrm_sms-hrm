@{
    Layout = "~/Views/Shared/_NewLayout.cshtml";
    ViewBag.Title = "Edit Section Supervisor";
    var sectionId = (int)ViewBag.SectionId;
    var roleId = (short)ViewBag.RoleId;
}
@section css{
    <link href="~/wwwroot/dist/styles/section.edit.discipline.manager.css" rel="stylesheet" />
}
@section js{
    <script src="~/wwwroot/dist/js/section.edit.shift.manager.js"></script>
}
@section Breadcrumb
{
    <a class="step">@Labels.HRSpace</a>
    <a href="@Url.Action("index", "team")" class="step">@Labels.SectionManagement</a>
    <a href="@Url.Action("TeamSupervisor", "team", new { id = sectionId })" class="step">@Labels.SectionSupervisor</a>
    <a class="step">@Labels.ShiftArrangement</a>
}

@Html.Hidden("SectionId", sectionId)
@Html.Hidden("RoleId", roleId)
<div id="shift-wrapper"></div>