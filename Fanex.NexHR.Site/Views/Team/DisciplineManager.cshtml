@{
    Layout = "~/Views/Shared/_NewLayout.cshtml";
    ViewBag.Title = Labels.DisciplineManager;
    var teamId = (int)ViewBag.TeamId;
}
@section css{
    <link href="~/wwwroot/dist/styles/section.edit.discipline.manager.css" rel="stylesheet" />
}
@section js{
    <script src="~/wwwroot/dist/js/section.edit.discipline.manager.js"></script>
}
@section Breadcrumb {
    <a class="step">@Labels.HRSpace</a>
    <a href="@Url.Action("index", "team")" class="step">@Labels.SectionManagement</a>
    <a href="@Url.Action("TeamSupervisor", "team", new { id = teamId })" class="step">@Labels.SectionSupervisor</a>
    <a class="step">@Labels.DisciplineManager</a>
}

<h2 class="page-title">@ViewBag.Title</h2>

@Html.Hidden("TeamId", teamId)
@Html.Hidden("RoleId", (short)ViewBag.RoleId)
<div id="discipline-wrapper"></div>