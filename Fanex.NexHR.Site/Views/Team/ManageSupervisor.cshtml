@{
    ViewBag.Title = "Edit Team Supervisor";
    var teamId = (int)ViewBag.TeamId;
    var roleId = (short)ViewBag.RoleId;
    var breadcrumb = string.Empty;
}
@section css{
    <link href="~/wwwroot/dist/styles/team.edit.supervisor.css" rel="stylesheet" />
}
@section js{
    <script src="~/wwwroot/dist/js/team.edit.supervisor.js"></script>
}
@section Breadcrumb
{
    <a class="step">@Labels.HRSpace</a>
    <a href="@Url.Action("index", "team")" class="step">@Labels.TeamManagement</a>
    <a href="@Url.Action("TeamSupervisor", "team", new { id = teamId })" class="step">@Labels.TeamSupervisor</a>
    <a class="step">
        @switch (roleId)
        {
            case (short)RoleSystem.Verifier:
                breadcrumb = Labels.Verifier;
                break;
            case (short)RoleSystem.Approver:
                breadcrumb = Labels.Approver;
                break;
            case (short)RoleSystem.OnBehalfRequest:
                breadcrumb = Labels.OnBehalfRequest;
                break;
        }
        @breadcrumb
    </a>
}

@Html.Hidden("TeamId", teamId)
@Html.Hidden("RoleId", roleId)
<div id="supervisor-wrapper"></div>