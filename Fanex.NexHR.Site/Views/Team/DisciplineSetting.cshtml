@model SupervisorViewModel
@{
    ViewBag.Title = Labels.DisciplineSetting;
}
@section css{
    @Url.CombresLink("teamdisciplinesettingcss")
}
@section js{
    @Url.CombresLink("teamdisciplinesettingjs")
}
@section Breadcrumb
{
    <a class="step">@Labels.HRSpace</a>
    <a href="@Url.Action("index", "team")" class="step">@Labels.SectionManagement</a>
    <a href="@Url.Action("TeamSupervisor", "team", new { id = Model.TeamId })" class="step">@Labels.SectionSupervisors</a>
    <a class="step">@Labels.DisciplineSetting</a>
}
<table id="tblSupervisor" class="table table-custom">
    <thead>
        <tr>
            <th colspan="3" class="align-left">
                <span class="title">@Labels.Employee</span> <span class="control">
                    @Html.TextBox("Supervisor", string.Empty, new { placeholder = Messages.SearchEmployeeWatermark })
                </span>
                @Html.Hidden("SupervisorId")
                @Html.Hidden("SupervisorTeam")
                <span class="add">
                    <a id="lknAdd" href="javascript:;">+ Add to list</a>
                </span>
            </th>
        </tr>
        <tr>
            <th class="supervisor">
                @Labels.Priority
            </th>
            <th class="supervisor">
                @Labels.Employee
            </th>
            <th>
                <a id="removeAll" href="javascript:;">@Labels.RemoveAll</a>
            </th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.SupervisorList != null && Model.SupervisorList.Any())
        {
            foreach (SupervisorModel item in Model.SupervisorList)
            {
                <tr>
                    <td>
                        <a href="javascript:;" class="moveUp">Up |</a>
                        <a href="javascript:;" class="moveDown">Down |</a>
                        <a href="javascript:;" class="moveTop">Top</a>
                    </td>
                    <td class="align-left" data-id="@item.OwnerId">
                        @item.NickName (@item.FullName)
                    </td>
                    <td>
                        <a href="javascript:;" class="lnkremove">@Labels.Remove</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
<div>
    @Html.Hidden("TeamId", Model.TeamId)
    @Html.Hidden("SupervisorRole", Model.SupervisorRole)
    <input id="btnSave" type="button" value="Save" />
    <a href="/team/TeamSupervisor/@Model.TeamId">
        <input type="button" value="Back" />
    </a>
</div>

