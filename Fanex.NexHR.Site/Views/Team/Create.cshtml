@using Fanex.NexHR.ViewModels.EmployeeGroup
@model TeamViewModel

@{
    ViewBag.Title = "Add new Section";
}

@section css{
    @Url.CombresLink("sitecss")
}
@section js{
    @Url.CombresLink("teameditjs")
}
@section Breadcrumb {
    <a class="step">HR Space</a>
    <a class="step" href="@Url.Action("index", "team")">Section Management</a>
    <span class="step">@ViewBag.Title</span>
}

<h2>@Labels.Create</h2>

@using (Html.BeginForm())
{
    <div class="bunhat">
        @Html.ValidationSummary(true)
        @Html.HiddenFor(model => model.CreatedDate)
        @Html.HiddenFor(model => model.CreatedBy)
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.TeamCode)
            </div>
            <div class="input">
                @Html.EditorFor(model => model.TeamCode)
                @Html.ValidationMessageFor(model => model.TeamCode)
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.TeamName)
            </div>
            <div class="input">
                @Html.EditorFor(model => model.TeamName)
                @Html.ValidationMessageFor(model => model.TeamName)
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.DepartmentId, Labels.Department)
            </div>
            <div class="input">
                @Html.DropDownListFor(model => model.DepartmentId, new SelectList(Model.Departments, "Id", "Name"))
                @Html.ValidationMessage("DepartmentId")
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Leaders, "Head")
            </div>
            <div class="input">
                @Html.HiddenFor(model => model.LeaderIds)
                <select id="Leaders" data-placeholder="Choose leaders..." multiple class="chosen-select">
                    @foreach (var employee in Model.Employees)
                    {
                        <option value="@employee.Id">@(employee.NickName + " (" + employee.FullName + ")")</option>
                    }
                </select>
                @Html.ValidationMessage("LeaderIds")
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.AssistantLeaders, "Assist Head")
            </div>
            <div class="input">
                @Html.HiddenFor(model => model.AssistantLeaderIds)
                <select id="AssistantLeaders" data-placeholder="Choose assistant leaders..." multiple class="chosen-select">
                    @foreach (var employee in Model.Employees)
                    {
                        <option value="@employee.Id" selected="@Model.AssistantLeaders.Any(l => l.Id == employee.Id)">@(employee.NickName + " (" + employee.FullName + ")")</option>
                    }
                </select>
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.MailGroup)
            </div>
            <div class="input">
                @Html.EditorFor(model => model.MailGroup)
                @Html.ValidationMessageFor(model => model.MailGroup)
            </div>
        </div>
        <div class="formrow">
            <div class="label">
            </div>
            <div class="input">
                <input type="submit" value="@Labels.Add" />
                <a href="@Url.Action("index","team")" class="button">@Labels.Back</a>
            </div>
        </div>
    </div>
}