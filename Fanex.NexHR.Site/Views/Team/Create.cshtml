@using Fanex.NexHR.ViewModels.EmployeeGroup
@model TeamViewModel

@{
    ViewBag.Title = "Add new Section";
}

@section css{
    @Url.CombresLink("sitecss")
}
@section js{
    @Url.CombresLink("teameditjs")
}
@section Breadcrumb {
    <a class="step">HR Space</a>
    <a class="step" href="@Url.Action("index", "team")">Section Management</a>
    <span class="step">@ViewBag.Title</span>
}

<h2>@Labels.Create</h2>

@using (Html.BeginForm())
{
    <div class="bunhat">
        @Html.ValidationSummary(true)
        @if (ViewBag.Inserted != null && (bool)ViewBag.Inserted)
        {
            <div class="success">@Messages.TeamCreated</div>
        }

        @Html.HiddenFor(model => model.CreatedDate)
        @Html.HiddenFor(model => model.CreatedBy)
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.TeamCode)
            </div>
            <div class="input">
                @Html.EditorFor(model => model.TeamCode)
                @Html.ValidationMessageFor(model => model.TeamCode)
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.TeamName)
            </div>
            <div class="input">
                @Html.EditorFor(model => model.TeamName)
                @Html.ValidationMessageFor(model => model.TeamName)
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.DepartmentId, Labels.Department)
            </div>
            <div class="input">
                @Html.DropDownListFor(model => model.DepartmentId, new SelectList(Model.Departments, "Id", "Name"))
                @Html.ValidationMessage("DepartmentId")
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Leader, "Head")
            </div>
            <div class="input">
                @Html.TextBox("Leader", string.Empty, new { placeholder = Messages.SearchEmployeeWatermark })

                @Html.ValidationMessage("Leader")

                @Html.HiddenFor(model => model.Leader)
                @Html.HiddenFor(model => model.LeaderId)
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.AssistantLeader, "Assist Head")
            </div>
            <div class="input">
                @Html.TextBox("AssistantLeader", string.Empty, new { placeholder = Messages.SearchEmployeeWatermark })

                @Html.HiddenFor(model => model.AssistantLeader)
                @Html.HiddenFor(model => model.AssistantLeaderId)
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.MailGroup)
            </div>
            <div class="input">
                @Html.EditorFor(model => model.MailGroup)
                @Html.ValidationMessageFor(model => model.MailGroup)
            </div>
        </div>
        <div class="formrow">
            <div class="label">
            </div>
            <div class="input">
                <input type="submit" value="@Labels.Add" />
                <a href="@Url.Action("index","team")" class="button">@Labels.Back</a>
            </div>
        </div>
    </div>
}