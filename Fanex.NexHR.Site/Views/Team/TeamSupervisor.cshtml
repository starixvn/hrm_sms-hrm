@using Fanex.NexHR.Models.Supervisor
@model List<TeamSupervisorModel>
@{
	ViewBag.Title = "Team Supervisor";
}
@section css{
	@Url.CombresLink("teamsupervisorcss")
}
@section js{
	@Url.CombresLink("teamsupervisorjs")
}
@section Breadcrumb {
	<a class="step">HR Space</a>
	<a href="~/team/index/" class="step">Team Management</a>
	<a class="step">@ViewBag.Title</a>
}
<h2>@ViewBag.Title</h2>
<table class="data" style="width: auto; min-width: 800px;">
	<thead>
		<tr>
			<th class="supervisor-team">@Labels.Team
			</th>
			<th>
				Action
			</th>
			<th>
				Supervisor Name
			</th>
			<th class="supervisor-action">
				Edit
			</th>
		</tr>
	</thead>
	@if (Model != null)
 {
	 int rowCount = 0;
		<tbody>
			<tr>
				@foreach (TeamSupervisorModel item in Model)
	{
		
		if (rowCount == 0)
		{
					<td rowspan="4">
						@item.Code
					</td>
					<td>
						@item.ActionName
					</td>
					<td class="supervisor-name">
						@item.Supervisors
					</td>
					<td>
						<a href="@Url.Action("ManageSupervisor", "Team", new { TeamId = ViewBag.TeamId, SupervisorRole = item.ActionType })">
							<img src="~/Styles/Images/edit-icon.png" /></a>
					</td>
			rowCount++;
		}
		else
		{
			<tr>
						<td>
							@item.ActionName
						</td>
						<td class="supervisor-name">
							@item.Supervisors
						</td>
						<td>
							<a href="@Url.Action("ManageSupervisor", "Team", new { TeamId = ViewBag.TeamId, SupervisorRole = item.ActionType })">
								<img src="~/Styles/Images/edit-icon.png" /></a>
						</td>
					</tr>
		}

	}
			</tr>
			@Html.Hidden("TeamId", (int)ViewBag.TeamId)
		</tbody>
 }
</table>
