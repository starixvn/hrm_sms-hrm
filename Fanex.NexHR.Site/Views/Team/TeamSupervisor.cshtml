@model List<TeamSupervisorModel>
@{
    ViewBag.Title = Labels.TeamSupervisor;
    var teamId = ViewBag.TeamId;
}
@section Breadcrumb {
    <a class="step">@Labels.HRSpace</a>
    <a href="@Url.Action("index", "team")" class="step">@Labels.TeamManagement</a>
    <a class="step">@ViewBag.Title</a>
}

@section css{
    <link href="~/wwwroot/dist/styles/team.supervisor.index.css" rel="stylesheet" />
}

<h2 class="page-title">@Labels.Team: @ViewBag.TeamCode</h2>
<table class="table table-custom" style="width: auto; min-width: 800px;">
    <thead>
        <tr>
            <th>@Labels.Roles</th>
            <th>@Labels.NickName</th>
            <th>@Labels.Edit</th>
        </tr>
    </thead>
    @if (Model != null)
    {
        <tbody>
            @foreach (TeamSupervisorModel item in Model)
            {
                <tr>
                    <td class="align-left">
                        @item.ActionName
                    </td>
                    <td class="align-left">
                        @item.Supervisors
                    </td>
                    <td>
                        @switch (item.ActionType)
                        {
                            case (short)RoleSystem.ShiftManager:
                                <a href="@Url.Action("ShiftManager", "Team", new { id = teamId })">
                                    <i class="fa fa-pencil fa-lg icon-edit"></i>
                                </a>
                                break;
                            case (short)RoleSystem.Verifier:
                            case (short)RoleSystem.Approver:
                            case (short)RoleSystem.OnBehalfRequest:
                                <a href="@Url.Action("ManageSupervisor", "Team", new { id = teamId, roleId = item.ActionType })">
                                    <i class="fa fa-pencil fa-lg icon-edit"></i>
                                </a>
                                break;
                            case (short)RoleSystem.DisciplineManager:
                                <a href="@Url.Action("DisciplineManager", "Team", new { id = teamId })">
                                    <i class="fa fa-pencil fa-lg icon-edit"></i>
                                </a>
                                break;
                        }
                    </td>
                </tr>
            }
        </tbody>
    }
</table>