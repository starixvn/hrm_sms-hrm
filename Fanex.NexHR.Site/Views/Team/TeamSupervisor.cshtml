@model List<TeamSupervisorModel>
@{
    ViewBag.Title = Labels.SectionSupervisor;
}
@section css{
    @Url.CombresLink("teamsupervisorcss")
}
@section js{
    @Url.CombresLink("teamsupervisorjs")
}
@section Breadcrumb {
    <a class="step">@Labels.HRSpace</a>
    <a href="@Url.Action("index", "team")" class="step">@Labels.SectionManagement</a>
    <a class="step">@ViewBag.Title</a>
}
<h2>@ViewBag.Title</h2>
<table class="table table-custom" style="width: auto; min-width: 800px;">
    <thead>
        <tr>
            <th>@Labels.Section</th>
            <th>@Labels.Roles</th>
            <th>@Labels.Nick</th>
            <th>@Labels.Edit</th>
        </tr>
    </thead>
    @if (Model != null)
    {
        int rowCount = 0;
        <tbody>
            @Html.Hidden("TeamId", (int)ViewBag.TeamId)
            @foreach (TeamSupervisorModel item in Model)
            {

                if (rowCount == 0)
                {
                    <tr>
                        <td rowspan="5">
                            @item.Code
                        </td>
                        <td class="align-left">
                            @item.ActionName
                        </td>
                        <td class="align-left">
                            @item.Supervisors
                        </td>
                        <td>
                            @if (item.ActionType == (short)RoleSystem.ShiftManager)
                            {
                            }
                            else
                            {
                                <a href="@Url.Action("ShiftManager", "Team", new { TeamId = ViewBag.TeamId })">
                                    <i class="fa fa-pencil fa-lg icon-edit"></i>
                                </a>
                            }
                        </td>
                    </tr>
                    rowCount++;
                }
                else
                {
                    <tr>
                        <td class="align-left">
                            @item.ActionName
                        </td>
                        <td class="align-left">
                            @item.Supervisors
                        </td>
                        <td>
                            @switch (item.ActionType)
                            {
                                case (short)RoleSystem.ShiftManager:
                                    break;
                                case (short)RoleSystem.Verifier:
                                case (short)RoleSystem.Approver:
                                case (short)RoleSystem.ActingSupervisor:
                                    <a href="@Url.Action("ManageSupervisor", "Team", new { TeamId = ViewBag.TeamId, SupervisorRole = item.ActionType })">
                                        <i class="fa fa-pencil fa-lg icon-edit"></i>
                                    </a>
                                    break;
                                case (short)RoleSystem.DisciplineManager:
                                <a href="@Url.Action("DisciplineSetting", "Team", new { TeamId = ViewBag.TeamId })">
                                    <i class="fa fa-pencil fa-lg icon-edit"></i>
                                </a>
                                    break;
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    }
</table>