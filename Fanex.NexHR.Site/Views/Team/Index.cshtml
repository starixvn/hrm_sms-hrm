@using Fanex.NexHR.Models
@using Fanex.NexHR.Resources
@model IList<Team>
@{
    ViewBag.Title = Labels.SectionManagement;
    var hasPermission = (bool)ViewBag.HasPermission;
    var hasPermissionToViewEmployee = (bool)ViewBag.HasPermissionToViewEmployee;
}
@section css{
    <link href="~/wwwroot/dist/styles/section.index.css" rel="stylesheet" />
}
@section js{
    <script src="~/wwwroot/dist/js/section.index.js"></script>
}
@section Breadcrumb {
    <a class="step">@Labels.HRSpace</a><span class="step">@ViewBag.Title</span>
}
<h2 class="page-title">@ViewBag.Title</h2>
<div class="filter">
    @if (hasPermission)
    {
        <a href="/team/create" class="btn btn-request">
            <span class="fa fa-plus"></span> @Labels.NewSection
        </a>
    }

    @Html.ActionLink("Employee Permission Summary", "EmployeeSupervisor", "report", null, new { @class = "btn btn-primary" })
    @Html.ActionLink("Section Permission Summary", "SectionSupervisor", "report", null, new { @class = "btn btn-primary" })
</div>
<table id="data" class="table table-custom" style="width: auto; min-width: 600px;">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th>@Labels.Code</th>
            <th>@Labels.Team</th>
            <th>@Labels.Department</th>
            <th>@Labels.SectionHead</th>
            <th>@Labels.AssistantSectionHead</th>
            <th>@Labels.Email</th>
            <th>@Labels.BasicAnnualLeaveBalance</th>
            <th>@Labels.TotalExpat</th>
            <th>@Labels.TotalLocal</th>
            <th>@Labels.Total</th>
            <th>@Labels.DisciplineRule</th>
            @if (hasPermission)
            {
                <th>@Labels.Edit</th>
                <th>@Labels.Roles</th>
                <th>@Labels.Delete</th>
            }
        </tr>
    </thead>
    <tbody>
        @{int index = 1;}
        @foreach (Team team in Model)
        {
            <tr id="row@(team.Id)">
                <td>@(index++)</td>
                <td>@team.Code</td>
                <td>@team.Name</td>
                <td>@team.Department.Name</td>
                <td>@string.Join(", ", team.Leaders.Select(x => x.Nickname))</td>
                <td>@string.Join(", ", team.AssistantLeaders.Select(x => x.Nickname))</td>
                <td class="align-left">@team.MailGroup</td>
                <td>@team.BasicAnnualLeaveBalance</td>
                <td>@team.TotalExpat</td>
                <td>@team.TotalLocal</td>
                <td>
                    @if (@team.NoOfMembers > 0 && hasPermissionToViewEmployee)
                    {
                        <a href="@Url.Action("UserManagement", "Employee", new { groupIds = team.Id })">@team.NoOfMembers</a>
                    }
                    else
                    {
                        <span>@team.NoOfMembers</span>
                    }
                </td>
                <td>
                    <a href="@Url.Action("disciplinerule", "team", new { Id = team.Id })">Manage</a>
                </td>
                @if (hasPermission)
                {
                    <td>
                        <a href="@Url.Action("Edit", "Team", new { Id = team.Id })">
                            <i class="fa fa-pencil fa-lg icon-edit"></i>
                        </a>
                    </td>
                    <td>
                        <a href="@Url.Action("TeamSupervisor", "Team", new { Id = team.Id })">Manage</a>
                    </td>
                    <td>
                        @if (team.NoOfMembers > 0)
                        {
                            <i class="fa fa-times fa-lg fa-disabled icon-delete"></i>
                        }
                        else
                        {
                            <a href="javascript:;" class="deleteTeam" data-team-id="@team.Id">
                                <i class="fa fa-times fa-lg icon-delete"></i>
                            </a>
                        }
                    </td>
                }
            </tr>
        }
    </tbody>
</table>