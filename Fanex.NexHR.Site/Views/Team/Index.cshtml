@model IList<Team>
@{
    ViewBag.Title = "Section Management";
}
@section css{
    @Url.CombresLink("sitecss")
}
@section js{
    @Url.CombresLink("teameditjs")
}
@section Breadcrumb {
    <a class="step">HR Space</a><span class="step">@ViewBag.Title</span>
}
<h2>@ViewBag.Title</h2>
<div class="button-icon">
    <span class="icon plus"></span>@Html.ActionLink("New Section", "Create")</div>
<div class="clear">
</div>
<div class="space">
</div>
<table class="data" style="width: auto; min-width: 600px;">
    <thead>
        <tr>
            <th>
                #
            </th>
            <th>@Labels.Code
            </th>
            <th>
                @Labels.Team
            </th>
            <th>@Labels.Department
            </th>
            <th>
                Section Head
            </th>
            <th>
                Assist.Section Head
            </th>
            <th>
                Email
            </th>
            <th>
                Total Expat
            </th>
            <th>
                Total Local
            </th>
            <th>
                Total
            </th>
            <th>
                @Labels.Edit
            </th>
            <th>
                Roles
            </th>
            <th>
                @Labels.Delete
            </th>
        </tr>
    </thead>
    <tbody>
        @{int index = 1;}
        @foreach (Team team in Model)
        {
            <tr id="row@(team.Id)">
                <td>@(index++)
                </td>
                <td>@team.Code
                </td>
                <td>@team.Name
                </td>
                <td>
                    @team.Department.Name
                </td>
                @if (team.Leader != null)
                {
                    <td class="tooltip" title="@team.Leader.FullName">@team.Leader.NickName
                    </td>
                }
                else
                {
                    <td>
                    </td>
                }
                @if (team.AssistantLeader != null)
                {
                    <td class="tooltip" title="@team.AssistantLeader.FullName">@team.AssistantLeader.NickName
                    </td>
                }
                else
                {
                    <td>
                    </td>
                }
                <td class="left">@team.MailGroup
                </td>
                <td>@team.TotalExpat
                </td>
                <td>@team.TotalLocal
                </td>
                <td>
                    @{
                if (@team.NoOfMembers > 0)
                {
                        <a href="@Url.Action("UserManagement", "Employee", new { groupIds = team.Id })">@team.NoOfMembers</a>
                }
                else
                {
                        <span>@team.NoOfMembers</span>
                }   
                    }
                </td>
                <td class="cmd">
                    <a href="@Url.Action("Edit", "Team", new { Id = team.Id })">
                        <img src="~/Styles/Images/edit-icon.png" /></a>
                </td>
                <td class="cmd">
                    <a href="@Url.Action("TeamSupervisor", "Team", new { Id = team.Id })">Manage</a>
                </td>
                <td class="cmd">
                    @{
                if (team.NoOfMembers > 0)
                {
                        <img src="~/Styles/Images/disabled-delete.png" />
                }
                else
                {
                        <a href="javascript:;" onclick="deleteTeam(@team.Id);">
                            <img src="~/Styles/Images/delete-icon.png" /></a>
                }
                    }
                </td>
                @Html.Hidden("groupid", team.Id)
            </tr>
        }
    </tbody>
</table>
