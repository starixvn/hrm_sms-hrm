@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Models
@using Fanex.NexHR.Resources
@model IList<Team>
    @{
        ViewBag.Title = Labels.TeamManagement;
        var hasPermission = (bool)ViewBag.HasPermission;
        var hasPermissionToViewEmployee = (bool)ViewBag.HasPermissionToViewEmployee;
    }
    @section css{
        <link href="~/wwwroot/dist/styles/team.index.css" rel="stylesheet" />
    }
    @section js{
        <script src="~/wwwroot/dist/js/team.index.js"></script>
    }
    @section Breadcrumb {
        <a class="step">@Labels.HRSpace</a><span class="step">@ViewBag.Title</span>
    }
    <h2 class="page-title">@ViewBag.Title</h2>
        @using (Html.BeginForm("index", "team", FormMethod.Get, new { @class = "filter" }))
        {
            <div class="form-horizontal clearfix">
                <div class="form-group form-group--m">
                    <div class="label-form">
                        @Html.Label(@Labels.Keyword, new { @class = "control-label" })
                    </div>
                    <div class="input-form">
                        <input id="nameSearch" type="text" name="nameInput" placeholder="@Messages.SearchTeamOrCode" class="form-control" autocomplete="off" />
                    </div>
                </div>
                <button class="btn btn-primary" type="submit" id="btnSearchTeam">@Labels.Submit</button>
                @if (hasPermission)
                {
                    <a href="/team/create" class="btn btn-request">
                        <span class="fa fa-plus"></span> @Labels.NewTeam
                    </a>
                }

                @Html.ActionLink("Employee Permission Summary", "EmployeeSupervisor", "report", null, new { @class = "btn btn-primary" })
                @Html.ActionLink("Team Permission Summary", "TeamSupervisor", "report", null, new { @class = "btn btn-primary" })
            </div>
        }
    <table id="data" class="table table-custom" style="width: auto; min-width: 600px;">
        <thead>
            <tr>
                <th>@Labels.SymbolCount</th>
                <th class="col-sorter" style="width: 120px" ;>
                    @Labels.Department
                    <div class="fa fa-sort" data-property="Department"></div>
                </th>
                <th class="col-sorter" style="width: 100px" ;>
                    @Labels.Section
                    <div class="fa fa-sort" data-property="Section"></div>
                </th>
                <th class="col-sorter">
                    @Labels.Team
                    <div class="fa fa-sort" data-property="Team"></div>
                </th>
                <th class="col-sorter">
                    @Labels.Code
                    <div class="fa fa-sort" data-property="Code"></div>
                </th>
                <th class="col-sorter" style="width: 100px" ;>
                    @Labels.UnitHead
                    <div class="fa fa-sort" data-property="UnitHead"></div>
                </th>
                <th class="col-sorter">
                    @Labels.Manager
                    <div class="fa fa-sort" data-property="Manager"></div>
                </th>
                <th class="col-sorter">
                    @Labels.Supervisor
                    <div class="fa fa-sort" data-property="Supervisor"></div>
                </th>
                <th class="col-sorter" style="width: 110px" ;>
                    @Labels.TeamLeader
                    <div class="fa fa-sort" data-property="TeamLeader"></div>
                </th>
                <th class="col-sorter">
                    @Labels.Email
                    <div class="fa fa-sort" data-property="Email"></div>
                </th>
                <th> @Labels.BasicAnnualLeaveBalance</th>
                <th class="col-sorter" style="width: 100px" ;>
                    @Labels.TotalExpat
                    <div class="fa fa-sort" data-property="TotalExpat"></div>
                </th>
                <th class="col-sorter" style="width: 100px" ;>
                    @Labels.TotalLocal
                    <div class="fa fa-sort" data-property="TotalLocal"></div>
                </th>
                <th class="col-sorter" style="width: 80px" ;>
                    @Labels.Total
                    <div class="fa fa-sort" data-property="Total"></div>
                </th>
                <th>@Labels.DisciplineRule</th>
                @if (hasPermission)
                {
                    <th>@Labels.Edit</th>
                    <th>@Labels.Roles</th>
                    <th>@Labels.Delete</th>
                }
            </tr>
        </thead>
        <tbody>
            @{int index = 1;}
            @foreach (Team team in Model)
            {
                var unitHead = team.Managers.FirstOrDefault(x => x.RoleId == (byte)TeamManagerRole.Head);
            <tr id="row@(team.Id)">
                <td>@(index++)</td>
                <td>@team.Department.Code</td>
                <td>@team.Section.Name</td>
                <td>@team.Name</td>
                <td>@team.Code</td>
                <td>@(unitHead != null ? unitHead.Nickname : string.Empty)</td>
                <td>@string.Join(", ", team.Managers.Where(x => x.RoleId == (byte)TeamManagerRole.Manager).Select(x => x.Nickname))</td>
                <td>@string.Join(", ", team.Managers.Where(x => x.RoleId == (byte)TeamManagerRole.Supervisor).Select(x => x.Nickname))</td>
                <td>@string.Join(", ", team.Managers.Where(x => x.RoleId == (byte)TeamManagerRole.Leader).Select(x => x.Nickname))</td>
                <td class="align-left">@team.MailGroup</td>
                <td>@team.BasicAnnualLeaveBalance</td>
                <td>@team.TotalExpat</td>
                <td>@team.TotalLocal</td>
                <td>
                    @if (@team.NoOfMembers > 0 && hasPermissionToViewEmployee)
                    {
                        <a href="@Url.Action("UserManagement", "Employee", new { teamIds = team.Id })">@team.NoOfMembers</a>
                    }
                    else
                    {
                        <span>@team.NoOfMembers</span>
                    }
                </td>
                <td>
                    <a href="@Url.Action("disciplinerule", "team", new { Id = team.Id })">Manage</a>
                </td>
                @if (hasPermission)
                {
                    <td>
                        <a href="@Url.Action("Edit", "Team", new { Id = team.Id })">
                            <i class="fa fa-pencil fa-lg icon-edit"></i>
                        </a>
                    </td>
                    <td>
                        <a href="@Url.Action("TeamSupervisor", "Team", new { Id = team.Id })">Manage</a>
                    </td>
                    <td>
                        @if (team.NoOfMembers > 0)
                        {
                            <i class="fa fa-times fa-lg fa-disabled icon-delete"></i>
                        }
                        else
                        {
                            <a href="javascript:;" class="deleteTeam" data-team-id="@team.Id">
                                <i class="fa fa-times fa-lg icon-delete"></i>
                            </a>
                        }
                    </td>
                }
            </tr>
            }
        </tbody>
    </table>
