@section css{
    @Url.CombresLink("myrequestcss")
}
@section js{
    @Url.CombresLink("paternityjs")
}
@section Breadcrumb {
    <a class="step">@Labels.HRSpace</a>
    <a class="step" href="/employee/usermanagement">@Labels.EmployeeManagement</a>
    <a class="step">@ViewBag.Title</a>
}
@{
    ViewBag.Title = "Employee Paternity";
}

@using (Html.BeginForm())
{
    <div class="container_24 bunhat">
        <div class="grid_1 gridlabel">
            <label for="Year">@Labels.Year</label>
        </div>
        <div class="grid_2">
            @Html.YearPicker("Year", 2010, DateTime.Now.Year)
        </div>
        <div class="grid_2">
            <input type="submit" id="submit" value="@Labels.Submit" class="button-primary submit processing-submit" />
        </div>
        @if (ViewBag.IsHost)
        {
            <div class="grid_5">
                <div class="button-icon" id="add-paternity">
                    <span class="icon plus"></span><a>Add Paternity</a>
                </div>
            </div>
        }
    </div>

    <div class="clear">
    </div>
}

<div id="list-paternity">
</div>
<div id="dialogAddPaternity"></div>
<div id="dialogEditPaternity"></div>