@using Fanex.NexHR.Models
@model IList<EmployeePaternity>

    <table class="table table-custom" id="data">
        <thead>
            <tr>
                <th>@Labels.SymbolCount</th>
                <th>@Labels.FullName</th>
                <th>@Labels.NickName</th>
                <th>Child's Born Date</th>
                <th>Leave Day</th>
                <th>@Labels.CreatedBy</th>
                <th>@Labels.CreatedDate</th>
                <th>@Labels.Remark</th>
                @if (ViewBag.IsHost)
                {
                    <th>@Labels.Action</th>
                }
            </tr>
        </thead>
        <tbody>
            @{int index = 1;}
            @if (Model != null && Model.Count > 0)
            {

                foreach (EmployeePaternity paternity in Model)
                {

                    <tr>
                        <td>@(index++)</td>
                        <td>@paternity.Fullname</td>
                        <td>@paternity.Nickname</td>
                        <td>@paternity.ChildBornDate.ToString("dd MMM yyyy")</td>
                        <td>@paternity.LeaveDay</td>
                        <td>@paternity.Creator</td>
                        <td>@paternity.CreatedDate.ToString("dd MMM yyyy")</td>
                        @if (!string.IsNullOrWhiteSpace(paternity.Remark))
                    {
                            <td class="tooltip" title="@paternity.Remark">
                                <span class="icon remark" alt="remark" />
                            </td>
                        }
                        else
                        {
                            <td>-</td>
                        }
                        @if (ViewBag.IsHost)
                        {
                            <td>
                                <a data-id="@paternity.PaternityId" class="edit-paternity" title="Edit">
                                    <i class="fa fa-pencil fa-lg icon-edit pointer"></i>
                                </a>
                                <a data-id="@paternity.PaternityId" class="delete-paternity" title="Delete">
                                    <i class="fa fa-trash fa-lg icon-delete pointer"></i>
                                </a>
                            </td>
                        }
                    </tr>
                }
            }
            else
            {
                @RazorHelper.DisplayNoInformation(colspan: 8);
            }
        </tbody>
    </table>