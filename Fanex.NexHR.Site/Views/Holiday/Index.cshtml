@model IList<Holiday>
@{
    ViewBag.Title = "Holiday";
    var hasPermission = (bool)ViewBag.HasPermission;
    var totalColumn = hasPermission ? 7 : 5;
}
@section css{
    @Url.CombresLink("holidaycss")
}
@section js{
    @Url.CombresLink("holidayjs")
}
@section Breadcrumb {
    <a class="step">@Labels.CompanySpace</a>
    <a class="step" href="@Url.Action("workingcalendars", "calendar")">Working calendars</a>
    <a class="step">@ViewBag.Title</a>
}
<h2>@ViewBag.Title</h2>

@using (Html.BeginGetForm())
{
    <div class="bunhat container_24">
        <div class="grid_1">
            Year
        </div>
        <div class="grid_2">
            @Html.YearPicker("year", 2010, (int)ViewBag.year)
        </div>
        <div class="grid_2">
            <input type="button" id="submit" value="@Labels.Submit" class="processing-submit" />
        </div>
        @if (hasPermission)
        {
            <div class="grid_2">
                <div class="button-icon"><span class="icon plus"></span>@Html.ActionLink("Holiday", "Create")</div>
            </div>
        }
    </div>
}

<table id="data" class="data persist-area">
    <thead>
        <tr class="persist-header">
            <th>@Labels.SymbolCount</th>
            <th>@Labels.Name</th>
            <th>@Labels.From</th>
            <th>@Labels.To</th>
            @if (hasPermission)
            {
                <th>
                    @Labels.Edit
                </th>

                <th>
                    @Labels.Delete
                </th>
            }
        </tr>
    </thead>
    @if (Model.Any())
    {
        <tbody>
            @{int index = 1;}
            @foreach (Holiday item in Model)
            {
                <tr id="row@(item.Id)">
                    <td>@(index++)</td>
                    <td class="left">
                        @item.HolidayName
                    </td>
                    <td class="ddMMyyyy">
                        @item.FromDate.ToDateMonthYearFormatedDate()
                    </td>
                    <td class="ddMMyyyy">
                        @item.ToDate.ToDateMonthYearFormatedDate()
                    </td>
                    @if (hasPermission)
                    {
                        <td class="cmd">
                            <a href="@Url.Action("Edit", "Holiday", new { Id = item.Id })">
                                <i class="fa fa-pencil fa-lg icon-edit"></i>
                            </a>
                        </td>
                        <td class="cmd">
                            <a href="javascript:;" class="js-link-delete-holiday" data-id="@item.Id">
                                <i class="fa fa-times fa-lg icon-delete"></i>
                            </a>
                        </td>
                    }
                </tr>
            }
        </tbody>
    }
    else
    {
        @RazorHelper.DisplayNoInformation(colspan: totalColumn);                    
    }
</table>