@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Core.Helpers
@using Fanex.NexHR.Resources
@model IList<Holiday>
    @{
        ViewBag.Title = Labels.Holiday;
        var hasPermission = (bool)ViewBag.HasPermission;
        var totalColumn = hasPermission ? 8 : 6;
    }
    @section css{
        <link href="~/wwwroot/dist/styles/holiday.index.css" rel="stylesheet" />
    }
    @section js{
        <script src="~/wwwroot/dist/js/holiday.index.js"></script>
    }
    @section Breadcrumb {
        <a class="step">@Labels.CompanySpace</a>
        <a class="step" href="@Url.Action("workingcalendars", "calendar")">Working calendars</a>
        <a class="step">@ViewBag.Title</a>
    }
    <h2 class="page-title">@ViewBag.Title</h2>

    @using (Html.BeginForm("index", "holiday", FormMethod.Get, new { @class = "filter" }))
    {
        <div class="form-horizontal clearfix">
            <div class="form-group year">
                <div class="label-form">
                    @Html.Label(Labels.Year, new { @class = "control-label" })
                </div>
                <div class="select-form">
                    @Html.YearPicker("Year", 2014, (int)ViewBag.Year)
                </div>
            </div>
            <div class="form-group form-group--m">
                <button type="submit" id="btnSearch" class="btn btn-primary">@Labels.Search</button>
                <a class="btn btn-request" href="@Url.Action("create", "holiday")">
                    <span class="fa fa-plus"></span> @Labels.NewHoliday
                </a>
            </div>
        </div>
    }
    <table id="data" class="table table-custom">
        <thead>
            <tr>
                <th>@Labels.SymbolCount</th>
                <th>@Labels.Name</th>
                <th>@Labels.Type</th>
                <th>@Labels.From</th>
                <th>@Labels.To</th>
                @if (hasPermission)
                {
                    <th>@Labels.Edit</th>
                    <th>@Labels.Delete</th>
                }
            </tr>
        </thead>
        @if (Model.Any())
        {
            <tbody>
                @{int index = 1;}
                @foreach (Holiday item in Model)
                {
                    <tr id="row@(item.Id)">
                        <td>@(index++)</td>
                        <td class="align-left">@item.HolidayName</td>
                        <td>@(((HolidayType)item.TypeId).GetDisplayName())</td>
                        <td>
                            @item.FromDate.ToDateMonthYearFormatedDate()
                        </td>
                        <td>
                            @item.ToDate.ToDateMonthYearFormatedDate()
                        </td>
                        @if (hasPermission)
                        {
                            <td class="cmd">
                                <a href="@Url.Action("edit", "Holiday", new { Id = item.Id })">
                                    <i class="fa fa-pencil fa-lg icon-edit"></i>
                                </a>
                            </td>
                            <td class="cmd">
                                <a href="javascript:;" class="deleteHoliday" data-id="@item.Id">
                                    <i class="fa fa-times fa-lg icon-delete"></i>
                                </a>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        }
        else
        {
            @RazorHelper.DisplayNoInformation(colspan: totalColumn);
        }
    </table>
