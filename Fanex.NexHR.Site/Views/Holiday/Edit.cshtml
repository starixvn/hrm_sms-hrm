@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Core.Helpers
@using Fanex.NexHR.Resources
@model Holiday
@{
    ViewBag.Title = Labels.Holiday;
    var holidayTypes = new List<SelectListItem>
    {
        new SelectListItem { Value = ((byte)HolidayType.Regular).ToString(), Text = HolidayType.Regular.GetDisplayName() },
        new SelectListItem { Value = ((byte)HolidayType.Special).ToString(), Text = HolidayType.Special.GetDisplayName() }
    };
}
@section css{
    <link href="~/wwwroot/dist/styles/holiday.create.css" rel="stylesheet" />
}
@section js{
    <script src="~/wwwroot/dist/js/holiday.edit.js"></script>
}
@section Breadcrumb {
    <a class="step">@Labels.CompanySpace</a>
    <a class="step" href="@Url.Action("workingcalendars", "calendar")">Working calendars</a>
    <a class="step" href="@Url.Action("index", "holiday")">@Labels.Holiday</a>
    <a class="step">@Labels.EditHoliday</a>
}
<h2 class="page-title">@Labels.EditHoliday</h2>
<div class="card">
    @Html.ValidationSummary()
    @using (Html.BeginForm("edit", "holiday", FormMethod.Post))
    {
        <div class="form-horizontal">
            @if (ViewBag.Updated != null && (bool)ViewBag.Updated)
            {
                <div class="success flash">Edited Successful!</div>
            }

            @Html.HiddenFor(model => model.Id)

            <br />
            <div class="form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.HolidayName, new { @class = "control-label" })
                </div>
                <div class="input-form">
                    @Html.TextBoxFor(model => model.HolidayName, new { @class = "form-control", @autocomplete = "off" })
                </div>
                @Html.ValidationMessageFor(model => model.HolidayName)
            </div>
            <div class="form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.TypeId, new { @class = "control-label" })
                </div>
                <div class="input-form">
                    @Html.DropDownListFor(model => model.TypeId, holidayTypes, new { @class = "form-control", @autocomplete = "off" })
                </div>
                @Html.ValidationMessageFor(model => model.TypeId)
            </div>
            <div class="form-group">
                <div class="label-form">Date(s)</div>
                <div class="input-form">
                    @{
                        var numDay = Model.ToDate.Day - Model.FromDate.Day + 1;
                    }
                    <input type="number" class="form-control" style="width:55px" name="numDay" id="numDay" min="1" max="15" step="1" value="@numDay" />
                </div>
                <span class="field-validation-valid" data-valmsg-for="numDay" data-valmsg-replace="true"></span>
            </div>

            <div class="form-group form-group--m">
                <div class="label-form">
                    @Html.LabelFor(model => model.FromDate, new { @class = "control-label" })
                </div>
                <div class="calendar-form">
                    @Html.TextBox(Html.NameFor(model => model.FromDate).ToString(), Model.FromDate.ToString("dd MMM, yyyy"), new { @class = "datepicker form-control", mindate = (new DateTime(2010, 1, 1)).ToString("yyyy/MM/dd"), maxdate = "null", disabledDate = "" })
                    <i class="icon-calendar fa fa-calendar"></i>
                </div>
            </div>
            <div class="form-group form-group--m">
                <div class="label-form">
                    @Html.LabelFor(model => model.ToDate, new { @class = "control-label" })
                </div>
                <div class="calendar-form">
                    @Html.TextBox(Html.NameFor(model => model.ToDate).ToString(), Model.ToDate.ToString("dd MMM, yyyy"), new { @class = "datepicker form-control", mindate = (new DateTime(2010, 1, 1)).ToString("yyyy/MM/dd"), maxdate = "null", disabledDate = "" })
                    <i class="icon-calendar fa fa-calendar"></i>
                </div>
            </div>

            <div class="form-group">
                <div>
                    <button type="submit" class="btn btn-primary" id="btnSubmit">@Labels.Save</button>
                    <a href="@Url.Action("index","holiday")" class="btn btn-default">@Labels.Back</a>
                </div>
            </div>
        </div>
    }
</div>