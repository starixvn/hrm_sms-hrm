@model Holiday
@{
    ViewBag.Title = Labels.Holiday;
}

@section css{
    @Url.CombresLink("holidayeditcss")
}
@section js{
    @Url.CombresLink("holidayeditjs")
}

@section Breadcrumb {
    <a class="step">@Labels.CompanySpace</a>
    <a class="step" href="@Url.Action("workingcalendars", "calendar")">Working calendars</a> 
     <a class="step" href="@Url.Action("index", "holiday")">@Labels.Holiday</a>
    <a class="step">Add new Holiday</a>
}

<h2>@Labels.CreateHoliday</h2>

@using (Html.BeginForm())
{
    <div class="container_24 bunhat" style="min-width: 400px">
    
    @Html.ValidationSummary(true)
    @if (ViewBag.Updated != null && (bool)ViewBag.Updated)
    {
        <div class="success flash">Created Successful!</div> 
    }
    
        @Html.HiddenFor(model => model.Id)

		<br />
        <div class="formrow">
			<div class="label">
					@Html.LabelFor(model => model.HolidayName)
				</div>
			<div class="input">
					@Html.EditorFor(model => model.HolidayName)
					@Html.ValidationMessageFor(model => model.HolidayName)
			</div>
		</div>
        <div class="formrow">
			<div class="label">
					Date(s)
			</div>
			<div class="input">
					@{
                        var numDay = Model.ToDate.Day - Model.FromDate.Day + 1;    
                    }
                    <input type="number" name="numDay" id="numDay" min="1" max="15" step="1" value="@numDay"/>
            </div>
        </div>
        <div class="formrow">
			<div class="label">
					@Html.LabelFor(model => model.FromDate)
			</div>
			<div class="input">
					@Html.DatePickerFor(model => model.FromDate)
					@Html.ValidationMessageFor(model => model.FromDate)
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                    @Html.LabelFor(model => model.ToDate)
            </div>
            <div class="input">
                    
                    @Html.DatePickerFor(model => model.ToDate)
					@Html.ValidationMessageFor(model => model.ToDate)
			</div>
            <div>
            
            </div>
        </div>

        <div class="formrow">
            <div class="label">&nbsp</div>
            <div class="input">
                @Html.AntiForgeryToken()
                <input type="submit" value="Add"/>
                <a href="@Url.Action("index","holiday")" class="button">@Labels.Back</a>
            </div>
        </div>
    </div>
}  

