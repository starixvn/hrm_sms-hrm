@using Fanex.NexHR.Core
@using Fanex.NexHR.Resources
@using System.Web.Mvc.Html5
@model Fanex.NexHR.ViewModels.Time.TimeRecordViewModel
@{
    ViewBag.Title = "Timesheet record";
}
@section css{
    <link href="~/wwwroot/dist/styles/addtimerecord.css" rel="stylesheet" />
}
@section js{
    <script src="~/wwwroot/dist/js/addtimerecord.js"></script>
}
@section Breadcrumb {
    <a class="step">Timesheet</a> <span class="step">@ViewBag.Title</span>
}
<div class="card">
    @using (Html.BeginForm("addtimerecord", "time", FormMethod.Post, new { @class = "form-horizontal" }))
    {
        @Html.ValidationSummary()
        if (ViewBag.Requested != null && (bool)ViewBag.Requested)
        {
            <div class="success">@Messages.RequestCreated</div>
        }

        @Html.HiddenFor(model => model.EmpId)
        <div class="form-group">
            <div class="label-form">@Labels.Employee</div>
            <div class="input-form">
                @Html.TextBoxFor(x => x.Employee, new { @class = "form-control", @autocomplete = "off" })
            </div>
        </div>
        <div class="form-group">
            <div class="label-form">
                @Html.LabelFor(model => model.InOutType, new { @class = "control-label" })
            </div>
            <div class="input-form request-type">
                @Html.RadioButtonList(model => model.InOutType, Utilities.CheckInOutTypes)
            </div>
        </div>
        <div class="form-group">
            <div class="label-form">@Labels.RequestTime</div>
            <div class="calendar-form">
                @Html.TextBox("ForDate", Model.ForDate.ToDateMonthYearFormatedDate(),
                    new {
                        @class = "datepicker form-control",
                        @readonly = "readonly"
                    })
                <i class="icon-calendar fa fa-calendar"></i>
            </div>
            <div class="request-time">
                @Html.Html5Number(0, 23, 1, Model.Hour, new { Name = "Hour", MaxLength = "2", id = "Hour", @class = "form-control" })
                :
                @Html.Html5Number(0, 59, 1, Model.Minute, new { Name = "Minute", MaxLength = "2", id = "Minute", @class = "form-control" })
            </div>
        </div>
        <div class="form-group">
            <input type="submit" class="btn btn-primary" value="Request" />
        </div>
    }
</div>