@model Fanex.NexHR.Criteria.Message.GetMessageByEmployeeCriteria
@using Fanex.NexHR.Resources;

@{
	ViewBag.Title = @Labels.MyMessage;
}
@section css{
    @Url.CombresLink("messagecss")
}
@section js{
    @Url.CombresLink("employeemessagejs")
}
@section Breadcrumb {
	<a class="step">@Labels.Personal</a>
	<a class="step">@ViewBag.Title</a>
}

<h2>@ViewBag.Title</h2>
@using (Html.BeginForm())
{
	<div class="container_24 bunhat" style="width: 878px;">
		@Html.HiddenFor(model => model.IsDisabled)
		<div class="grid_3 formrow message-label">
			@Html.LabelFor(model => model.EffectedDate)
		</div>
		<div class="grid_4">
			@Html.DatePickerFor(model => model.EffectedDate)
		</div>
		<div class="grid_2 formrow message-label">
			<label>@Labels.Status</label>
		</div>
		<div class="grid_3">
			@RazorHelper.MessageStatusDropDownList(controlName: "status")
		</div>
		<div class="grid_7">
			<input type="submit" id="submit" class="processing-submit" value="@Labels.Submit" />
		</div>
	</div>
	<div class="clear">
	</div>
	<table id="messageTable" class="data persist-area" style="width: 900px;">
		<thead>
			<tr>
				<th>#
				</th>
				<th>@Labels.Subject
				</th>
				<th>@Labels.Category
				</th>
				<th>@Labels.Content
				</th>
				<th>@Labels.FromDate
				</th>
				<th>@Labels.ToDate
				</th>
				<th>@Labels.Delete
				</th>
			</tr>
		</thead>
		@if (ViewBag.Messages != null && ViewBag.Messages.Count > 0)
		{
			<tbody>
				@{int index = 1;}
				@foreach (Message message in ViewBag.Messages)
				{
					<tr id="row_@message.MessageId">
						<td>@(index++)
						</td>
						<td class="left">@message.Subject
						</td>
						<td>@message.CategoryName
						</td>
						<td class="left">@message.Contents
						</td>
						<td>@message.FromDate.ToDateMonthYearFormatedDate()
						</td>
						<td>@message.ToDate.ToDateMonthYearFormatedDate()
						</td>
						<td class="cmd" title="Delete">
							<a href="javascript:;" onclick="deleteMessage(@message.MessageId)">
								<img src="~/Styles/Images/delete-icon.png" alt="Delete" />
							</a>
						</td>
					</tr>
				}
			</tbody>
		}
		else
		{
				@RazorHelper.DisplayNoInformation(7)
		}
	</table>
}
