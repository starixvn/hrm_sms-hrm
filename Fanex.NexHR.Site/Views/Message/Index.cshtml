@using Fanex.NexHR.Models.Message
@model GetMessageByCreatorParam
@{
    ViewBag.Title = Labels.Message;
    var hasPermission = (bool)ViewBag.HasPermission;
}
@section css{
    @Url.CombresLink("messagecss")
}
@section js{
    @Url.CombresLink("messagejs")
}
@section Breadcrumb {
    <a class="step">@Labels.HRSpace</a>
    <span class="step">@ViewBag.Title</span>
}

<h2>@ViewBag.Title</h2>
@using (Html.BeginForm())
{
    <div class="container_24 bunhat" style="width: 920px;">
        @Html.HiddenFor(model => model.IsDisabled)
        <div class="grid_2 formrow message-label">
            @Html.LabelFor(model => model.FromDate)
        </div>
        <div class="grid_4">
            @Html.DatePickerFor(model => model.FromDate)
        </div>
        <div class="grid_2 formrow message-label">
            @Html.LabelFor(model => model.ToDate)
        </div>
        <div class="grid_4">
            @Html.DatePickerFor(model => model.ToDate)
        </div>
        <div class="grid_2 formrow message-label">
            <label>@Labels.Status</label>
        </div>
        <div class="grid_3">
            @RazorHelper.MessageStatusDropDownList(controlName: "status")
        </div>
        <div class="grid_6">
            <input type="submit" id="submit" class="processing-submit" value="@Labels.Submit" />
            @if (hasPermission)
            {
                <div class="button-icon">
                    <span class="icon plus"></span>@Html.ActionLink("Create Message", "Create")
                </div>
            }
        </div>
    </div>
    <div class="clear">
    </div>
    <table id="messageTable" class="table table-custom persist-area" style="width: 942px;">
        <thead>
            <tr>
                <th>
                    @Labels.SymbolCount
                </th>
                <th>
                    @Labels.Subject
                </th>
                <th>
                    @Labels.Category
                </th>
                <th>
                    @Labels.SendTo
                </th>
                <th>
                    @Labels.CreatedDate
                </th>
                @if (hasPermission)
                {
                    <th>
                        @Labels.Edit
                    </th>
                    <th>
                        @Labels.Delete
                    </th>
                }
            </tr>
        </thead>
        @if (ViewBag.Messages != null && ViewBag.Messages.Count > 0)
        {
            <tbody>
                @{int index = 1;}
                @foreach (Message message in ViewBag.Messages)
                {
                    <tr id="row_@message.MessageId">
                        <td>
                            @(index++)
                        </td>
                        <td class="left">
                            <a href="/message/detail/@message.MessageId">@message.Subject</a>
                        </td>
                        <td>
                            @message.CategoryName
                        </td>
                        <td class="send-to">
                            @message.SendTo
                        </td>
                        <td>
                            @message.CreatedDate.ToDateMonthYearFormatedDate()
                        </td>
                        @if (hasPermission)
                        {
                            <td class="cmd" title="Edit">
                                <a href="@Url.Action("Edit", "message", new { Id = message.MessageId })">
                                    <i class="fa fa-pencil fa-lg icon-edit"></i>
                                </a>
                            </td>
                            <td class="cmd" title="Delete">
                                <a href="javascript:;" onclick="deleteMessage(@message.MessageId)">
                                    <i class="fa fa-times fa-lg icon-delete"></i>
                                </a>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        }
        else
        {
            @RazorHelper.DisplayNoInformation(7)
        }
    </table>
}