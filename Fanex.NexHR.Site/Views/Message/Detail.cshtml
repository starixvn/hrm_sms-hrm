@using Fanex.NexHR.Models.Message
@model Message
@{
    Layout = "~/Views/Shared/_NewLayout.cshtml";
    var messageSubject = Model != null ? Model.Subject : Labels.NoData;
    ViewBag.Title = messageSubject + " - " + Labels.Message;
}
@section css{
    <link href="~/wwwroot/dist/styles/message.css" rel="stylesheet" />
}
@section js{
}
@section Breadcrumb {
    <a class="step">@Labels.HRSpace</a>
    <a class="step" href="@Url.Action("Index", "message")">@Labels.Message</a>
    <a class="step">Details</a>
}
<h2 class="page-title">@Labels.Details</h2>
@if (!ReferenceEquals(Model, null))
{
    <table class="table table-custom memo" style="width:50%;">
        <thead>
            <tr>
                <th colspan="4">
                    @Model.Subject
                </th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td class="left">
                    @Labels.SendTo
                </td>
                <td class="left">
                    <b>@Model.SendTo</b>
                </td>
            </tr>
            <tr>
                <td>
                    @Labels.Category
                </td>
                <td>
                    <b>@Model.CategoryName</b>
                </td>
            </tr>
            <tr>
                <td class="left" style="width:80px;">
                    @Labels.FromDate
                </td>
                <td class="left">
                    <b>@Model.FromDate.ToDateMonthYearFormatedDate()</b>
                </td>
            </tr>
            <tr>
                <td>
                    @Labels.ToDate
                </td>
                <td>
                    <b>@Model.ToDate.ToDateMonthYearFormatedDate()</b>
                </td>
            </tr>
            <tr>
                <td class="left">
                    @Labels.Content
                </td>
                <td colspan="3">
                    <b>@Model.Contents</b>
                </td>
            </tr>
        </tbody>
    </table>
    <a class="btn btn-primary" onclick="parent.history.back()">@Labels.Back</a>
}
else
{
    <h2>@Messages.ThisContentHasAlreadyBeenDeleted</h2>
}
