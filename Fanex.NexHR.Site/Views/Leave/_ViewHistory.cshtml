@using Fanex.NexHR.Core
@using Fanex.NexHR.Core.Constants
@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Resources
@using Fanex.NexHR.Models.Request
@model IEnumerable<LeaveRequest>

    <table class="table table-custom">
        <thead>
            <tr>
                <th>@Labels.SymbolCount</th>
                <th>@Labels.Team</th>
                <th>@Labels.Employee</th>
                <th>@Labels.LeaveType</th>
                <th>@Labels.From</th>
                <th>@Labels.To</th>
                <th>@Labels.Total</th>
                <th>@Labels.Remark</th>
                <th>@Labels.Verifier</th>
                <th>@Labels.Approver</th>
                <th>@Labels.Status</th>
                <th>@Labels.LogDate</th>
            </tr>
        </thead>
        @if (Model != null && Model.Any())
        {
            int index = 1;
            <tbody>
                @foreach (LeaveRequest request in Model)
                {
                    <tr>
                        <td>@(index++)</td>
                        <td>@request.Requester.Team</td>
                        <td>
                            <span class="tooltip-tipsy" title="@request.Requester.FullName">@request.Requester.Nickname</span>
                        </td>
                        <td>@request.LeaveType.Name</td>
                        <td>@request.FromDate.ToDateMonthYearFormatedDate()</td>
                        <td>@request.ToDate.ToDateMonthYearFormatedDate()</td>
                        <td>
                            @{ var totaldays = string.Empty; }
                            @switch (request.LeaveType.Id)
                            {
                                case (ushort)LeaveTypes.KeepInViewByHour:
                                case (ushort)LeaveTypes.BusinessDuringWorking:
                                    LeaveRequestDetail detail = request.LeaveDetail.FirstOrDefault();
                                    if (detail != null)
                                    {
                                        var minutes = (detail.ToTime - detail.FromTime).TotalMinutes;
                                        totaldays = (minutes / Constants.TotalMinuteInHour).ToString("0.#") + " hour(s)";
                                    }
                                    break;
                                default:
                                    totaldays = request.TotalDays.ToString("0.0");
                                    break;
                            }
                            @totaldays
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(request.Remark))
                            {
                                <span class="fa fa-comment tooltip-tipsy" title="@request.Remark"></span>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                        <td>
                            @if (request.Verifier != null)
                            {
                                @request.Verifier.Nickname
                            }
                        </td>
                        <td>
                            @if (request.Approver != null)
                            {
                                @request.Approver.Nickname
                            }
                        </td>
                        <td>@request.Status.ToString()</td>
                        <td class="align-left">@string.Format(Messages.LogDate, @request.Modifier.Nickname, @request.InsertedDate.ToShortFormatedDate())</td>
                    </tr>
                }
            </tbody>
        }
        else
        {
            @RazorHelper.DisplayNoInformation(colspan: 12);
        }
    </table>
