@using Fanex.NexHR.Core
@using Fanex.NexHR.Resources
@using Fanex.NexHR.Models.Request
@model IList<LeaveRequest>

<table class="table table-custom">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th>@Labels.Team</th>
            <th>@Labels.Employee</th>
            <th>@Labels.LeaveType</th>
            <th>@Labels.From</th>
            <th>@Labels.To</th>
            <th>@Labels.Total</th>
            <th>@Labels.Remark</th>
            <th>@Labels.Verifier</th>
            <th>@Labels.Approver</th>
            <th>@Labels.Status</th>
            <th>@Labels.LogDate</th>
        </tr>
    </thead>
    @if (Model != null && Model.Any())
    {
        int index = 1;
        <tbody>
            @foreach (LeaveRequest request in Model)
            {
                <tr>
                    <td>@(index++)</td>
                    <td>
                        <span class="tooltip-tipsy" title="@request.Employee.Team.Name">@request.Employee.Team.Code</span>
                    </td>
                    <td>
                        <span class="tooltip-tipsy" title="@request.Employee.FullName">@request.Employee.NickName</span>
                    </td>
                    <td>@request.LeaveType.Name</td>
                    <td>@request.FromDate.ToDateMonthYearFormatedDate()</td>
                    <td>@request.ToDate.ToDateMonthYearFormatedDate()</td>
                    <td>@request.TotalDays.ToString("0.0")</td>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(request.Remark))
                        {
                            <span class="fa fa-comment tooltip-tipsy" title="@request.Remark"></span>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                    <td>
                        @if (request.VerifiedBy != null)
                        {
                            @request.VerifiedBy.NickName
                        }
                    </td>
                    <td>
                        @if (request.ApprovedBy != null)
                        {
                            @request.ApprovedBy.NickName
                        }
                    </td>
                    <td>@request.Status.ToString()</td>
                    <td>@request.InsertedDate.ToShortFormatedDate()</td>
                </tr>
            }
        </tbody>
    }
    else
    {
        @RazorHelper.DisplayNoInformation(colspan: 12);
    }
</table>