@using Fanex.NexHR.Resources
@using Fanex.NexHR.Models.Request
@model IList<LeaveModel>
    @{
        ViewBag.Title = Labels.RequestHistory;
        Layout = null;
    }
    @section css{
        @Url.CombresLink("sitecss")
    }
    @section js{
        @Url.CombresLink("sitejs")
    }
    @section Breadcrumb {
        <span class="step">@ViewBag.Title</span>
    }
    <table class="table table-custom">
        <thead>
            <tr>
                <th>@Labels.SymbolCount</th>
                <th>@Labels.Team</th>
                <th>@Labels.Employee</th>
                <th>@Labels.LeaveType</th>
                <th>@Labels.From</th>
                <th>@Labels.To</th>
                <th>@Labels.Total</th>
                <th>@Labels.Remark</th>
                <th>@Labels.VerifiedBy</th>
                <th>@Labels.ApprovedBy</th>
                <th>@Labels.Status</th>
                <th>@Labels.LogDate</th>
            </tr>
        </thead>

        @if (Model != null && Model.Any())
        {
            <tbody>
                @{int index = 1;}
                @foreach (LeaveModel request in Model)
                {
                <tr id="row@(request.RequestId)">
                    <td>@(index++)</td>
                    <td class="tooltip-tipsy" original-title="@request.Employee.Team.Name">@request.Employee.Team.Code</td>
                    <td class="tooltip-tipsy" original-title="@request.Employee.FullName">@request.Employee.NickName</td>
                    <td>@request.LeaveType.Name</td>
                    <td class="ddMMyyyy">
                        @request.FromDate.ToDateMonthYearFormatedDate()
                    </td>
                    <td class="ddMMyyyy">
                        @request.ToDate.ToDateMonthYearFormatedDate()
                    </td>
                    <td>@request.TotalDays.ToString("0.0")</td>

                    @if (!string.IsNullOrWhiteSpace(request.Remark))
                    {
                        <td title="@request.Remark">
                            <span class="glyphicon glyphicon-comment tooltip-tipsy icon remark" original-title="@request.Remark"></span>
                        </td>
                    }
                    else
                    {
                        <td>-</td>
                    }
                    <td>@request.VerifiedBy.NickName</td>
                    <td>@request.ApprovedBy.NickName</td>
                    <td>@request.Status.ToString()</td>
                    <td class="ddMMyyyyhhmm">@request.InsertedDate.ToShortFormatedDate()</td>
                </tr>
                }
            </tbody>
        }
        else
        {
            @RazorHelper.DisplayNoInformation(colspan: 12);
        }
    </table>
