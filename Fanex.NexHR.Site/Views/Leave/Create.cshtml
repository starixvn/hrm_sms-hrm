@using System.Web.Mvc.Html5
@using Fanex.NexHR.Core
@using Fanex.NexHR.Core.Constants
@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels.Request
@model LeaveRequestViewModel
@{
    ViewBag.Title = Labels.Create;
    var hasOnBehalfOthersPermission = (bool)ViewBag.HasOnBehalfOthersPermission;
}
@section css{
    @Url.CombresLink("leavecss")
}
@section js{
    @Url.CombresLink("leavejs")
}
@section Breadcrumb {
    <a class="step">@Labels.Personal</a>
    <a class="step" href="@Url.Action("employeeview", "leave")">@Labels.MyLeaveRequest</a>
    <a class="step">@ViewBag.Title</a>
}
<h2>@Labels.Create</h2>
<div class="bunhat">
    @using (Html.BeginForm())
    {
        @Html.HiddenFor(model => model.EmployeeId)
        @Html.Hidden("RequestType", (byte)RequestType.Leave)
        @Html.Hidden("RequestId", -1)
        @Html.ValidationSummary()

        <div class="lv">
            <div class="leave-info">
                ※ <span class="infobalance">
                    In <span id="lblMonth">@Model.ToDate.ToString("MMMM")</span>, you can use up to
                    <span class="numberbalance" id="lblCurrentLeaveBalance">@Model.EmployeeLeaveBalance.CurrentLeaveBalanceDay.ToString("0.#")</span> day(s) AL for

                    <span id="lblYear">@Model.ToDate.ToString("yyyy")</span>
                </span>
                <br />
                ※ <span class="infobalance">
                    Weekend Leave has been taken:
                    <span class="numberbalance" id="lblWeekendLeave">@Model.EmployeeLeaveBalance.WeekedLeaveDayTaken.ToString("0.#")</span> day(s)
                </span>
                <br />
                <span id="kivbyhourbalance">
                    ※<span class="infobalance">
                        KIV balance:
                        <span class="numberbalance" id="lblKeepInViewBalance">@Model.EmployeeLeaveBalance.KeepInViewBalance.ToString("0.#")</span> day(s) &
                        <span class="numberbalance">@Model.EmployeeLeaveBalance.KeepInViewByHourBalance.ToString("0.#")</span> hour(s)
                    </span>
                </span>
            </div>
        </div>

        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Employee)
            </div>
            <div class="input">
                @if (hasOnBehalfOthersPermission)
                {
                    @Html.EditorFor(model => model.Employee)
                }
                else
                {
                    @Html.Label(Model.Employee)
                    @Html.HiddenFor(model => model.Employee)
                }
            </div>
            <div class="clear">
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.LeaveTypeId, Labels.LeaveType)
            </div>
            <div class="input">
                @RazorHelper.LeaveTypeDropDownList("LeaveTypeId", Model.LeaveTypeList, "ddl-leavetype", null)
                @Html.HiddenFor(model => model.LeaveTypeName)
                <span id="leavetype-info" class="icon-info" title="@Model.LeaveTypeDescription"></span>
            </div>
            <div class="clear">
            </div>
        </div>
        <div id="grbHalfDay" class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.HalfDayOff)
            </div>
            <div class="input">
                @Html.CheckBoxFor(model => model.HalfDayOff)
            </div>
            <div class="clear">
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.FromDate, Labels.FromDate)
            </div>
            <div class="input">
                @Html.DatePickerFor(model => model.FromDate,
            new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(-5),
                     new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(Constants.NumberMonthsInFutureCanLeaveRequest).AddDays(-1),
            unavailDates: new List<DateTime> { DateTime.Now.AddYears(-3) })
                <span class="time hide">
                    @Html.DropDownList("FromTime", Utilities.TimeSteps(30))
                </span>

                <span class="time-businesstrip hide">
                    @Html.Html5Number(0, 23, 1, Model.FromTimeHour, new { Name = "Hour", MaxLength = "2", id = "FromTimeHour" })
                    :
                    @Html.Html5Number(0, 59, 1, Model.FromTimeMinute, new { Name = "Minute", MaxLength = "2", id = "FromTimeMinute" })
                </span>
                <span class="time-isafterday hide">
                    @Html.CheckBoxFor(model => model.IsFromTimeAfterDay)
                    @Html.LabelFor(model => model.IsFromTimeAfterDay, "Is after day")
                </span>
            </div>
            <div class="clear">
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.ToDate, Labels.ToDate)
            </div>
            <div class="input">
                @Html.DatePickerFor(model => model.ToDate)
                <span class="time hide">
                    @Html.DropDownList("ToTime", Utilities.TimeSteps(30))
                </span>
                <span class="time-businesstrip hide">
                    @Html.Html5Number(0, 23, 1, Model.ToTimeHour, new { Name = "Hour", MaxLength = "2", id = "ToTimeHour" })
                    :
                    @Html.Html5Number(0, 59, 1, Model.ToTimeMinute, new { Name = "Minute", MaxLength = "2", id = "ToTimeMinute" })
                </span>
            </div>
            <div class="clear">
            </div>
        </div>
        <div id="grbTotalDay" class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.TotalDays, Labels.TotalDays, new { id = "lblTotalDay" })
            </div>
            <div class="input">
                @Html.EditorFor(model => model.TotalDays)
            </div>
            <div class="clear">
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.VerifierId, Labels.VerifiedBy)
            </div>
            <div class="input">
                @if (Model.Verifiers.Count > 1)
                {
                    @Html.DropDownListFor(model => model.VerifierId, new SelectList(Model.Verifiers, "OwnerId", "DisplayName"), Labels.SelectVerifier)
                }
                else
                {
                    @Html.DropDownListFor(model => model.VerifierId, new SelectList(Model.Verifiers, "OwnerId", "DisplayName"))
                }
            </div>
            <div class="clear">
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.ApproverId, Labels.ApprovedBy)
            </div>
            <div class="input">
                @if (Model.Approvers.Count > 1)
                {
                    @Html.DropDownListFor(model => model.ApproverId, new SelectList(Model.Approvers, "OwnerId", "DisplayName"), Labels.SelectApprover)
                }
                else
                {
                    @Html.DropDownListFor(model => model.ApproverId, new SelectList(Model.Approvers, "OwnerId", "DisplayName"))
                }
            </div>
            <div class="clear">
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Remark)
            </div>
            <div class="input">
                @Html.TextAreaFor(model => model.Remark)
            </div>
            <div class="clear">
            </div>
        </div>

        <div class="formrow">
            <div id="leaveDetails"></div>
        </div>
        <div class="formrow">
            <div class="label">
                &nbsp;
            </div>
            <div class="input">
                <input id="btnSubmit" type="button" value="@Labels.Request" class="button-primary submit" />
                <a href="javascript:;" class="button" id="backPrevious">@Labels.Back</a>
            </div>
            <div class="clear">
            </div>
        </div>
    }
</div>