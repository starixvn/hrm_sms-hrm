@using Fanex.NexHR.Models.Request
@model IList<RequestEntity>
@{
    ViewBag.Title = Labels.MyLeaveRequest;
    var emmployeeBalance = ViewBag.EmployeeBalance == null ? null : (EmployeeAnnualBalance)ViewBag.EmployeeBalance;
    decimal annualBalance = emmployeeBalance == null ? 0 : emmployeeBalance.AnnualBalance;
    decimal keepInViewBalance = emmployeeBalance == null ? 0 : emmployeeBalance.KeepInViewBalance;
}
@section css{
    @Url.CombresLink("myrequestcss")
}
@section js{
    @Url.CombresLink("empleavejs")
}
@{
    ViewBag.Title = Labels.MyLeaveRequest;
}
@section Breadcrumb {
    <a class="step">Personal</a> <a class="step">@ViewBag.Title</a>
}
<h2>@ViewBag.Title</h2>
<div class="balance-area">
    <table class="tblBalance">
        <tr class="odd1">
            <td>@Labels.AnualLeaveBalance:<strong> @annualBalance.ToString("0.#") day(s)</strong></td>
        </tr>
        <tr class="event1">
            <td>Keep In View Balance:<strong> @keepInViewBalance.ToString("0.#") day(s)</strong></td>
        </tr>
    </table>
    @*@Labels.AnualLeaveBalance:<strong> @annualBalance.ToString("0.#") day(s)</strong>
    <br />
    Keep In View Balance:<strong> @keepInViewBalance.ToString("0.#") day(s)</strong>*@
</div>

@using (Html.BeginForm())
{ 
    <input type="hidden" value="Leave" id="RequestType" />
    <span>@Labels.Year:</span>
    @Html.YearPicker("Year", 2010, (int)ViewBag.Year)
    <input type="submit" id="submit" value="@Labels.Submit" class="button-primary submit processing-submit"/>
    <div class="button-icon">
        <span class="icon plus"></span>@Html.ActionLink(Labels.LeaveRequest, "Create")</div>
    
}

    <table class="data" id="data">
        <thead>
            <tr>
                <th>
                    #
                </th>
                <th>@Labels.RefNo1
                </th>
                <th>@Labels.LeaveType
                </th>
                <th>@Labels.From
                </th>
                <th>@Labels.To
                </th>
                <th>@Labels.Total
                </th>
                <th>@Labels.CreatedDate
                </th>
                <th>@Labels.Remark
                </th>
                <th>@Labels.Status
                </th>
                <th>@Labels.History
            </th>
            </tr>
        </thead>
        <tbody>
            @{int index = 1;}
            @if (Model != null && Model.Count > 0)
            {
                var verifiedStatus = VerifiedStatus.Pending;
                var approvedStatus = ApprovedStatus.Pending;
                var processedStatus = HrStatus.Pending;

                foreach (RequestEntity request in Model)
                {
                    verifiedStatus = (VerifiedStatus)request.VerifiedStatus;
                    approvedStatus = (ApprovedStatus)request.ApprovedStatus;
                    processedStatus = (HrStatus)request.ProcessedStatus;
                <tr id="row@(request.Id)">
                    <td>@(index++)
                    </td>
                    <td>@request.RefNO
                    </td>
                    <td>
                        <a class="viewdetail" 
                        data-id="@request.Id" 
                        data-verifier="@request.VerifiedBy.NickName"
                        data-verifier-status="@verifiedStatus"
                        data-verified-date="@(request.VerifiedStatus == (int)VerifiedStatus.Pending ? string.Empty : request.VerifiedDate.ToShortFormatedDate())"
                        data-approver="@request.ApprovedBy.NickName"
                        data-approver-status="@approvedStatus"
                        data-approved-date="@(request.ApprovedStatus == (int)ApprovedStatus.Pending ? string.Empty : request.ApprovedDate.ToShortFormatedDate())"
                        data-hr="@request.ProcessedBy.NickName"
                        data-hr-status="@processedStatus"
                        data-processed-date="@(request.ProcessedStatus == (int)HrStatus.Pending ? string.Empty : request.ProcessedDate.ToShortFormatedDate())"
                        href="~/Leave/Detail?requestId=@request.Id">@request.LeaveType.Name</a>
                    </td>
                    <td class="ddMMyyyy highlight">@request.FromDate.ToDateMonthYearFormatedDate()
                    </td>
                    <td class="ddMMyyyy highlight">@request.ToDate.ToDateMonthYearFormatedDate()
                    </td>
                    @*@if (request.TotalDays < 1 && request.LeaveType.Id != Constants.GeneralLeave)
                    { 
                        <td class="ddMMyyyy highlight">@request.FromDate.ToShortFormatedDate()
                        </td>
                        <td class="ddMMyyyy highlight">@request.ToDate.ToShortFormatedDate()
                        </td>
                    }
                    else
                    {
                        <td class="ddMMyyyy highlight">@request.FromDate.ToDateMonthYearFormatedDate()
                        </td>
                        <td class="ddMMyyyy highlight">@request.ToDate.ToDateMonthYearFormatedDate()
                        </td>
                    }*@
                    <td class="highlight">@request.TotalDays.ToString("0.0")
                    </td>
                    <td class="ddMMyyyy tooltip" title="@request.CreatedDate.ToShortFormatedDate()" >
                        @request.CreatedDate.ToShortFormatedDate()
                    </td>
                    @if (!string.IsNullOrWhiteSpace(request.Remark))
                    { 
                        <td class="tooltip" title="@request.Remark">
                            <span class="icon remark" alt="remark" />
                        </td>
                    }
                    else
                    {
                        <td>-</td>
                    }
                    @Html.Partial("_SharedRequestStatus", request)
                    <td>
                        <a class="viewhistory" href="javascript:;" id="/request/hrviewhistory?id=@request.Id&type=@request.Type.RequestHistoryFilter">
                            @Labels.View </a>
                    </td>
                </tr>
                }
            }
            else
            { 
                @RazorHelper.DisplayNoInformation(colspan: 10);
            }
        </tbody>
    </table>

<div id="dialog-reason" title="@Labels.ReasonReedit">
    <div>
        <span>@Messages.ReasonReedit</span>
    </div>
    <br />
    <div>
        <textarea id="txtReason" rows="2" cols="20"></textarea>
    </div>
</div>
@RazorHelper.EmployeeProcessMenu()
@RazorHelper.EmployeeReeditMenu()
<div id="dialoghistorycontent" />
