<div id="confirmedDialog">
    <div class="formrow">
        <div class="label">
            @Labels.Remark
        </div>
        <div class="input">
            @Html.TextArea("reasonToProcess")
        </div>
    </div>
    <div class="formrow ignored" style="display: none">
        <div class="label">
            @Labels.Ignored
        </div>
        <div class="input">
            @Html.CheckBox("ignoredDiscipline")
        </div>
    </div>
</div>