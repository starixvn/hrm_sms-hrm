@model IList<RequestEntity>

<table class="table table-custom">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th>@Labels.Team</th>
            <th>@Labels.Employee</th>
            <th>@Labels.Request</th>
            <th>@Labels.Time</th>
            <th>@Labels.Date</th>
            <th>@Labels.Shift</th>
            <th>@Labels.CreatedDate</th>
            <th>@Labels.Remark</th>
            <th>@Labels.Status</th>
            <th>@Labels.PerformedBy</th>
        </tr>
    </thead>

    @if (ViewBag.EntityList.Count > 0)
    {
        <tbody>
            @{int index = 1;}
            @foreach (RequestEntity request in Model)
            {
                <tr id="row@(request.Id)">
                    <td>@(index++)</td>
                    <td class="tooltip" title="@request.Requester.Team.Name">@request.Requester.Team.Code</td>
                    <td class="tooltip" title="@request.Requester.FullName">
                        @request.Requester.NickName
                    </td>
                    <td>@request.RequestType.ToString()</td>
                    <td>@RazorHelper.LateInEarlyOutTimeFormat(request.TotalMins, (short)request.RequestType.Id)</td>
                    <td class="ddMMyyyy">@request.FromDate.ToDateMonthYearFormatedDate()</td>
                    <td>@request.FromShift.Name</td>
                    <td class="ddMMyyyyhhmm">@request.CreatedDate.ToShortFormatedDate()</td>

                    @if (!string.IsNullOrWhiteSpace(request.Remark))
                    {
                        <td class="tooltip" title="@request.Remark">
                            <span class="icon remark" alt="remark"></span>
                        </td>
                    }
                    else
                    {
                        <td>-</td>
                    }

                    <td>@request.Status.ToString()</td>
                    @Html.Partial("History/SharedPeformedBy", request)
                </tr>
            }
        </tbody>
    }
    else
    {
        @RazorHelper.DisplayNoInformation(colspan: 11);
    }
</table>