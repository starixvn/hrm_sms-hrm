@model RequestEntity

@{
    switch (Model.Status.Id)
    {
        case (byte)CurrentRequestStatus.Pending:
            <td>
                @Model.Requester.NickName
            </td>
            break;
        case (byte)CurrentRequestStatus.Verified:
        case (byte)CurrentRequestStatus.NotVerified:
        <td>
            @Model.VerifiedBy.NickName (@Model.VerifiedDate.ToShortFormatedDate())
        </td>
            break;
        case (byte)CurrentRequestStatus.Approved:
        case (byte)CurrentRequestStatus.Rejected:
        <td>
            @Model.ApprovedBy.NickName (@Model.ApprovedDate.ToShortFormatedDate())
        </td>
            break;

        case (byte)CurrentRequestStatus.Processed:
        case (byte)CurrentRequestStatus.Void:
        <td>
            @Model.ProcessedBy.NickName (@Model.ProcessedDate.ToShortFormatedDate())
        </td>
            break;
        default:
        <td></td>
            break;
    }
}