@model Fanex.NexHR.ViewModels.RequestViewModel
@using Fanex.NexHR.Models.Request;
@{
    ViewBag.Title = Labels.MemberRequest;
}
@section css{
    @Url.CombresLink("memberrequestpersonalspacecss")
}
@section js{
    @Url.CombresLink("memberrequestpersonalspacejs")
}
@section Breadcrumb {
    <a class="step">Leader View</a> <span class="step">@ViewBag.Title</span>
}
<h2>@ViewBag.Title</h2>
<div>
    @Html.Partial("CriteriaPanel", Model)
</div>
@*select view here*@
@switch (Model.RequestType)
{
    case (int)RequestFilter.All: // All Request
        IList<RequestEntity> entityAll = ViewBag.EntityList;
        Html.RenderPartial("Request/Member/AllRequest", entityAll);
        break;
    case (int)RequestFilter.Leave: // Annual Leave
        IList<RequestEntity> entityLeave = ViewBag.EntityList;
        Html.RenderPartial("Request/Member/MemberLeaveRequest", entityLeave);
        break;
    case (int)RequestFilter.ChangeShift: // Change Shift
        IList<RequestEntity> entityChangeShift = ViewBag.EntityList;
        Html.RenderPartial("Request/Member/MemberChangeShiftRequest", entityChangeShift);
        break;
    case (int)RequestFilter.LateInEarlyOut: // Late in - Early Out
        IList<RequestEntity> entityLateInEarlyOut = ViewBag.EntityList;
        Html.RenderPartial("Request/Member/MemberLateInEarlyOutRequest", entityLateInEarlyOut);
        break;
    case (int)RequestFilter.CheckInOut: // Check-In/Out
        IList<RequestEntity> entityCheckInOut = ViewBag.EntityList;
        Html.RenderPartial("Request/Member/MemberCheckInOutRequest", entityCheckInOut);
        break;
    case (int)RequestFilter.KeepInView: // Keep In View Request
        IList<RequestEntity> entityKeepInView = ViewBag.EntityList;
        Html.RenderPartial("Request/Member/MemberKeepInViewRequest", entityKeepInView);
        break;
}
<div id="dialoghistorycontent" />
@Html.Partial("ConfirmedProcessRequest")
