@using Fanex.NexHR.Models.Request
@section css{
    @Url.CombresLink("employeerequestdetailhrspacecss")
}
@section js{
    @Url.CombresLink("employeerequestdetailhrspacejs")
}
@section Breadcrumb {
    <a class="step">HR</a> <span class="step">@ViewBag.Title</span>
}
@switch (Convert.ToInt32(HttpContext.Current.Request["type"]))
{
    case (int)RequestFilter.Leave: // Annual Leave
        IList<RequestEntity> entityLeave = ViewBag.EntityList;
        Html.RenderPartial("Request/HR/HRViewLeaveDetail", entityLeave);
        ViewBag.Title = Labels.ViewLeaveDetail;
        break;
    case (int)RequestFilter.ChangeShift: // Change Shift
        IList<RequestEntity> entityChangeShift = ViewBag.EntityList;
        Html.RenderPartial("Request/HR/HRViewChangeShiftDetail", entityChangeShift);
        ViewBag.Title = Labels.ViewChangeShiftDetail;
        break;
}
