@model IList<RequestEntity>

<table class="table table-custom">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th>@Labels.Team</th>
            <th>@Labels.Employee</th>
            <th>@Labels.LeaveType</th>
            <th>@Labels.From</th>
            <th>@Labels.To</th>
            <th>@Labels.Total</th>
            <th>@Labels.CreatedDate</th>
            <th>@Labels.Remark</th>
            <th>@Labels.Status</th>
            <th>@Labels.PerformedBy</th>
        </tr>
    </thead>

    @if (ViewBag.EntityList != null && ViewBag.EntityList.Count > 0)
    {
        <tbody>
            @{int index = 1;}
            @foreach (RequestEntity request in Model)
            {
                <tr id="row@(request.Id)">
                    <td>@(index++)</td>
                    <td class="tooltip-tipsy" original-title="@request.Requester.Team.Name">@request.Requester.Team.Code</td>
                    <td class="tooltip-tipsy" original-title="@request.Requester.FullName">@request.Requester.NickName</td>
                    <td>@request.LeaveType.Name</td>
                    <td class="ddMMyyyy">
                        @request.FromDate.ToDateMonthYearFormatedDate()
                    </td>
                    <td class="ddMMyyyy">
                        @request.ToDate.ToDateMonthYearFormatedDate()
                    </td>
                    <td>@request.TotalDays.ToString("0.0")</td>
                    <td class="ddMMyyyyhhmm">@request.CreatedDate.ToShortFormatedDate()</td>

                    @if (!string.IsNullOrWhiteSpace(request.Remark))
                    {                        
                        <td>
                            <span class="icon remark glyphicon glyphicon-comment tooltip-tipsy" original-title="@request.Remark"></span>
                        </td>
                    }
                    else
                    {
                        <td>-</td>
                    }

                    <td>@request.Status.ToString()</td>

                    @Html.Partial("HistoryNewVersion/SharedPeformedBy", request)
                </tr>
            }
        </tbody>
    }
    else
    {
        @RazorHelper.DisplayNoInformation(colspan: 12);
    }
</table>