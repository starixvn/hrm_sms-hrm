@model ProcessRequestViewModel
<form>
    @Html.HiddenFor(model => model.RequestId)
    @Html.HiddenFor(model => model.EmployeeId)
    @Html.HiddenFor(model => model.RoleId)
    @Html.HiddenFor(model => model.Command)
    <div class="formrow">
        <div class="validation-summary-valid validation-summary-errors" style="display: none;"></div>
        @switch (Model.RequestTypeId)
        {
            case (int)RequestType.CheckIn:
            case (int)RequestType.CheckOut:
                if (Model.CheckInOutDetail != null)
                {
                    Html.RenderPartial("ProcessRequest/_CheckInOutRequestDetail", Model.CheckInOutDetail);
                }
                break;
            case (int)RequestType.LateIn:
            case (int)RequestType.EarlyOut:
                if (Model.LateInEarlyOutDetail != null)
                {
                    Html.RenderPartial("ProcessRequest/_LateInEarlyOutRequestDetail", Model.LateInEarlyOutDetail);
                }
                break;
            case (int)RequestType.ChangeShift:
                if (Model.ChangeShiftDetails != null && Model.ChangeShiftDetails.Any())
                {
                    Html.RenderPartial("ProcessRequest/_ChangeShiftRequestDetail", Model.ChangeShiftDetails);
                }
                break;
            case (int)RequestType.Leave:
                if (Model.LeaveDetails != null && Model.LeaveDetails.Any())
                {
                    Html.RenderPartial("ProcessRequest/_LeaveRequestDetail", Model.LeaveDetails);
                }
                break;
        }
    </div>
    <div class="formrow">
        <div class="label">
            @Html.LabelFor(model => model.Comment)
        </div>
        <div class="input">
            @Html.TextAreaFor(model => model.Comment)
        </div>
    </div>
</form>