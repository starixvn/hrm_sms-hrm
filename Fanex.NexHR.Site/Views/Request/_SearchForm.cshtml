@using Fanex.NexHR.Resources
@using Fanex.NexHR.Core.Enums
@model RequestViewModel

@using (Html.BeginGetForm())
{
    @Html.Hidden("DateTime-Now", DateTime.Now.ToString("MMMM dd, yyyy"))
    @Html.HiddenFor(model => model.ActionName)
    @Html.HiddenFor(model => model.TeamIds)
    <div class="form-horizontal clearfix">
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.Label(@Labels.DateRange, new { @class = "control-label" })
            </div>
            <div class="select-form">
                <select id="Date" name="Date" class="form-control">
                    <option value="0" selected="@(Model.DateOption == 0)">
                        @Labels.DateRange
                    </option>
                    <option value="1" selected="@(Model.DateOption == 1)">
                        @Labels.ToDay
                    </option>
                    <option value="2" selected="@(Model.DateOption == 2)">
                        @Labels.Yesterday
                    </option>
                    <option value="3" selected="@(Model.DateOption == 3)">
                        @Labels.CurrentWeek
                    </option>
                    <option value="4" selected="@(Model.DateOption == 4)">
                        @Labels.LastWeek
                    </option>
                    <option value="5" selected="@(Model.DateOption == 5)">
                        @Labels.CurrentMonth
                    </option>
                    <option value="6" selected="@(Model.DateOption == 6)">
                        @Labels.LastMonth
                    </option>
                    <option value="7" selected="@(Model.DateOption == 7)">
                        @Labels.SinceLastMonth
                    </option>
                </select>
                @Html.Hidden("DateOption", Model.DateOption)
            </div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.LabelFor(model => model.FromDate, new { @class = "control-label" })
            </div>
            <div class="calendar-form">
                @Html.TextBox(Html.NameFor(model => model.FromDate).ToString(), Model.FromDate.ToDateMonthYearFormatedDate(),
                    new { @class = "datepicker form-control", mindate = (new DateTime(2010, 1, 1)).ToString("yyyy/MM/dd") })
                <i class="icon-calendar fa fa-calendar"></i>
            </div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.LabelFor(model => model.ToDate, new { @class = "control-label" })
            </div>
            <div class="calendar-form">
                @Html.TextBox(Html.NameFor(model => model.ToDate).ToString(), Model.ToDate.ToDateMonthYearFormatedDate(),
                    new { @class = "datepicker form-control", mindate = (new DateTime(2010, 1, 1)).ToString("yyyy/MM/dd") })
                <i class="icon-calendar fa fa-calendar"></i>
            </div>
        </div>

        <div class="form-group form-group--m">
            <div class="label-form">
                <label class="control-label">@Labels.On</label>
            </div>
            <div class="select-form">
                @{
                    var filteringDateType = new List<SelectListItem>
                    {
                        new SelectListItem() {Text = "Effected Date", Value = "true"},
                        new SelectListItem() {Text = "Created Date", Value = "false"},
                    };
                }
                @Html.DropDownListFor(model => model.IsFilterByAffectedDate, filteringDateType, new { @class = "form-control" })
            </div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.LabelFor(model => model.StatusId, new { @class = "control-label" })
            </div>
            <div class="select-form">
                @RazorHelper.StatusDropDownList(Model.StatusId, isShowPendingAndVerified: (Model.ViewType == RequestViewType.PersonalSpace), controlName: "statusId", htmlClass: "form-control")
            </div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                <label class="control-label">@Labels.SectionTeam</label>
            </div>
            <div class="select-form" id="Team"></div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.LabelFor(model => model.Employee, new { @class = "control-label" })
            </div>
            <div class="input-form">
                @Html.TextBox("Employee", Model.Employee, new { @class = "form-control", placeholder = Messages.SearchEmployeeWatermark })
                @Html.HiddenFor(model => model.EmployeeId)
            </div>
        </div>
    </div>
    <div class="form-horizontal clearfix">
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.Label(@Labels.Category, new { @class = "control-label" })
            </div>
            <div class="select-form">
                @{
                    var category = new List<SelectListItem>
                    {
                        new SelectListItem() {Text = Labels.All, Value = string.Empty},
                        new SelectListItem() {Text = Labels.Expat, Value = "0"},
                        new SelectListItem() {Text = Labels.Local, Value = "1"},
                    };
                }

                @Html.DropDownListFor(model => model.IsLocal, category, new { @class = "form-control" })
            </div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.Label(@Labels.LeaveType, new { @class = "control-label" })
            </div>
            <div class="select-form">
                @{
                    var listTypes = new List<SelectListItem> { new SelectListItem { Value = "", Text = "All" } };
                    listTypes.AddRange(Model.LeaveTypes.Select(l => new SelectListItem { Value = l.Id.ToString(), Text = l.Name }).ToList());
                }
                @Html.DropDownListFor(model => model.LeaveType, listTypes, new { @class = "form-control" })
            </div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.LabelFor(model => model.RequestType, "Request", new { @class = "control-label" })
            </div>
            <div class="select-form">
                @{
                    var requestTypes = new List<SelectListItem>
                    {
                        new SelectListItem() {Text = Labels.All, Value = ((int)RequestFilter.All).ToString()},
                        new SelectListItem() {Text = Labels.Leave, Value = ((int)RequestFilter.Leave).ToString()},
                        new SelectListItem() {Text = Labels.ChangeShift, Value = ((int)RequestFilter.ChangeShift).ToString()},
                        new SelectListItem() {Text = Labels.LateInEarlyOut, Value = ((int)RequestFilter.LateInEarlyOut).ToString()},
                        new SelectListItem() {Text = Labels.CheckInOut, Value = ((int)RequestFilter.CheckInOut).ToString()},
                        new SelectListItem() {Text = Labels.CompensationLeave, Value = ((int)RequestFilter.KeepInView).ToString()}
                    };
                    @Html.DropDownListFor(model => model.RequestType, requestTypes, new { @class = "form-control" })
                }
            </div>
        </div>
    </div>
    <div class="form-horizontal clearfix">
        <div class="button-group">
            <input class="btn btn-primary" type="submit" id="submit" value="@Labels.Search" />
            <input type="button" value="@Labels.Excel" id="btnExcel" class="btn btn-excel" />
        </div>
    </div>
}