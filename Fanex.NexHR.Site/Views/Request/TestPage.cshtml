@{
    Layout = null;
}
@using Fanex.NexHR.Services
@model RequestViewModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>SMS HRM</title>
    @*<base target="_parent" />*@
    <!-- Bootstrap -->
    <link href="/Styles/css/lib/bootstrap/css/bootstrap.css" rel="stylesheet" />
    <link href="/Styles/Libs/jquery-ui-1.2.1/jquery-ui.css" rel="stylesheet" />
    @Url.CombresLink("employeerequestcss_new")
    <link href="https://fonts.googleapis.com/css?family=Abel" rel="stylesheet">
    <link href="/Styles/css/lib/tipsy/tipsy.css" rel="stylesheet" />
    <link href="/Styles/css/style.css" rel="stylesheet" />
</head>
<body>
    <div id="content-wrapper" class="content_wrap">
        <section id="section_body">
            <div class="content_scroll">
                <h2 class="page-title">Member's request</h2>
                <div class="filter">
                    @Html.Partial("_CriteriaPanelNewLayout", Model)
                </div>

                <div class="table-data">
                    <table class="table table-custom persist-area">
                        <thead>
                            <tr class="persist-header">
                                <th>@Labels.SymbolCount</th>
                                <th>@Labels.Employee</th>
                                <th>@Labels.Team</th>
                                <th>@Labels.Request</th>
                                <th>@Labels.Details</th>
                                <th>@Labels.Remark</th>
                                <th>@Labels.CreatedDate</th>
                                <th>@Labels.Status</th>
                                <th>@Labels.History</th>
                                <th></th>
                            </tr>
                        </thead>
                        @if (Model.Requests != null && Model.Requests.Any())
                        {
                            int index = 1;
                            <tbody>
                                @foreach (RequestEntity request in Model.Requests)
                                {
                                    var requestModel = new RequestViewModel
                                    {
                                        DateOption = Model.DateOption,
                                        FromDate = Model.FromDate,
                                        ToDate = Model.ToDate,
                                        EmployeeId = request.Requester.Id,
                                        Employee = request.Requester.NickName + " (" + request.Requester.FullName + ")",
                                        TeamIds = Model.TeamIds,
                                        StatusId = Model.StatusId,
                                        RequestType = request.RequestType.FilterRequest,
                                        ViewType = Model.ViewType
                                    };
                                    <tr id="row@(request.Id)">
                                        <td>@(index++)</td>
                                        <td>                                          
                                            <span class="tooltip-tipsy" original-title="@request.Requester.FullName">@request.Requester.NickName</span>
                                        </td>
                                        <td>
                                            <span class="tooltip-tipsy" original-title="@request.Requester.Team.Name">@request.Requester.Team.Code</span>
                                        </td>
                                        <td>
                                            @switch (request.RequestType.Id)
                                            {
                                                case (int)RequestType.Leave:
                                                    <a href="#" onclick="window.parent.location.href='@Url.Action("Detail", "Leave", new { requestId = request.Id })';">@request.LeaveType.Name</a>
                                                    break;
                                                case (int)RequestType.ChangeShift:
                                                    <a href="#" onclick="window.parent.location.href='@Url.Action("Detail", "ChangeShift", new { id = request.Id })';">@request.RequestType.Name</a>
                                                    break;
                                                default:
                                                    <a href="#" onclick='window.parent.location.href="@Url.Action(Model.ActionName, "request", requestModel)";'>@request.RequestType.Name</a>
                                                    break;
                                            }
                                        </td>
                                        <td class="align-left">
                                            @Html.Raw(RequestService.ToRequestMessage(request))
                                        </td>
                                        @if (!string.IsNullOrWhiteSpace(request.Remark))
                                        {
                                            <td>
                                                <span class="icon remark glyphicon glyphicon-comment tooltip-tipsy" original-title="@request.Remark"></span>
                                            </td>
                                        }
                                        else
                                        {
                                            <td>-</td>
                                        }
                                        <td class="ddMMyyyyhhmm">
                                            @request.CreatedDate.ToShortFormatedDate()
                                        </td>
                                        @RenderStatus(Model, request)
                                        <td>
                                            <a class="viewhistory" href="javascript:;" id="/request/viewhistorynewversion?id=@request.Id&type=@request.RequestType.FilterRequestHistory">
                                                @Labels.View
                                            </a>
                                        </td>
                                        <td class="td-warning">
                                            @if (request.IsWarning)
                                            {
                                                <span class="icon-warning tooltip-tipsy" original-title="@Labels.RequestWarning"></span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        }
                        else
                        {
                            @RazorHelper.DisplayNoInformation(colspan: 10);
                        }
    
                    </table>
                </div>
            </div>

            @RenderContextMenu(Model)
            <div id="dialoghistorycontent"></div>
            <div id="dialogProcessRequest"></div>
            <div id="message">
            </div>

            @helper RenderContextMenu(RequestViewModel model)
            {
                switch (model.ViewType)
                {
                    case RequestViewType.PersonalSpace:
                            @RazorHelper.VerifierAndApproverMenu()
                            @RazorHelper.ResetMenu()
                        break;
                    case RequestViewType.SASpace:
                            @RazorHelper.VoidMenu();
                        break;
                    case RequestViewType.HRSpace:
                            @RazorHelper.HrMenu()
                            @RazorHelper.ResetMenu()
                        break;
                }
            }
            @helper RenderStatus(RequestViewModel model, RequestEntity request)
            {
                switch (model.ViewType)
                {
                    case RequestViewType.PersonalSpace:
                            @RenderStatusPersonalSpace(model, request);
                        break;
                    case RequestViewType.SASpace:
                            @RenderStatusSASpace(model, request);
                        break;
                    default:
                            @RenderStatusHRSpace(model, request);
                        break;
                }
            }

            @helper RenderStatusHRSpace(RequestViewModel model, RequestEntity request)
            {
                switch (request.Status.Id)
                {
                    case (byte)CurrentRequestStatus.Pending:
                            <td class="status">
                                <span class="tooltip-tipsy" original-title="@request.Requester.NickName had @request.TotalDaysRequestInMonth.ToString("0.#") approved request(s) in @request.FromDate.ToMonthAndYearFormatedDate()">
                                    @request.Status.ToString()
                                </span>
                            </td>
                        break;
                    case (byte)CurrentRequestStatus.Verified:
                    case (byte)CurrentRequestStatus.NotVerified:
                            <td class="status">
                                <span class="tooltip-tipsy" original-title="@request.Status.Name by @request.VerifiedBy.NickName (@request.VerifiedDate.ToShortFormatedDate())">
                                    @request.Status.ToString()
                                </span>
                            </td>
                        break;
                    case (byte)CurrentRequestStatus.Approved:
                    case (byte)CurrentRequestStatus.Rejected:
                        if (Model.IsAllowChangeStatus && request.Status.Id == (byte)CurrentRequestStatus.Approved)
                        {
                                <td class="status">
                                    <a roleid="@Convert.ToInt32(RoleSystem.HR)" requestid="@request.Id" requesttypeid="@request.RequestType.Id" employeeid="@request.Requester.Id"
                                       href="javascript:void(0);" class="hr-actions tooltip-tipsy"
                                       original-title="@request.Status.Name by @request.ApprovedBy.NickName (@request.ApprovedDate.ToShortFormatedDate())">
                                        @request.Status.ToString()
                                    </a>
                                </td>
                        }
                        else
                        {
                                <td class="status">
                                    <span class="tooltip-tipsy" original-title="@request.Status.Name by @request.ApprovedBy.NickName (@request.ApprovedDate.ToShortFormatedDate())">
                                        @request.Status.ToString()
                                    </span>
                                </td>
                        }
                        break;
                    case (byte)CurrentRequestStatus.Processed:
                        if (Model.IsAllowChangeStatus)
                        {
                                <td class="status">
                                    <a roleid="@Convert.ToInt32(RoleSystem.HR)" requestid="@request.Id" requesttypeid="@request.RequestType.Id" employeeid="@request.Requester.Id"
                                       href="javascript:void(0);" class="hr-actions-reset tooltip-tipsy"
                                       original-title="@request.Status.Name by @request.ProcessedBy.NickName (@request.ProcessedDate.ToShortFormatedDate())">
                                        @request.Status.ToString()
                                    </a>
                                </td>
                        }
                        else
                        {
                                <td class="status">
                                    <span class="tooltip-tipsy" original-title="@request.Status.Name by @request.ProcessedBy.NickName (@request.ProcessedDate.ToShortFormatedDate())">
                                        @request.Status.ToString()
                                    </span>
                                </td>
                        }
                        break;
                    default:
                            <td class="status">
                                <span class="tooltip-tipsy">@request.Status.ToString()</span>
                            </td>
                        break;
                }
                }

            @helper RenderStatusPersonalSpace(RequestViewModel model, RequestEntity request)
            {
                switch (request.Status.Id)
                {
                    case (byte)CurrentRequestStatus.Pending:
                        if (request.ApprovedBy.Id == Model.CurrentUserId)
                        {
                                <td class="status">
                                    <a roleid="@Convert.ToInt32(RoleSystem.Approver)" requestid="@request.Id" requesttypeid="@request.RequestType.Id" employeeid="@request.Requester.Id"
                                       href="javascript:void(0);" class="approver-actions tooltip-tipsy"
                                       original-title="@request.Requester.NickName had @request.TotalDaysRequestInMonth.ToString("0.#") approved request(s) in @request.FromDate.ToMonthAndYearFormatedDate()">
                                        @request.Status.ToString()
                                        <span class="caret"></span>
                                    </a>
                                </td>
                        }
                        else if (request.VerifiedBy.Id == Model.CurrentUserId)
                        {
                                <td class="status">
                                    <a roleid="@Convert.ToInt32(RoleSystem.Verifier)" requestid="@request.Id" requesttypeid="@request.RequestType.Id" employeeid="@request.Requester.Id"
                                       href="javascript:void(0);" class="verifier-actions tooltip-tipsy"
                                       original-title="@request.Requester.NickName had @request.TotalDaysRequestInMonth.ToString("0.#") approved request(s) in @request.FromDate.ToMonthAndYearFormatedDate()">
                                        @request.Status.ToString()
                                    </a>
                                </td>
                        }
                        else
                        {
                                <td class="status">
                                    <span>@request.Status.ToString()</span>
                                </td>
                        }
                        break;
                    case (byte)CurrentRequestStatus.Verified:
                        if (request.ApprovedBy.Id == Model.CurrentUserId)
                        {
                                <td class="status">
                                    <a roleid="@Convert.ToInt32(RoleSystem.Approver)" requestid="@request.Id" requesttypeid="@request.RequestType.Id" employeeid="@request.Requester.Id"
                                       href="javascript:void(0);" class="approver-actions tooltip-tipsy"
                                       original-title="@request.Status.Name by @request.VerifiedBy.NickName (@request.VerifiedDate.ToShortFormatedDate())">
                                        @request.Status.ToString()
                                    </a>
                                </td>
                        }
                        else if (request.VerifiedBy.Id == Model.CurrentUserId)
                        {
                                <td class="status">
                                    <a roleid="@Convert.ToInt32(RoleSystem.Verifier)" requestid="@request.Id" requesttypeid="@request.RequestType.Id" employeeid="@request.Requester.Id"
                                       href="javascript:void(0);" class="verifier-actions-reset tooltip-tipsy"
                                       original-title="@request.Status.Name by @request.VerifiedBy.NickName (@request.VerifiedDate.ToShortFormatedDate())">
                                        @request.Status.ToString()
                                    </a>
                                </td>
                        }
                        else
                        {
                                <td class="status">
                                    <span>@request.Status.ToString()</span>
                                </td>
                        }
                        break;
                    case (byte)CurrentRequestStatus.NotVerified:
                        if (request.VerifiedBy.Id == Model.CurrentUserId)
                        {
                                <td class="status">
                                    <a roleid="@Convert.ToInt32(RoleSystem.Verifier)" requestid="@request.Id" requesttypeid="@request.RequestType.Id" employeeid="@request.Requester.Id"
                                       href="javascript:void(0);" class="verifier-actions-reset tooltip-tipsy"
                                       original-title="@request.Status.Name by @request.VerifiedBy.NickName (@request.VerifiedDate.ToShortFormatedDate())">
                                        @request.Status.ToString()
                                    </a>
                                </td>
                        }
                        else
                        {
                                <td class="status">
                                    <span>@request.Status.ToString()</span>
                                </td>
                        }
                        break;
                    case (byte)CurrentRequestStatus.Approved:
                    case (byte)CurrentRequestStatus.Rejected:
                        if (request.ApprovedBy.Id == Model.CurrentUserId)
                        {
                                <td class="status">
                                    <a roleid="@Convert.ToInt32(RoleSystem.Approver)" requestid="@request.Id" requesttypeid="@request.RequestType.Id" employeeid="@request.Requester.Id"
                                       href="javascript:void(0);" class="approver-actions-reset tooltip-tipsy"
                                       original-title="@request.Status.Name by @request.ApprovedBy.NickName (@request.ApprovedDate.ToShortFormatedDate())">
                                        @request.Status.ToString()
                                    </a>
                                </td>
                        }
                        else
                        {
                                <td class="status">
                                    <span>@request.Status.ToString()</span>
                                </td>
                        }
                        break;
                    case (byte)CurrentRequestStatus.Processed:
                    case (byte)CurrentRequestStatus.Void:
                            <td class="status">
                                <span>@request.Status.ToString()</span>
                            </td>
                        break;
                    default:
                            <td class="status">
                                <span>@request.Status.ToString()</span>
                            </td>
                        break;
                }
                }

            @helper RenderStatusSASpace(RequestViewModel model, RequestEntity request)
            {
                switch (request.Status.Id)
                {
                    case (byte)CurrentRequestStatus.Pending:
                            <td class="status">
                                <a roleid="@Convert.ToInt32(RoleSystem.HR)" requestid="@request.Id" requesttypeid="@request.RequestType.Id" employeeid="@request.Requester.Id"
                                   class="sa-void tooltip-tipsy" href="javascript:void(0);"
                                   original-title="@request.Requester.NickName had @request.TotalDaysRequestInMonth.ToString("0.#") approved request(s) in @request.FromDate.ToMonthAndYearFormatedDate()">
                                    @request.Status.ToString()
                                </a>
                            </td>
                        break;
                    case (byte)CurrentRequestStatus.Verified:
                            <td class="status">
                                <a roleid="@Convert.ToInt32(RoleSystem.HR)" requestid="@request.Id" requesttypeid="@request.RequestType.Id" employeeid="@request.Requester.Id"
                                   class="sa-void tooltip-tipsy" href="javascript:void(0);"
                                   original-title="@request.Status.Name by @request.VerifiedBy.NickName (@request.VerifiedDate.ToShortFormatedDate())">
                                    @request.Status.ToString()
                                </a>
                            </td>
                        break;
                    case (byte)CurrentRequestStatus.NotVerified:
                            <td class="status">
                                <span class="tooltip-tipsy" original-title="@request.Status.Name by @request.VerifiedBy.NickName (@request.VerifiedDate.ToShortFormatedDate())">
                                    @request.Status.ToString()
                                </span>
                            </td>
                        break;
                    case (byte)CurrentRequestStatus.Approved:
                            <td class="status">
                                <a roleid="@Convert.ToInt32(RoleSystem.HR)" requestid="@request.Id" requesttypeid="@request.RequestType.Id" employeeid="@request.Requester.Id"
                                   class="sa-void tooltip-tipsy" href="javascript:void(0);"
                                   original-title="@request.Status.Name by @request.ApprovedBy.NickName (@request.ApprovedDate.ToShortFormatedDate())">
                                    @request.Status.ToString()
                                </a>
                            </td>
                        break;
                    case (byte)CurrentRequestStatus.Rejected:
                            <td class="status">
                                <span class="tooltip-tipsy" original-title="@request.Status.Name by @request.ApprovedBy.NickName (@request.ApprovedDate.ToShortFormatedDate())">
                                    @request.Status.ToString()
                                </span>
                            </td>
                        break;
                    case (byte)CurrentRequestStatus.Processed:
                            <td class="status">
                                <a roleid="@Convert.ToInt32(RoleSystem.HR)" requestid="@request.Id" requesttypeid="@request.RequestType.Id" employeeid="@request.Requester.Id"
                                   class="sa-void tooltip-tipsy" href="javascript:void(0);"
                                   original-title="@request.Status.Name by @request.ProcessedBy.NickName (@request.ProcessedDate.ToShortFormatedDate())">
                                    @request.Status.ToString()
                                </a>
                            </td>
                        break;
                    case (byte)CurrentRequestStatus.Void:
                            <td class="status">
                                <span class="tooltip-tipsy" original-title="@request.Status.Name by @request.ProcessedBy.NickName (@request.ProcessedDate.ToShortFormatedDate())">
                                    @request.Status.ToString()
                                </span>
                            </td>
                        break;
                    default:
                            <td class="status">
                                <span class="tooltip-tipsy">@request.Status.ToString()</span>
                            </td>
                        break;
                }
                }
        </section>

    </div>
    <!-- jQuery (necessary for Bootstrap's JavaScript plugins) -->
    <script src="/Scripts/Libs/jquery/jquery-1.12.4.min.js"></script>


    <script src="/Scripts/Libs/bootstrap/js/bootstrap.js"></script>
    <script src="/Scripts/Libs/tipsy/jquery.tipsy.js"></script>
    <script src="/Scripts/Libs/jquery-ui-1.2.1/jquery-ui.js"></script>

    @Url.CombresLink("employeerequestjs_new")
    @Html.Action("GlobalScript", "UI")
</body>
</html>