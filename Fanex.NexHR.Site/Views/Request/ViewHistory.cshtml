@model Fanex.NexHR.ViewModels.Request.RequestViewModel
@using Fanex.NexHR.Models.Request
@{
    ViewBag.Title = Labels.RequestHistory;
    Layout = null;
}
@section css{
    @Url.CombresLink("sitecss")
}
@section js{
    @Url.CombresLink("sitejs")
}
@section Breadcrumb {
    <a class="step">HR</a> <span class="step">@ViewBag.Title</span>
}
@switch ((int)ViewBag.requestType)
{
    case (int)RequestFilter.CheckInOut:
        IList<RequestEntity> entityCheckInOut = ViewBag.EntityList;
        Html.RenderPartial("History/ViewCheckInOutRequestHistory", entityCheckInOut);
        break;
    case (int)RequestFilter.LateInEarlyOut:
        IList<RequestEntity> entityLateInEarlyOut = ViewBag.EntityList;
        Html.RenderPartial("History/ViewLateInEarlyOutRequestHistory", entityLateInEarlyOut);
        break;
    case (int)RequestFilter.ChangeShift:
        IList<RequestEntity> entityChangeShift = ViewBag.EntityList;
        Html.RenderPartial("History/ViewChangeShiftRequestHistory", entityChangeShift);
        break;
    case (int)RequestFilter.Leave:
        IList<RequestEntity> entityLeave = ViewBag.EntityList;
        Html.RenderPartial("History/ViewLeaveRequestHistory", entityLeave);
        break;
    case (int)RequestFilter.KeepInView:
        IList<RequestEntity> entityOKeepInView = ViewBag.EntityList;
        Html.RenderPartial("History/ViewKeepInViewRequestHistory", entityOKeepInView);
        break;
}
