@model Fanex.NexHR.ViewModels.RequestViewModel
@using Fanex.NexHR.Core;
@using Fanex.NexHR.Resources;
@Html.Hidden("DateTime-Now", DateTime.Now.ToString("MMMM dd, yyyy"))
@Html.Hidden("ActionRequest", ViewBag.Action != null ? (string)ViewBag.Action : string.Empty)
@using (Html.BeginGetForm())
{ 
    <div class="container_24 bunhat">
        <div class="grid_2">
            @Labels.DateRange
        </div>
        <div class="grid_4">
            <select id="Date" name="Date">
                <option value="0" selected= "@(Model.DateOption == 0)">
                    @Labels.DateRange</option>
                <option value="1" selected= "@(Model.DateOption == 1)">
                    @Labels.ToDay</option>
                <option value="2" selected= "@(Model.DateOption == 2)">
                    @Labels.Yesterday</option>
                <option value="3" selected= "@(Model.DateOption == 3)">
                    @Labels.CurrentWeek</option>
                <option value="4" selected= "@(Model.DateOption == 4)">
                    @Labels.LastWeek</option>
                <option value="5" selected= "@(Model.DateOption == 5)">
                    @Labels.CurrentMonth</option>
                <option value="6" selected= "@(Model.DateOption == 6)">
                    @Labels.LastMonth</option>
                <option value="7" selected= "@(Model.DateOption == 7)">
                    @Labels.SinceLastMonth</option>
            </select>
            @Html.Hidden("DateOption", Model.DateOption)
        </div>
        <div class="grid_2">
            @Html.LabelFor(model => model.FromDate)
        </div>
        <div class="grid_6">
            @Html.DatePickerFor(model => model.FromDate, minDate: new DateTime(2010, 1, 1))
        </div>
        <div class="grid_2">
            @Html.LabelFor(model => model.ToDate)
        </div>
        <div class="grid_4">
            @Html.DatePickerFor(model => model.ToDate, minDate: new DateTime(2010, 1, 1))
        </div>
        <div class="grid_1">
            @Labels.On
        </div>
         <div class="grid_4">
            @{
                var filteringDateType = new List<SelectListItem>
                    {
                        new SelectListItem() {Text = "Effected Date", Value = "true"}, 
                        new SelectListItem() {Text = "Created Date", Value = "false"},
                    };
            }
            @Html.DropDownListFor(model => model.IsDailyRequest, filteringDateType)
        </div>
        <div class="clear">
        </div>
        <div class="space">
        </div>
        <div class="grid_2">
            @Html.LabelFor(model => model.StatusId)
        </div>
        <div class="grid_4">
            @RazorHelper.StatusDropDownList(Model.StatusId, isShowPendingAndVerified: Model.IsMember, controlName: "statusId")
        </div>
        <div class="grid_2">
            @Html.LabelFor(model => model.TeamCollection)
        </div>
        <div class="grid_6">
            @Html.DropDownList("TeamId", Model.GetSelecListItemTeam, new { @multiple = "multiple" })
        </div>
        <div class="grid_2">
            @Html.LabelFor(model => model.Employee)
        </div>
        <div class="grid_4">
            @Html.TextBox("Employee", Model.Employee, new { placeholder = Messages.SearchEmployeeWatermark })
            @Html.HiddenFor(model => model.EmployeeId)
        </div>
        <div class="clear">
        </div>
        <div class="space">
        </div>
        <div class="grid_2">
            Category
        </div>
         <div class="grid_4">
            @{
                var category = new List<SelectListItem>
                    {
                        new SelectListItem() {Text = "All", Value = string.Empty},
                        new SelectListItem() {Text = "Expat", Value = "0"}, 
                        new SelectListItem() {Text = "Local", Value = "1"},
                    };
            }
            @Html.DropDownListFor(model => model.IsLocal, category)
        </div>

        <div class="grid_2">
        @Html.LabelFor(model => model.RequestType, "Request")
        </div>
        <div class="grid_15">
            @{
            var types = new List<SelectListItem>
            {
                new SelectListItem() {Text = Labels.All, Value = ((int)RequestFilter.All).ToString()},
                new SelectListItem() {Text = Labels.Leave, Value = ((int)RequestFilter.Leave).ToString()},
                new SelectListItem() {Text = Labels.ChangeShift, Value = ((int)RequestFilter.ChangeShift).ToString()},
                new SelectListItem() {Text = Labels.LateInEarlyOut, Value = ((int)RequestFilter.LateInEarlyOut).ToString()},
                new SelectListItem() {Text = Labels.CheckInOut, Value = ((int)RequestFilter.CheckInOut).ToString()},
                new SelectListItem() {Text = Labels.KeepInView, Value = ((int)RequestFilter.KeepInView).ToString()}
            };    
            }
            @Html.RadioButtonList(model => model.RequestType, types)
        </div>
        <div class="clear">
        </div>
        <div class="space">
        </div>
          <div class="space">
        </div>

        <div class="prefix_2 grid_6">
            <input class="processing-submit" type="submit" id="submit" value="@Labels.Submit"/>
            <input type="button" value="Excel" id="btnExcel"/>
        </div>
    </div>

}
