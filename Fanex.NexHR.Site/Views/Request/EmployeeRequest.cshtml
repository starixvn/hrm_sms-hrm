@helper RenderHistoryLink(RequestEntity request)
{
    switch (request.RequestType.Id)
    {
        case (byte)RequestType.CheckIn:
        case (byte)RequestType.CheckOut:
            <a class="viewhistory" href="javascript:;" id="/checkinout/viewhistory/@request.Id">@Labels.View</a>
            break;
        case (byte)RequestType.LateIn:
        case (byte)RequestType.EarlyOut:
            <a class="viewhistory" href="javascript:;" id="/lateinearlyout/viewhistory/@request.Id">@Labels.View</a>
            break;
        case (byte)RequestType.ChangeShift:
            <a class="viewhistory" href="javascript:;" id="/changeshift/viewhistory/@request.Id">@Labels.View</a>
            break;
        case (byte)RequestType.Leave:
            <a class="viewhistory" href="javascript:;" id="/leave/viewhistory/@request.Id">@Labels.View</a>
            break;
        case (byte)RequestType.KeepInView:
            <a class="viewhistory" href="javascript:;" id="/keepinview/viewhistory/@request.Id">@Labels.View</a>
            break;
        default:
            // nothing
            break;
    }
}