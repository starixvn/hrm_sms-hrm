@model RequestViewModel
@using Fanex.NexHR.Services
@{
    Layout = "~/Views/Shared/_NewLayout.cshtml";
    ViewBag.Title = Model.PageTitle;
}
@section css{
    @Url.CombresLink("employeerequestcss_new")
}
@section js{
    @Url.CombresLink("employeerequestjs_new")
}
@section Breadcrumb {
    <a class="step">@Model.BreadcrumbText</a><span class="step">@ViewBag.Title</span>
}

<h2 class="page-title">@ViewBag.Title</h2>
<div class="filter">
    @Html.Partial("_CriteriaPanelNewLayout", Model)
</div>

<div class="table-data">
    <table class="table table-custom persist-area">
        <thead>
            <tr class="persist-header">
                <th>@Labels.SymbolCount</th>
                <th>@Labels.Employee</th>
                <th>@Labels.Team</th>
                <th>@Labels.Request</th>
                <th>@Labels.Details</th>
                <th>@Labels.Remark</th>
                <th>@Labels.CreatedDate</th>
                <th>@Labels.Status</th>
                <th>@Labels.History</th>
                <th></th>
            </tr>
        </thead>
        @if (Model.Requests != null && Model.Requests.Any())
        {
            int index = 1;
            <tbody>
                @foreach (RequestEntity request in Model.Requests)
                {
                    var requestModel = new RequestViewModel
                    {
                        DateOption = Model.DateOption,
                        FromDate = Model.FromDate,
                        ToDate = Model.ToDate,
                        EmployeeId = request.Requester.Id,
                        Employee = request.Requester.NickName + " (" + request.Requester.FullName + ")",
                        TeamIds = Model.TeamIds,
                        StatusId = Model.StatusId,
                        RequestType = request.RequestType.FilterRequest,
                        ViewType = Model.ViewType
                    };
                    <tr id="row@(request.Id)">
                        <td>@(index++)</td>
                        <td>
                            <span class="tooltip-tipsy" original-title="@request.Requester.FullName">@request.Requester.NickName</span>
                        </td>
                        <td>
                            <span class="tooltip-tipsy" original-title="@request.Requester.Team.Name">@request.Requester.Team.Code</span>
                        </td>
                        <td>
                            @switch (request.RequestType.Id)
                            {
                                case (int)RequestType.Leave:
                                    <a href="#" onclick="window.parent.location.href='@Url.Action("Detail", "Leave", new { requestId = request.Id })';">@request.LeaveType.Name</a>
                                    break;
                                case (int)RequestType.ChangeShift:
                                    <a href="#" onclick="window.parent.location.href='@Url.Action("Detail", "ChangeShift", new { id = request.Id })';">@request.RequestType.Name</a>
                                    break;
                                default:
                                    <a href="#" onclick='window.parent.location.href="@Url.Action(Model.ActionName, "request", requestModel)";'>@request.RequestType.Name</a>
                                    break;
                            }
                        </td>
                        <td class="align-left">
                            @Html.Raw(RequestService.ToRequestMessage(request))
                        </td>
                        @if (!string.IsNullOrWhiteSpace(request.Remark))
                        {
                            <td>
                                <span class="icon remark glyphicon glyphicon-comment tooltip-tipsy" original-title="@request.Remark"></span>
                            </td>
                        }
                        else
                        {
                            <td>-</td>
                        }
                        <td class="ddMMyyyyhhmm">
                            @request.CreatedDate.ToShortFormatedDate()
                        </td>
                        @RenderStatus(Model, request)
                        <td>
                            <a class="viewhistory" href="javascript:;" id="/request/viewhistorynewversion?id=@request.Id&type=@request.RequestType.FilterRequestHistory">
                                @Labels.View
                            </a>
                        </td>
                        <td class="td-warning">
                            @if (request.IsWarning)
                            {
                                <span class="icon-warning tooltip-tipsy" original-title="@Labels.RequestWarning"></span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        }
        else
        {
            @RazorHelper.DisplayNoInformation(colspan: 10);
        }
    </table>
</div>
<div id="dialoghistorycontent"></div>
<div id="dialogProcessRequest"></div>
<div id="message"></div>
