@using Fanex.NexHR.Core
@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Models.Request
@using Fanex.NexHR.Resources
@using Fanex.NexHR.Services
@model RequestViewModel
@{
    ViewBag.Title = Model.PageTitle;
}
@section css{
    <link href="~/wwwroot/dist/styles/employee.request.css" rel="stylesheet" />
}
@section js{
    <script src="~/wwwroot/dist/js/employee.request.js"></script>
}
@section Breadcrumb {
    <a class="step">@Model.BreadcrumbText</a><span class="step">@ViewBag.Title</span>
}

<h2 class="page-title">@ViewBag.Title</h2>
<div class="filter">
    @Html.Partial("_SearchForm", Model)
</div>

<div class="table-data">
    <table class="table table-custom" id="data">
        <thead>
            @if (Model.ViewType == RequestViewType.PersonalSpace)
            {
                <tr>
                    <th colspan="16">
                        <div style="float:right; margin-left: 10px">
                            <input type="button" class="btn btn-primary btnApproveMultiple" id="btnApproveMultiple" command-type="@RequestCommand.Approve" value="@Labels.Approve" />
                        </div>

                        <div style="float:right;">
                            <input type="button" class="btn btn-primary btnApproveMultiple" id="btnApproveMultiple" command-type="@RequestCommand.Accept" value="@Labels.Verify" />
                        </div>
                    </th>
                </tr>
            }
            else if (Model.ViewType == RequestViewType.HRSpace)
            {
                <tr>
                    <th colspan="16">
                        <div style="float:right;">
                            <input type="button" class="btn btn-primary btnApproveMultiple" id="btnApproveMultiple" command-type="@RequestCommand.Process" value="@Labels.Process" />
                        </div>
                    </th>
                </tr>
            }
            <tr>
                @if (Model.ViewType == RequestViewType.PersonalSpace || Model.ViewType == RequestViewType.HRSpace)
                {
                    <th>
                        <div class="checkbox">
                            <input type="checkbox" class="checkbox-custom" id="ckbAll" />
                            <label for="ckbAll"></label>
                        </div>
                    </th>
                }
                <th>@Labels.SymbolCount</th>
                <th class="col-sorter">
                    @Labels.Department
                    <div class="fa fa-sort"></div>
                </th>
                <th class="col-sorter">
                    @Labels.Section
                    <div class="fa fa-sort"></div>
                </th>
                <th class="col-sorter">
                    @Labels.Team
                    <div class="fa fa-sort"></div>
                </th>
                <th class="col-sorter">
                    @Labels.Employee
                    <div class="fa fa-sort"></div>
                </th>
                <th class="col-sorter">
                    @Labels.Request
                    <div class="fa fa-sort"></div>
                </th>
                <th class="col-sorter">
                    @Labels.Details
                    <div class="fa fa-sort"></div>
                </th>
                <th class="col-sorter">
                    @Labels.Verified
                    <div class="fa fa-sort"></div>
                </th>
                <th class="col-sorter">
                    @Labels.Approver
                    <div class="fa fa-sort"></div>
                </th>
                <th>@Labels.Remark</th>
                @if (@Model.ActionName != "DailyView")
                {
                    <th>@Labels.FileAttach</th>
                }
                <th class="col-sorter">
                    @Labels.CreatedDate
                    <div class="fa fa-sort"></div>
                </th>
                <th class="col-sorter">
                    @Labels.Status
                    <div class="fa fa-sort"></div>
                </th>
                <th>@Labels.History</th>
                <th></th>
            </tr>
        </thead>
        @if (Model.Requests != null && Model.Requests.Any())
        {
            int index = 1;
            <tbody>
                @foreach (RequestEntity request in Model.Requests)
                {
                    <tr id="row@(request.Id)">
                        @if (Model.ViewType == RequestViewType.PersonalSpace)
                        {
                            <td>
                                <div class="checkbox">
                                    @if (request.ApprovedBy.Id == Model.CurrentUserId
                                        && (request.Status.Id == (byte)CurrentRequestStatus.Pending || request.Status.Id == (byte)CurrentRequestStatus.Verified))
                                    {
                                        <input type="checkbox"
                                               class="checkbox-custom chk-request"
                                               roleid="@Convert.ToInt32(RoleSystem.Approver)"
                                               requesttypeid="@request.RequestType.Id"
                                               employeeid="@request.Requester.Id"
                                               id="@request.Id" />
                                        <label for="@request.Id"></label>
                                    }
                                    else if (request.VerifiedBy.Id == Model.CurrentUserId && request.Status.Id == (byte)CurrentRequestStatus.Pending)
                                    {
                                        <input type="checkbox"
                                               class="checkbox-custom chk-request"
                                               roleid="@Convert.ToInt32(RoleSystem.Verifier)"
                                               requesttypeid="@request.RequestType.Id"
                                               employeeid="@request.Requester.Id"
                                               id="@request.Id" />
                                        <label for="@request.Id"></label>
                                    }
                                </div>
                            </td>
                        }
                        else if (Model.ViewType == RequestViewType.HRSpace)
                        {
                            <td>
                                <div class="checkbox">
                                    @if (Model.IsAllowChangeStatus && request.Status.Id == (byte)CurrentRequestStatus.Approved)
                                    {
                                        <input type="checkbox"
                                               class="checkbox-custom chk-request"
                                               roleid="@Convert.ToInt32(RoleSystem.HR)"
                                               requesttypeid="@request.RequestType.Id"
                                               employeeid="@request.Requester.Id"
                                               id="@request.Id" />
                                        <label for="@request.Id"></label>
                                    }
                                </div>
                            </td>
                        }

                        <td>@(index++)</td>
                        <td>
                            @if (@request.Requester.Team.Section != null && @request.Requester.Team.Section.Department != null)
                            {
                                <span class="tooltip-tipsy" title="@request.Requester.Team.Section.Department.Code">@request.Requester.Team.Section.Department.Code</span>
                            }
                        </td>
                        <td>
                            @if (@request.Requester.Team.Section != null)
                            {
                                <span class="tooltip-tipsy" title="@request.Requester.Team.Section.Code">@request.Requester.Team.Section.Code</span>
                            }
                        </td>
                        <td>
                            <span class="tooltip-tipsy" title="@request.Requester.Team.Name">@request.Requester.Team.Code</span>
                        </td>
                        <td>
                            <span class="tooltip-tipsy" title="@request.Requester.FullName">@request.Requester.NickName</span>
                        </td>
                        <td>
                            @switch (request.RequestType.Id)
                            {
                                case (byte)RequestType.Leave:
                                    <a href="@Url.Action("Detail", "Leave", new { id = request.Id })">@request.LeaveType.Name</a>
                                    break;
                                case (byte)RequestType.ChangeShift:
                                    <a href="@Url.Action("Details", "ChangeShift", new { id = request.Id })">@request.RequestType.Name</a>
                                    break;
                                default:
                                    @request.RequestType.Name
                                    break;
                            }
                        </td>
                        <td class="align-left">
                            @Html.Raw(RequestService.ToRequestMessage(request))
                        </td>
                        <td>
                            <span class="tooltip-tipsy" title="@request.VerifiedBy.FullName">@request.VerifiedBy.NickName</span>
                        </td>
                        <td>
                            <span class="tooltip-tipsy" title="@request.ApprovedBy.FullName">@request.ApprovedBy.NickName</span>
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(request.Remark))
                            {
                                <span class="fa fa-comment tooltip-tipsy" title="@request.Remark"></span>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                        @if (@Model.ActionName != "DailyView")
                        {
                            <td>@Html.Raw(request.ContentFile)</td>
                        }
                        <td>@request.CreatedDate.ToDetailFormatedDate()</td>
                        <td class="status">@RenderStatus(Model, request)</td>
                        <td>@RenderHistoryLink(request)</td>
                        <td class="td-warning">
                            @if (request.IsWarning)
                            {
                                <span class="fa fa-exclamation-triangle tooltip-tipsy" title="@Labels.RequestWarning"></span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        }
        else
        {
            @RazorHelper.DisplayNoInformation(colspan: 16);
        }
    </table>
</div>
<div id="dialoghistorycontent"></div>
<div id="dialogProcessRequest" h></div>
<div id="dialogApproveMultipleRequest" role="dialog" class="modal dialogApproveMultipleRequest">
    <form>
        <div class="formrow">
            <div class="validation-summary-valid validation-summary-errors" style="display: none;"></div>
        </div>

        <div class="formrow">
            <div class="label approver-selection">
                <label>@Labels.Violation : </label>
            </div>
            <div class="input radio-btn">
                <input type="radio" id="chk-ignore-all" name="btn-violation" />
                <label for="chk-ignore-all">@Labels.ViolationIgnored</label>
            </div>
            <div class="input radio-btn">
                <input type="radio" id="chk-record-all" name="btn-violation" />
                <label for="chk-record-all">@Labels.ViolationRecorded</label>
            </div>
        </div>

        <div class="formrow">
            <div class="label approver-comment">
                <label for="Comment">@Labels.Comment : </label>
            </div>
            <div class="input">
                <textarea class="form-control" cols="20" id="Comment" viewtype="@Model.ViewType" maxlength="500" name="Comment" rows="2"></textarea>
            </div>
        </div>
    </form>
</div>
<div id="dialogProcessMultipleRequest" role="dialog" class="modal dialogProcessRequest">
    <form>
        <div class="formrow">
            <div class="validation-summary-valid validation-summary-errors" style="display: none;"></div>
        </div>
        <div class="formrow">
            <div class="label approver-comment">
                <label for="Comment">@Labels.Comment : </label>
            </div>
            <div class="input">
                <textarea class="form-control" cols="20" id="Comment" viewtype="@Model.ViewType" maxlength="500" name="Comment" rows="2"></textarea>
            </div>
        </div>
    </form>
</div>

@helper RenderStatus(RequestViewModel model, RequestEntity request)
{
    switch (model.ViewType)
    {
        case RequestViewType.PersonalSpace:
            @RenderStatusPersonalSpace(model, request);
            break;
        case RequestViewType.SASpace:
            @RenderStatusSASpace(model, request);
            break;
        default:
            @RenderStatusHRSpace(model, request);
            break;
    }
}

@helper RenderStatusHRSpace(RequestViewModel model, RequestEntity request)
{
    var annualBalance = string.Empty;
    if (request.RequestType.Id == (byte)RequestType.Leave)
    {
        annualBalance = "AL Balance " + request.FromDate.Year + ": " + request.Requester.AnnualLeaveBalance + " && ";
    }

    switch (request.Status.Id)
    {
        case (byte)CurrentRequestStatus.Pending:
            <span class="tooltip-tipsy" title="@annualBalance @request.Requester.NickName had @request.TotalDaysRequestInMonth.ToString("0.#") approved request(s) in @request.FromDate.ToMonthAndYearFormatedDate()">
                @request.Status.ToString()
            </span>
            break;
        case (byte)CurrentRequestStatus.Verified:
        case (byte)CurrentRequestStatus.NotVerified:
            <span class="tooltip-tipsy" title="@annualBalance @request.Status.Name by @request.VerifiedBy.NickName (@request.VerifiedDate.ToShortFormatedDate())">
                @request.Status.ToString()
            </span>
            break;
        case (byte)CurrentRequestStatus.Approved:
        case (byte)CurrentRequestStatus.Rejected:
            if (Model.IsAllowChangeStatus && request.Status.Id == (byte)CurrentRequestStatus.Approved)
            {
                <a roleid="@Convert.ToInt32(RoleSystem.HR)" requestid="@request.Id" requesttypeid="@request.RequestType.Id" employeeid="@request.Requester.Id"
                   href="javascript:void(0);" class="hr-actions tooltip-tipsy"
                   title="@request.Status.Name by @request.ApprovedBy.NickName (@request.ApprovedDate.ToShortFormatedDate())">
                    @request.Status.ToString()
                    <span class="caret"></span>
                </a>
            }
            else
            {
                <span class="tooltip-tipsy" title="@request.Status.Name by @request.ApprovedBy.NickName (@request.ApprovedDate.ToShortFormatedDate())">
                    @request.Status.ToString()
                </span>
            }
            break;
        case (byte)CurrentRequestStatus.Processed:
            if (Model.IsAllowChangeStatus)
            {
                <a roleid="@Convert.ToInt32(RoleSystem.HR)" requestid="@request.Id" requesttypeid="@request.RequestType.Id" employeeid="@request.Requester.Id"
                   href="javascript:void(0);" class="hr-actions-reset tooltip-tipsy"
                   title="@request.Status.Name by @request.ProcessedBy.NickName (@request.ProcessedDate.ToShortFormatedDate())">
                    @request.Status.ToString()
                    <span class="caret"></span>
                </a>
            }
            else
            {
                <span class="tooltip-tipsy" title="@request.Status.Name by @request.ProcessedBy.NickName (@request.ProcessedDate.ToShortFormatedDate())">
                    @request.Status.ToString()
                </span>
            }
            break;
        case (byte)CurrentRequestStatus.Void:
            <span class="tooltip-tipsy" title="@request.Status.Name by @request.ProcessedBy.NickName (@request.ProcessedDate.ToShortFormatedDate())">
                @request.Status.ToString()
            </span>
            break;
        default:
            <span>@request.Status.ToString()</span>
            break;
    }
}

