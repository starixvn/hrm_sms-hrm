@using Fanex.NexHR.Services
@model RequestViewModel
@{
    ViewBag.Title = Model.PageTitle;
}
@section css{
    @Url.CombresLink("employeerequestcss")
}
@section js{
    @Url.CombresLink("employeerequestjs")
}
@section Breadcrumb {
    <a class="step">@Model.BreadcrumbText</a> <span class="step">@ViewBag.Title</span>
}
<h2>@ViewBag.Title</h2>
<div>
    @Html.Partial("CriteriaPanel", Model)
</div>
<table class="table table-custom persist-area">
    <thead>
        <tr class="persist-header">
            <th>@Labels.SymbolCount</th>
            <th>@Labels.Employee</th>
            <th>@Labels.Team</th>
            <th>@Labels.Request</th>
            <th>@Labels.Details</th>
            <th>@Labels.Remark</th>
            <th>@Labels.CreatedDate</th>
            <th>@Labels.Status</th>
            <th>@Labels.History</th>
            <th></th>
        </tr>
    </thead>
    @if (Model.Requests != null && Model.Requests.Any())
    {
        int index = 1;
        <tbody>
            @foreach (RequestEntity request in Model.Requests)
            {
                var requestModel = new RequestViewModel
                {
                    DateOption = Model.DateOption,
                    FromDate = Model.FromDate,
                    ToDate = Model.ToDate,
                    EmployeeId = request.Requester.Id,
                    Employee = request.Requester.NickName + " (" + request.Requester.FullName + ")",
                    TeamIds = Model.TeamIds,
                    StatusId = Model.StatusId,
                    RequestType = request.RequestType.FilterRequest,
                    ViewType = Model.ViewType
                };
                <tr id="row@(request.Id)">
                    <td>@(index++)</td>
                    <td class="tooltip" title="@request.Requester.FullName">
                        @request.Requester.NickName
                    </td>
                    <td class="tooltip" title="@request.Requester.Team.Name">
                        @request.Requester.Team.Code
                    </td>
                    <td>
                        @switch (request.RequestType.Id)
                        {
                            case (int)RequestType.Leave:
                                <a href="@Url.Action("Detail", "Leave", new { requestId = request.Id })">@request.LeaveType.Name</a>
                                break;
                            case (int)RequestType.ChangeShift:
                            <a href="@Url.Action("Detail", "ChangeShift", new { id = request.Id })">@request.RequestType.Name</a>
                                break;
                            default:
                            <a href="@Url.Action(Model.ActionName, "request", requestModel)">@request.RequestType.Name</a>
                                break;
                        }
                    </td>
                    <td class="align-left">
                        @Html.Raw(RequestService.ToRequestMessage(request))
                    </td>
                    @if (!string.IsNullOrWhiteSpace(request.Remark))
                    {
                        <td class="tooltip" title="@request.Remark">
                            <span class="icon remark"></span>
                        </td>
                    }
                    else
                    {
                        <td>-</td>
                    }
                    <td class="ddMMyyyyhhmm">
                        @request.CreatedDate.ToShortFormatedDate()
                    </td>
                    @RenderStatus(Model, request)
                    <td>
                        <a class="viewhistory" href="javascript:;" id="/request/viewhistory?id=@request.Id&type=@request.RequestType.FilterRequestHistory">
                            @Labels.View
                        </a>
                    </td>
                    <td class="td-warning">
                        @if (request.IsWarning)
                        {
                            <span class="icon-warning tooltip" title="@Labels.RequestWarning"></span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    }
    else
    {
        @RazorHelper.DisplayNoInformation(colspan: 10);
    }
</table>

@RenderContextMenu(Model)
<div id="dialoghistorycontent"></div>
<div id="dialogProcessRequest"></div>

@helper RenderContextMenu(RequestViewModel model)
{
    switch (model.ViewType)
    {
        case RequestViewType.PersonalSpace:
            @RazorHelper.VerifierAndApproverMenu()
            @RazorHelper.ResetMenu()
            break;
        case RequestViewType.SASpace:
            @RazorHelper.VoidMenu();
            break;
        case RequestViewType.HRSpace:
            @RazorHelper.HrMenu()
            @RazorHelper.ResetMenu()
            break;
    }
}
@helper RenderStatus(RequestViewModel model, RequestEntity request)
{
    switch (model.ViewType)
    {
        case RequestViewType.PersonalSpace:
            @RenderStatusPersonalSpace(model, request);
            break;
        case RequestViewType.SASpace:
            @RenderStatusSASpace(model, request);
            break;
        default:
            @RenderStatusHRSpace(model, request);
            break;
    }
}

@helper RenderStatusHRSpace(RequestViewModel model, RequestEntity request)
{
    switch (request.Status.Id)
    {
        case (byte)CurrentRequestStatus.Pending:
            <td>
                <span class="tooltip" title="@request.Requester.NickName had @request.TotalDaysRequestInMonth.ToString("0.#") approved request(s) in @request.FromDate.ToMonthAndYearFormatedDate()">
                    @request.Status.ToString()
                </span>
            </td>
            break;
        case (byte)CurrentRequestStatus.Verified:
        case (byte)CurrentRequestStatus.NotVerified:
            <td>
                <span class="tooltip" title="@request.Status.Name by @request.VerifiedBy.NickName (@request.VerifiedDate.ToShortFormatedDate())">
                    @request.Status.ToString()
                </span>
            </td>
            break;
        case (byte)CurrentRequestStatus.Approved:
        case (byte)CurrentRequestStatus.Rejected:
            if (Model.IsAllowChangeStatus && request.Status.Id == (byte)CurrentRequestStatus.Approved)
            {
                <td>
                    <a roleid="@Convert.ToInt32(RoleSystem.HR)" requestid="@request.Id" requesttypeid="@request.RequestType.Id" employeeid="@request.Requester.Id"
                       href="javascript:void(0);" class="hr-actions tooltip"
                       title="@request.Status.Name by @request.ApprovedBy.NickName (@request.ApprovedDate.ToShortFormatedDate())">
                        @request.Status.ToString()
                    </a>
                </td>
            }
            else
            {
                <td>
                    <span class="tooltip" title="@request.Status.Name by @request.ApprovedBy.NickName (@request.ApprovedDate.ToShortFormatedDate())">
                        @request.Status.ToString()
                    </span>
                </td>
            }
            break;
        case (byte)CurrentRequestStatus.Processed:
            if (Model.IsAllowChangeStatus)
            {
                <td>
                    <a roleid="@Convert.ToInt32(RoleSystem.HR)" requestid="@request.Id" requesttypeid="@request.RequestType.Id" employeeid="@request.Requester.Id"
                       href="javascript:void(0);" class="hr-actions-reset tooltip"
                       title="@request.Status.Name by @request.ProcessedBy.NickName (@request.ProcessedDate.ToShortFormatedDate())">
                        @request.Status.ToString()
                    </a>
                </td>
            }
            else
            {
                <td>
                    <span class="tooltip" title="@request.Status.Name by @request.ProcessedBy.NickName (@request.ProcessedDate.ToShortFormatedDate())">
                        @request.Status.ToString()
                    </span>
                </td>
            }
            break;
        default:
            <td>
                <span class="tooltip">@request.Status.ToString()</span>
            </td>
            break;
    }
}

@helper RenderStatusPersonalSpace(RequestViewModel model, RequestEntity request)
{
    switch (request.Status.Id)
    {
        case (byte)CurrentRequestStatus.Pending:
            if (request.ApprovedBy.Id == Model.CurrentUserId)
            {
                <td>
                    <a roleid="@Convert.ToInt32(RoleSystem.Approver)" requestid="@request.Id" requesttypeid="@request.RequestType.Id" employeeid="@request.Requester.Id"
                       href="javascript:void(0);" class="approver-actions tooltip"
                       title="@request.Requester.NickName had @request.TotalDaysRequestInMonth.ToString("0.#") approved request(s) in @request.FromDate.ToMonthAndYearFormatedDate()">
                        @request.Status.ToString()
                    </a>
                </td>
            }
            else if (request.VerifiedBy.Id == Model.CurrentUserId)
            {
                <td>
                    <a roleid="@Convert.ToInt32(RoleSystem.Verifier)" requestid="@request.Id" requesttypeid="@request.RequestType.Id" employeeid="@request.Requester.Id"
                       href="javascript:void(0);" class="verifier-actions tooltip"
                       title="@request.Requester.NickName had @request.TotalDaysRequestInMonth.ToString("0.#") approved request(s) in @request.FromDate.ToMonthAndYearFormatedDate()">
                        @request.Status.ToString()
                    </a>
                </td>
            }
            else
            {
                <td>
                    <span>@request.Status.ToString()</span>
                </td>
            }
            break;
        case (byte)CurrentRequestStatus.Verified:
            if (request.ApprovedBy.Id == Model.CurrentUserId)
            {
                <td>
                    <a roleid="@Convert.ToInt32(RoleSystem.Approver)" requestid="@request.Id" requesttypeid="@request.RequestType.Id" employeeid="@request.Requester.Id"
                       href="javascript:void(0);" class="approver-actions tooltip"
                       title="@request.Status.Name by @request.VerifiedBy.NickName (@request.VerifiedDate.ToShortFormatedDate())">
                        @request.Status.ToString()
                    </a>
                </td>
            }
            else if (request.VerifiedBy.Id == Model.CurrentUserId)
            {
                <td>
                    <a roleid="@Convert.ToInt32(RoleSystem.Verifier)" requestid="@request.Id" requesttypeid="@request.RequestType.Id" employeeid="@request.Requester.Id"
                       href="javascript:void(0);" class="verifier-actions-reset tooltip"
                       title="@request.Status.Name by @request.VerifiedBy.NickName (@request.VerifiedDate.ToShortFormatedDate())">
                        @request.Status.ToString()
                    </a>
                </td>
            }
            else
            {
                <td>
                    <span>@request.Status.ToString()</span>
                </td>
            }
            break;
        case (byte)CurrentRequestStatus.NotVerified:
            if (request.VerifiedBy.Id == Model.CurrentUserId)
            {
                <td>
                    <a roleid="@Convert.ToInt32(RoleSystem.Verifier)" requestid="@request.Id" requesttypeid="@request.RequestType.Id" employeeid="@request.Requester.Id"
                       href="javascript:void(0);" class="verifier-actions-reset tooltip"
                       title="@request.Status.Name by @request.VerifiedBy.NickName (@request.VerifiedDate.ToShortFormatedDate())">
                        @request.Status.ToString()
                    </a>
                </td>
            }
            else
            {
                <td>
                    <span>@request.Status.ToString()</span>
                </td>
            }
            break;
        case (byte)CurrentRequestStatus.Approved:
        case (byte)CurrentRequestStatus.Rejected:
            if (request.ApprovedBy.Id == Model.CurrentUserId)
            {
                <td>
                    <a roleid="@Convert.ToInt32(RoleSystem.Approver)" requestid="@request.Id" requesttypeid="@request.RequestType.Id" employeeid="@request.Requester.Id"
                       href="javascript:void(0);" class="approver-actions-reset tooltip"
                       title="@request.Status.Name by @request.ApprovedBy.NickName (@request.ApprovedDate.ToShortFormatedDate())">
                        @request.Status.ToString()
                    </a>
                </td>
            }
            else
            {
                <td>
                    <span>@request.Status.ToString()</span>
                </td>
            }
            break;
        case (byte)CurrentRequestStatus.Processed:
        case (byte)CurrentRequestStatus.Void:
            <td>
                <span>@request.Status.ToString()</span>
            </td>
            break;
        default:
            <td>
                <span>@request.Status.ToString()</span>
            </td>
            break;
    }
}

