@model RequestViewModel
@{
    ViewBag.Title = Model.PageTitle;
}
@section css{
    @Url.CombresLink("employeerequestcss")
}
@section js{
    @Url.CombresLink("employeerequestjs")
}
@section Breadcrumb {
    <a class="step">@Model.BreadcrumbText</a> <span class="step">@ViewBag.Title</span>
}

<iframe sandbox="allow-same-origin allow-scripts allow-popups allow-forms"
        src='@Url.Action("MemberNewVersion","Request")'
        style="border: 0; width: 100%; height: 100%"></iframe>