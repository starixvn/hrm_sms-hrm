@model IList<RequestEntity>

<table class="data">
    <thead>
        <tr>
            <th>@Labels.RequestTime</th>
            <th>@Labels.Shift</th>
            <th>@Labels.Request</th>
            <th>@Labels.CreatedDate</th>
            <th>@Labels.Remark</th>
            <th>@Labels.Ignored</th>
        </tr>
    </thead>
    @if (Model != null && Model.Any())
    {
        <tbody>
            @foreach (RequestEntity request in Model)
            {
                <tr id="row@(request.Id)">
                    <td class="ddMMyyyyhhmm highlight">
                        @request.RequestedDate.ToShortFormatedDate()
                    </td>
                    <td class="highlight">
                        @request.FromShift.Name
                    </td>
                    <td class="highlight">
                        @request.RequestType.ToString()
                    </td>
                    <td class="ddMMyyyyhhmm">
                        @request.CreatedDate.ToShortFormatedDate()
                    </td>
                    @if (!string.IsNullOrWhiteSpace(request.Remark))
                    {
                        <td class="tooltip" title="@request.Remark">
                            <span class="icon remark" alt="remark"></span>
                        </td>
                    }
                    else
                    {
                        <td>-</td>
                    }
                    <td>
                        @{
                            var disciplineTypeId = (int)DisciplineType.MissingCheckInOut;
                        }
                        <input type="checkbox" data-workdate="@request.RequestedDate.ToDateMonthYearFormatedDate()"
                               data-disciplineTypeId="@disciplineTypeId"/>
                    </td>
                </tr>
            }
        </tbody>
    }
    else
    {
        @RazorHelper.DisplayNoInformation(colspan: 6);
    }
</table>