@model RequestEntity
@if (Model != null)
{
    <table class="tabledata">
        <thead>
            <tr>
                <th>@Labels.RequestTime</th>
                <th>@Labels.Shift</th>
                <th>@Labels.Request</th>
                <th>@Labels.CreatedDate</th>
                <th>@Labels.Remark</th>
                <th>@Labels.Ignored</th>
            </tr>
        </thead>
        <tbody>
            <tr id="row@(Model.Id)">
                <td class="ddMMyyyyhhmm highlight">
                    @Model.RequestedDate.ToShortFormatedDate()
                </td>
                <td class="highlight">
                    @Model.FromShift.Name
                </td>
                <td class="highlight">
                    @Model.RequestType.ToString()
                </td>
                <td class="ddMMyyyyhhmm">
                    @Model.CreatedDate.ToShortFormatedDate()
                </td>
                @if (!string.IsNullOrWhiteSpace(Model.Remark))
                {
                    <td class="tooltip" title="@Model.Remark">
                        <span class="icon remark" alt="remark"></span>
                    </td>
                }
                else
                {
                    <td>-</td>
                }
                <td class="ignoredDiscipline">
                    @{
                        var disciplineTypeId = (int)DisciplineType.MissingCheckInOut;
                    }
                    <input type="checkbox" data-workdate="@Model.RequestedDate" data-disciplinetypeid="@disciplineTypeId" />
                </td>
            </tr>
        </tbody>
    </table>
}