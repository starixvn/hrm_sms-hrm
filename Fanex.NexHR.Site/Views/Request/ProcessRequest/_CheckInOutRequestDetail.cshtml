@model RequestEntity
<table class="table table-custom">
    <thead>
        <tr>
            <th>@Labels.RequestTime</th>
            <th>@Labels.Shift</th>
            <th>@Labels.Request</th>
            <th>@Labels.CreatedDate</th>
            <th>@Labels.Remark</th>
            <th>@Labels.ViolationIgnored</th>
            <th>@Labels.ViolationRecorded</th>
        </tr>
    </thead>
    <tbody>
        <tr id="row@(Model.Id)">
            <td>
                @Model.RequestedDate.ToShortFormatedDate()
            </td>
            <td>
                @if (Model.FromShift != null)
                {
                    @Model.FromShift.Name
                }
            </td>
            <td>
                @Model.RequestType.ToString()
            </td>
            <td>
                @Model.CreatedDate.ToShortFormatedDate()
            </td>
            @if (!string.IsNullOrWhiteSpace(Model.Remark))
            {
                <td class="tooltip" title="@Model.Remark">
                    <span class="icon remark" alt="remark"></span>
                </td>
            }
            else
            {
                <td>-</td>
            }
            <td class="violationIgnored">
                @{
                    var disciplineTypeId = (int)DisciplineType.MissingCheckInOut;
                }
                <input type="radio" data-workdate="@Model.FromDate.Date.ToString("d")" data-disciplinetypeid="@disciplineTypeId" />
            </td>
            <td class="violationRecorded">
                <input type="radio" />
            </td>
        </tr>
    </tbody>
</table>
