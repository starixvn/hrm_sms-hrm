@model List<LeaveDetailModel>
<table class="table table-custom">
    <thead>
        <tr>
            <th>@Labels.Date</th>
            <th>@Labels.ScheduleStatus</th>
            <th>@Labels.LeaveTypeName</th>
            <th>@Labels.HalfDay</th>
            <th>@Labels.FromTime</th>
            <th>@Labels.ToTime</th>
            <th>@Labels.ViolationIgnored</th>
            <th>@Labels.ViolationRecorded</th>
        </tr>
    </thead>
    <tbody>
        @foreach (LeaveDetailModel item in Model)
        {
            <tr>
                <td>
                    @(item.LeaveDate.ToDateMonthYearFormatedDate() + " (" + item.LeaveDate.ToString("ddd") + ")")
                </td>
                <td>
                    @item.ScheduleStatus
                </td>
                @if (!item.IsOffOrHoliday)
                {
                    <td>
                        @if (item.LeaveTypeId == 0) // general leave
                        {
                            <span>-</span>
                        }
                        else
                        {
                            @item.LeaveTypeName
                        }
                    </td>
                    <td>
                        @if (item.LeaveTypeId == 0)
                        {
                            <span>-</span>
                        }
                        else
                        {
                            @Html.CheckBoxFor(m => item.IsHalfDay, new { @disabled = "disabled" })
                        }
                    </td>
                    @*<td>
                        @if (item.LeaveTypeId == 0)
                        {
                            <span>-</span>
                        }
                        else
                        {
                            double totalDays = item.ToTime.Subtract(item.FromTime).TotalDays + 1;
                            @(item.IsHalfDay ? "0.5" : totalDays.ToString())
                        }
                    </td>*@
                    <td>
                        @if (item.IsHalfDay)
                        {
                            <div>
                                @Html.DropDownListFor(m => item.FromTime, Utilities.TimeSteps(30, item.FromTime.ToShortTime()), new { @disabled = "disabled" })
                                @Html.CheckBoxFor(m => item.IsFromAfterday, new { @disabled = "disabled", @title = "Is after day" })
                            </div>
                        }
                        else
                        {
                            @item.FromTime.ToDateMonthYearFormatedDate()
                        }
                    </td>
                    <td>
                        @if (item.IsHalfDay)
                        {
                            <div>
                                @Html.DropDownListFor(m => item.ToTime, Utilities.TimeSteps(30, item.ToTime.ToShortTime()), new { @disabled = "disabled" })
                                @Html.CheckBoxFor(m => item.IsToAfterday, new { @disabled = "disabled", @title = "Is after day" })
                            </div>
                        }
                        else
                        {
                            @item.ToTime.ToDateMonthYearFormatedDate()
                        }
                    </td>
                    <td class="violationIgnored">
                        @if (item.IsUnpaidLeaveAbsent)
                        {
                            var disciplinetypeId = (int)DisciplineType.UnpaidLeaveAbsent;
                            <input type="radio" data-workdate="@item.LeaveDate.Date.ToString("d")" data-disciplinetypeid="@disciplinetypeId" />
                        }
                        else if (item.IsAbsent)
                        {
                            var disciplinetypeId = (int)DisciplineType.Absent;
                            <input type="radio" data-workdate="@item.LeaveDate.Date.ToString("d")" data-disciplinetypeid="@disciplinetypeId" />
                        }
                        else if (item.IsUnplannedLeave)
                        {
                            var disciplinetypeId = (int)DisciplineType.UnplannedLeave;
                            <input type="radio" data-workdate="@item.LeaveDate.Date.ToString("d")" data-disciplinetypeid="@disciplinetypeId" />
                        }
                        else if (item.LeaveTypeId == 25)//unpaid leave
                        {
                            var disciplinetypeId = (int)DisciplineType.UnpaidLeave;
                            <input type="radio" data-workdate="@item.LeaveDate.Date.ToString("d")" data-disciplinetypeid="@disciplinetypeId" />
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                    <td class="violationRecorded">
                        @if (item.IsUnpaidLeaveAbsent || item.IsAbsent || item.IsUnplannedLeave || item.LeaveTypeId == 25)
                        {
                            <input type="radio" />
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                }
                else
                {
                    <td>-</td>
                    <td>-</td>
                    <td>-</td>
                    <td>-</td>
                    <td>-</td>
                    <td>-</td>
                }
            </tr>
        }
    </tbody>
</table>