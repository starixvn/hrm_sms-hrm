@using Fanex.NexHR.Resources
@model List<LeaveDisciplineModel>
@{
    var isNotExistsWeekendLeave = !Model.Any(t => t.IsWeekendLeave);
}
<table class="table table-custom table-leave-discipline">
    <thead>
        <tr>
            <th rowspan="2">@Labels.Date</th>
            <th rowspan="2">@Labels.LeaveType</th>
            <th rowspan="2">@Labels.HalfDay</th>
            <th rowspan="2">@Labels.FromTime</th>
            <th rowspan="2">@Labels.ToTime</th>
            @if (isNotExistsWeekendLeave)
            {
                <th colspan="2">@Labels.Violation</th>
            }
            else
            {
                <th colspan="2">@Labels.Violation1</th>
                <th colspan="2">@Labels.Violation2</th>
            }
        </tr>
        <tr>
            <th>@Labels.Type</th>
            <th>@Labels.Waive <br /><input class="chk-ignoreAll" type="radio" /></th>
            @if (!isNotExistsWeekendLeave)
            {
                <th>@Labels.Type</th>
                <th>@Labels.Waive <br /><input class="chk-weekend-ignoreAll" type="radio" /></th>
            }

        </tr>
    </thead>
    <tbody>
        @foreach (LeaveDisciplineModel item in Model)
        {
            var rowspan = item.LeaveDetail.Count();
            if (rowspan == 0)
            {
                rowspan = 1;
            }
            <tr>
                <td rowspan="@rowspan">
                    @(item.WorkDate.ToDateMonthYearFormatedDate() + " (" + item.WorkDate.ToString("ddd") + ")")
                    <br />
                    <span class="shift-info">
                        @item.ScheduleStatus
                    </span>
                </td>

                @if (item.LeaveDetail.Count() > 0 && !item.IsOffDayOrHoliday)
                {
                    var leaveDetail = item.LeaveDetail[0];
                    <td>
                        @if (leaveDetail.LeaveTypeId == 0) // general leave
                        {
                            <span>-</span>
                        }
                        else
                        {
                            @leaveDetail.LeaveTypeName
                        }
                    </td>
                    <td>
                        @if (leaveDetail.LeaveTypeId == 0)
                        {
                            <span>-</span>
                        }
                        else
                        {
                            @Html.CheckBoxFor(m => leaveDetail.IsHalfDay, new { @disabled = "disabled" })
                        }
                    </td>
                    <td>
                        @if (leaveDetail.IsHalfDay)
                        {
                            <div>
                                @leaveDetail.FromTime.ToShortTime()
                                @if (leaveDetail.IsFromAfterday)
                                {
                                    <span>*</span>
                                }
                            </div>
                        }
                    </td>
                    <td>
                        @if (leaveDetail.IsHalfDay)
                        {
                            <div>
                                @leaveDetail.ToTime.ToShortTime()
                                @if (leaveDetail.IsToAfterday)
                                {
                                    <span>*</span>
                                }
                            </div>
                        }
                    </td>
                    <td rowspan="@rowspan" class="td-type">
                        <span class="violation-type">
                            @item.DisciplineTypeName
                        </span>
                    </td>
                    <td rowspan="@rowspan" class="td-active">
                        @if (item.IsUnpaidLeaveAbsent || item.IsAbsent || item.IsUnplannedLeave || item.IsUnpaidLeave || item.IsSevenDaysLeave)
                        {
                            <input class="chk-ignore" type="radio" 
                                   data-workdate="@item.WorkDate.Date.ToString("d")"
                                   data-disciplinetypeid="@item.DisciplineTypeId" />
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                    if (!isNotExistsWeekendLeave)
                    {
                        <td rowspan="@rowspan" class="td-type">
                            @if (item.IsWeekendLeave)
                            {
                                <span class="violation-type">
                                    @Labels.WeekendLeave
                                </span>
                            }
                            else
                            {
                                <span>-</span>
                            }

                        </td>
                        <td rowspan="@rowspan" class="td-active">
                            @if (item.IsWeekendLeave)
                            {
                                <input class="chk-weekend-ignore" type="radio" data-workdate="@item.WorkDate.Date.ToString("d")" />
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                    }
                }
                else
                {
                    <td>-</td>
                    <td>-</td>
                    <td>-</td>
                    <td>-</td>
                    <td class="td-type">-</td>
                    <td>-</td>
                    <td>-</td>
                    if (!isNotExistsWeekendLeave)
                    {
                        <td class="td-type">-</td>
                        <td>-</td>
                        <td>-</td>
                    }
                }

            </tr>
            if (rowspan == 2)
            {
                var leaveDetail2 = item.LeaveDetail[1];
                <tr>
                    <td>
                        @if (leaveDetail2.LeaveTypeId == 0) // general leave
                        {
                            <span>-</span>
                        }
                        else
                        {
                            @leaveDetail2.LeaveTypeName
                        }
                    </td>
                    <td>
                        @if (leaveDetail2.LeaveTypeId == 0)
                        {
                            <span>-</span>
                        }
                        else
                        {
                            @Html.CheckBoxFor(m => leaveDetail2.IsHalfDay, new { @disabled = "disabled" })
                        }
                    </td>
                    <td>
                        @if (leaveDetail2.IsHalfDay)
                        {
                            <div>
                                @leaveDetail2.FromTime.ToShortTime()
                                @if (leaveDetail2.IsFromAfterday)
                                {
                                    <span>*</span>
                                }
                            </div>
                        }
                    </td>
                    <td>
                        @if (leaveDetail2.IsHalfDay)
                        {
                            <div>
                                @leaveDetail2.ToTime.ToShortTime()
                                @if (leaveDetail2.IsToAfterday)
                                {
                                    <span>*</span>
                                }
                            </div>
                        }
                    </td>
                </tr>
            }

        }
    </tbody>
</table>
