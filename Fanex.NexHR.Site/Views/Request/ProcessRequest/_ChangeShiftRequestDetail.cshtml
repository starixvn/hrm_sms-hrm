@using Fanex.NexHR.Core
@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Resources
@using Fanex.NexHR.Models.Request.ChangeShift
@model List<ChangeShiftDetail>

<table class="table table-custom">
    <thead>
        <tr>
            <th>@Labels.Date</th>
            <th>@Labels.Schedule</th>
            <th>@Labels.ChangeTo</th>
            <th>@Labels.Remark</th>
            <th>@Labels.ViolationIgnored</th>
            <th>@Labels.ViolationRecorded</th>
        </tr>
    </thead>
    <tbody>
        @foreach (ChangeShiftDetail item in Model)
        {
            var scheduleStatus = item.FromShiftId.Equals(-1) ? Labels.Off : item.FromShift;
            var disciplineTypeId = (int)DisciplineType.ChangeShift;
            <tr>
                <td>@item.OnDate.ToDayOfWeekFormatedDate()</td>
                <td>@scheduleStatus</td>
                @if (scheduleStatus == null || scheduleStatus.Equals(Labels.NA))
                {
                    <td>-</td>
                    <td>-</td>
                }
                else
                {
                    <td>
                        @(item.ToShiftId.Equals(-1) ? Labels.Off : item.ToShift)
                    </td>
                    if (!string.IsNullOrWhiteSpace(item.Remark))
                    {
                        <td>
                            <span class="fa fa-comment tooltip-tipsy" title="@item.Remark"></span>
                        </td>
                    }
                    else
                    {
                        <td>-</td>
                    }
                }
                <td class="violationIgnored">
                    <input type="radio" class="chk-ignore"
                           data-workdate="@item.OnDate.Date.ToString("d")" data-disciplinetypeid="@disciplineTypeId" />
                </td>
                <td class="violationRecorded">
                    <input type="radio" class="chk-record" />
                </td>
            </tr>
        }
    </tbody>
</table>
