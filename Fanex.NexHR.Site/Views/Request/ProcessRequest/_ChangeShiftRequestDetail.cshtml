@model IList<ChangeShiftDetailModel>
@if (Model != null && Model.Any())
{
    <table class="table table-custom">
        <thead>
            <tr>
                <th>@Labels.Date</th>
                <th>@Labels.ScheduleStatus</th>
                <th>@Labels.ChangeTo</th>
                <th>@Labels.Remark</th>
                <th>@Labels.Ignored</th>
                <th>@Labels.Confirmed</th>
            </tr>
        </thead>
        <tbody>
            @foreach (ChangeShiftDetailModel item in Model)
            {
                var scheduleStatus = item.FromShiftId.Equals(-1) ? Labels.Off : item.FromShift;
                var disciplineTypeId = (int)DisciplineType.ChangeShift;
                <tr class='left'>
                    <td>@item.OnDate.ToDayOfWeekFormatedDate()</td>
                    <td>@scheduleStatus</td>
                    @if (scheduleStatus == null || scheduleStatus.Equals(Labels.NA))
                    {
                        <td>-</td>
                        <td>-</td>
                    }
                    else
                    {
                        <td>
                            @(item.ToShiftId.Equals(-1) ? Labels.Off : item.ToShift)
                        </td>
                        if (!string.IsNullOrWhiteSpace(item.Remark))
                        {
                            <td class="tooltip" title="@item.Remark">
                                <span class="icon remark" alt="remark"></span>
                            </td>
                        }
                        else
                        {
                            <td>-</td>
                        }
                    }
                    <td class="ignoredDiscipline">
                        <input type="checkbox" data-workdate="@item.OnDate.Date.ToString("d")" data-disciplinetypeid="@disciplineTypeId" />
                    </td>
                    <td class="confirmedDiscipline">
                        <input type="checkbox" />
                    </td>
                </tr>
            }
        </tbody>
    </table>
}