@model IList<ChangeShiftDetailViewModel>
@if (Model != null && Model.Any())
{
    <table class="tabledata">
        <thead>
            <tr>
                <th>@Labels.Date</th>
                <th>@Labels.ScheduleStatus</th>
                <th>@Labels.ChangeTo</th>
                <th>@Labels.Remark</th>
                <th>@Labels.Ignored</th>
            </tr>
        </thead>
        <tbody>
            @foreach (ChangeShiftDetailViewModel item in Model)
            {
                <tr class='left'>
                    <td>@item.OnDate.ToDayOfWeekFormatedDate()</td>
                    <td>@item.ScheduleStatus</td>
                    @if (item.ScheduleStatus == null || item.ScheduleStatus.Equals(Labels.NA))
                    {
                        <td>-</td>
                        <td>-</td>
                    }
                    else
                    {
                        <td>
                            @Html.DropDownListFor(m => item.ToShiftId, new SelectList(ViewBag.Shifts, "Id", "Code", item.ToShiftId), new { @disabled = false })
                        </td>
                        if (!string.IsNullOrWhiteSpace(item.Remark))
                        {
                            <td class="tooltip" title="@item.Remark">
                                <span class="icon remark" alt="remark"></span>
                            </td>
                        }
                        else
                        {
                            <td>-</td>
                        }
                    }
                    <td class="ignoredDiscipline">
                        @{
                            var disciplineTypeId = (int)DisciplineType.ChangeShift;
                        }
                        <input type="checkbox" data-workdate="@item.OnDate" data-disciplinetypeid="@disciplineTypeId" />
                    </td>
                </tr>
            }
        </tbody>
    </table>
}