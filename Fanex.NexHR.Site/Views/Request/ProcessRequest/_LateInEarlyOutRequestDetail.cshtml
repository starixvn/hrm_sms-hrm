@model IList<RequestEntity>

<table class="data">
    <thead>
        <tr>
            <th>@Labels.Date</th>
            <th>@Labels.Shift</th>
            <th>@Labels.Request</th>
            <th>@Labels.Time</th>
            <th>@Labels.CreatedDate</th>
            <th>@Labels.Remark</th>
            <th>@Labels.Ignored</th>
        </tr>
    </thead>

    @if (Model != null && Model.Any())
    {
        <tbody>
            @foreach (RequestEntity request in Model)
            {
                <tr id="row@(request.Id)">
                    <td class="ddMMyyyy highlight">@request.FromDate.ToDateMonthYearFormatedDate()</td>
                    <td>@request.FromShift.Name</td>
                    <td class="highlight">@request.RequestType.ToString()</td>
                    <td class="highlight">@RazorHelper.LateInEarlyOutTimeFormat(request.TotalMins, request.RequestType.Id)</td>
                    <td class="ddMMyyyyhhmm">@request.CreatedDate.ToShortFormatedDate()</td>
                    @if (!string.IsNullOrWhiteSpace(request.Remark))
                    {
                        <td class="tooltip" title="@request.Remark">
                            <span class="icon remark" alt="remark"></span>
                        </td>
                    }
                    else
                    {
                        <td>-</td>
                    }
                    <td>
                        @{
                            var disciplineTypeId = request.RequestType.Id == (int) RequestType.LateIn ? (int) DisciplineType.LateIn : (int) DisciplineType.EarlyOut;
                        }
                        <input type="checkbox" data-workdate="@request.FromDate.ToDateMonthYearFormatedDate()"
                               data-disciplineTypeId="@disciplineTypeId"/>
                    </td>
                </tr>
            }
        </tbody>
    }
    else
    {
        @RazorHelper.DisplayNoInformation(colspan: 8);
    }
</table>