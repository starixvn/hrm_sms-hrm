@using Fanex.NexHR.Resources
@using Fanex.NexHR.Models.HospitalizationLeave
@model HospitalizationLeaveTransaction
@{
    ViewBag.Title = "Edit " + Model.Nickname + "'s sick leave balance";
}
@section css{
    <link href="~/wwwroot/dist/styles/annual.leavebalance.employee.create.edit.css" rel="stylesheet" />
}
@section js{
    <script src="~/wwwroot/dist/js/annual.leavebalance.employee.create.edit.js"></script>
}
@section Breadcrumb
{
    <a class="step" href="javascript:;">@Labels.HRSpace</a>
    <a class="step" href="@Url.Action("index", "SickLeaveBalance")">@Labels.SickLeaveBalance</a>
    <a class="step" href="~/SickLeaveBalance/employee/@Model.EmpId">@Model.Nickname's sick leave balance</a>
    <span class="step">@Labels.Edit</span>
}
<h2 class="page-title">@Labels.Edit</h2>

@using (Html.BeginForm())
{
    <div class="card form-horizontal">
        @Html.ValidationSummary(true)

        @if (ViewBag.Updated != null && (bool)ViewBag.Updated)
        {
            <div class="success">@Messages.UpdatedSuccessfully</div>
        }
        
        @Html.HiddenFor(model => model.EmpId)
        @Html.HiddenFor(model => model.TransId)
        <div class="form-group">
            <div class="label-form">
                @Html.LabelFor(model => model.TotalDays, new { @class = "control-label" })
            </div>
            <div class="input-form">
                @Html.TextBoxFor(model => model.TotalDays, new { @class = "form-control", autocomplete = "off" })
            </div>
            @Html.ValidationMessageFor(model => model.TotalDays)
        </div>

        <div class="form-group">
            <div class="label-form">
                @Html.LabelFor(model => model.Description, new { @class = "control-label" })
            </div>
            <div class="input-form">
                @Html.TextAreaFor(model => model.Description, new { @class = "form-control" })
            </div>
            @Html.ValidationMessageFor(model => model.Description)
        </div>

        <div class="form-group">
            <div class="label-form">
                @Html.LabelFor(model => model.AffectedFrom, new { @class = "control-label" })
            </div>
            <div class="calendar-form">
                @Html.TextBox(Html.NameFor(model => model.AffectedFrom).ToString(), Model.AffectedFrom.ToDateMonthYearFormatedDate(),
                    new { @class = "datepicker form-control", mindate = (new DateTime(2010, 1, 1)).ToString("yyyy/MM/dd") })
                <i class="icon-calendar fa fa-calendar"></i>
            </div>
            @Html.ValidationMessageFor(model => model.AffectedFrom)
        </div>

        <div class="form-group">
            <div class="label-form">
            </div>
            <div class="input-form">
                <button type="submit" name="command" class="btn btn-primary">@Labels.Update</button>
                <input class="btn btn-default delete" type="submit" value="@Labels.Delete" name="command" />
            </div>
        </div>
    </div>
}