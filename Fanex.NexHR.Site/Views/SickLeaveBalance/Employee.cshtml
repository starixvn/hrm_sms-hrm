@using Fanex.NexHR.Core
@using Fanex.NexHR.Models.HospitalizationLeave
@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels.HospitalizationLeave
@model HospitalizationLeaveTransactionViewModel
@{
    ViewBag.Title = Model.Nickname + "'s sick leave balance";
}
@section css{
    <link href="~/wwwroot/dist/styles/annual.leavebalance.employee.css" rel="stylesheet" />
}
@section Breadcrumb
{
    <a class="step" href="javascript:;">@Labels.HRSpace</a>
    <a class="step" href="@Url.Action("index", "SickLeaveBalance")">@Labels.SickLeaveBalance</a>
    <span class="step">@Model.Nickname's sick leave balance</span>
}
<h2 class="page-title">@ViewBag.Title</h2>
<div class="filter">
    @using (Html.BeginForm())
    {
        <div class="form-horizontal clearfix">
            <div class="form-group year">
                <div class="label-form">
                    @Html.LabelFor(model => model.Year, new { @class = "control-label" })
                </div>
                <div class="select-form">
                    @Html.YearPickerFor(model => model.Year, 2010)
                </div>
            </div>

            <div class="form-group form-group--m" style="margin-top: 10px;">
                <input type="checkbox" class="checkbox-custom" id="IncludedRequestTrans" name="IncludedRequestTrans"
                       value="true" checked="@(Model.IncludedRequestTrans ? true : false)" />
                @Html.LabelFor(model => model.IncludedRequestTrans, new { @for = "IncludedRequestTrans" })
                @Html.HiddenFor(model => model.EmployeeId)
            </div>
            <div class="form-group form-group--m">
                <button type="submit" class="btn btn-primary">@Labels.Submit</button>
                <a href="@Url.Action("create", "SickLeaveBalance", new { id = Model.EmployeeId })" class="btn btn-request">
                    <span class="fa fa-plus"></span>
                    @Labels.Adjustment
                </a>
            </div>
        </div>
    }
</div>
<div class="clear"></div>
<table class="table table-custom">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th>@Labels.AffectFrom</th>
            <th>@Labels.TotalDays</th>
            <th>@Labels.Description</th>
            <th>@Labels.ModifiedDate</th>
            <th>@Labels.Edit</th>
        </tr>
    </thead>
    @if (Model.Transactions.Any())
    {
        <tbody>
            @{int index = 1;}
            @foreach (HospitalizationLeaveTransaction item in Model.Transactions)
            {
                <tr>
                    <td>@(index++)</td>
                    <td class="ddMMyyyy">@item.AffectedFrom.ToDateMonthYearFormatedDate()</td>
                    <td>@item.TotalDays</td>
                    <td class="align-left">
                        @if (item.RequestId != null)
                        {
                            <span>[request]</span>
                        }
                        @item.Description
                    </td>
                    <td>@item.ModifiedDate.ToShortFormatedDate()</td>
                    @if (item.RequestId == null)
                    {
                        <td>
                            <a href="~/SickLeaveBalance/edit/@item.TransId">@Labels.Edit</a>
                        </td>
                    }
                    else
                    {
                        <td>-</td>
                    }
                </tr>
            }
        </tbody>

    }
    else
    {
        @RazorHelper.DisplayNoInformation(6)
    }
</table>