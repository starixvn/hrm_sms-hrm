@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Access Denied</title>
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
    <link href="https://fonts.googleapis.com/css?family=Open+Sans" rel="stylesheet">
    <link href="~/wwwroot/dist/styles/error.css" rel="stylesheet" />
</head>
<body>
    <div class="page-error page-error-405">
        <div class="page-content vertical-align-middle">
            <div class="img-block">
                <img class="door" src="~/wwwroot/sources/styles/images/405/door.svg" alt="door.svg" />
                <div class="seal-slideshow">
                    <div class="mover-1"></div>
                </div>

                <img class="signage" src="~/wwwroot/sources/styles/images/405/signage.svg" alt="signage.svg" />
            </div>
            <p class="error-advise">Oops. 405, ACCESS DENIED</p>
            <p class="small-text">
                Sorry about that, but you don't have permission to access this page.
            </p>
            <a class="cta" href="@Url.Action("index", "home")">
                <span class="icon-back"></span>Take me back to the dashboard
            </a>
        </div>
    </div>
</body>
</html>