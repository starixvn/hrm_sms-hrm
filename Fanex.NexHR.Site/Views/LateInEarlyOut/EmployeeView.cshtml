@using Fanex.NexHR.Models.Request
@model IList<LateInEarlyOutModel>
@{
    ViewBag.Title = Labels.MyLateInEarlyOutRequest;
}
@section css{
    @Url.CombresLink("myrequestcss")
}
@section js{
    @Url.CombresLink("empcheckinoutjs")
}
@section Breadcrumb {
    <a class="step">@Labels.Personal</a><a class="step">@ViewBag.Title</a>
}
<h2>@ViewBag.Title</h2>
@using (Html.BeginForm())
{
    <input type="hidden" value="LateInEarlyOut" id="RequestType" />

    <div class="container_24 bunhat">
        <div class="grid_1 gridlabel">
            <label for="Year">@Labels.Year</label>
        </div>
        <div class="grid_2">
            @Html.YearPicker("Year", 2010, (int)ViewBag.Year)
        </div>
        <div class="grid_2">
            <input type="submit" id="submit" value="@Labels.Submit" class="button-primary submit processing-submit" />
        </div>
        <div class="grid_5">
            <div class="button-icon">
                <span class="icon plus"></span>@Html.ActionLink(Labels.LateInEarlyOutRequest, "Create")
            </div>
        </div>
    </div>

    <div class="clear">
    </div>

    <table class="table table-custom">
        <thead>
            <tr>
                <th>@Labels.SymbolCount</th>
                <th>@Labels.Request</th>
                <th>@Labels.Time</th>
                <th>@Labels.ActualTime</th>
                <th>@Labels.RequestDate</th>
                <th>@Labels.Shift</th>
                <th>@Labels.Reason</th>
                <th>@Labels.CreatedDate</th>
                <th>@Labels.Remark</th>
                <th>@Labels.Status</th>
                <th>@Labels.History</th>
            </tr>
        </thead>
        @if (Model != null && Model.Any())
        {
            int index = 1;
            <tbody>
                @foreach (LateInEarlyOutModel request in Model)
                {
                    var totalMins = request.RequestTypeId == (int)RequestType.LateIn ? request.LateInMins : request.EarlyOutMins;

                <tr id="row@(request.RequestId)">
                    <td>
                        @(index++)
                    </td>
                    <td>
                        @request.RequestTypeName
                    </td>
                    <td>
                        @RazorHelper.LateInEarlyOutTimeFormat(totalMins, (short)request.RequestTypeId)
                    </td>
                    <td>
                        @if (request.ActualLateInEarlyOut == 0)
                        {
                            <span>N/A</span>
                        }
                        else
                        {
                            @RazorHelper.LateInEarlyOutTimeFormat(request.ActualLateInEarlyOut, (short)request.RequestTypeId);
                        }
                    </td>
                    <td class="ddMMyyyyhhmm">
                        @request.OnDate.ToDateMonthYearFormatedDate()
                    </td>
                    <td>
                        @request.ShiftName
                    </td>
                    <td>@request.ReasonName</td>
                    <td class="ddMMyyyyhhmm">
                        @request.CreatedDate.ToShortFormatedDate()
                    </td>
                    @if (!string.IsNullOrWhiteSpace(request.Remark))
                    {
                        <td class="tooltip" title="@request.Remark">
                            <span class="icon remark" />
                        </td>
                    }
                    else
                    {
                        <td>
                            -
                        </td>
                    }

                    @RazorHelper.RenderRequestStatus(request)
                    <td>
                        <a class="viewhistory" href="javascript:;" id="/lateinearlyout/viewhistory?id=@request.RequestId">
                            @Labels.View
                        </a>
                    </td>
                </tr>
                }
            </tbody>
        }
        else
        {
            @RazorHelper.DisplayNoInformation(colspan: 12);
        }
    </table>
}
@RazorHelper.EmployeeProcessMenu()
<div id="dialoghistorycontent" />