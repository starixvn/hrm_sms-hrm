@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels.Request
@model LateInEarlyOutRequestViewModel
@{
    ViewBag.Title = @Labels.Edit;
    var isTopManager = (bool)ViewBag.IsTopManager;
    var today = DateTime.Today;
}
@section css{
    <link href="~/wwwroot/dist/styles/lateinearlyout.create.css" rel="stylesheet" />
}
@section js{
    <script src="~/wwwroot/dist/js/lateinearlyout.edit.js"></script>
}
@section Breadcrumb {
    <a class="step">@Labels.Personal</a>
    <a class="step" href="@Url.Action("employeeview", "lateinearlyout", new { })">@Labels.MyLateInEarlyOutRequest</a>
    <a class="step">@ViewBag.Title</a>
}
<h2 class="page-title">@Labels.Edit</h2>
<div class="card">
    <input type="checkbox" id="IsTopManager" hidden @(isTopManager ? "checked" : string.Empty) />
    @using (Html.BeginForm("Edit", "lateinearlyout", FormMethod.Post, new { @class = "form-horizontal" }))
    {
        @Html.ValidationSummary()
        <div class="validation-summary-errors" style="display: none;"></div>
        @Html.HiddenFor(model => model.Employee)
        @Html.HiddenFor(model => model.EmployeeId)
        @Html.HiddenFor(model => model.RequestType)
        @Html.HiddenFor(model => model.RequestId)
        <div class="form-group">
            <div class="label-form">@Labels.RequestCode</div>
            <div class="input-form"><strong>Rq.@Model.RequestId</strong></div>
        </div>
        <div class="form-group">
            <div class="label-form">
                @Html.LabelFor(model => model.RequestType, new { @class = "control-label" })
            </div>
            <div class="input-form">
                <strong>@(Model.RequestType == (byte)RequestType.LateIn ? Labels.LateIn : Labels.EarlyOut)</strong>
            </div>
        </div>
        <div class="form-group">
            <div class="label-form">
                @Html.LabelFor(model => model.Employee, new { @class = "control-label" })
            </div>
            <div class="input-form">
                <strong>@Html.DisplayFor(model => model.Employee)</strong>
            </div>
        </div>
        <div class="form-group">
            <div class="label-form">
                @Html.LabelFor(model => model.OnDate, new { @class = "control-label" })
            </div>
            <div class="calendar-form">
                @Html.TextBox("OnDate", Model.OnDate.ToDateMonthYearFormatedDate(),
                    new {
                        @class = "datepicker form-control",
                        mindate = Model.OnDate.AddMonths(-1).ToString("yyyy/MM/dd"),
                        maxdate = today.ToString("yyyy/MM/dd"),
                        disabledDate = string.Join(",", Model.DisabledDates.Select(x => x.ToString("yyyy/MM/dd")))
                    })
                <i class="icon-calendar fa fa-calendar"></i>
            </div>
            <div>
                <span id="actualLateIn"> ※ Actual Late In: <strong id="lateInHours">N/A</strong></span>
                <span id="actualEarlyOut"> ※ Actual Early Out: <strong id="earlyOutHours">N/A</strong></span>
            </div>
        </div>
        <div class="form-group">
            <div class="label-form">
                @Html.LabelFor(model => model.Minute, new { @class = "control-label" })
            </div>
            <div class="input-form">
                @Html.TextBoxFor(model => model.Minute, new { @class = "form-control", @type = "number", @min = 1, @max = 60, @step = 1 })
            </div>
        </div>
        <div class="form-group">
            <div class="label-form">@Labels.Reason</div>
            <div class="select-form">
                @RazorHelper.LateInEarlyOutReasonDropDownList(Model.ReasonId, htmlClass: "form-control")
            </div>
        </div>
        <div class="form-group">
            <div class="label-form">
                @Html.LabelFor(model => model.VerifierId, new { @class = "control-label" })
            </div>
            <div class="select-form">
                @Html.DropDownListFor(x => x.VerifierId, new SelectList(Model.Verifiers, "OwnerId", "DisplayName"), new { @class = "form-control" })
            </div>
        </div>
        <div class="form-group">
            <div class="label-form">
                @Html.LabelFor(model => model.ApproverId, new { @class = "control-label" })
            </div>
            <div class="select-form">
                @Html.DropDownListFor(x => x.ApproverId, new SelectList(Model.Approvers, "OwnerId", "DisplayName"), new { @class = "form-control" })
            </div>
        </div>
        <div class="form-group">
            <div class="label-form">
                @Html.LabelFor(model => model.Remark, new { @class = "control-label" })
            </div>
            <div class="input-form">
                @Html.TextAreaFor(model => model.Remark, new { @class = "form-control" })
            </div>
        </div>
        <div class="form-group">
            <div class="label-form">
                @Html.LabelFor(model => model.Files, Labels.UploadFile, new { @class = "control-label" })
            </div>
            <div class="left input--m" id="upload">
                <input type="file" id="file" name="file" size="55" multiple />
            </div>
        </div>
        <div class="form-group">
            <div class="label-form">
            </div>
            <div class="input-form" id="@Model.RequestId">
                @if (Model.Files != null)
                {
                    foreach (string file in Model.Files)
                    {
                        <a href="javascript:;" class="delete-file" id="@file" data-id="@file">
                            <i class=" fa fa-close">@file</i><br>
                        </a>
                    }
                }
            </div>
        </div>
        <div class="form-group">
            <div class="label-form"></div>
            <div>
                <button type="button" class="btn btn-primary" id="btnSubmit">@Labels.Update</button>
                <button type="button" class="btn btn-default" onclick="window.history.back()">@Labels.Back</button>
            </div>
        </div>
    }
</div>
