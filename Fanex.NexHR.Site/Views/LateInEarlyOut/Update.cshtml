@using Fanex.NexHR.ViewModels.Request
@model LateInEarlyOutRequestViewModel
@using System.Web.Mvc.Html5;
@{
    ViewBag.Title = "Update My Late In Early Out Request";
}
@section css{
    @Url.CombresLink("lateinearlyoutcss")
}
@section js{
    @Url.CombresLink("lateinearlyoutjs")
}
@section Breadcrumb {
    <a class="step">Personal</a> <a class="step" href="@Url.Action("employeeview", "lateinearlyout")">@Labels.MyLateInEarlyOutRequest</a>
    <a class="step">@ViewBag.Title</a>
}
<h2>@Labels.Edit</h2>
<div class="bunhat">
    @{ Html.EnableClientValidation(false); }
    @using (Html.BeginForm())
    {
        @Html.ValidationSummary()

        if (ViewBag.Updated != null && (bool)ViewBag.Updated)
        {
        <div class="success">@Messages.RequestUpdated</div> 
        <input type="hidden" id="successed" value="true" />
        <input type="hidden" id="year" value="@ViewBag.Year" />
        }
        
        <div id="model-state-error" class="ui-state-error ui-corner-all">
            @Labels.CannotCreateRequest
        </div>
        
        <div class="formrow">
            <div class="label">
                @Fanex.NexHR.Resources.Labels.RequestCode
            </div>
            <div class="input">
                <strong>Rq.@Model.RequestId</strong>
            </div>
        </div>
        
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.RequestType)
            </div>
            <div class="input">
                @(Model.RequestType == 3 ? "Late in" : "Early out")
            </div>
        </div>
        
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Employee)
            </div>
            <div class="input">
                @Html.DisplayFor(model => model.Employee)
            </div>
        </div>
        
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Date)
            </div>
            <div class="input">
                @Html.DatePickerFor(model => model.Date,
                new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(-1),
                new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(10).AddDays(-1),
                unavailDates: (IEnumerable<DateTime>)ViewBag.UnavailDates)
            </div>
        </div>
        
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Minute)
            </div>
            <div class="input">
                @Html.TextBoxFor(model => model.Minute)
            </div>
        </div>
        
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Verifier)*
            </div>
            <div class="input">
                @Html.DropDownListFor(x => x.VerifierId, Model.Verifier, new { @class = "dropdown" })
            </div>
        </div>
        
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Approver)*
            </div>
            <div class="input">
                @Html.DropDownListFor(x => x.ApproverId, Model.Approver, new { @class = "dropdown" })
            </div>
        </div>
        
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Remark)
            </div>
            <div class="input">
                @Html.TextAreaFor(model => model.Remark)
            </div>
            <div class="clear">
            </div>
        </div>
        
        <div class="formrow">
            <div class="label">
                @Html.HiddenFor(model => model.Employee)
                @Html.HiddenFor(model => model.EmployeeId)
                @Html.HiddenFor(model => model.RequestType)
				@Html.HiddenFor(model => model.RequestId)
            </div>
            <div class="input">
                <input type="submit" value="@Labels.Update"/>
                <a href="javascript:;" class="button" id="backPrevious">@Labels.Back</a>
            </div>
        </div>
    }
</div>
