@using Fanex.NexHR.ViewModels.Request
@model LateInEarlyOutRequestViewModel
@using System.Web.Mvc.Html5;
@{
    ViewBag.Title = @Labels.UpdateMyLateInEarlyOutRequest;
}
@section css{
    @Url.CombresLink("lateinearlyoutcss")
}
@section js{
    @Url.CombresLink("lateinearlyoutjs")
}
@section Breadcrumb {
    <a class="step">Personal</a> <a class="step" href="@Url.Action("employeeview", "lateinearlyout")">@Labels.MyLateInEarlyOutRequest</a>
    <a class="step">@ViewBag.Title</a>
}
<h2>@Labels.Edit</h2>
<div class="bunhat">
    @using (Html.BeginForm())
    {
        @Html.ValidationSummary()

        if (ViewBag.Updated != null && (bool)ViewBag.Updated)
        {
        <div class="success">@Messages.RequestUpdated</div> 
        <input type="hidden" id="successed" value="true" />
        <input type="hidden" id="year" value="@Model.OnDate.Year" />
        }
        
        <div id="model-state-error" class="ui-state-error ui-corner-all">
            @Labels.CannotCreateRequest
        </div>
        
        <div class="formrow">
            <div class="label">
                @Labels.RequestCode
            </div>
            <div class="input">
                <strong>Rq.@Model.RequestId</strong>
            </div>
        </div>
        
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.RequestType)
            </div>
            <div class="input">
                @(Model.RequestType == (int)RequestType.LateIn ? Labels.LateIn : Labels.EarlyOut)
            </div>
        </div>
        
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Employee)
            </div>
            <div class="input">
                @Html.DisplayFor(model => model.Employee)
            </div>
        </div>
        
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.OnDate)
            </div>
            <div class="input">
                @Html.DatePickerFor(model => model.OnDate,
                new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(-1),
                new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(10).AddDays(-1))

                <span id="lateIn"> ※ Actual Late In: <span id="lateInHours">N/A</span></span>
                <span id="earlyOut"> ※ Actual Early Out: <span id="earlyOutHours">N/A</span></span>
            </div>
        </div>
        
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Minute)
            </div>
            <div class="input">
                @Html.TextBoxFor(model => model.Minute)
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Labels.Reason
            </div>
            <div class="input">
                @RazorHelper.LateInEarlyOutReasonDropDownList(Model.ReasonId)
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.VerifierId)
            </div>
            <div class="input">
                @Html.DropDownListFor(x => x.VerifierId, new SelectList(Model.VerifierAndApprover.Verifiers, "OwnerId", "DisplayName"), new { @class = "dropdown" })
            </div>
        </div>
        
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.ApproverId)
            </div>
            <div class="input">
                @Html.DropDownListFor(x => x.ApproverId, new SelectList(Model.VerifierAndApprover.Approvers, "OwnerId", "DisplayName"), new { @class = "dropdown" })
            </div>
        </div>
        
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Remark)
            </div>
            <div class="input">
                @Html.TextAreaFor(model => model.Remark)
            </div>
            <div class="clear">
            </div>
        </div>
        
        <div class="formrow">
            <div class="label">
                @Html.HiddenFor(model => model.Employee)
                @Html.HiddenFor(model => model.EmployeeId)
                @Html.HiddenFor(model => model.RequestType)
				@Html.HiddenFor(model => model.RequestId)
            </div>
            <div class="input">
                <input type="submit" value="@Labels.Update"/>
                <a href="javascript:;" class="button" id="backPrevious">@Labels.Back</a>
            </div>
        </div>
    }
</div>
