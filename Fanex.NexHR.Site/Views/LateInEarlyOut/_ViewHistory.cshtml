@using Fanex.NexHR.Core
@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Resources
@using Fanex.NexHR.Models.Request
@model IList<LateInEarlyOutRequest>
<table class="table table-custom">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th>@Labels.Team</th>
            <th>@Labels.Employee</th>
            <th>@Labels.Request</th>
            <th>@Labels.Time</th>
            <th>@Labels.ActualTime</th>
            <th>@Labels.Date</th>
            <th>@Labels.Shift</th>
            <th>@Labels.Reason</th>
            <th>@Labels.Remark</th>
            <th>@Labels.VerifiedBy</th>
            <th>@Labels.ApprovedBy</th>
            <th>@Labels.Status</th>
            <th>@Labels.LogDate</th>
        </tr>
    </thead>
    @if (Model != null && Model.Any())
    {
        int index = 1;
        <tbody>
            @foreach (LateInEarlyOutRequest request in Model)
            {
                var totalMins = request.RequestTypeId == (int)RequestType.LateIn ? request.LateInMins : request.EarlyOutMins;
                <tr>
                    <td>@(index++)</td>
                    <td>
                        <span class="tooltip-tipsy" title="@request.Employee.Team.Name">@request.Employee.Team.Code</span>
                    </td>
                    <td>
                        <span class="tooltip-tipsy" title="@request.Employee.FullName">@request.Employee.NickName</span>
                    </td>
                    <td>@request.RequestTypeName</td>
                    <td>
                        @RazorHelper.LateInEarlyOutTimeFormat(totalMins, (short)request.RequestTypeId)
                    </td>
                    <td>
                        @if (request.ActualLateInEarlyOut == 0)
                        {
                            <span>N/A</span>
                        }
                        else
                        {
                            @RazorHelper.LateInEarlyOutTimeFormat(request.ActualLateInEarlyOut, (short)request.RequestTypeId);
                        }
                    </td>
                    <td>@request.OnDate.ToDateMonthYearFormatedDate()</td>
                    <td>@request.ShiftName</td>
                    <td>@request.ReasonName</td>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(request.Remark))
                        {
                            <span class="fa fa-comment tooltip-tipsy" title="@request.Remark"></span>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                    <td>
                        @if (request.VerifiedBy != null)
                        {
                            @request.VerifiedBy.NickName
                        }
                    </td>
                    <td>
                        @if (request.ApprovedBy != null)
                        {
                            @request.ApprovedBy.NickName
                        }
                    </td>
                    <td>@request.Status.ToString()</td>
                    <td>@request.InsertedDate.ToShortFormatedDate()</td>
                </tr>
            }
        </tbody>
    }
    else
    {
        @RazorHelper.DisplayNoInformation(colspan: 14);
    }
</table>