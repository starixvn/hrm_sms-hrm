@using Fanex.NexHR.Core
@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Resources
@using Fanex.NexHR.Models.Request
@model IList<LateInEarlyOutRequest>
    <table class="table table-custom">
        <thead>
            <tr>
                <th>@Labels.SymbolCount</th>
                <th>@Labels.Team</th>
                <th>@Labels.Employee</th>
                <th>@Labels.Request</th>
                <th>@Labels.Time</th>
                <th>@Labels.ActualTime</th>
                <th>@Labels.Date</th>
                <th>@Labels.Shift</th>
                <th>@Labels.Reason</th>
                <th>@Labels.Remark</th>
                <th>@Labels.Verifier</th>
                <th>@Labels.Approver</th>
                <th>@Labels.Status</th>
                <th>@Labels.LogDate</th>
            </tr>
        </thead>
        @if (Model != null && Model.Any())
        {
            int index = 1;
            <tbody>
                @foreach (LateInEarlyOutRequest request in Model)
                {
                    var totalMins = request.RequestTypeId == (byte)RequestType.LateIn ? request.LateInMins : request.EarlyOutMins;
                    <tr>
                        <td>@(index++)</td>
                        <td>@request.Requester.Team</td>
                        <td>
                            <span class="tooltip-tipsy" title="@request.Requester.FullName">@request.Requester.Nickname</span>
                        </td>
                        <td>@request.RequestTypeName</td>
                        <td>
                            @RazorHelper.LateInEarlyOutTimeFormat(totalMins, (short)request.RequestTypeId)
                        </td>
                        <td>
                            @if (request.ActualLateInEarlyOut == 0)
                            {
                                <span>N/A</span>
                            }
                            else
                            {
                                @RazorHelper.LateInEarlyOutTimeFormat(request.ActualLateInEarlyOut, (short)request.RequestTypeId);
                            }
                        </td>
                        <td>@request.OnDate.ToDateMonthYearFormatedDate()</td>
                        <td>@request.ShiftName</td>
                        <td>@request.ReasonName</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(request.Remark))
                            {
                                <span class="fa fa-comment tooltip-tipsy" title="@request.Remark"></span>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                        <td>
                            @if (request.Verifier != null)
                            {
                                @request.Verifier.Nickname
                            }
                        </td>
                        <td>
                            @if (request.Approver != null)
                            {
                                @request.Approver.Nickname
                            }
                        </td>
                        <td>@request.Status.ToString()</td>
                        <td class="align-left">@string.Format(Messages.LogDate, @request.Modifier.Nickname, @request.InsertedDate.ToShortFormatedDate())</td>
                    </tr>
                }
            </tbody>
        }
        else
        {
            @RazorHelper.DisplayNoInformation(colspan: 14);
        }
    </table>
