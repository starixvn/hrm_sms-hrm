@model LateInEarlyOutRequestViewModel
@{
    ViewBag.Title = Labels.NewLateInEarlyOutRequest;
}
@section css{
    @Url.CombresLink("lateinearlyoutcss")
}
@section js{
    @Url.CombresLink("lateinearlyoutjs")
}
@section Breadcrumb {
    <a class="step">Personal</a> <a class="step" href="@Url.Action("employeeview", "lateinearlyout")">@Labels.MyLateInEarlyOutRequest</a>
    <a class="step">@ViewBag.Title</a>
}
<h2>@ViewBag.Title</h2>
<div class="bunhat">
    @using (Html.BeginForm())
    {
        @Html.ValidationSummary()

        if (ViewBag.Requested != null && (bool)ViewBag.Requested)
        {
            <div class="success">@Messages.RequestCreated</div>
            <input type="hidden" id="successed" value="true" />
            <input type="hidden" id="year" value="@ViewBag.Year" />
        }

        <div id="model-state-error" class="ui-state-error ui-corner-all">
            <p>@Labels.CannotCreateRequest</p>
        </div>

        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.RequestType)
            </div>
            <div class="input">
                @Html.RadioButtonList(model => model.RequestType, Utilities.LateInEarlyOutTypes)
                <div class="clear"></div>
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Employee)
            </div>
            <div class="input">
                @Html.EditorFor(model => model.Employee)
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.OnDate)
            </div>
            <div class="input">
                @Html.DatePickerFor(model => model.OnDate,
                new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(-1),
                new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(4).AddDays(-1))
                <span id="lateIn"> ※ Actual Late In: <span id="lateInHours">N/A</span></span>
                <span id="earlyOut"> ※ Actual Early Out: <span id="earlyOutHours">N/A</span></span>
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Minute)
            </div>
            <div class="input">
                @Html.TextBoxFor(model => model.Minute)
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Labels.Reason
            </div>
            <div class="input">
                @RazorHelper.LateInEarlyOutReasonDropDownList()
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.VerifierId)
            </div>
            <div class="input">
                @if (Model.VerifierAndApprover.Verifiers.Count() > 1)
                {
                    @Html.DropDownListFor(x => x.VerifierId, new SelectList(Model.VerifierAndApprover.Verifiers, "OwnerId", "DisplayName"), Labels.SelectVerifier, new { @class = "dropdown" })
                }
                else
                {
                    @Html.DropDownListFor(x => x.VerifierId, new SelectList(Model.VerifierAndApprover.Verifiers, "OwnerId", "DisplayName"), new { @class = "dropdown" })
                }
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.ApproverId)
            </div>
            <div class="input">
                @if (Model.VerifierAndApprover.Approvers.Count() > 1)
                {
                    @Html.DropDownListFor(x => x.ApproverId, new SelectList(Model.VerifierAndApprover.Approvers, "OwnerId", "DisplayName"), Labels.SelectApprover, new { @class = "dropdown" })
                }
                else
                {
                    @Html.DropDownListFor(x => x.ApproverId, new SelectList(Model.VerifierAndApprover.Approvers, "OwnerId", "DisplayName"), new { @class = "dropdown" })
                }
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Remark)
            </div>
            <div class="input">
                @Html.TextAreaFor(model => model.Remark)
            </div>
            <div class="clear">
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.HiddenFor(model => model.Employee)
                @Html.HiddenFor(model => model.EmployeeId)
                @Html.Hidden("RequestType", (int)RequestType.LateIn)
            </div>
            <div class="input">
                <input type="submit" value="@Labels.Request" />
                <a href="javascript:;"
                   class="button" id="backPrevious">@Labels.Back</a>
            </div>
        </div>
    }
</div>