@using Fanex.NexHR.Core
@using Fanex.NexHR.Resources
@using Fanex.NexHR.Models.Request.ChangeShift
@model IEnumerable<ChangeShiftRequest>

<table class="table table-custom">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th>@Labels.Team</th>
            <th>@Labels.Employee</th>
            <th>@Labels.FromDate</th>
            <th>@Labels.ToDate</th>
            <th>@Labels.CreatedDate</th>
            <th>@Labels.Remark</th>
            <th>@Labels.VerifiedBy</th>
            <th>@Labels.ApprovedBy</th>
            <th>@Labels.Status</th>
            <th>@Labels.LogDate</th>
        </tr>
    </thead>
    @if (Model != null && Model.Count() > 0)
    {
        <tbody>
            @{int index = 1;}
            @foreach (ChangeShiftRequest request in Model)
            {
            <tr id="row@(request.RequestId)">
                <td>@(index++)</td>
                <td class="tooltip" title="@request.Employee.Team.Name">
                    @request.Employee.Team.Code
                </td>
                <td class="tooltip" title="@request.Employee.FullName">
                    @request.Employee.NickName
                </td>
                <td>@request.FromDate.ToDateMonthYearFormatedDate()</td>
                <td>@request.ToDate.ToDateMonthYearFormatedDate()</td>
                <td>@request.CreatedDate.ToShortFormatedDate()</td>
                @if (!string.IsNullOrWhiteSpace(request.Remark))
                {
                    <td class="tooltip" title="@request.Remark">
                        <span class="icon remark" alt="remark"></span>
                    </td>
                }
                else
                {
                    <td>-</td>
                }
                <td>@request.VerifiedBy.NickName</td>
                <td>@request.ApprovedBy.NickName</td>
                <td>@request.Status.ToString()</td>
                <td>@request.InsertedDate.ToShortFormatedDate()</td>
            </tr>
            }
        </tbody>
    }
    else
    {
        @RazorHelper.DisplayNoInformation(colspan: 11);
    }
</table>