@using Fanex.NexHR.Resources
@using Fanex.NexHR.Core
@using Fanex.NexHR.Models.Request
@model IList<RequestEntity>
@{
    ViewBag.Title = Labels.MyChangeShiftRequest;
}
@section css{
    @Url.CombresLink("myrequestcss")
}
@section js{
    @Url.CombresLink("empchangeshiftjs")
}
@section Breadcrumb {
    <a class="step">@Labels.Personal</a> <a class="step">@ViewBag.Title</a>
}
<h2>@ViewBag.Title</h2>
@using (Html.BeginForm("employeeview", "changeshift", FormMethod.Get, new { @class = "form-horizontal" }))
{
    <div class="container_24 bunhat">
        <div class="grid_1 gridlabel">
            <label for="Year">@Labels.Year</label>
        </div>
        <div class="grid_2">
            @Html.YearPicker("Year", 2010, (int)ViewBag.Year)
        </div>
        <div class="grid_2">
            <input type="submit" id="btnSearch" class="button-primary button" value="@Labels.Submit" />
        </div>
        <div class="grid_5">
            <div class="button-icon">
                <span class="icon plus"></span>@Html.ActionLink(Labels.ChangeShiftRequest, "Create")
            </div>
        </div>
    </div>
}
<table class="table table-custom">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th>@Labels.RefNo1</th>
            <th>@Labels.FromDate</th>
            <th>@Labels.ToDate</th>
            <th>@Labels.CreatedDate</th>
            <th>@Labels.Remark</th>
            <th>@Labels.Status</th>
            <th>@Labels.History</th>
        </tr>
    </thead>
    @if (Model.Count > 0)
    {
        <tbody>
            @{int index = 1;}
            @foreach (RequestEntity request in Model)
            {
                <tr id="row@(request.Id)">
                    <td>@(index++)</td>
                    <td><a href="@Url.Action("details", "changeshift", new { id = request.Id })">@request.Id</a></td>
                    <td>@request.FromDate.ToDateMonthYearFormatedDate()</td>
                    <td>@request.ToDate.ToDateMonthYearFormatedDate()</td>
                    <td>@request.CreatedDate.ToShortFormatedDate()</td>
                    @if (!string.IsNullOrWhiteSpace(request.Remark))
                    {
                        <td class="tooltip" title="@request.Remark">
                            <span class="icon remark" alt="remark" />
                        </td>
                    }
                    else
                    {
                        <td>-</td>
                    }
                    @Html.Partial("_SharedRequestStatus", request)
                    <td>
                        <a class="viewhistory" href="javascript:;" requestid="@request.Id">@Labels.View</a>
                    </td>
                </tr>
            }
        </tbody>
    }
    else
    {
        @RazorHelper.DisplayNoInformation(colspan: 10);
    }
</table>
@RazorHelper.EmployeeProcessMenu()
<div id="dialoghistorycontent" />