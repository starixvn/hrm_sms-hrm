@using Fanex.NexHR.ViewModels.Request
@model ChangeShiftViewModel
@{
    ViewBag.Title = "View Detail Change Shift Request";
}
@section css{
    @Url.CombresLink("changeshiftcss")
}
@section js{
    @Url.CombresLink("changeshiftjs")
}
@section Breadcrumb {
    <a class="step">Personal</a>
    <a class="step" href="@Url.Action("employeeview", "changeshift")">@Labels.MyChangeShiftRequest</a>
    <a class="step">@ViewBag.Title</a>
}

<h2>@Labels.Details</h2>
<div class="bunhat">
<div class="model-state" id="errors-model-state">
</div>
    @using (Html.BeginForm())
    {
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Employee)
            </div>
            <div class="input">
                @Html.DisplayFor(model => model.Employee)
            </div>
        </div>
        
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.FromDate)
            </div>
            <div class="input">
                @Html.DatePickerFor(model => model.FromDate,
                new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(-1),
                new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(2).AddDays(-1),
             unavailDates: (IEnumerable<DateTime>)ViewBag.UnavailDates)
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.ToDate)
            </div>
            <div class="input">
                @Html.DatePickerFor(model => model.ToDate,
                new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(-1),
                new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(2).AddDays(-1),
             unavailDates: (IEnumerable<DateTime>)ViewBag.UnavailDates)
            </div>
        </div>
         <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Verifier)
            </div>
            <div class="input">
                @Html.DropDownListFor(x => x.VerifierId, Model.Verifier, new { @class = "dropdown" })
            </div>
        </div>
        
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Approver)
            </div>
            <div class="input">
                @Html.DropDownListFor(x => x.ApproverId, Model.Approver, new { @class = "dropdown" })
            </div>
        </div>
        
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Remark)
            </div>
            <div class="input">
                @Html.TextAreaFor(model => model.Remark)
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Status.Name, "Status")
            </div>
            <div class="input">
                @Html.DisplayFor(model => model.Status.Name)
            </div>
            <div class="clear">
            </div>
        </div>
         <div class="formrow" id="shiftDetailSchedule">
            @Html.Partial("ChangeShiftDetail", Model.ShiftDetails)
        </div>
        
        <div class="formrow">
            <div class="label">
                @Html.HiddenFor(model => model.EmployeeId)
                @Html.HiddenFor(model => model.RequestId)
                @Html.Hidden("RequestType", (int)RequestType.ChangeShift)
                @Html.Hidden("IsView", (bool)ViewBag.IsView)
            </div>
            <div class="input">
                <a href="javascript:;" class="button" id="backPrevious">@Labels.Back</a>
            </div>
        </div>
    }
</div>
