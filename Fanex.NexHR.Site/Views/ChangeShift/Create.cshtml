@using Fanex.NexHR.ViewModels.Request
@model ChangeShiftViewModel
@{
    ViewBag.Title = Labels.NewChangeShiftRequest;
}
@section css{
    @Url.CombresLink("changeshiftcss")
}
@section js{
    @Url.CombresLink("changeshiftjs")
}
@section Breadcrumb {
    <a class="step">Personal</a> <a class="step" href="@Url.Action("employeeview", "changeshift")">@Labels.MyChangeShiftRequest</a>
    <a class="step">@ViewBag.Title</a>
}
<h2>@ViewBag.Title</h2>
<div class="bunhat">
    @using (Html.BeginForm("Create", "ChangeShift", FormMethod.Post, new { id = "formShift" }))
    {
        @Html.ValidationSummary()
        <div class="validation-summary-errors" id="errors-model-state">
        </div>

        if (Model.TotalRequestInMonth >= 1)
        {
        <div class="ui-state-error ui-corner-all model-state">
            <p>
                <a href="@Url.Action("EmployeeView")">You've already requested for Change shift <b>@Model.TotalRequestInMonth</b>
                    times since @DateTime.Now.ToString("MMM yyyy")</a>
            </p>
        </div>
        }
        
        
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Employee)
            </div>
            <div class="input">
                @Html.EditorFor(model => model.Employee)
                @Html.ValidationMessageFor(model => model.Employee)
            </div>
        </div>
        
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.FromDate)
            </div>
            <div class="input">
                @Html.DatePickerFor(model => model.FromDate,
                new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(-1),
                new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(2).AddDays(-1))
            </div>
        </div>
        
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.ToDate)
            </div>
            <div class="input">
                @Html.DatePickerFor(model => model.ToDate,
                new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(-1),
                new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(2).AddDays(-1))
            </div>
        </div>
        
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.VerifierId)
            </div>
            <div class="input">
                @if (Model.VerifierAndApprover.Verifiers.Count() > 1)
                {
                    @Html.DropDownListFor(x => x.VerifierId, new SelectList(Model.VerifierAndApprover.Verifiers, "OwnerId", "DisplayName"), Labels.SelectVerifier, new { @class = "dropdown" })
                }
                else
                {
                    @Html.DropDownListFor(x => x.VerifierId, new SelectList(Model.VerifierAndApprover.Verifiers, "OwnerId", "DisplayName"), new { @class = "dropdown" })
                }

                @Html.ValidationMessageFor(model => model.VerifierId)
            </div>
        </div>
        
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.ApproverId)
            </div>
            <div class="input">
                @if (Model.VerifierAndApprover.Approvers.Count() > 1)
                {
                    @Html.DropDownListFor(x => x.ApproverId, new SelectList(Model.VerifierAndApprover.Approvers, "OwnerId", "DisplayName"), Labels.SelectApprover, new { @class = "dropdown" })
                }
                else
                {
                    @Html.DropDownListFor(x => x.ApproverId, new SelectList(Model.VerifierAndApprover.Approvers, "OwnerId", "DisplayName"), new { @class = "dropdown" })
                }
                @Html.ValidationMessageFor(model => model.ApproverId)
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Remark)
            </div>
            <div class="input">
                @Html.TextAreaFor(model => model.Remark)
            </div>
        </div>
        
        <div class="formrow" id="shiftDetailSchedule">
            @Html.Partial("ChangeShiftDetail", Model.ShiftDetails)
        </div>
        
        <div class="formrow">
            <div class="label">
                @Html.HiddenFor(model => model.EmployeeId)
                @Html.Hidden("RequestType", (int)RequestType.ChangeShift)
            </div>
            <div class="input">
                <input type="button" name="submit" value="@Labels.Request" class="button-primary button"/>
                <a href="javascript:;" class="button" id="backPrevious">@Labels.Back</a>
            </div>
        </div>
    }
</div>
