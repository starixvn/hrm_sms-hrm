@using Fanex.NexHR.Core
@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Resources
@using Fanex.NexHR.Models.Request.ChangeShift
@using Newtonsoft.Json
@model List<ChangeShiftDetail>

@{
    var typeId = (byte)ViewBag.TypeId;
    var isHost = (bool)ViewBag.IsHost;
    var shifts = (IList<Shift>)ViewBag.Shifts;

    var deserializeSettings = new JsonSerializerSettings { ObjectCreationHandling = ObjectCreationHandling.Replace };
    var shiftSerializes = JsonConvert.SerializeObject(shifts);
    var shiftWithNoOffs = JsonConvert.DeserializeObject<IList<Shift>>(shiftSerializes, deserializeSettings);
    shiftWithNoOffs.RemoveAt(0);
}

<table id="tblchangeshift" class="table table-custom">
    <thead>
        <tr>
            <th>@Labels.Date</th>
            <th>@Labels.Schedule</th>
            @if (typeId == (byte)ChangeShiftType.MoveOffDay)
            {
                <th>@Labels.MoveToDate</th>
                <th>@Labels.NewShift</th>
            }
            @if (typeId == (byte)ChangeShiftType.ChangeShift)
            {
                <th>@Labels.ChangeTo</th>
            }
            <th>@Labels.Remark</th>
        </tr>
    </thead>
    <tbody>
        @foreach (ChangeShiftDetail item in Model)
        {
            <tr>
                <td>
                    @item.OnDate.ToDayOfWeekFormatedDate()
                    @Html.HiddenFor(model => item.FromShiftId, new { @class = "fromShiftId" })
                    <input type="text" class="onDate" hidden value="@item.OnDate.ToDateMonthYearFormatedDate()" />
                </td>
                <td>@item.FromShift</td>
                @if (typeId == (byte)ChangeShiftType.MoveOffDay)
                {
                    var disabledates = string.Join(",", item.DisableDates.Select(x => x.ToString("yyyy/MM/dd")));

                    <td>
                        <div class="calendar-form">
                            @{ var toDate = item.ToDate.HasValue ? item.ToDate.ToDateMonthYearFormatedDate() : string.Empty; }
                            <input type="text" class="datepicker form-control moveToDate" value="@toDate"
                                @(!isHost ? "disabled" : string.Empty)
                                requestdate="@item.OnDate.ToDateMonthYearFormatedDate()"
                                mindate="@(new DateTime(item.OnDate.Year, 1, 1).ToString("yyyy/MM/dd"))"
                                maxdate="@(new DateTime(item.OnDate.Year, 12, 31).ToString("yyyy/MM/dd"))"
                                original-disabledDate="@disabledates"
                                disabledDate="@disabledates" />
                            <i class="icon-calendar fa fa-calendar"></i>
                        </div>
                    </td>

                    <td>
                        @Html.DropDownListFor(m => item.ToShiftId, new SelectList(shiftWithNoOffs, "Id", "Code", item.ToShiftId),
                            new { @class = "toShiftId form-control" })
                    </td>
                }
                @if (typeId == (byte)ChangeShiftType.ChangeShift)
                {
                    if (isHost)
                    {
                        <td>
                            @Html.DropDownListFor(m => item.ToShiftId, new SelectList(shifts, "Id", "Code", item.ToShiftId),
                                new { @class = "toShiftId form-control" })
                        </td>
                    }
                    else
                    {
                        <td>
                            @Html.DropDownListFor(m => item.ToShiftId, new SelectList(shifts, "Id", "Code", item.ToShiftId),
                                new { @class = "toShiftId form-control", @disabled = "disabled" })
                        </td>
                    }
                }
                <td>
                    @if (isHost)
                    {
                        @Html.TextBoxFor(model => item.Remark, new { @class = "form-control remark" })
                    }
                    else
                    {
                        @Html.TextBoxFor(model => item.Remark, new { @class = "form-control remark", @disabled = "disabled" })
                    }
                </td>
            </tr>
        }
    </tbody>
</table>