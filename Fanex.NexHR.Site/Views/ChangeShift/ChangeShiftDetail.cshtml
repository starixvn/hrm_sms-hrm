@using Fanex.NexHR.ViewModels.Request
@model List<ChangeShiftDetailViewModel>

@section css{
    @Url.CombresLink("changeshiftcss")
}

<table id="tblchangeshift" class="tabledata">
    <thead>
        <tr>
            <th rowspan="1">
                @Labels.Date
            </th>
            <th rowspan="1">
                @Labels.ScheduleStatus
            </th>
            <th rowspan="1">
                Change to
            </th>
            <th rowspan="1">
                @Labels.Remark
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (ChangeShiftDetailViewModel item in Model)
        {
            <tr class='left'>
                <td>@item.OnDate.ToDayOfWeekFormatedDate()</td>
                <td>@item.ScheduleStatus</td>
                @if (item.ScheduleStatus == null || item.ScheduleStatus.Equals(Labels.NA))
                { 
                    <td>-</td>
                    <td>-</td>
                }
                else
                { 
                    <td>
                        @Html.DropDownListFor(m => item.ToShiftId, new SelectList(ViewBag.Shift, "Id", "Code", item.ToShiftId), new { @class = "item_ToShift" })
                        @*@Html.DropDownListFor(model => item.ToShift, new SelectList(ViewBag.Shift, "Id", "Code"), new { @class = "item_ToShift" })*@
                    </td>
                    <td>@Html.TextBoxFor(model => item.Remark) </td>
                }

                @Html.HiddenFor(model => item.FromShiftId)
            </tr>
        }
    </tbody>
</table>
