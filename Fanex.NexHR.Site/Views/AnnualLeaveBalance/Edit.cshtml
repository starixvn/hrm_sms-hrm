@model AnnualLeaveBalanceModel
@{
    ViewBag.Title = "Edit " + ViewBag.Employee.NickName + "'s annual leave balance";
}
@section css{
    @Url.CombresLink("sitecss")
}
@section js{
    @Url.CombresLink("sitejs")
}
@section Breadcrumb
{
    <a class="step" href="javascript:;">HR</a> 
    <span class="step">
        <a href="@Url.Action("index", "annualleavebalance")">Annual leave balance</a>
    </span>
    <span class="step">
        <a href="~/annualleavebalance/employee/@ViewBag.Employee.Id">@ViewBag.Employee.NickName's annual leave balance</a>
    </span>
    <span class="step">@Labels.Edit</span>
}

@using (Html.BeginForm())
{
<div class="bunhat" style="min-width: 400px">
    @Html.ValidationSummary(true)

    @if ((bool)ViewBag.Updated)
    {
        <div class="success flash">@Messages.Saved</div> 
    }
    
    <div class="formrow">
        <div class="label">
            @Html.LabelFor(model => model.TotalDays)
        </div>
        <div class="input">
            @Html.EditorFor(model => model.TotalDays)
            @Html.ValidationMessageFor(model => model.TotalDays)
        </div>
    </div>
    
    <div class="formrow">
        <div class="label">
            @Html.LabelFor(model => model.Description)
        </div>
        <div class="input">
            @Html.TextAreaFor(model => model.Description)
        </div>
    </div>
    
    <div class="formrow">
        <div class="label">
            @Html.LabelFor(model => model.AffectedFrom)
        </div>
        <div class="input">
            @Html.DatePickerFor(model => model.AffectedFrom)
            @Html.ValidationMessageFor(model => model.AffectedFrom)
        </div>
    </div>
    
    <div class="formrow">
        <div class="label">
            @Html.HiddenFor(model => model.EmpId)
            @Html.HiddenFor(model => model.LeaveTransId)
        </div>
        <div class="input">
            <input type="submit" value="@Labels.Update" name="command" />
            <input class="cancel delete" type="submit" value="@Labels.Delete" name="command" />
        </div>
    </div>
</div>
}