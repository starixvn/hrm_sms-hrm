@model LeaveSummaryViewModel
@{
    ViewBag.Title = Labels.AnualLeaveBalance;
    var hasPermissionToEdit = (bool)ViewBag.HasPermissionToEdit;
}
@section css{
    @Url.CombresLink("annualbalancecss")
}
@section js{
    @Url.CombresLink("annualbalancejs")
}
@section Breadcrumb {
    <a class="step">@Labels.CompanySpace</a> <a class="step">@ViewBag.Title</a>
}
<h2>@ViewBag.Title</h2>
@if (hasPermissionToEdit)
{
    <div class="container_24 bunhat">
        @using (Html.BeginForm())
        {
            <div class="grid_3 gridlabel">
                @Labels.Category
            </div>
                <div class="grid_3">
                    <select id="Category" name="Category" class="category">
                        <option value="">-- All --</option>
                        <option selected="@(Model.Category == 1)" value="1">@Labels.Local</option>
                        <option selected="@(Model.Category == 0)" value="0">@Labels.Expat</option>
                    </select>
                </div>
                <div class="grid_1 gridlabel">
                    @Html.LabelFor(model => model.Year)
                </div>
                <div class="grid_2">
                    @Html.YearPickerFor(model => model.Year, 2010)
                </div>
                <div class="grid_2 gridlabel">
                    @Html.LabelFor(model => model.Employee)
                </div>
                <div class="grid_6">
                    @Html.TextBox("Employee", Model.Employee, new { placeholder = Messages.SearchEmployeeWatermark, style = "width:183px;" })
                    @Html.HiddenFor(model => model.EmployeeId)
                </div>
                <div class="grid_2 gridlabel">
                    @Labels.Section
                </div>
                <div class="grid_6">
                    <select id="SectionId" multiple="multiple" name="SectionId" class="yearpicker">
                        @{
                            var sectionIds = !string.IsNullOrEmpty(Model.SectionIds) ? Model.SectionIds.Split(',') : null;
                            var selected = string.Empty;
                            foreach (Team team in Model.Sections)
                            {
                                selected = string.Empty;
                                if (sectionIds != null)
                                {
                                    int pos = Array.IndexOf(sectionIds, team.Id.ToString());
                                    if (pos > -1)
                                    {
                                        selected = "selected";
                                    }
                                }
                                <option @selected value="@team.Id">@team.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="clear"></div>
                <div class="space"></div>
                <div class="grid_3 gridlabel">
                    @Html.Label(@Labels.MinBalance)
                </div>
                <div class="grid_3">
                    <select id="MinAnnualBalance" name="MinAnnualBalance" class="category">
                        <option value="0">@Labels.None</option>
                        @for (int i = 1; i <= 10; i++)
                        {
                            <option selected="@(Model.MinAnnualBalance == i)" value="@i">@i</option>
                        }
                    </select>
                </div>
                <div class="grid_12">
                    <input type="submit" value="@Labels.Submit" class="processing-submit" />
                    <input type="button" value="Excel" id="btnExcel" />
                    @if (Model.IsShowCloseBalance)
                    {
                        <div class="button-icon">
                            <span class="icon plus"></span><a href="javascript:;" id="resetblc">Close Balance</a>
                        </div>
                    }
                    @if (hasPermissionToEdit)
                    {
                        <div class="button-icon">
                            <span class="icon plus"></span><a href="javascript:;" id="addadj">Adjustment</a>
                        </div>
                    }
                </div>
                <div class="clear"></div>
                <div class="space"></div>
                            }
    </div>
    <div class="clear"></div>
                            }
<table class="table table-custom persist-area">
    <thead class="persist-header">
        <tr>
            <th rowspan="2">
                <input type="checkbox" class="checkuncheckall" />
            </th>
            <th rowspan="2">
                @Labels.Nick
            </th>
            <th rowspan="2">
                @Labels.KeepInView
            </th>
            <th rowspan="2">
                @Labels.AnnualLeave
            </th>
            <th colspan="12">
                Leave's Report @Model.Year
            </th>
            <th rowspan="2">
                Balance of AL @Model.Year
            </th>
            <th rowspan="2">
                Balance of KIV @Model.Year
            </th>
            @if (hasPermissionToEdit)
            {
                <th rowspan="2">
                    @Labels.Edit
                </th>
            }
        </tr>
        <tr>
            <th>@Labels.Jan</th>
            <th>@Labels.Feb</th>
            <th>@Labels.Mar</th>
            <th>@Labels.Apr</th>
            <th>@Labels.May</th>
            <th>@Labels.Jun</th>
            <th>@Labels.Jul</th>
            <th>@Labels.Aug</th>
            <th>@Labels.Sep</th>
            <th>@Labels.Oct</th>
            <th>@Labels.Nov</th>
            <th>@Labels.Dec</th>
        </tr>
    </thead>
    @*Check if exists*@
    @{
        bool checkSummaryList = true;
        foreach (LeaveSummaryByTeam leaveSumaryByTeam in ViewBag.LeaveSummaryByTeamList)
        {
            if (leaveSumaryByTeam.LeaveSummaryInTeam.Count > 0)
            {
                checkSummaryList = true;
                break;
            }
            else
            {
                checkSummaryList = false;
            }
        }
    }
    @if (checkSummaryList)
    {
        <tbody>
            @foreach (LeaveSummaryByTeam item in ViewBag.LeaveSummaryByTeamList)
            {
                if (item.LeaveSummaryInTeam.Count > 0)
                {
                    <tr>
                        <td class="rowdivider align-left" colspan="19">
                            <b>@item.Team.Name.ToUpper()</b>
                        </td>
                    </tr>
                }
                foreach (LeaveSummary leave in item.LeaveSummaryInTeam)
                {
                    <tr>
                        <td>
                            <input type="checkbox" class="aba" data-id="@leave.Employee.Id" />
                        </td>
                        <td class="tooltip" title="@leave.Employee.FullName">
                            @leave.Employee.NickName
                        </td>
                        <td>
                            @if (leave.CreditKIV > 0)
                            {
                                <span>@leave.CreditKIV.ToString("0.0")</span>
                            }
                        </td>
                        <td>
                            @{
                                if (leave.AnnualLeaveCurrentYear > 0)
                                {
                                    <span>@leave.AnnualLeaveCurrentYear.ToString("0.0")</span>
                                }
                                if (leave.AnnualLeaveCurrentYear < 0)
                                {
                                    <span class="red">@leave.AnnualLeaveCurrentYear.ToString("0.0")</span>
                                }
                            }
                        </td>
                        <td>
                            @{
                                if (leave.Jan > 0)
                                {
                                    <span>@leave.Jan.ToString("0.0")</span>
                                }
                                if (leave.Jan < 0)
                                {
                                    <span class="red">@leave.Jan.ToString("0.0")</span>
                                }
                            }
                        </td>
                        <td>
                            @{
                                if (leave.Feb > 0)
                                {
                                    <span>@leave.Feb.ToString("0.0")</span>
                                }
                                if (leave.Feb < 0)
                                {
                                    <span class="red">@leave.Feb.ToString("0.0")</span>
                                }
                            }
                        </td>
                        <td>
                            @{
                                if (leave.Mar > 0)
                                {
                                    <span>@leave.Mar.ToString("0.0")</span>
                                }
                                if (leave.Mar < 0)
                                {
                                    <span class="red">@leave.Mar.ToString("0.0")</span>
                                }
                            }
                        </td>
                        <td>
                            @{
                                if (leave.Apr > 0)
                                {
                                    <span>@leave.Apr.ToString("0.0")</span>
                                }
                                if (leave.Apr < 0)
                                {
                                    <span class="red">@leave.Apr.ToString("0.0")</span>
                                }
                            }
                        </td>
                        <td>
                            @{
                                if (leave.May > 0)
                                {
                                    <span>@leave.May.ToString("0.0")</span>
                                }
                                if (leave.May < 0)
                                {
                                    <span class="red">@leave.May.ToString("0.0")</span>
                                }
                            }
                        </td>
                        <td>
                            @{
                                if (leave.Jun > 0)
                                {
                                    <span>@leave.Jun.ToString("0.0")</span>
                                }
                                if (leave.Jun < 0)
                                {
                                    <span class="red">@leave.Jun.ToString("0.0")</span>
                                }
                            }
                        </td>
                        <td>
                            @{
                                if (leave.Jul > 0)
                                {
                                    <span>@leave.Jul.ToString("0.0")</span>
                                }
                                if (leave.Jul < 0)
                                {
                                    <span class="red">@leave.Jul.ToString("0.0")</span>
                                }
                            }
                        </td>
                        <td>
                            @{
                                if (leave.Aug > 0)
                                {
                                    <span>@leave.Aug.ToString("0.0")</span>
                                }
                                if (leave.Aug < 0)
                                {
                                    <span class="red">@leave.Aug.ToString("0.0")</span>
                                }
                            }
                        </td>
                        <td>
                            @{
                                if (leave.Sep > 0)
                                {
                                    <span>@leave.Sep.ToString("0.0")</span>
                                }
                                if (leave.Sep < 0)
                                {
                                    <span class="red">@leave.Sep.ToString("0.0")</span>
                                }
                            }
                        </td>
                        <td>
                            @{
                                if (leave.Oct > 0)
                                {
                                    <span>@leave.Oct.ToString("0.0")</span>
                                }
                                if (leave.Oct < 0)
                                {
                                    <span class="red">@leave.Oct.ToString("0.0")</span>
                                }
                            }
                        </td>
                        <td>
                            @{
                                if (leave.Nov > 0)
                                {
                                    <span>@leave.Nov.ToString("0.0")</span>
                                }
                                if (leave.Nov < 0)
                                {
                                    <span class="red">@leave.Nov.ToString("0.0")</span>
                                }
                            }
                        </td>
                        <td>
                            @{
                                if (leave.Dec > 0)
                                {
                                    <span>@leave.Dec.ToString("0.0")</span>
                                }
                                if (leave.Dec < 0)
                                {
                                    <span class="red">@leave.Dec.ToString("0.0")</span>
                                }
                            }
                        </td>
                        <td>
                            @{
                                if (leave.LeaveBalance >= 0)
                                {
                                    <span>@leave.LeaveBalance.ToString("0.0")</span>
                                }
                                if (leave.LeaveBalance < 0)
                                {
                                    <span class="red">@leave.LeaveBalance.ToString("0.0")</span>
                                }
                            }
                        </td>
                        <td>
                            @{
                                if (leave.KIVBalance >= 0)
                                {
                                    <span>@leave.KIVBalance.ToString("0.0")</span>
                                }
                                if (leave.KIVBalance < 0)
                                {
                                    <span class="red">@leave.KIVBalance.ToString("0.0")</span>
                                }
                            }
                        </td>
                        @if (hasPermissionToEdit)
                        {
                            <td>
                                <a href="~/annualleavebalance/employee/@leave.Employee.Id">
                                    <i class="fa fa-pencil fa-lg icon-edit"></i>
                                </a>
                            </td>
                        }
                    </tr>
                                    }
                                }
        </tbody>
                                }
                                else
                                {
                                    @RazorHelper.DisplayNoInformation(19)
                                }
</table>
<div class="hide">
    <div id="insertform" title="Adjust annual leave balance">
        @Html.Action("MultipleInsert")
    </div>
</div>
<div class="hide">
    <div id="resetform" title="Close balance for year @DateTime.Now.AddYears(-1).Year">
        @Html.Action("MultipleReset")
    </div>
</div>