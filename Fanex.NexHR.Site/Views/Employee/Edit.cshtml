                        @Html.LabelFor(model => model.IsDefaultSchedule, Labels.ApplicableDefaultShift)
                    </div>
                    <div class="input">
                        @Html.CheckBoxFor(model => model.IsDefaultSchedule)
                    </div>
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label marginlable">
                        @Html.Label(Labels.DefaultShift)
                    </div>
                    <div class="input">

                        <a href="@Url.Action("defaultschedule", "employee", new { id = Model.Id })">View</a>
                    </div>
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label marginlable">
                        @Html.LabelFor(model => model.Enabled, Labels.EnabledUser)
