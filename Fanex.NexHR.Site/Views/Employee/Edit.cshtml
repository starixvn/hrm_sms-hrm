                    @{ var confirmedDate = Model.ConfirmedDate.HasValue ? Model.ConfirmedDate.ToDateMonthYearFormatedDate() : string.Empty; }
                    @Html.TextBox("ConfirmedDate", confirmedDate, new { @class = "datepicker form-control" })
                    <i class="icon-calendar fa fa-calendar"></i>
                </div>
            </li>
            <li class="list-group-item form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.ResignedDate, new { @class = "control-label" })
                </div>
                <div class="calendar-form">
                    @{ var resignedDate = Model.ResignedDate.HasValue ? Model.ResignedDate.ToDateMonthYearFormatedDate() : string.Empty; }
                    @Html.TextBox("ResignedDate", resignedDate, new { @class = "datepicker form-control" })
                    <i class="icon-calendar fa fa-calendar"></i>
                </div>
            </li>
            <li class="list-group-item form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.ResignedReason, Labels.ResignedReason, new { @class = "control-label" })
                </div>
                <div class="input-form">
                    @Html.TextAreaFor(model => model.ResignedReason, new { @class = "form-control", maxlength = 200 })
                </div>
            </li>
            <li class="list-group-item form-group">
                <div class="label-form">@Labels.LengthOfService:</div>
            </li>
            @if (enableGroupDate)
            {
                <li class="list-group-item form-group field-length-service">
                    <div class="label-form">@Labels.ByGroupDate</div>
                    <div>@ViewBag.LengthOfServiceByGroupDate</div>
                </li>
            }
            <li class="list-group-item form-group field-length-service">
                <div class="label-form">@Labels.ByCompanyDate</div>
                <div>@ViewBag.LengthOfServiceByCompanyDate</div>
            </li>
