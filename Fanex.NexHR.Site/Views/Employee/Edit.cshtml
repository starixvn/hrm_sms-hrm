                    <div class="label">
                        @Html.LabelFor(model => model.BankAccount)
                    </div>
                    <div class="input">
                        @Html.EditorFor(model => model.BankAccount)
                    </div>
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label">
                        @Html.LabelFor(model => model.TaxCode)
                    </div>
                    <div class="input">
                        @Html.EditorFor(model => model.TaxCode)
                    </div>
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label">
                        @Html.LabelFor(model => model.SocialInsuranceNo)
