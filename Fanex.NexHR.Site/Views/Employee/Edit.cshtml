					<div class="input">
						@Model.EmpShiftList
						@Html.ActionLink("Update", "ShiftManager", "Employee", new { role = (short)RoleSystem.ShiftManager, employeeId = Model.Id }, new { @class = "linkUpdate" })
					</div>
					<div class="clear">
