				</div>
				<div class="line">
					<div class="label">
						@Html.Label("Working hours per day")
					</div>
					<div class="input">
						@Html.TextBoxFor(model => model.WorkingHours)
						@Html.ValidationMessageFor(model => model.WorkingHours)
					</div>
					<div class="clear">
