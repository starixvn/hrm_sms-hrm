						@Html.ValidationMessageFor(model => model.Yahoo)
					</div>
					<div class="clear">
					</div>
				</div>
			</div>
		</div>
		<div class="employeeInfo">
			<div class="boxtitle">
				<img src="~/Styles/Images/collapsed.gif" />
				<span>Information</span>
			</div>
			<div class="boxcontent">
				<div class="line">
					<div class="label">
						@Html.Label("Unit")
					</div>
					<div class="input">
						@Html.EditorFor(model => model.Unit)
						@Html.ValidationMessageFor(model => model.Unit)
					</div>
					<div class="clear">
					</div>
				</div>
				<div class="line">
					<div class="label">
						@Html.Label("Department/Team")
					</div>
					<div class="input">
						@Html.DropDownListFor(model => model.Team.Id, new SelectList(ViewBag.Groups, "Id", "Name"), "--Select a Team--")
						@Html.ValidationMessageFor(model => model.Team.Id)
					</div>
					<div class="clear">
					</div>
				</div>
				<div class="line">
					<div class="label">
						@Html.LabelFor(model => model.JobTitleId)
					</div>
					<div class="input">
						@Html.DropDownListFor(model => model.JobTitleId, new SelectList(ViewBag.JobTitles, "Id", "Name"), "--Select a Job Title--", new { @style = "width : 230px;" })
						@Html.ValidationMessageFor(model => model.JobTitleId)
					</div>
					<div class="clear">
					</div>
				</div>
				<div class="line">
					<div class="label marginlable">
						@Html.Label("Verified by")
					</div>
					<div class="input">
						<span id="lstVerifier">@Model.Verifier</span>
						@Html.ActionLink("Update", "Supervisor", "Employee", new { role = (short)RoleSystem.Verifier, employeeId = Model.Id }, new { @class = "linkUpdate" })
					</div>
					<div class="clear">
					</div>
				</div>
				<div class="line">
					<div class="label marginlable">
						@Html.Label("Approved by")
					</div>
					<div class="input">
						<span id="lstApprover">@Model.Approver</span>
						@Html.ActionLink("Update", "Supervisor", "Employee", new { role = (short)RoleSystem.Approver, employeeId = Model.Id }, new { @class = "linkUpdate" })
					</div>
					<div class="clear">
					</div>
				</div>
				<div class="line">
					<div class="label">
						@Html.Label("Group Date")
					</div>
					<div class="input">
						@Html.DatePickerFor(model => model.JoinedDate)
					</div>
					<div class="clear">
					</div>
				</div>
				<div class="line">
					<div class="label">
						@Html.Label("Company Date")
					</div>
					<div class="input">
						@Html.DatePickerFor(model => model.CompanyDate)
					</div>
					<div class="clear">
					</div>
				</div>
				<div class="line">
					<div class="label">
						@Html.LabelFor(model => model.ConfirmedDate)
					</div>
					<div class="input">
						@Html.DatePickerFor(model => model.ConfirmedDate)
						@Html.ValidationMessageFor(model => model.ConfirmedDate)
					</div>
					<div class="clear">
					</div>
				</div>
				<div class="line">
					<div class="label">
						@Html.LabelFor(model => model.ResignedDate)
					</div>
					<div class="input">
						@Html.DatePickerFor(model => model.ResignedDate)
						@Html.ValidationMessageFor(model => model.ResignedDate)
					</div>
					<div class="clear">
					</div>
				</div>
			</div>
		</div>
		<div class="employeeInfo">
			<div class="boxtitle">
				<img src="~/Styles/Images/collapsed.gif" />
				<span>Policy</span>
			</div>
			<div class="boxcontent">
				<div class="line">
					<div class="label marginlable">
						@Html.Label("Allow Claim OT")
					</div>
					<div class="input">
						@Html.CheckBoxFor(model => model.CanOT)
					</div>
					<div class="clear">
