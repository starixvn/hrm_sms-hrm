		<div class="employeeInfo">
			<div class="boxtitle">
				<img src="~/Styles/Images/collapsed.gif" />
				<span>Permission</span>
			</div>
			<div class="boxcontent">
				<div class="line">
					<div class="label marginlable">
						@Html.Label("Authority Level")
					</div>
					<div class="input" id="userRole">
						@{
  var roles = new List<SelectListItem>
                    {
                        new SelectListItem() {Text = "Verifier", Value = "2"},
                        new SelectListItem() {Text = "Approver", Value = "3"},
                        new SelectListItem() {Text = "Shift Monitor", Value = "4"},
                        new SelectListItem() {Text = "On Behalf Function", Value = "5"},
                        new SelectListItem() {Text = "Human Resource", Value = "6"},
                        new SelectListItem() {Text = "System Admin", Value = "7"}
                    };
						}
						@Html.CheckBox("Member", true, new { disabled = true })
						@Html.Label("Member", "Member")
						@Html.CheckBoxListFor(model => model.RoleArray, roles)
						@Html.ValidationMessageFor(model => model.RoleArray)
					</div>
					<div class="clear">
					</div>
				</div>
				<div class="line">
					<div class="label marginlable">
						@Html.LabelFor(model => model.IsTopManager)
					</div>
					<div class="input">
						@Html.CheckBoxFor(model => model.IsTopManager)
					</div>
					<div class="clear">
					</div>
				</div>
				<div class="line">
					<div class="label marginlable">
						@Html.Label("Shift Arrangement")
