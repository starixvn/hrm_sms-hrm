				<div class="line">
					<div class="label">
						Number of Offday:
					</div>
					<div class="pcontent">
						@Html.TextBoxFor(model => model.OffDaysbyWeek)
						@Html.ValidationMessageFor(model => model.OffDaysbyWeek)
					</div>
					<div class="clear">
					</div>
				</div>
				<div class="line">
					<div class="label marginlable">
						Leave Balance
					</div>
					<div class="input">
						@Model.AnnualLeaveBalance day(s)
						<a href="~/annualleavebalance/employee/@Model.Id" class="linkUpdate" >Update</a>
					</div>
					<div class="clear">
					</div>
				</div>
				<div class="line">
					<div class="label marginlable">
						KIV Balance
					</div>
					<div class="input">
						@Model.KeepInViewBalance day(s)
					</div>
					<div class="clear">
