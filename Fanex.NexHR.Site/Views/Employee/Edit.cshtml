@model Fanex.NexHR.Models.Employee
@{
	ViewBag.Title = "Edit";
}
@section css{
	@Url.CombresLink("employeeeditcss")
}
@section js{
	@Url.CombresLink("employeeeditjs")
}
@section Breadcrumb
{
	<a class="step" href="javascript:;">HR</a>
	<a class="step" href="@Url.Action("usermanagement", "employee")">@Labels.EmployeeManagement</a>
	<span class="step">Edit @Model.NickName (@Model.FullName) 's Personal Information</span>
}
@using (Html.BeginForm("Edit", "Employee", FormMethod.Post, new { @id = "formEditUser" }))
{
	<div class="bunhat">
		@Html.ValidationSummary(false)
		@if (ViewBag.Updated == true)
  {
			<div class="success flash">
				Saved</div> 
  }
  else if (ViewBag.Updated == false)
  { 
			<div class="error flash">@Messages.ErrorTryAgain</div> 
  }
		<div class="employeeInfo">
			<div class="boxtitle">
				<img src="~/Styles/Images/collapsed.gif" class="collapsed" />
				<span>Personal</span>
			</div>
			<div class="boxcontent">
				<div class="line">
					<div class="label">
						Avatar:
					</div>
					<div class="pcontent">
						<img id="avatar" class="img-employee" src="~/employee/avatar/@(Model.Code)?f=@(Fanex.NexHR.Core.Utilities.RandomString(4))" alt="@Model.FullName" /><br />
						<input type="file" id="file" />
						<input type="button" id="upload" value="Upload" />
					</div>
					<div class="clear">
					</div>
				</div>
				<div class="line">
					<div class="label">
						@Html.Label("Employee ID"):
					</div>
					<div class="input">
						@Html.EditorFor(model => model.Code)
						@Html.ValidationMessageFor(model => model.Code)
					</div>
					<div class="clear">
					</div>
				</div>
				<div class="line">
					<div class="label">
						@Html.LabelFor(model => model.DomainUsername)
					</div>
					<div class="input">
						@Html.EditorFor(model => model.DomainUsername)
						@Html.ValidationMessageFor(model => model.DomainUsername)
					</div>
					<div class="clear">
					</div>
				</div>
				<div class="line">
					<div class="label">
						@Html.LabelFor(model => model.FullName)
					</div>
					<div class="input">
						@Html.EditorFor(model => model.FullName)
						@Html.ValidationMessageFor(model => model.FullName)
					</div>
					<div class="clear">
					</div>
				</div>
				<div class="line">
					<div class="label">
						@Html.LabelFor(model => model.NickName)
					</div>
					<div class="input">
						@Html.EditorFor(model => model.NickName)
						@Html.ValidationMessageFor(model => model.NickName)
					</div>
					<div class="clear">
					</div>
				</div>
				<div class="line">
					<div class="label">
						@Html.LabelFor(model => model.DateOfBirth)
					</div>
					<div class="input">
						<div id="DOBPicker">
						</div>
					</div>
					@Html.HiddenFor(model => model.DateOfBirth)
					<div class="clear">
					</div>
				</div>
				<div class="line">
					<div class="label">
						@Html.LabelFor(model => model.PlaceOfBirth)
					</div>
					<div class="input">
						<div id="DOBPicker">
						</div>
					</div>
					@Html.EditorFor(model => model.PlaceOfBirth)
					<div class="clear">
					</div>
				</div>
				<div class="line">
					<div class="label">
						@Html.LabelFor(model => model.Ethnic)
					</div>
					<div class="input">
						<div id="DOBPicker">
						</div>
					</div>
					@Html.EditorFor(model => model.Ethnic)
					<div class="clear">
					</div>
				</div>
				<div class="line">
					<div class="label">
						@Html.LabelFor(model => model.Native)
					</div>
					<div class="input">
						<div id="DOBPicker">
						</div>
					</div>
					@Html.EditorFor(model => model.Native)
					<div class="clear">
					</div>
				</div>
				<div class="line">
					<div class="label">
						@Html.LabelFor(model => model.Religion)
					</div>
					<div class="input">
						<div id="DOBPicker">
						</div>
					</div>
					@Html.EditorFor(model => model.Religion)
					<div class="clear">
					</div>
				</div>
				<div class="line">
					<div class="label">
						@Html.LabelFor(model => model.Gender)
					</div>
					<div class="input">
						@{
  var gender = new List<SelectListItem>
                    {
                        new SelectListItem() {Text = "Unknown", Value = ""}, 
                        new SelectListItem() {Text = "Female", Value = "0"},
                        new SelectListItem() {Text = "Male", Value = "1"}
                    };
						}
						@Html.DropDownListFor(model => model.Gender, gender)
						@Html.ValidationMessageFor(model => model.Gender)
					</div>
					<div class="clear">
					</div>
				</div>
				<div class="line">
					<div class="label">
						@Html.Label("Marriage")
					</div>
					<div class="input">
						@Html.DropDownListFor(model => model.Marriage, (IList<SelectListItem>)ViewBag.Marriages)
					</div>
					<div class="clear">
					</div>
				</div>
				<div class="line">
					<div class="label">
						@Html.Label("Nationality")
