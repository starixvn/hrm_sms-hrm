@using Fanex.NexHR.Core
@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Resources
@using Fanex.NexHR.Models
@using GO.UserControl.Client.Core.Models.Role
@model Employee
@{
    ViewBag.Title = Labels.EditEmployeeInfo;
    var roles = (IEnumerable<Role>)ViewBag.Roles;
    var roleItems = roles.Select(i => new SelectListItem() { Text = i.Name, Value = i.RoleId.ToString() });
    bool enableGroupDate = ViewBag.EnableGroupDate;
}
@section css{
    <link href="~/wwwroot/dist/vendors/chosen.css" rel="stylesheet" />
    <link href="~/wwwroot/dist/styles/employee.edit.css" rel="stylesheet" />
}
@section js{
    <script src="~/wwwroot/dist/js/employee.edit.js"></script>
}
@section Breadcrumb
{
    <a class="step" href="javascript:;">@Labels.HRSpace</a>
    <a class="step" href="@Url.Action("usermanagement", "employee")">@Labels.EmployeeManagement</a>
    <span class="step">Edit @Model.NickName (@Model.FullName) 's Personal Information</span>
}
@using (Html.BeginForm("Edit", "Employee", FormMethod.Post, new { @id = "formEditUser", @class = "form-edit-user form-horizontal" }))
{
    @Html.ValidationSummary(false)
    if (ViewBag.Updated != null && (bool)ViewBag.Updated)
    {
        <div class="success flash">@Messages.UpdatedSuccessfully</div>
    }
    else if (ViewBag.Updated != null && !(bool)ViewBag.Updated)
    {
        <div class="error flash">@ViewBag.ErrorMessage</div>
    }
    <div class="panel panel-default">
        <div class="panel-heading">
            <span class="fa fa-chevron-down"></span>
            <span>@Labels.Personal</span>
        </div>
        <ul class="list-group">
            <li class="list-group-item form-group upload-avatar">
                <div class="label-form">@Html.Label(Labels.Avatar, new { @class = "control-label" })</div>
                <div class="input-form">
                    <div class="avatarbox">
                        <img id="avatar" src="~/employee/avatar/@(Model.Code)?f=@(Utilities.RandomString(4))" alt="@Model.FullName" />
                    </div>
                    <br />
                    <input type="file" id="file" />
                    <input type="button" id="upload" class="btn btn-primary" value="Upload" style="display: none;" />
                </div>
            </li>
            <li class="list-group-item form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.Code, Labels.EmployeeID, new { @class = "control-label" })
                </div>
                <div class="input-form">
                    @Html.TextBoxFor(model => model.Code, new { @class = "form-control" })
                </div>
            </li>
            <li class="list-group-item form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.EmployeeCard, new { @class = "control-label" })
                </div>
                <div class="input-form">
                    @Html.TextBoxFor(model => model.EmployeeCard, new { @class = "form-control", maxlength = "10" })
                </div>
            </li>
            <li class="list-group-item form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.DomainUsername, new { @class = "control-label" })
                </div>
                <div class="input-form">
                    @Html.TextBoxFor(model => model.DomainUsername, new { @class = "form-control" })
                </div>
            </li>
            <li class="list-group-item form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.FullName, new { @class = "control-label" })
                </div>
                <div class="input-form">
                    @Html.TextBoxFor(model => model.FullName, new { @class = "form-control" })
                </div>
            </li>
            <li class="list-group-item form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.NickName, Labels.NickName, new { @class = "control-label" })
                </div>
                <div class="input-form">
                    @Html.TextBoxFor(model => model.NickName, new { @class = "form-control" })
                </div>
            </li>
            <li class="list-group-item form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.DateOfBirth, new { @class = "control-label" })
                </div>
                <div class="input-form">
                    <div id="DOBPicker"></div>
                </div>
                @Html.HiddenFor(model => model.DateOfBirth)
            </li>
            <li class="list-group-item form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.PlaceOfBirth, new { @class = "control-label" })
                </div>
                <div class="input-form">
                    @Html.TextBoxFor(model => model.PlaceOfBirth, new { @class = "form-control" })
                </div>
            </li>
            <li class="list-group-item form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.Ethnic, new { @class = "control-label" })
                </div>
                <div class="input-form">
                    @Html.TextBoxFor(model => model.Ethnic, new { @class = "form-control" })
                </div>
            </li>
            <li class="list-group-item form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.Native, new { @class = "control-label" })
                </div>
                <div class="input-form">
                    @Html.TextBoxFor(model => model.Native, new { @class = "form-control" })
                </div>
            </li>
            <li class="list-group-item form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.Religion, new { @class = "control-label" })
                </div>
                <div class="input-form">
                    @Html.TextBoxFor(model => model.Religion, new { @class = "form-control" })
                </div>
            </li>
            <li class="list-group-item form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.Gender, new { @class = "control-label" })
                </div>
                <div class="select-form">
                    @{
                        var gender = new List<SelectListItem>
                        {
                            new SelectListItem() {Text = Labels.Unknown, Value = "2"},
                            new SelectListItem() {Text = Labels.Female, Value = "0"},
                            new SelectListItem() {Text = Labels.Male, Value = "1"}
                        };
                    }
                    @Html.DropDownListFor(model => model.Gender, gender, new { @class = "form-control" })
                </div>
            </li>
            <li class="list-group-item form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.Marriage, new { @class = "control-label" })
                </div>
                <div class="select-form">
                    @Html.DropDownListFor(model => model.Marriage, (IList<SelectListItem>)ViewBag.Marriages, new { @class = "form-control" })
                </div>
            </li>
            <li class="list-group-item form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.CountryCode, Labels.Nationality, new { @class = "control-label" })
                </div>
                <div class="select-form">
                    @Html.DropDownListFor(x => x.CountryCode, new SelectList(Model.Coutries, "CountryCode", "CountryName"), new { @class = "form-control" })
                </div>
            </li>
            <li class="list-group-item form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.CardNo, Labels.IDCardNo, new { @class = "control-label" })
                </div>
                <div class="input-form">
                    @Html.TextBoxFor(model => model.CardNo, new { @class = "form-control" })
                </div>
            </li>
            <li class="list-group-item form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.DateOfIdCard, Labels.IDCardIssueDate, new { @class = "control-label" })
                </div>
                <div class="calendar-form">
                    @{ var dateOfIdCard = Model.DateOfIdCard.HasValue ? Model.DateOfIdCard.ToDateMonthYearFormatedDate() : string.Empty; }
                    @Html.TextBox("DateOfIdCard", dateOfIdCard, new { @class = "datepicker form-control" })
                    <i class="icon-calendar fa fa-calendar"></i>
                </div>
            </li>
            <li class="list-group-item form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.PlaceOfIdCard, Labels.IDCardPlaceOfIssue, new { @class = "control-label" })
                </div>
                <div class="input-form">
                    @Html.TextBoxFor(model => model.PlaceOfIdCard, new { @class = "form-control" })
                </div>
            </li>
            <li class="list-group-item form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.PassportNo, new { @class = "control-label" })
                </div>
                <div class="input-form">
                    @Html.TextBoxFor(model => model.PassportNo, new { @class = "form-control" })
                </div>
            </li>
            <li class="list-group-item form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.PassportExp, new { @class = "control-label" })
                </div>
                <div class="calendar-form">
                    @{ var passportExp = Model.PassportExp.HasValue ? Model.PassportExp.ToDateMonthYearFormatedDate() : string.Empty; }
                    @Html.TextBox("PassportExp", passportExp, new { @class = "datepicker form-control" })
                    <i class="icon-calendar fa fa-calendar"></i>
                </div>
            </li>
            <li class="list-group-item form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.Qualification, new { @class = "control-label" })
                </div>
                <div class="input-form">
                    @Html.TextBoxFor(model => model.Qualification, new { @class = "form-control" })
                </div>
            </li>
            <li class="list-group-item form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.Major, new { @class = "control-label" })
                </div>
                <div class="input-form">
                    @Html.TextBoxFor(model => model.Major, new { @class = "form-control" })
                </div>
            </li>
        </ul>
    </div>
    if (Model.Gender != null && Model.Gender != 0)
    {
        <div class="panel panel-default">
            <div class="panel-heading">
                <span class="fa fa-chevron-down"></span>
                <span>Military</span>
            </div>
            <ul class="list-group">
                <li class="list-group-item form-group">
                    <div class="label-form">
                        @Html.LabelFor(model => model.MilitaryFromDate, Labels.From, new { @class = "control-label" })
                    </div>
                    <div class="calendar-form">
                        @{ var militaryFromDate = Model.MilitaryFromDate.HasValue ? Model.MilitaryFromDate.ToDateMonthYearFormatedDate() : string.Empty; }
                        @Html.TextBox("MilitaryFromDate", militaryFromDate, new { @class = "datepicker form-control" })
                        <i class="icon-calendar fa fa-calendar"></i>
                    </div>
                </li>
                <li class="list-group-item form-group">
                    <div class="label-form">
                        @Html.LabelFor(model => model.MilitaryToDate, Labels.To, new { @class = "control-label" })
                    </div>
                    <div class="calendar-form">
                        @{ var militaryToDate = Model.MilitaryToDate.HasValue ? Model.MilitaryToDate.ToDateMonthYearFormatedDate() : string.Empty; }
                        @Html.TextBox("MilitaryToDate", militaryToDate, new { @class = "datepicker form-control" })
                        <i class="icon-calendar fa fa-calendar"></i>
                    </div>
                </li>
            </ul>
        </div>
    }

    <div class="panel panel-default">
        <div class="panel-heading">
            <span class="fa fa-chevron-down"></span>
            <span>@Labels.Contact</span>
        </div>
        <ul class="list-group">
            <li class="list-group-item form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.Phone, Labels.Cellphone, new { @class = "control-label" })
                </div>
                <div class="input-form">
                    @Html.TextBoxFor(model => model.Phone, new { @class = "form-control" })
                </div>
            </li>
            <li class="list-group-item form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.HomePhone, Labels.HomePhone, new { @class = "control-label" })
                </div>
                <div class="input-form">
                    @Html.TextBoxFor(model => model.HomePhone, new { @class = "form-control" })
                </div>
            </li>
            <li class="list-group-item form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.Email, Labels.WorkEmail, new { @class = "control-label" })
                </div>
                <div class="input-form">
                    @Html.TextBoxFor(model => model.Email, new { @class = "form-control" })
                </div>
            </li>
            <li class="list-group-item form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.Address, new { @class = "control-label" })
                </div>
                <div class="input-form">
                    @Html.TextAreaFor(model => model.Address, new { @class = "form-control" })
                </div>
            </li>
            <li class="list-group-item form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.CurrentAddress, new { @class = "control-label" })
                </div>
                <div class="input-form">
                    @Html.TextAreaFor(model => model.CurrentAddress, new { @class = "form-control" })
                </div>
            </li>
            <li class="list-group-item form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.PickupRemark, Labels.PickupRemark, new { @class = "control-label" })
                </div>
                <div class="input-form">
                    @Html.TextAreaFor(model => model.PickupRemark, new { @class = "form-control", maxlength = 200 })
                </div>
            </li>
            <li class="list-group-item form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.Skype, new { @class = "control-label" })
                </div>
                <div class="input-form">
                    @Html.TextBoxFor(model => model.Skype, new { @class = "form-control" })
                </div>
            </li>
            <li class="list-group-item form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.LetsTalk, Labels.LetsTalk, new { @class = "control-label" })
                </div>
                <div class="input-form">
                    @Html.TextBoxFor(model => model.LetsTalk, new { @class = "form-control" })
                </div>
            </li>
        </ul>
    </div>
    <div class="panel panel-default">
        <div class="panel-heading">
            <span class="fa fa-chevron-down"></span>
            <span>@Labels.Information</span>
        </div>
        <ul class="list-group">
            <li class="list-group-item form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.Team.Id, Labels.SectionTeam, new { @class = "control-label" })
                </div>
                @Html.HiddenFor(model => model.Team.Id)
                <div class="select-form" id="Team"></div>
            </li>
            <li class="list-group-item form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.TeamDate, new { @class = "control-label" })
                </div>
                <div class="calendar-form">
                    @{ var teamDate = Model.TeamDate.HasValue ? Model.TeamDate.ToDateMonthYearFormatedDate() : string.Empty; }
                    @Html.TextBox("TeamDate", teamDate, new { @class = "datepicker form-control" })
                    <i class="icon-calendar fa fa-calendar"></i>
                </div>
            </li>
            <li class="list-group-item form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.JobTitleId, new { @class = "control-label" })
                </div>
                <div class="select-form">
                    @Html.DropDownListFor(model => model.JobTitleId, new SelectList(ViewBag.JobTitles, "Id", "Name"), "--Select a Job Title--", new { @class = "form-control" })
                </div>
            </li>
            <li class="list-group-item form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.JobLevelId, new { @class = "control-label" })
                </div>
                <div class="select-form">
                    @Html.DropDownListFor(model => model.JobLevelId, new SelectList(ViewBag.JobLevel, "Id", "Name"), "--Select a Job Level--", new { @class = "form-control" })
                </div>
            </li>
            <li class="list-group-item form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.ExpertGradeId, new { @class = "control-label" })
                </div>
                <div class="select-form">
                    @Html.DropDownListFor(model => model.ExpertGradeId, new SelectList(ViewBag.Grades, "Id", "Name"), "--Select an Expert Grade--", new { @class = "form-control" })
                </div>
            </li>
            <li class="list-group-item form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.PromotionDate, new { @class = "control-label" })
                </div>
                <div class="calendar-form">
                    @{ var promotionDate = Model.PromotionDate.HasValue ? Model.PromotionDate.ToDateMonthYearFormatedDate() : string.Empty; }
                    @Html.TextBox("PromotionDate", promotionDate, new { @class = "datepicker form-control" })
                    <i class="icon-calendar fa fa-calendar"></i>
                </div>
            </li>
            <li class="list-group-item form-group @(enableGroupDate ? "" : "hide-group-date")">
                <div class="label-form">
                    @Html.LabelFor(model => model.JoinedDate, Labels.GroupDate, new { @class = "control-label" })
                </div>
                <div class="calendar-form">
                    @{ var joinedDate = Model.JoinedDate.HasValue ? Model.JoinedDate.ToDateMonthYearFormatedDate() : string.Empty; }
                    @Html.TextBox("JoinedDate", joinedDate, new { @class = "datepicker form-control" })
                    <i class="icon-calendar fa fa-calendar"></i>
                </div>
            </li>
            <li class="list-group-item form-group">
