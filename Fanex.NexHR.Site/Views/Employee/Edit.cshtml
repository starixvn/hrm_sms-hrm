                        new SelectListItem() {Text = "Expat", Value = "false"},
                    };
						}
						@Html.DropDownListFor(model => model.IsLocal, empType)
					</div>
					<div class="clear">
					</div>
				</div>
				<div class="line" id="expatHoliday">
