@model Employee
@{
    ViewBag.Title = "Edit";
    var roles = (IEnumerable<Nexus.RoleManagement.Services.SystemRoleModel>)ViewBag.Roles;
    var roleItemList = roles.Select(i => new SelectListItem() { Text = i.RoleName, Value = i.RoleId });
}
@section css{
    @Url.CombresLink("employeeeditcss")
}
@section js{
    @Url.CombresLink("employeeeditjs")
}
@section Breadcrumb
{
    <a class="step" href="javascript:;">HR</a>
    <a class="step" href="@Url.Action("usermanagement", "employee")">@Labels.EmployeeManagement</a>
    <span class="step">Edit @Model.NickName (@Model.FullName) 's Personal Information</span>
}
@using (Html.BeginForm("Edit", "Employee", FormMethod.Post, new { @id = "formEditUser" }))
{
    <div class="bunhat">
        @Html.ValidationSummary(false)
        @if (ViewBag.Updated != null && (bool)ViewBag.Updated)
        {
            <div class="success flash">
                @Labels.Saved
            </div>
        }
        else if (ViewBag.Updated != null && !(bool)ViewBag.Updated)
        {
            <div class="error flash">@Messages.ErrorTryAgain</div>
        }
        <div class="employeeInfo">
            <div class="boxtitle">
                <span class="fa fa-chevron-down"></span>
                <span>@Labels.Personal</span>
            </div>
            <div class="boxcontent">
                <div class="line">
                    <div class="label">
                        @Html.Label(Labels.Avatar)
                    </div>
                    <div class="pcontent">
                        <img id="avatar" class="img-employee" src="~/employee/avatar/@(Model.Code)?f=@(Utilities.RandomString(4))" alt="@Model.FullName" /><br />
                        <input type="file" id="file" />
                        <input type="button" id="upload" value="Upload" />
                    </div>
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label">
                        @Html.LabelFor(model => model.Code, Labels.EmployeeID)
                    </div>
                    <div class="input">
                        @Html.EditorFor(model => model.Code)
                        @Html.ValidationMessageFor(model => model.Code)
                    </div>
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label">
                        @Html.LabelFor(model => model.EmployeeCard)
                    </div>
                    <div class="input">
                        @Html.TextBoxFor(model => model.EmployeeCard, new { maxlength = "10" })
                        @Html.ValidationMessageFor(model => model.EmployeeCard)
                    </div>
                </div>
                <div class="line">
                    <div class="label">
                        @Html.LabelFor(model => model.DomainUsername)
                    </div>
                    <div class="input">
                        @Html.EditorFor(model => model.DomainUsername)
                        @Html.ValidationMessageFor(model => model.DomainUsername)
                    </div>
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label">
                        @Html.LabelFor(model => model.FullName)
                    </div>
                    <div class="input">
                        @Html.EditorFor(model => model.FullName)
                        @Html.ValidationMessageFor(model => model.FullName)
                    </div>
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label">
                        @Html.LabelFor(model => model.NickName)
                    </div>
                    <div class="input">
                        @Html.EditorFor(model => model.NickName)
                        @Html.ValidationMessageFor(model => model.NickName)
                    </div>
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label">
                        @Html.LabelFor(model => model.DateOfBirth)
                    </div>
                    <div class="input">
                        <div id="DOBPicker">
                        </div>
                    </div>
                    @Html.HiddenFor(model => model.DateOfBirth)
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label">
                        @Html.LabelFor(model => model.PlaceOfBirth)
                    </div>
                    <div class="input">
                        <div id="DOBPicker">
                        </div>
                    </div>
                    @Html.EditorFor(model => model.PlaceOfBirth)
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label">
                        @Html.LabelFor(model => model.Ethnic)
                    </div>
                    <div class="input">
                        <div id="DOBPicker">
                        </div>
                    </div>
                    @Html.EditorFor(model => model.Ethnic)
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label">
                        @Html.LabelFor(model => model.Native)
                    </div>
                    <div class="input">
                        <div id="DOBPicker">
                        </div>
                    </div>
                    @Html.EditorFor(model => model.Native)
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label">
                        @Html.LabelFor(model => model.Religion)
                    </div>
                    <div class="input">
                        <div id="DOBPicker">
                        </div>
                    </div>
                    @Html.EditorFor(model => model.Religion)
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label">
                        @Html.LabelFor(model => model.Gender)
                    </div>
                    <div class="input">
                        @{
    var gender = new List<SelectListItem>
                            {
                                new SelectListItem() {Text = "Unknown", Value = ""},
                                new SelectListItem() {Text = "Female", Value = "0"},
                                new SelectListItem() {Text = "Male", Value = "1"}
                            };
                        }
                        @Html.DropDownListFor(model => model.Gender, gender)
                        @Html.ValidationMessageFor(model => model.Gender)
                    </div>
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label">
                        @Html.Label(Labels.Marriage)
                    </div>
                    <div class="input">
                        @Html.DropDownListFor(model => model.Marriage, (IList<SelectListItem>)ViewBag.Marriages)
                    </div>
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label">
                        @Html.Label(Labels.Nationality)
                    </div>
                    <div class="input">
                        @Html.DropDownListFor(x => x.CountryCode, Model.ListCountryCode, new { @class = "dropdown", @style = "width : 230px;" })
                    </div>
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label">
                        @Html.Label(Labels.IDCardNo)
                    </div>
                    <div class="input">
                        @Html.EditorFor(model => model.CardNo)
                    </div>
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label">
                        @Html.Label(Labels.IDCardIssueDate)
                    </div>
                    <div class="input">
                        @Html.DatePickerFor(model => model.DateOfIdCard)
                    </div>
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label">
                        @Html.Label(Labels.IDCardPlaceOfIssue)
                    </div>
                    <div class="input">
                        @Html.EditorFor(model => model.PlaceOfIdCard)
                    </div>
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label">
                        @Html.LabelFor(model => model.PassportNo)
                    </div>
                    <div class="input">
                        @Html.EditorFor(model => model.PassportNo)
                    </div>
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label">
                        @Html.LabelFor(model => model.PassportExp)
                    </div>
                    <div class="input">
                        @Html.DatePickerFor(model => model.PassportExp)
                    </div>
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label">
                        @Html.LabelFor(model => model.Qualification)
                    </div>
                    <div class="input">
                        @Html.EditorFor(model => model.Qualification)
                    </div>
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label">
                        @Html.LabelFor(model => model.Major)
                    </div>
                    <div class="input">
                        @Html.EditorFor(model => model.Major)
                    </div>
                    <div class="clear">
                    </div>
                </div>
            </div>
        </div>
