                <div class="label-form">@Labels.DisciplineManager</div>
                <div>
                    <span id="lstDisciplinarian" class="list-supervisor">@Model.Disciplinarian</span>
                    @Html.ActionLink("Update", "DisciplineManager", "Employee", new { id = Model.Id }, null)
                </div>
            </li>
            <li class="list-group-item form-group">
                <div class="label-form">@Labels.ShiftArrangement</div>
                <div>
                    <span class="list-supervisor">@Model.EmpShiftList</span>
                    @Html.ActionLink("Update", "ShiftManager", "Employee", new { id = Model.Id }, null)
                </div>
            </li>
            <li class="list-group-item form-group">
                <div class="label-form">@Labels.OnBehalfRequest</div>
                <div>
                    <span class="list-supervisor">@Model.ActingEmpList</span>
                    @Html.ActionLink("Update", "ManageSupervisor", "Employee", new { id = Model.Id, roleId = (short)RoleSystem.OnBehalfRequest }, null)
                </div>
            </li>
            <li class="list-group-item form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.IsLocal, Labels.Category, new { @class = "control-label" })
                </div>
                <div class="select-form">
                    @{
                        var empType = new List<SelectListItem>
                        {
                            new SelectListItem() {Text = Labels.Local, Value = "true"},
                            new SelectListItem() {Text = Labels.Expat, Value = "false"},
                        };
                    }
                    @Html.DropDownListFor(model => model.IsLocal, empType, new { @class = "form-control" })
                </div>
            </li>
            <li class="list-group-item form-group" id="expatHoliday">
                <div class="label-form">
                    @Html.LabelFor(model => model.IsExpatUseHoliday, Labels.ExpatApplicableHoliday, new { @class = "control-label" })
                </div>
                <div class="input-form">
                    <div class="checkbox">@Html.CheckBoxCustomFor(model => model.IsExpatUseHoliday)</div>
                </div>
            </li>
            <li class="list-group-item form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.Enabled, Labels.EnabledUser, new { @class = "control-label" })
                </div>
                <div class="input-form">
                    <div class="checkbox">@Html.CheckBoxCustomFor(model => model.Enabled)</div>
                </div>
            </li>
        </ul>
    </div>
    <div class="menu">
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.Id)
        @Html.HiddenFor(model => model.UserId)
        <input type="button" value="@Labels.Save" id="postform" class="btn btn-primary" />
        <input type="button" id="delete" value="@Labels.Delete" class="btn btn-danger" />
        <input type="button" id="resetpassword" value="Reset Password" class="btn btn-primary" />
    </div>
}