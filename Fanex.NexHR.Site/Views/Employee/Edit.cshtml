				</div>
				<div class="line">
					<div class="label">
						@Html.Label("ID Card Place Of Issue")
					</div>
					<div class="input">
						@Html.EditorFor(model => model.PlaceOfIdCard)
					</div>
					<div class="clear">
					</div>
				</div>
				<div class="line">
					<div class="label">
						@Html.LabelFor(model => model.PassportNo)
					</div>
					<div class="input">
						@Html.EditorFor(model => model.PassportNo)
					</div>
					<div class="clear">
					</div>
				</div>
				<div class="line">
					<div class="label">
						@Html.LabelFor(model => model.PassportExp)
					</div>
					<div class="input">
						@Html.DatePickerFor(model => model.PassportExp)
					</div>
					<div class="clear">
					</div>
				</div>
				<div class="line">
					<div class="label">
						@Html.LabelFor(model => model.Qualification)
					</div>
					<div class="input">
						@Html.EditorFor(model => model.Qualification)
					</div>
					<div class="clear">
					</div>
				</div>
				<div class="line">
					<div class="label">
						@Html.LabelFor(model => model.Major)
					</div>
					<div class="input">
						@Html.EditorFor(model => model.Major)
					</div>
					<div class="clear">
