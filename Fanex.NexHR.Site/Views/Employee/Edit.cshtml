            </li>
            <li class="list-group-item form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.IsTopManager, new { @class = "control-label" })
                </div>
                <div class="input-form">
                    <div class="checkbox">@Html.CheckBoxCustomFor(model => model.IsTopManager)</div>
                </div>
            </li>
            <li class="list-group-item form-group">
                <div class="label-form">@Labels.VerifiedBy</div>
                <div>
                    <span id="lstVerifier" class="list-supervisor">@Model.Verifier</span>
                    @Html.ActionLink("Update", "ManageSupervisor", "Employee", new { id = Model.Id, roleId = (short)RoleSystem.Verifier }, null)
                </div>
            </li>
            <li class="list-group-item form-group">
