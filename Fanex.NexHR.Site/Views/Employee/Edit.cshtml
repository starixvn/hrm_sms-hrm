                    </div>
                    <div class="input">
                        @Html.EditorFor(model => model.Email)
                        @Html.ValidationMessageFor(model => model.Email)
                    </div>
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label">
                        @Html.LabelFor(model => model.Address)
                    </div>
                    <div class="input">
                        @Html.TextAreaFor(model => model.Address)
                    </div>
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label">
                        @Html.LabelFor(model => model.CurrentAddress)
                    </div>
                    <div class="input">
                        @Html.TextAreaFor(model => model.CurrentAddress)
                    </div>
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label">
                        @Html.LabelFor(model => model.Skype)
                    </div>
                    <div class="input">
                        @Html.EditorFor(model => model.Skype)
                        @Html.ValidationMessageFor(model => model.Skype)
                    </div>
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label">
                        @Html.LabelFor(model => model.Yahoo)
                    </div>
                    <div class="input">
                        @Html.EditorFor(model => model.Yahoo)
                        @Html.ValidationMessageFor(model => model.Yahoo)
                    </div>
                    <div class="clear">
                    </div>
                </div>
            </div>
        </div>
        <div class="employeeInfo">
            <div class="boxtitle">
                <span class="fa fa-chevron-down"></span>
                <span>@Labels.Information</span>
            </div>
            <div class="boxcontent">
                <div class="line">
                    <div class="label">
                        @Html.LabelFor(model => model.Unit, Labels.CostCenter)
                    </div>
                    <div class="input">
                        @Html.EditorFor(model => model.Unit)
                        @Html.ValidationMessageFor(model => model.Unit)
                    </div>
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label">
                        @Html.LabelFor(model => model.Team.Id, Labels.DepartmentSection)
                    </div>
                    <div class="input">
                        @Html.DropDownListFor(model => model.Team.Id, new SelectList(ViewBag.Groups, "Id", "Name"), "--Select a Team--")
                        @Html.ValidationMessageFor(model => model.Team.Id)
                    </div>
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label">
                        @Html.LabelFor(model => model.JobTitleId)
                    </div>
                    <div class="input">
                        @Html.DropDownListFor(model => model.JobTitleId, new SelectList(ViewBag.JobTitles, "Id", "Name"), "--Select a Job Title--", new { @style = "width : 230px;" })
                        @Html.ValidationMessageFor(model => model.JobTitleId)
                    </div>
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label marginlable">
                        @Html.Label(Labels.VerifiedBy)
                    </div>
                    <div class="input">
                        <span id="lstVerifier">@Model.Verifier</span>
                        @Html.ActionLink("Update", "Supervisor", "Employee", new { role = (short)RoleSystem.Verifier, employeeId = Model.Id }, new { @class = "linkUpdate" })
                    </div>
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label marginlable">
                        @Html.Label(Labels.ApprovedBy)
                    </div>
                    <div class="input">
                        <span id="lstApprover">@Model.Approver</span>
                        @Html.ActionLink("Update", "Supervisor", "Employee", new { role = (short)RoleSystem.Approver, employeeId = Model.Id }, new { @class = "linkUpdate" })
                    </div>
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label marginlable">
                        @Html.Label(Labels.EditDiscipline)
                    </div>
                    <div class="input">
                        <span id="lstDisciplinarian">@Model.Disciplinarian</span>
                        @Html.ActionLink("Update", "DisciplineSetting", "Employee", new { employeeId = Model.Id }, new { @class = "linkUpdate" })
                    </div>
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label">
                        @Html.LabelFor(model => model.JoinedDate, Labels.GroupDate)
                    </div>
                    <div class="input">
                        @Html.DatePickerFor(model => model.JoinedDate)
                    </div>
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label">
                        @Html.LabelFor(model => model.CompanyDate, Labels.CompanyDate)
                    </div>
                    <div class="input">
                        @Html.DatePickerFor(model => model.CompanyDate)
                    </div>
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label">
                        @Html.LabelFor(model => model.ConfirmedDate)
                    </div>
                    <div class="input">
                        @Html.DatePickerFor(model => model.ConfirmedDate)
                        @Html.ValidationMessageFor(model => model.ConfirmedDate)
                    </div>
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label">
                        @Html.LabelFor(model => model.ResignedDate)
                    </div>
                    <div class="input">
                        @Html.DatePickerFor(model => model.ResignedDate)
                        @Html.ValidationMessageFor(model => model.ResignedDate)
                    </div>
                    <div class="clear">
                    </div>
                </div>
            </div>
        </div>
        <div class="employeeInfo">
            <div class="boxtitle">
                <span class="fa fa-chevron-down"></span>
                <span>@Labels.Policy</span>
            </div>
            <div class="boxcontent">
                <div class="line">
                    <div class="label marginlable">
                        @Html.Label(Labels.AllowClaimOT)
                    </div>
                    <div class="input">
                        @Html.CheckBoxFor(model => model.CanOT)
                    </div>
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label">
                        @Html.Label(Labels.WorkingDaysPerMonth)
                    </div>
                    <div class="input">
                        @Html.TextBoxFor(model => model.WorkingDays)
                        @Html.ValidationMessageFor(model => model.WorkingDays)
                    </div>
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label">
                        @Html.Label(Labels.WorkingHoursPerDay)
                    </div>
                    <div class="input">
                        @Html.TextBoxFor(model => model.WorkingHours)
                        @Html.ValidationMessageFor(model => model.WorkingHours)
                    </div>
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label">
                        @Html.Label(Labels.NumberOfOffday)
                    </div>
                    <div class="pcontent">
                        @Html.TextBoxFor(model => model.OffDaysbyWeek)
                        @Html.ValidationMessageFor(model => model.OffDaysbyWeek)
                    </div>
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label marginlable">
                        @Html.Label(Labels.LeaveBalance)
                    </div>
                    <div class="input">
                        @Model.AnnualLeaveBalance day(s)
                        <a href="~/annualleavebalance/employee/@Model.Id" class="linkUpdate">Update</a>
                    </div>
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label marginlable">
                        @Html.Label(Labels.KIVBalance)
                    </div>
                    <div class="input">
                        @Model.KeepInViewBalance day(s)
                    </div>
                    <div class="clear">
                    </div>
                </div>
            </div>
        </div>
        <div class="employeeInfo">
            <div class="boxtitle">
                <span class="fa fa-chevron-down"></span>
                <span>@Labels.Permission</span>
            </div>
            <div class="boxcontent">
                <div class="line role-system">
                    <div class="label marginlable">
                        @Html.Label(Labels.AuthorityLevel)
                    </div>
                    <div class="input" id="userRole">
                        @Html.CheckBox("Member", true, new { disabled = true })
                            @Html.Label("Member", "Member")
                        @Html.CheckBoxListFor(model => model.RoleArray, roleItemList)
                        @Html.ValidationMessageFor(model => model.RoleArray)
                    </div>
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label marginlable">
                        @Html.LabelFor(model => model.IsTopManager)
                    </div>
                    <div class="input">
                        @Html.CheckBoxFor(model => model.IsTopManager)
                    </div>
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label marginlable">
                        @Html.Label(Labels.ShiftArrangement)
                    </div>
                    <div class="input">
                        @Model.EmpShiftList
                        @Html.ActionLink("Update", "ShiftManager", "Employee", new { role = (short)RoleSystem.ShiftManager, employeeId = Model.Id }, new { @class = "linkUpdate" })
                    </div>
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label marginlable">
                        @Html.Label(Labels.OnBehalfRequest)
                    </div>
                    <div class="input">
                        @Model.ActingEmpList
                        @Html.ActionLink("Update", "Supervisor", "Employee", new { role = (short)RoleSystem.ActingSupervisor, employeeId = Model.Id }, new { @class = "linkUpdate" })
                    </div>
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
                    <div class="label">
                        @Html.Label(Labels.Category)
                    </div>
                    <div class="input">
                        @{
    var empType = new List<SelectListItem>
                            {
                                new SelectListItem() {Text = "Local", Value = "true"},
                                new SelectListItem() {Text = "Expat", Value = "false"},
                            };
                        }
                        @Html.DropDownListFor(model => model.IsLocal, empType)
                    </div>
                    <div class="clear">
                    </div>
                </div>
                <div class="line" id="expatHoliday">
                    <div class="label marginlable">
                        @Html.LabelFor(model => model.IsExpatUseHoliday, Labels.ExpatApplicableHoliday)
                    </div>
                    <div class="input">
                        @Html.CheckBoxFor(model => model.IsExpatUseHoliday)
                    </div>
                    <div class="clear">
                    </div>
                </div>
                <div class="line">
