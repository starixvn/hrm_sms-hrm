				</div>
				<div class="line">
					<div class="label">
						@Html.Label("ID Card No")
					</div>
					<div class="input">
						@Html.EditorFor(model => model.CardNo)
					</div>
					<div class="clear">
					</div>
				</div>
				<div class="line">
					<div class="label">
						@Html.Label("ID Card Issue Date")
