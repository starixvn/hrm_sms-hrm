@model Employee
@{
    ViewBag.Title = Model.NickName + " (" + Model.FullName + ") 's Personal Information";
    var hasPermission = (bool)ViewBag.HasPermission;
}
@section css{
    @Url.CombresLink("accountcss")
}
@section js{
    @Url.CombresLink("accountjs")
}
@section Breadcrumb {
    <a class="step">Personal</a>
    @if (hasPermission)
    {
        <a class="step" href="@Url.Action("usermanagement", "employee")">@Labels.EmployeeManagement</a>
    }
    else
    {
        <a class="step" href="@Url.Action("index", "employee")">Contact list</a>
    }
    <span class="step">@ViewBag.Title</span>
}
<div class="leftpersonal">
    <div class="avatarbox panel panel-default">
        <div class="panel-heading">
            <div class="avatar">
                <img class="img-employee" src="~/employee/avatar/@(Model.Code)" alt="@Model.NickName" />
            </div>
            <div class="pinfo">
                <span class="name">@Model.FullName</span>
                <p class="accinfo">
                    @Model.DomainUsername<br>
                    <br>
                    Staff ID: @Model.Code
                </p>
            </div>
        </div>
    </div>
    <div class="panel panel-default">
        <div class="panel-heading">
            PERSONAL INFORMATION
        </div>
        <ul class="list-group">
            <li class="list-group-item">
                <div class="label">@Labels.FullName:</div>
                <div class="pcontent">@Model.FullName</div>
                <div class="clear"></div>
            </li>
            <li class="list-group-item">
                <div class="label">@Labels.Nick:</div>
                <div class="pcontent">@Model.NickName</div>
                <div class="clear"></div>
            </li>
            @if (hasPermission)
            {
                <li class="list-group-item">
                    <div class="label">D.O.B:</div>
                    <div class="pcontent">
                        @Model.DateOfBirth.ToDateMonthYearFormatedDate()
                    </div>
                    <div class="clear"></div>
                </li>
            }
            <li class="list-group-item">
                <div class="label">@Labels.Gender:</div>
                <div class="pcontent">
                    @(Model.Gender == 1 ? Labels.Male : Labels.Female)
                </div>
                <div class="clear"></div>
            </li>
            <li class="list-group-item">
                <div class="label">@Labels.Nationality:</div>
                <div class="pcontent">@Model.CountryName</div>
                <div class="clear"></div>
            </li>
            @if (hasPermission)
            {
                <li class="list-group-item">
                    <div class="label">@Labels.Marriage:</div>
                    <div class="pcontent">
                        @{
                            MarriageStatus status = (MarriageStatus)Model.Marriage;
                        }
                        @(Model.Marriage == null ? "Unknown" : status.ToString())
                    </div>
                    <div class="clear"></div>
                </li>
                <li class="list-group-item">
                    <div class="label">@Labels.CardNo:</div>
                    <div class="pcontent">@Model.CardNo</div>
                    <div class="clear"></div>
                </li>
                if (!string.IsNullOrEmpty(Model.PassportNo))
                {
                    <li class="list-group-item">
                        <div class="label">@Labels.PassportNo:</div>
                        <div class="pcontent">@Model.PassportNo</div>
                        <div class="clear"></div>
                    </li>
                }
                if (Model.PassportExp.HasValue)
                {
                    <li class="list-group-item">
                        <div class="label">@Labels.PassportExp:</div>
                        <div class="pcontent">
                            @Model.PassportExp.Value.ToDateMonthYearFormatedDate()
                        </div>
                        <div class="clear"></div>
                    </li>
                }
                if (Model.WorkingDays > 0)
                {
                    <li class="list-group-item">
                        <div class="label">@Labels.WorkingDays:</div>
                        <div class="pcontent">
                            @Model.WorkingDays
                        </div>
                        <div class="clear"></div>
                    </li>
                }
                if (Model.WorkingHours > 0)
                {
                    <li class="list-group-item">
                        <div class="label"> Working Hours: </div>
                        <div class="pcontent">@Model.WorkingHours</div>
                        <div class="clear"> </div>
                    </li>
                }
            }
        </ul>
    </div>
    <div class="panel panel-default">
        <div class="panel-heading">
            JOB INFORMATION
        </div>
        <ul class="list-group">
            <li class="list-group-item">
                <div class="label">@Labels.JobTitle:</div>
                <div class="pcontent">@Model.JobTitle</div>
                <div class="clear"></div>
            </li>
            <li class="list-group-item">
                <div class="label">@Labels.Section:</div>
                <div class="pcontent">@Model.Team.Name</div>
                <div class="clear"></div>
            </li>
            <li class="list-group-item">
                <div class="label">@Labels.Roles:</div>
                <div class="pcontent role">
                    @Model.NX_Roles2String
                </div>
                <div class="clear"></div>
            </li>
            <li class="list-group-item">
                <div class="label">@Labels.GroupDate:</div>
                <div class="pcontent">
                    @if (Model.JoinedDate.HasValue)
                    {
                        @Model.JoinedDate.Value.ToDateMonthYearFormatedDate()
                    }
                </div>
                <div class="clear"></div>
            </li>
            <li class="list-group-item">
                <div class="label">@Labels.CompanyDate:</div>
                <div class="pcontent">
                    @if (Model.CompanyDate.HasValue)
                    {
                        @Model.CompanyDate.Value.ToDateMonthYearFormatedDate()
                    }
                </div>
                <div class="clear"></div>
            </li>
            <li class="list-group-item">
                <div class="label">@Labels.ConfirmedDate:</div>
                <div class="pcontent">
                    @if (Model.ConfirmedDate.HasValue)
                    {
                        @Model.ConfirmedDate.Value.ToDateMonthYearFormatedDate()
                    }
                </div>
                <div class="clear"></div>
            </li>
            @if (Model.ResignedDate.HasValue)
            {
                <li class="list-group-item">
                    <div class="label">@Labels.ResignedDate:</div>
                    <div class="pcontent">
                        @Model.ResignedDate.Value.ToDateMonthYearFormatedDate()
                    </div>
                    <div class="clear"></div>
                </li>
            }
        </ul>
    </div>
</div>
<div class="rightjob">
    <div class="panel panel-default">
        <div class="panel-heading">
            CONTACT DETAILS
        </div>
        <ul class="list-group">
            <li class="list-group-item">
                <div class="label">@Labels.Email:</div>
                <div class="pcontent">
                    <a href="mailto:@Model.Email">@Model.Email</a>
                </div>
                <div class="clear"></div>
            </li>
            <li class="list-group-item">
                <div class="label">@Labels.Phone:</div>
                <div class="pcontent">@Model.Phone</div>
                <div class="clear"></div>
            </li>
            <li class="list-group-item">
                <div class="label">@Labels.Skype:</div>
                <div class="pcontent">
                    <a href="skype:@(Model.Skype)?chat">@Model.Skype</a>
                </div>
                <div class="clear"></div>
            </li>
            <li class="list-group-item">
                <div class="label">@Labels.Yahoo:</div>
                <div class="pcontent">
                    <a href="ymsgr:SendIM?@(Model.Yahoo)">@Model.Yahoo</a>
                </div>
                <div class="clear"></div>
            </li>
            @if (hasPermission)
            {
                <li class="list-group-item">
                    <div class="label">@Labels.Address:</div>
                    <div class="pcontent">@Model.Address</div>
                    <div class="clear"></div>
                </li>
                <li class="list-group-item">
                    <div class="label">@Labels.CurrentAddress:</div>
                    <div class="pcontent">@Model.CurrentAddress</div>
                    <div class="clear"></div>
                </li>
            }
        </ul>
    </div>
    <div class="panel panel-default">
        <div class="panel-heading">
            ATTENDANCE REPORT
        </div>
        <ul class="list-group">
            <li class="list-group-item">
                <div class="label2">@Labels.AnualLeaveBalance:</div>
                <div class="pcontent">
                    @Model.AnnualLeaveBalance day(s)
                </div>
                <div class="clear"></div>
            </li>
            <li class="list-group-item">
                <div class="label2">@Labels.KeepInViewBalance:</div>
                <div class="pcontent">
                    @Model.KeepInViewBalance day(s)
                </div>
                <div class="clear"></div>
            </li>
            @if (Model.IsDefaultSchedule)
            {
                <li class="list-group-item">
                    <div class="label2">
                        Default Working Calendar:
                    </div>
                    <div class="pcontent">
                        <div class="schedule">
                            <div class="day">@Labels.Mon:</div>
                            <div class="shift">@ViewBag.Mon</div>
                        </div>
                        <div class="schedule">
                            <div class="day">@Labels.Tue</div>
                            <div class="shift">@ViewBag.Tue</div>
                        </div>
                        <div class="schedule">
                            <div class="day">@Labels.Wed:</div>
                            <div class="shift">@ViewBag.Wed</div>
                        </div>
                        <div class="schedule">
                            <div class="day">@Labels.Thu</div>
                            <div class="shift">@ViewBag.Thu</div>
                        </div>
                        <div class="schedule">
                            <div class="day">@Labels.Fri</div>
                            <div class="shift">@ViewBag.Fri</div>
                        </div>
                        <div class="scheduleoff">
                            <div class="day">@Labels.Sat</div>
                            <div class="shift">@ViewBag.Sat</div>
                        </div>
                        <div class="scheduleoff">
                            <div class="day">@Labels.Sun</div>
                            <div class="shift">@ViewBag.Sun</div>
                        </div>
                    </div>
                </li>
            }
        </ul>
    </div>
</div>