@model MySpaceModel
@section css{
    @Url.CombresLink("myspacecss")
}
@section js{
    @Url.CombresLink("myspacejs")
}
@{
    ViewBag.Title = "Dashboard";
}
@section Breadcrumb {
    <a class="step" href="#">Personal</a> <span class="step">@ViewBag.Title</span>
}
<h2>@Labels.MySpace</h2>
@Html.Hidden("ChangePassword", (bool)ViewBag.ResetPassword)
<table class="data" id="myspace">
    <thead>
        <tr>
            <th class="firstColumn">
                @Labels.Request
            </th>
            <th>@DateTime.Now.ToString("MMM yyyy")
            </th>
            <th>
                @Labels.Pending
            </th>
            <th>
                @Labels.CreateRequest
            </th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td class="firstColumn">
                @Labels.CheckInOut
            </td>
            <td>
                @Model.TotalCheckInOutRequest
            </td>
            <td>
                @if (Model.TotalPendingCheckInOutRequest > 0)
                { 
                    @Html.ActionLink(Model.TotalPendingCheckInOutRequest.ToString(), "employeeView", "checkinout")
                }
                else
                { 
                    <span>0</span>
                }
            </td>
            <td>
                @Html.ActionLink(Labels.Request, "create", "checkinout")
            </td>
        </tr>
        <tr>
            <td class="firstColumn">
                @Labels.LateInEarlyOut
            </td>
            <td>
                @Model.TotalLateInEarlyOutRequest
            </td>
            <td>
                @if (Model.TotalPendingLateInEarlyOutRequest > 0)
                { 
                    @Html.ActionLink(Model.TotalPendingLateInEarlyOutRequest.ToString(), "employeeView", "lateinearlyout")
                }
                else
                { 
                    <span>0</span>
                }
            </td>
            <td>
                @Html.ActionLink(Labels.Request, "create", "lateinearlyout")
            </td>
        </tr>
        <tr>
            <td class="firstColumn">
                @Labels.ChangeShift
            </td>
            <td>
                @Model.TotalChangedShiftRequest
            </td>
            <td>
                @if (Model.TotalPendingChangedShiftRequest > 0)
                { 
                    @Html.ActionLink(Model.TotalPendingChangedShiftRequest.ToString(), "employeeView", "changeshift")
                }
                else
                { 
                    <span>0</span>
                }
            </td>
            <td>
                @Html.ActionLink(Labels.Request, "create", "changeshift")
            </td>
        </tr>
        <tr>
            <td class="firstColumn">
                @Labels.Leave
            </td>
            <td>
                @Model.TotalLeaveRequest
            </td>
            <td>
                @if (Model.TotalPendingLeaveRequest > 0)
                { 
                    @Html.ActionLink(Model.TotalPendingLeaveRequest.ToString(), "employeeView", "leave")
                }
                else
                { 
                    <span>0</span>
                }
            </td>
            <td>
                @Html.ActionLink(Labels.Request, "create", "leave")
            </td>
        </tr>
        <tr>
            <td class="firstColumn">
                @Labels.KeepInView
            </td>
            <td>
                @Model.TotalKivRequest
            </td>
            <td>
                @if (Model.TotalPendingKivRequest > 0)
                { 
                    @Html.ActionLink(Model.TotalPendingKivRequest.ToString(), "employeeView", "KeepInView")
                }
                else
                { 
                    <span>0</span>
                }
            </td>
            <td>
                @Html.ActionLink(Labels.Request, "create", "KeepInView")
            </td>
        </tr>
		<tr>
            <td class="firstColumn">
                @Labels.Overtime
            </td>
            <td>
                -
            </td>
            <td>
                @if (Model.TotalPendingOverTimeRequest > 0)
                { 
                    @Html.ActionLink(Model.TotalPendingOverTimeRequest.ToString(), "employeeView", "overtime")
                }
                else
                { 
                    <span>0</span>
                }
            </td>
            <td>
                @Html.ActionLink(Labels.Request, "employeeView", "overtime")
            </td>
        </tr>

    </tbody>
</table>
<div class="space">
</div>
<div id="changePasswordDialog" title="Change Password">
    <fieldset>
        <h5>
            The password for your account has been recently reset. For security reasons please
            change it now.
        </h5>
        <label class="checkbox">
            <input type="checkbox" name="chk-change" id="chk-change" />
            Don't show me this again
        </label>
    </fieldset>
</div>
@Html.Action("ManagementDashboard")
