@model IList<Fanex.NexHR.ViewModels.WorkingScheduleModel>
@{
    ViewBag.Title = "Monthly Schedule";
}
@section css{
    @Url.CombresLink("monthschedulecss")
}
@section js{
    @Url.CombresLink("monthschedulejs")
}
@section Breadcrumb {
    <a class="step">HR</a> 
    <a class="step" href="@Url.Action("usermanagement", "employee")">@Labels.EmployeeManagement</a>
    <span class="step">@ViewBag.Title</span>
}
<script>
    var id = @ViewBag.Id;
</script>
<h2>
    The Monthly Working Schedule of @ViewBag.Employee.NickName</h2>
@{
    if (((Employee)ViewBag.Employee).IsDefaultSchedule == true)
    {
    <div class="section">
        <input id="scheduledefault" type="radio" name="schedule" />
        <label for="scheduledefault">
            Default working schedule</label>
        <input id="schedulemonth" type="radio" name="schedule" />
        <label for="schedulemonth">
            View by month</label>
    </div>
    }
}
<div class="clear">
</div>
<div id="calendar">
</div>
<div class="hide">
    <div id="dialog" title="Update shift">
        <div class="formrow">
            <div class="label">
                Current shift
            </div>
            <div class="input">
                <span id="current"></span>
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                Change to
            </div>
            <div class="input">
                @Html.DropDownList("shifts", (List<SelectListItem>)ViewBag.Shifts, Labels.Off)
            </div>
            <div class="clear">
            </div>
        </div>
        <div class="space">
        </div>
        <div class="formrow">
            <div class="label">
            </div>
            <div class="input">
                <input type="button" value="@Labels.Update" id="update" />
            </div>
        </div>
    </div>
</div>
