@using Fanex.NexHR.Core
@using Fanex.NexHR.Resources
@using Fanex.NexHR.Models
@model IList<Employee>
@{
    var pagerOption = (PagerOptionModel)ViewBag.PagerOption;
    var hasPermissionToEdit = (bool)ViewBag.HasPermissionToEdit;
    var totalColumn = 13;
    totalColumn -= hasPermissionToEdit ? 0 : 1;
    bool enableGroupDate = ViewBag.EnableGroupDate;
}

<table id="data" class="table table-custom">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    @Labels.Department
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    @Labels.Section
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    @Labels.Team
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    @Labels.Code
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    @Labels.FullName
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    @Labels.NickName
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            @if (enableGroupDate)
            {
                <th class="col-sorter">
                    <div class="cell-control-wrapper">
                        @Labels.GroupDate
                        <div class="fa fa-sort cell-right-div"></div>
                    </div>
                </th>
            }
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    @Labels.JobTitle
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter col-roles">
                <div class="cell-control-wrapper">
                    @Labels.Roles
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="resignedDate">@Labels.ResignedDate</th>
            @if (hasPermissionToEdit)
            {
                <th>@Labels.ActivityLog</th>
                <th>@Labels.Edit</th>
            }
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            var index = (pagerOption.CurrentPage - 1) * pagerOption.ItemsPerPage;
            foreach (Employee employee in Model)
            {
                index++;
                var cssClass = employee.Enabled ? "" : "disabled";
                <tr class="@cssClass">
                    <td>@index</td>
                    <td>@employee.Team.Section.Department.Code</td>
                    <td>@employee.Team.Section.Code</td>
                    <td>@employee.Team.Code</td>
                    <td>@employee.Code</td>
                    <td class="align-left">@employee.FullName</td>
                    <td>
                        <a class="avatar-tooltip" data-code="@employee.Code" href="@Url.Action("detail", "employee", new { id = employee.Id })">@employee.NickName</a>
                    </td>
                    @if (enableGroupDate)
                    {
                        <td>
                            @if (employee.JoinedDate.HasValue)
                            {
                                @employee.JoinedDate.Value.ToDateMonthYearFormatedDate()
                            }
                        </td>
                    }
                    <td class="align-left">@employee.JobTitle</td>
                    <td class="align-left">@employee.Roles2String</td>
                    <td class="resignedDate">
                        @if (employee.ResignedDate.HasValue)
                        {
                            @employee.ResignedDate.Value.ToDateMonthYearFormatedDate()
                        }
                    </td>
                    @if (hasPermissionToEdit)
                    {
                        <td>
                            <a href="@Url.Action("ActivityLog", "employee", new { id = employee.Id })" title="@Labels.ActivityLog">
                                <i class="fa fa-search fa-lg icon-edit"></i>
                            </a>
                        </td>
                        <td>
                            <a href="@Url.Action("edit", "employee", new { id = employee.Id })" title="Edit">
                                <i class="fa fa-pencil fa-lg icon-edit"></i>
                            </a>
                        </td>
                        <td>
                            <a href="javascript:;" class="xicon avatar fullSizeAvatar" data-code="@employee.Code" data-nickName="@employee.NickName"></a>
                        </td>
                    }
                </tr>
            }
        }
        else
        {
            @RazorHelper.DisplayNoInformation(totalColumn)
        }
    </tbody>
    @if (Model.Any())
    {
        <tfoot>
            <tr>
                <td colspan="@totalColumn" id="pagination">
                    @{
                        var from = (pagerOption.CurrentPage - 1) * pagerOption.ItemsPerPage + 1;
                        var to = from + (Model.Count - 1);
                        IList<SelectListItem> itemsPerPageArray = pagerOption.ItemsPerPageArray.Select(x => new SelectListItem
                        {
                            Text = x.Text,
                            Value = x.Value,
                            Selected = x.Value == pagerOption.ItemsPerPage.ToString()
                        }).ToList();
                    }
                    @Html.Hidden("CurrentPage", (int)pagerOption.CurrentPage)
                    @Html.Hidden("ItemsPerPage", (int)pagerOption.ItemsPerPage)
                    @Html.Hidden("TotalItem", (int)pagerOption.TotalItem)
                    @Html.DropDownList("ItemsPerPageOption", itemsPerPageArray, new { @class = "itemsPerPageOption form-control" })
                    <div class="detailtext">
                        Showing <strong>@from</strong> to <strong>@to</strong> of <strong>@pagerOption.TotalItem</strong> entries
                    </div>
                    <ul id="numberlist" class="pagination"></ul>
                </td>
            </tr>
        </tfoot>
    }
</table>
