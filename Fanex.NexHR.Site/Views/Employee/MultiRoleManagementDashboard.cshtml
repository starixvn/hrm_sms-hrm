                    }
                    else
                    {
                        <span>0</span>
                    }
                </td>
                <td>@item.TotalApprovedChangeShiftRequest
                </td>
                <td>@item.TotalRejectChangeShiftRequest
                </td>
            </tr>
            <tr>
                <td class="firstColumn">@Fanex.NexHR.Resources.Labels.Leave
                </td>
                <td>
                    @if (item.TotalPendingLeaveRequest > 0)
                    {
                        requestModel.RequestType = 4;
                        requestModel.FromDate = minRequestDate;
                        <a href="@Url.Action("member", "request", requestModel)">@item.TotalPendingLeaveRequest.ToString()</a>
                    }
                    else
                    {
                        <span>0</span>
                    }
                </td>
                <td>@item.TotalApprovedLeaveRequest
                </td>
                <td>@item.TotalRejectLeaveRequest
                </td>
            </tr>

            <tr>
                <td class="firstColumn">@Fanex.NexHR.Resources.Labels.KeepInView

                </td>
                <td>
                    @if (item.TotalPendingKIVRequest > 0)
                    {
                        requestModel.RequestType = 5;
                        requestModel.FromDate = minRequestDate;
