                    }
                    else
                    {
                        <span>0</span>
                    }
                </td>
                <td>@item.TotalApprovedKIVRequest
                </td>
                <td>@item.TotalRejecteKIVRequest
                </td>
            </tr>
        </tbody>
    </table>
    }
    if (item.RoleId == (int)RolesEnum.Approver)
    { 
     <h4>Approval List</h4>
