@model List<HrLeaderDashboardModel>
<h2 class="section">
    My members' requests</h2>
@foreach (var item in Model)
{
    if (item.RoleId == (int)RolesEnum.Verifier)
    {
    <h4>Verification List</h4>
    <table class="data" id="myspace">
        <thead>
            <tr>
                <th rowspan="2" class="firstColumn">@Fanex.NexHR.Resources.Labels.Request
                </th>
                <th colspan="3" class="center">
                    @DateTime.Now.AddDays(-7).Day - @DateTime.Now.ToString("dd MMM, yyyy")
                </th>
            </tr>
            <tr>
                <th>@Fanex.NexHR.Resources.Labels.Pending
                </th>
                <th>@Fanex.NexHR.Resources.Labels.Verified
                </th>
                <th>@Fanex.NexHR.Resources.Labels.NotVerified
                </th>
            </tr>
        </thead>
        <tbody>
            @{
        var requestModel = new RequestViewModel
        {
            DateOption = 0,
            ToDate = DateTime.Now,
            FromDate = DateTime.Now.AddDays(-7),
            StatusId = (byte)CurrentRequestStatus.Pending,
            TeamIds = string.Empty
        };
        var minRequestDate = DateTime.Now.AddMonths(-4).Date;
            }
            <tr>
                <td class="firstColumn">@Fanex.NexHR.Resources.Labels.CheckInOut
                </td>
                <td>
                    @if (item.TotalPendingCheckInOutRequest > 0)
                    {
                        requestModel.RequestType = 1;
                        requestModel.FromDate = minRequestDate;
                        <a href="@Url.Action("member", "request", requestModel)">@item.TotalPendingCheckInOutRequest.ToString()</a>
                    }
                    else
                    {
                        <span>0</span>
                    }
                </td>
                <td>@item.TotalApprovedCheckInOutRequest
                </td>
                <td>@item.TotalRejectCheckInOutRequest
                </td>
            </tr>
            <tr>
                <td class="firstColumn">@Fanex.NexHR.Resources.Labels.LateInEarlyOut
                </td>
                <td>
                    @if (item.TotalPendingLateInEarlyOutRequest > 0)
                    {
                        requestModel.RequestType = 2;
                        requestModel.FromDate = minRequestDate;
                        <a href="@Url.Action("member", "request", requestModel)">@item.TotalPendingLateInEarlyOutRequest.ToString()</a>
                    }
                    else
                    {
                        <span>0</span>
                    }
                </td>
                <td>@item.TotalApprovedLateInEarlyOutRequest
                </td>
                <td>@item.TotalRejectLateInEarlyOutRequest
                </td>
            </tr>
            <tr>
                <td class="firstColumn">@Fanex.NexHR.Resources.Labels.ChangeShift
                </td>
