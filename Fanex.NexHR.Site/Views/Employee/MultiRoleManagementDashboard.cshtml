@model List<HRLeaderDashboardModel>
<h2 class="section">
    My members' requests</h2>
@foreach (var item in Model)
{
    if (item.RoleId == (int)RoleSystem.Verifier)
    {
    <h4>
        Verification List</h4>
    <table class="data" id="myspace">
        <thead>
            <tr>
                <th rowspan="2" class="firstColumn">@Fanex.NexHR.Resources.Labels.Request
                </th>
                <th rowspan="2">@Fanex.NexHR.Resources.Labels.Pending
                </th>
                <th colspan="3" class="center">
                    @DateTime.Now.AddDays(-7).Day - @DateTime.Now.ToString("dd MMM, yyyy")
                </th>
            </tr>
            <tr>
                <th>@Fanex.NexHR.Resources.Labels.Verified
                </th>
                <th>@Fanex.NexHR.Resources.Labels.NotVerified
                </th>
            </tr>
        </thead>
        <tbody>
            @{
        var requestModel = new RequestViewModel
        {
            DateOption = 0,
            ToDate = DateTime.Now,
            FromDate = DateTime.Now.AddDays(-7),
            StatusId = (byte)CurrentRequestStatus.Pending,
            TeamIds = string.Empty,
            IsDailyRequest = false
        };
        var minRequestDate = DateTime.Now.AddMonths(-4).Date;
            }
            <tr>
                <td class="firstColumn">@Fanex.NexHR.Resources.Labels.CheckInOut
                </td>
                <td>
                    @if (item.TotalPendingCheckInOutRequest > 0)
                    {
                        requestModel.RequestType = 1;
                        requestModel.FromDate = minRequestDate;
                        <a href="@Url.Action("member", "request", requestModel)">@item.TotalPendingCheckInOutRequest.ToString()</a>
                    }
                    else
                    {
                        <span>0</span>
                    }
                </td>
                <td>@item.TotalApprovedCheckInOutRequest
                </td>
                <td>@item.TotalRejectCheckInOutRequest
                </td>
            </tr>
            <tr>
                <td class="firstColumn">@Fanex.NexHR.Resources.Labels.LateInEarlyOut
                </td>
                <td>
                    @if (item.TotalPendingLateInEarlyOutRequest > 0)
                    {
                        requestModel.RequestType = 2;
                        requestModel.FromDate = minRequestDate;
                        <a href="@Url.Action("member", "request", requestModel)">@item.TotalPendingLateInEarlyOutRequest.ToString()</a>
                    }
                    else
                    {
                        <span>0</span>
                    }
                </td>
                <td>@item.TotalApprovedLateInEarlyOutRequest
                </td>
                <td>@item.TotalRejectLateInEarlyOutRequest
                </td>
            </tr>
            <tr>
                <td class="firstColumn">@Fanex.NexHR.Resources.Labels.ChangeShift
                </td>
                <td>
                    @if (item.TotalPendingChangeShiftRequest > 0)
                    {
                        requestModel.RequestType = 3;
                        requestModel.FromDate = minRequestDate;
                        <a href="@Url.Action("member", "request", requestModel)">@item.TotalPendingChangeShiftRequest.ToString()</a>
                    }
                    else
                    {
                        <span>0</span>
                    }
                </td>
                <td>@item.TotalApprovedChangeShiftRequest
                </td>
                <td>@item.TotalRejectChangeShiftRequest
                </td>
            </tr>
            <tr>
                <td class="firstColumn">@Fanex.NexHR.Resources.Labels.Leave
                </td>
                <td>
                    @if (item.TotalPendingLeaveRequest > 0)
                    {
                        requestModel.RequestType = 4;
                        requestModel.FromDate = minRequestDate;
                        <a href="@Url.Action("member", "request", requestModel)">@item.TotalPendingLeaveRequest.ToString()</a>
                    }
                    else
                    {
                        <span>0</span>
                    }
                </td>
                <td>@item.TotalApprovedLeaveRequest
                </td>
                <td>@item.TotalRejectLeaveRequest
                </td>
            </tr>
            <tr>
                <td class="firstColumn">@Fanex.NexHR.Resources.Labels.KeepInView
                </td>
                <td>
                    @if (item.TotalPendingKivRequest > 0)
                    {
                        requestModel.RequestType = 5;
                        requestModel.FromDate = minRequestDate;
                        <a href="@Url.Action("member", "request", requestModel)">@item.TotalPendingKivRequest.ToString()</a>
                    }
                    else
                    {
                        <span>0</span>
                    }
                </td>
                <td>@item.TotalApprovedKivRequest
                </td>
                <td>@item.TotalRejecteKivRequest
                </td>
            </tr>

			<tr>
                <td class="firstColumn">@Fanex.NexHR.Resources.Labels.Overtime
                </td>
                <td>
                    @if (item.TotalPendingOvertime > 0)
                    {
						 @Html.ActionLink(item.TotalPendingOvertime.ToString(), "memberovertime", "overtime")
                        @*<a href="@Url.Action("memberovertime", "overtime")">@item.TotalPendingOvertime.ToString()</a>*@
					}
					else
					{
                        <span>0</span>
					}
                </td>
                <td> -
                </td>
                <td> -
                </td>
            </tr>

        </tbody>
    </table>
	}
	if (item.RoleId == (int)RoleSystem.Approver)
	{ 
    <h4>
        Approval List</h4>
    <table class="data" id="myspace">
        <thead>
            <tr>
                <th rowspan="2" class="firstColumn">@Fanex.NexHR.Resources.Labels.Request
                </th>
                <th rowspan="2">@Fanex.NexHR.Resources.Labels.Pending
                </th>
                <th colspan="3" class="center">
                    @DateTime.Now.AddDays(-7).Day - @DateTime.Now.ToString("dd MMM, yyyy")
                </th>
            </tr>
            <tr>
                <th>@Fanex.NexHR.Resources.Labels.Approved
                </th>
                <th>@Fanex.NexHR.Resources.Labels.Rejected
                </th>
            </tr>
        </thead>
        <tbody>
            @{
		var requestModel = new RequestViewModel
		{
			DateOption = 0,
			ToDate = DateTime.Now,
			FromDate = DateTime.Now.AddDays(-7),
			StatusId = (byte)CurrentRequestStatus.Pending,
			TeamIds = string.Empty,
			IsDailyRequest = false
		};
		var minRequestDate = DateTime.Now.AddMonths(-4).Date; 
            }
            <tr>
                <td class="firstColumn">@Fanex.NexHR.Resources.Labels.CheckInOut
                </td>
                <td>
                    @if (item.TotalPendingCheckInOutRequest > 0)
					{
						requestModel.RequestType = 1;
						requestModel.FromDate = minRequestDate;
                        <a href="@Url.Action("member", "request", requestModel)">@item.TotalPendingCheckInOutRequest.ToString()</a>
					}
					else
					{
                        <span>0</span>
					}
                </td>
                <td>@item.TotalApprovedCheckInOutRequest
                </td>
                <td>@item.TotalRejectCheckInOutRequest
                </td>
            </tr>
            <tr>
                <td class="firstColumn">@Fanex.NexHR.Resources.Labels.LateInEarlyOut
                </td>
                <td>
                    @if (item.TotalPendingLateInEarlyOutRequest > 0)
					{
						requestModel.RequestType = 2;
						requestModel.FromDate = minRequestDate;
                        <a href="@Url.Action("member", "request", requestModel)">@item.TotalPendingLateInEarlyOutRequest.ToString()</a>
					}
					else
					{
                        <span>0</span>
					}
                </td>
                <td>@item.TotalApprovedLateInEarlyOutRequest
                </td>
                <td>@item.TotalRejectLateInEarlyOutRequest
                </td>
            </tr>
            <tr>
                <td class="firstColumn">@Fanex.NexHR.Resources.Labels.ChangeShift
                </td>
                <td>
                    @if (item.TotalPendingChangeShiftRequest > 0)
					{
						requestModel.RequestType = 3;
						requestModel.FromDate = minRequestDate;
                        <a href="@Url.Action("member", "request", requestModel)">@item.TotalPendingChangeShiftRequest.ToString()</a>
					}
					else
					{
                        <span>0</span>
					}
                </td>
                <td>@item.TotalApprovedChangeShiftRequest
                </td>
                <td>@item.TotalRejectChangeShiftRequest
                </td>
            </tr>
            <tr>
                <td class="firstColumn">@Fanex.NexHR.Resources.Labels.Leave
                </td>
                <td>
                    @if (item.TotalPendingLeaveRequest > 0)
					{
						requestModel.RequestType = 4;
						requestModel.FromDate = minRequestDate;
                        <a href="@Url.Action("member", "request", requestModel)">@item.TotalPendingLeaveRequest.ToString()</a>
					}
					else
					{
                        <span>0</span>
					}
                </td>
                <td>@item.TotalApprovedLeaveRequest
                </td>
                <td>@item.TotalRejectLeaveRequest
                </td>
            </tr>
            <tr>
                <td class="firstColumn">@Fanex.NexHR.Resources.Labels.KeepInView
                </td>
                <td>
                    @if (item.TotalPendingKivRequest > 0)
					{
						requestModel.RequestType = 5;
						requestModel.FromDate = minRequestDate;
                        <a href="@Url.Action("member", "request", requestModel)">@item.TotalPendingKivRequest.ToString()</a>
					}
					else
					{
                        <span>0</span>
					}
                </td>
                <td>@item.TotalApprovedKivRequest
                </td>
                <td>@item.TotalRejecteKivRequest
                </td>
            </tr>
			<tr>
                <td class="firstColumn">@Fanex.NexHR.Resources.Labels.Overtime
                </td>
                <td>
                    @if (item.TotalPendingOvertime > 0)
                    {
						 @Html.ActionLink(item.TotalPendingOvertime.ToString(), "memberovertime", "overtime")
                        @*<a href="@Url.Action("memberovertime", "overtime")">@item.TotalPendingOvertime.ToString()</a>*@
					}
					else
					{
                        <span>0</span>
					}
                </td>
                <td> -
                </td>
                <td> -
                </td>
            </tr>

        </tbody>
    </table>
    }


}
