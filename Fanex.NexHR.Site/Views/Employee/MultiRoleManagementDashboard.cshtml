                        <span>0</span>
                    }
                </td>
                <td>@item.TotalApprovedLateInEarlyOutRequest
                </td>
                <td>@item.TotalRejectLateInEarlyOutRequest
                </td>
            </tr>
            <tr>
                <td class="firstColumn">@Fanex.NexHR.Resources.Labels.ChangeShift
