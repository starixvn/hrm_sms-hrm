@using Fanex.NexHR.Resources
@using Fanex.NexHR.Models
@model IList<Employee>
    @{
        var pagerOption = (PagerOptionModel)ViewBag.PagerOption;
        bool isShowJobtitle = (bool)ViewBag.IsShowJobtitle;
    }

    <table id="data" class="table table-custom">
        <thead>
            <tr>
                <th>@Labels.SymbolCount</th>
                <th>@Labels.Code</th>
                <th>@Labels.Nick</th>
                <th>@Labels.Name</th>
                <th>@Labels.Team</th>
                @if (isShowJobtitle)
                {
                    <th>@Labels.JobTitle</th>
                }
                <th>@Labels.Skype</th>
                <th>@Labels.Email</th>
                <th>@Labels.Phone</th>
                <th>Ext No</th>
                <th>@Labels.GroupDate</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                var index = (pagerOption.CurrentPage - 1) * pagerOption.ItemsPerPage;
                foreach (Employee employee in Model)
                {
                    index++;
                    var cssClass = employee.Enabled ? "" : "disabled";
                    <tr class="@cssClass">
                        <td>@index</td>
                        <td>@employee.Code</td>
                        <td class="nick" data-code="@employee.Code">
                            <a href="@Url.Action("detail", "employee", new { id = employee.Id })">@employee.NickName</a>
                        </td>
                        <td class="align-left">@employee.FullName</td>
                        <td class="tooltip" title="@employee.Team.Name">@employee.Team.Code</td>
                        @if (isShowJobtitle)
                        {
                            <td class="align-left">@employee.JobTitle</td>
                        }
                        <td>
                            <a href="skype:@employee.Skype?chat">@employee.Skype</a>
                        </td>
                        <td class="align-left">
                            <a href="mailto:@employee.Email">@employee.Email</a>
                        </td>
                        <td class="align-left">
                            @employee.Phone
                        </td>
                        <td>
                            @employee.ExtensionNo
                        </td>
                        <td>
                            @if (employee.JoinedDate.HasValue)
                            {
                                @employee.JoinedDate.Value.ToDateMonthYearFormatedDate()
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                @RazorHelper.DisplayNoInformation(11)
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="11" id="pagination">
                    @{
                        var from = (pagerOption.CurrentPage - 1) * pagerOption.ItemsPerPage + 1;
                        var to = from + (Model.Count - 1);
                        IList<SelectListItem> itemsPerPageArray = pagerOption.ItemsPerPageArray.Select(x => new SelectListItem
                        {
                            Text = x.Text,
                            Value = x.Value,
                            Selected = x.Value == pagerOption.ItemsPerPage.ToString()
                        }).ToList();
                    }
                    @Html.Hidden("CurrentPage", (int)pagerOption.CurrentPage)
                    @Html.Hidden("ItemsPerPage", (int)pagerOption.ItemsPerPage)
                    @Html.Hidden("TotalItem", (int)pagerOption.TotalItem)
                    @Html.DropDownList("ItemsPerPageOption", itemsPerPageArray, new { @class = "itemsPerPageOption form-control" })
                    <div class="detailtext">
                        Showing <strong>@from</strong> to <strong>@to</strong> of <strong>@pagerOption.TotalItem</strong> entries
                    </div>
                    <ul id="numberlist" class="pagination"></ul>
                </td>
            </tr>
        </tfoot>
    </table>