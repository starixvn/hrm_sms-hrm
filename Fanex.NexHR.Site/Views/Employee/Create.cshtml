@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels.Employee
@model CreateEmployeeViewModel
@{
    ViewBag.Title = Labels.CreateAccount;
}
@section css{
    <link href="~/wwwroot/dist/styles/employee.create.css" rel="stylesheet" />
}
@section js{
    <script src="~/wwwroot/dist/js/employee.create.js"></script>
}
@section Breadcrumb {
    <a class="step">@Labels.SASpace</a><span class="step">@ViewBag.Title</span>
}
<h2 class="page-title">@ViewBag.Title</h2>
@using (Html.BeginForm())
{
    <div class="card form-horizontal">
        @Html.ValidationSummary()
        @Html.HiddenFor(model => model.TeamId)
        <div class="form-group">
            <div class="label-form">
                @Html.LabelFor(model => model.FullName, new { @class = "control-label" })
            </div>
            <div class="input-form">
                @Html.TextBoxFor(model => model.FullName, new { @class = "form-control", @autocomplete = "off" })
            </div>
        </div>
        <div class="form-group">
            <div class="label-form">
                @Html.LabelFor(model => model.Nickname, new { @class = "control-label" })
            </div>
            <div class="input-form">
                @Html.TextBoxFor(model => model.Nickname, new { @class = "form-control", @autocomplete = "off" })
            </div>
        </div>
        <div class="form-group">
            <div class="label-form">
                @Html.LabelFor(model => model.DomainUsername, new { @class = "control-label" })
            </div>
            <div class="input-form">
                @Html.TextBoxFor(model => model.DomainUsername, new { @class = "form-control", @autocomplete = "off" })
            </div>
        </div>
        <div class="form-group">
            <div class="label-form">
                @Html.LabelFor(model => model.Code, new { @class = "control-label" })
            </div>
            <div class="input-form">
                @Html.TextBoxFor(model => model.Code, new { @class = "form-control", @autocomplete = "off" })
            </div>
            <input type="button" class="btn btn-primary generate-code" id="generate" value="Generate" />
        </div>
        <div class="form-group">
            <div class="label-form">
                @Html.LabelFor(model => model.TeamId, Labels.Team, new { @class = "control-label" })
            </div>
            <div class="select-form" id="Team"></div>
        </div>
        <div class="form-group">
            <div class="label-form"></div>
            <div>
                <input type="button" id="btnSubmit" class="btn btn-primary" value="Next" />
            </div>
        </div>
    </div>
}