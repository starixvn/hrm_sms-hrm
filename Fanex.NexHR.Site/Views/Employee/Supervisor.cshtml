@using Fanex.NexHR.ViewModels.Supervisor
@model SupervisorViewModel
@{
	ViewBag.Title = "Update Supervisor";
}
@section css{
	@Url.CombresLink("employeesupervisorcss")
}
@section js{
	@Url.CombresLink("employeesupervisorjs")
}
@section Breadcrumb
{
	@if (Model.ForView == "Employee")
 {
		<a class="step" href="javascript:;">HR</a> 
		<span class="step">
			<a href="@Url.Action("usermanagement", "employee")">@Labels.EmployeeManagement</a>
		</span>
		<span class="step">
			<a href="/employee/edit/@Model.EmployeeId">Employee Personal Information</a>
		</span>
 }
 else
 {
		<a class="step">HR Space</a>
		<a href="~/team/index/" class="step">Team Management</a>
		<a href="~/team/TeamSupervisor/@Model.TeamId" class="step">Team Supervisors</a>
 }
	<a class="step">@Model.DisplayTitle</a>
}
<div class="addnew-supervisor">
	@{
		if (Model.SupervisorRole == (short)RoleSystem.Verifier)
		{
		@Html.Label("Verifier")
		}
		if (Model.SupervisorRole == (short)RoleSystem.Approver)
		{
		@Html.Label("Approver")
		}
		if (Model.SupervisorRole == (short)RoleSystem.ShiftManager)
		{
		@Html.Label("Employee")
		}
		if (Model.SupervisorRole == (short)RoleSystem.ActingSupervisor)
		{
		@Html.Label("Employee")
		@Html.Hidden("supervisorRole", true)
		}
	}
	@Html.TextBox("Supervisor", string.Empty, new { placeholder = Messages.SearchEmployeeWatermark })
	@Html.Hidden("SupervisorId")
	@Html.Hidden("SupervisorTeam")
	<a id="lknAdd" href="javascript:;">+ Add to list</a>
	@if (Model.SupervisorRole == (short)RoleSystem.ActingSupervisor)
 {
		<span class="title team">@Labels.Team</span> <span class="control">
			<select id="group" multiple="multiple" class="team-select">
				@foreach (Team item in ViewBag.Groups)
	{ 
					<option value="@item.Id">@item.Name</option>
	}
			</select>
		</span><span class="add">
			<a id="lnkAddEmployeesOfTeam" href="javascript:;">+ Add all members to list</a>
		</span>
 }
</div>
<div>
	<table id="tblSupervisor" class="datasupervisor">
		<thead>
			<tr>
				<th rowspan="2" class="supervisor">
					Priority
				</th>
				<th rowspan="2" class="supervisor">
					@{
						if (Model.SupervisorRole == (short)RoleSystem.Verifier)
						{
						@Html.Label("Verifier")
						} if (Model.SupervisorRole == (short)RoleSystem.Approver)
						{
						@Html.Label("Approver")
						} if (Model.SupervisorRole == (short)RoleSystem.ShiftManager)
						{
						@Html.Label("Employee")
						} if (Model.SupervisorRole == (short)RoleSystem.ActingSupervisor)
						{
						@Html.Label("Employee")
						}
					}
				</th>
				<th rowspan="2" class="supervisor">
					@Labels.Team
				</th>
				<th colspan="6">@Labels.Request
				</th>
				<th rowspan="2">
					<a id="removeAll" href="javascript:;">Remove All</a>
				</th>
			</tr>
			<tr>
				<th class="request">@Labels.Leave
				</th>
				<th class="request">@Labels.ChangeShift
				</th>
				<th class="request">@Labels.LateInEarlyOut
				</th>
				<th class="request">@Labels.CheckInOut
				</th>
				<th class="request">@Labels.Overtime
				</th>
				<th class="request">@Labels.KeepInView
				</th>
			</tr>
		</thead>
		<tbody>
			@if (Model != null && Model.SupervisorList != null)
   {
	   foreach (var item in Model.SupervisorList)
	   {
				<tr>
					<td>
						<a href="javascript:;" class="up">Up |</a>
						<a href="javascript:;" class="down">Down |</a>
						<a href="javascript:;" class="moveTop">Top</a>
					</td>
					<td class="left" data-id="@item.OwnerId">@item.NickName (@item.FullName)
					</td>
					<td class="left">@item.Team
					</td>
					<td>
						@Html.CheckBoxFor(x => item.Leaves, new { @class = "LeaveRole" })
					</td>
					<td>
						@Html.CheckBoxFor(x => item.ChangeShifts, new { @class = "ChangeShiftRole" })
					</td>
					<td>
						@Html.CheckBoxFor(x => item.LateInEarlyOuts, new { @class = "LateInEarlyOutRole" })
					</td>
					<td>
						@Html.CheckBoxFor(x => item.CheckInOuts, new { @class = "CheckInOutRole" })
					</td>
					<td>
						@Html.CheckBoxFor(x => item.Overtimes, new { @class = "OvertimeRole" })
					</td>
					<td>
						@Html.CheckBoxFor(x => item.KeepInViews, new { @class = "KeepInViewRole" })
					</td>
					<td>
						<a href="javascript:;" class="lnkremove">@Labels.Remove</a>
					</td>
				</tr>
	   }
   }
		</tbody>
	</table>
</div>
<div>
	@Html.Hidden("EmployeeId", Model.EmployeeId)
	@Html.Hidden("TeamId", Model.TeamId)
	@Html.Hidden("SupervisorRole", Model.SupervisorRole)
	@Html.Hidden("ForView", Model.ForView)
	<input id="btnSave" type="button" value="Save" />
	@if (Model.ForView == "Employee")
 {
		<a href="/employee/edit/@Model.EmployeeId">
			<input type="button" value="Back" />
		</a>
 }
 else
 {
		<a href="/team/TeamSupervisor/@Model.TeamId">
			<input type="button" value="Back" />
		</a>
 }
</div>
