@model Fanex.NexHR.ViewModels.SupervisorViewModel
@{
    ViewBag.Title = "Update Supervisor";
}
@section css{
    @Url.CombresLink("employeesupervisorcss")
}
@section js{
    @Url.CombresLink("employeesupervisorjs")
}
@section Breadcrumb
{
    <a class="step" href="javascript:;">HR</a> 
    <span class="step"> <a href="@Url.Action("usermanagement", "employee")">@Labels.EmployeeManagement</a> </span>
    <span class="step"> <a href="/employee/edit/@Model.EmployeeId">Employee Personal Information</a> </span>
    <span class="step">Supervisor</span>
}
@*<div class="filter"> 
    @Html.Label("Role Supervisor")
    @RazorHelper.SupervisorRolesDropDownList()
    <input type="button" value="Submit" />
</div>

<br />
<br />*@
<div class="addnew-supervisor">
    @{
        if (Model.SupervisorRole == (short)RolesEnum.Verifier)
        {
        @Html.Label("Verifier")
        }
        if (Model.SupervisorRole == (short)RolesEnum.Approver)
        {
        @Html.Label("Approver")
        }
        if (Model.SupervisorRole == (short)RolesEnum.ShiftManager)
        {
        @Html.Label("Employee")
        }
        if (Model.SupervisorRole == (short)RolesEnum.ActingSupervisor)
        {
        @Html.Label("Employee")
        @Html.Hidden("supervisorRole", true)
        }
    }
    @Html.TextBox("Supervisor", string.Empty, new { placeholder = Messages.SearchEmployeeWatermark })
    @Html.Hidden("SupervisorId")
    @Html.Hidden("SupervisorTeam")
    @*@Html.DropDownList("SupervisorId", Model.SupervisorList, new { @multiple = "multiple", @class ="chosen-select", @style="width:400px;" })*@
    <a id="lknAdd" href="javascript:;">+ Add to list</a>

    @if (Model.SupervisorRole == (short)RolesEnum.ActingSupervisor)
    {
            <span class="title team">@Labels.Team</span> <span class="control">
        <select id="group" multiple="multiple" class="team-select">
            @foreach (Fanex.NexHR.Models.Team item in ViewBag.Groups)
            { 
                <option value="@item.Id">@item.Name</option>
            }
        </select>
    </span><span class="add"><a id="lnkAddEmployeesOfTeam" href="javascript:;">+ Add all
        members to list</a> </span>
    }

</div>

<div>
    <table id="tblSupervisor" class="datasupervisor">
        <thead>
            <tr>
                <th rowspan="2" class="supervisor">
                    Priority
                </th>
                <th rowspan="2" class="supervisor">
                    @{
                        if (Model.SupervisorRole == (short)RolesEnum.Verifier)
                        {
                        @Html.Label("Verifier")
                        } if (Model.SupervisorRole == (short)RolesEnum.Approver)
                        {
                        @Html.Label("Approver")
                        } if (Model.SupervisorRole == (short)RolesEnum.ShiftManager)
                        {
                        @Html.Label("Employee")
                        } if (Model.SupervisorRole == (short)RolesEnum.ActingSupervisor)
                        {
                        @Html.Label("Employee")
                        }
                    }
                </th>
                <th rowspan="2" class="supervisor">
                    @Labels.Team
                </th>
                <th colspan="6">@Labels.Request
                </th>
                <th rowspan="2">
                    <a id="removeAll" href="javascript:;">Remove All</a>
                </th>
            </tr>
            <tr>
                <th class="request">@Labels.Leave
                </th>
                <th class="request">@Labels.ChangeShift
                </th>
                <th class="request">@Labels.LateInEarlyOut
                </th>
                <th class="request">@Labels.CheckInOut
                </th>
                <th class="request">@Labels.Overtime
                </th>
                <th class="request">@Labels.KeepInView
                </th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.SupervisorList != null)
            {
                foreach (var item in Model.SupervisorList)
                {
                <tr>
                    <td>
                        <a href="javascript:;" class="up">Up |</a>
                         <a href="javascript:;" class="down">Down |</a> 
                         <a href="javascript:;" class="moveTop">Top</a>
                    </td>
                    <td class="left" data-id="@item.OwnerId">@item.NickName (@item.FullName)
                    </td>
                    <td class="left" >@item.Team
                    </td>
                    <td>
                        @Html.CheckBoxFor(x => item.HasLeaveRequest, new { @class = "LeaveRole" })
                        @*<input class="LeaveRole" type="checkbox" />*@
                    </td>
                    <td>
                        @Html.CheckBoxFor(x => item.HasChangeShiftRequest, new { @class = "ChangeShiftRole" })
                        @*<input class="ChangeShiftRole" type="checkbox" />*@
                    </td>
                    <td>
                        @Html.CheckBoxFor(x => item.HasLateInEarlyOutRequest, new { @class = "LateInEarlyOutRole" })
                        @*<input class="LateInEarlyOutRole" type="checkbox" />*@
                    </td>
                    <td>
                        @Html.CheckBoxFor(x => item.HasCheckInOutRequest, new { @class = "CheckInOutRole" })
                        @*<input class="CheckInOutRole" type="checkbox" />*@
                    </td>
                    <td>
                        @Html.CheckBoxFor(x => item.HasOvertimeRequest, new { @class = "OvertimeRole" })
                        @* <input class="OvertimeRole" type="checkbox" />*@
                    </td>
                    <td>
                        @Html.CheckBoxFor(x => item.HasKeepInViewRequest, new { @class = "KeepInViewRole" })
                        @*<input class="KeepInViewRole" type="checkbox" />*@
                    </td>
                    <td>
                        <a href="javascript:;" class="lnkremove">@Labels.Remove</a>
                    </td>
                </tr>
                }
            }
        </tbody>
    </table>
</div>
<div>
    @Html.Hidden("EmployeeId", Model.EmployeeId)
    @Html.Hidden("SupervisorRole", Model.SupervisorRole)
    <input id="btnSave" type="button" value="Save" />
    <a href="/employee/edit/@Model.EmployeeId">
        <input type="button" value="Back" />
    </a>
</div>
