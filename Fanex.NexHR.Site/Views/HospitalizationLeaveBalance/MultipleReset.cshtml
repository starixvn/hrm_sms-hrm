@using (Html.BeginForm("HospitalizationLeaveBalance", "Reset", FormMethod.Post))
{
    @Html.ValidationSummary()

    <div class="form-horizontal clearfix">
        <div class="form-group">
            <div class="label-form">
                @Html.Label("Max Balance", new { @class = "control-label" })
            </div>
            <div class="input-form">
                @Html.TextBox("ResetDays", null, new { @class = "form-control", autocomplete = "off", required = true })
            </div>
        </div>

        <div class="form-group">
            <div class="label-form">
                @Html.Label("Description", new { @class = "control-label" })
            </div>
            <div class="input-form">
                @Html.TextArea("Description", new { @class = "form-control", rows = 5 })
            </div>
        </div>
    </div>
}