@using Fanex.NexHR.Resources
@model Employee

@{
    Layout = "~/Views/Shared/_NewLayout.cshtml";
    ViewBag.Title = "Update information";
}
@section css{
    <link href="~/wwwroot/dist/styles/account.editprofile.css" rel="stylesheet" />
}
@section js{
    <script src="~/wwwroot/dist/js/employee.information.js"></script>
}
@section Breadcrumb {
    <a class="step" href="/Account/Index">Personal</a><span class="step">@ViewBag.Title</span>
}

@using (Html.BeginForm("UpdateInformation", "Information", FormMethod.Post, new { @id = "info-update" }))
{
    <div class="leftpersonal">
        @Html.AntiForgeryToken()
        @Html.ValidationSummary()
        <div class="panel panel-default">
            <div class="panel-heading">PERSONAL INFORMATION</div>
            <ul class="list-group">
                <li class="list-group-item">
                    <div class="label">@Labels.FullName:</div>
                    <div class="pcontent bold">@Model.FullName</div>
                </li>
                <li class="list-group-item">
                    <div class="label">@Labels.Nick:</div>
                    <div class="pcontent bold">@Model.NickName</div>
                </li>
                <li class="list-group-item">
                    <div class="label label-edit">@Labels.ChineseName:</div>
                    <div class="pcontent">
                        @Html.TextBoxFor(model => model.ChineseName, new { @class = "form-control" })
                    </div>
                </li>
                <li class="list-group-item">
                    <div class="label label-edit">D.O.B:</div>
                    <div class="pcontent">
                        @{
                            var birthdayYearRange = "1945:" + DateTime.Now.Year.ToString();
                        }
                        @Html.TextBox(Html.NameFor(model => model.DateOfBirth).ToString(), Model.DateOfBirth.ToString("dd MMM, yyyy"), new { @class = "datepicker form-control", yearrange = birthdayYearRange})
                        <i class="icon-calendar glyphicon glyphicon-calendar ui-datepicker-trigger"></i>
                    </div>
                </li>
                <li class="list-group-item">
                    <div class="label label-edit">@Labels.PlaceOfBirth:</div>
                    <div class="pcontent">
                        @Html.TextBoxFor(model => model.PlaceOfBirth, new { @class = "form-control" })
                    </div>
                </li>
                <li class="list-group-item">
                    <div class="label label-edit">@Labels.Ethnic:</div>
                    <div class="pcontent">
                        @Html.TextBoxFor(model => model.Ethnic, new { @class = "form-control" })
                    </div>
                </li>
                <li class="list-group-item">
                    <div class="label label-edit">@Labels.Native:</div>
                    <div class="pcontent">
                        @Html.TextBoxFor(model => model.Native, new { @class = "form-control" })
                    </div>
                </li>
                <li class="list-group-item">
                    <div class="label label-edit">@Labels.Religion:</div>
                    <div class="pcontent">
                        @Html.TextBoxFor(model => model.Religion, new { @class = "form-control" })
                    </div>
                </li>
                <li class="list-group-item">
                    <div class="label label-edit">@Labels.Gender:</div>
                    <div class="pcontent">
                        @Html.DropDownListFor(model => model.Gender, (IList<SelectListItem>)ViewBag.Genders, new { @class = "form-control" })
                    </div>
                </li>
                <li class="list-group-item">
                    <div class="label label-edit">@Labels.Nationality:</div>
                    <div class="pcontent">
                        @Html.DropDownListFor(model => model.CountryCode, (IList<SelectListItem>)ViewBag.Countries, new { @class = "form-control" })
                    </div>
                </li>
                <li class="list-group-item">
                    <div class="label label-edit">@Labels.Marriage:</div>
                    <div class="pcontent">
                        @Html.DropDownListFor(model => model.Marriage, (IList<SelectListItem>)ViewBag.Marriages, new { @class = "form-control" })
                    </div>
                </li>
                <li class="list-group-item">
                    <div class="label label-edit">@Labels.CardNo:</div>
                    <div class="pcontent">
                        @Html.TextBoxFor(model => model.CardNo, new { @class = "form-control" })
                    </div>
                </li>
                <li class="list-group-item">
                    <div class="label label-edit">Issue ID Card Date:</div>
                    <div class="pcontent">
                        @{ 
                            var idIssueYearRange = "1960:" + DateTime.Now.Year.ToString();
                        }
                        @Html.TextBox(Html.NameFor(model => model.DateOfIdCard).ToString(), Model.DateOfIdCard.HasValue ? Model.DateOfIdCard.Value.ToString("dd MMM, yyyy") : null, new { @class = "datepicker form-control" , yearrange = @idIssueYearRange })
                        <i class="icon-calendar glyphicon glyphicon-calendar ui-datepicker-trigger"></i>
                    </div>
                </li>
                <li class="list-group-item">
                    <div class="label label-edit">Issue ID Card Place:</div>
                    <div class="pcontent">
                        @Html.TextBoxFor(model => model.PlaceOfIdCard, new { @class = "form-control" })
                    </div>
                </li>
                <li class="list-group-item">
                    <div class="label label-edit">@Labels.PassportNo:</div>
                    <div class="pcontent">
                        @Html.TextBoxFor(model => model.PassportNo, new { @class = "form-control" })
                    </div>
                </li>
                <li class="list-group-item">
                    <div class="label label-edit">@Labels.PassportExp:</div>
                    <div class="pcontent">
                        @Html.TextBox(Html.NameFor(model => model.PassportExp).ToString(), Model.PassportExp.HasValue ? Model.PassportExp.Value.ToString("dd MMM, yyyy") : null, new { @class = "datepicker form-control" })
                        <i class="icon-calendar glyphicon glyphicon-calendar ui-datepicker-trigger"></i>
                    </div>
                </li>
                <li class="list-group-item">
                    <div class="label label-edit">@Labels.Qualification:</div>
                    <div class="pcontent">
                        @Html.TextBoxFor(model => model.Qualification, new { @class = "form-control" })
                    </div>
                </li>
                <li class="list-group-item">
                    <div class="label label-edit">@Labels.Major:</div>
                    <div class="pcontent">
                        @Html.TextBoxFor(model => model.Major, new { @class = "form-control" })
                    </div>
                </li>
                <li class="list-group-item">
                    <div class="label label-edit">@Labels.Email:</div>
                    <div class="pcontent">
                        @Html.TextBoxFor(model => model.Email, new { @class = "form-control" })
                    </div>
                </li>
                <li class="list-group-item">
                    <div class="label label-edit">@Labels.Phone:</div>
                    <div class="pcontent">
                        @Html.TextBoxFor(model => model.Phone, new { @class = "form-control" })
                    </div>
                </li>
                <li class="list-group-item">
                    <div class="label label-edit">@Labels.Skype:</div>
                    <div class="pcontent">
                        @Html.TextBoxFor(model => model.Skype, new { @class = "form-control" })
                    </div>
                </li>
                <li class="list-group-item">
                    <div class="label label-edit">@Labels.LetsTalk:</div>
                    <div class="pcontent">
                        @Html.TextBoxFor(model => model.LetsTalk, new { @class = "form-control" })
                    </div>
                </li>
                <li class="list-group-item">
                    <div class="label label-edit">@Labels.Address:</div>
                    <div class="pcontent">
                        @Html.TextAreaFor(model => model.Address, new { @class = "form-control text-erea" })
                    </div>
                </li>
                <li class="list-group-item">
                    <div class="label label-edit">@Labels.CurrentAddress:</div>
                    <div class="pcontent">
                        @Html.TextAreaFor(model => model.CurrentAddress, new { @class = "form-control text-erea" })
                    </div>
                </li>
                <li class="list-group-item">
                    <div class="align-right">
                        <button type="submit" class="btn btn-primary">@Labels.Save</button>
                    </div>
                </li>
            </ul>
        </div>
    </div>
}
<div class="rightjob">
    <div class="panel panel-default">
        <div class="panel-heading">
            EMERGENCY
        </div>
        <div class="relationship">
            <button class="btn btn-primary" id="btn-add-emergency" title="Add Emergency" data-url="/Information/InsertEmergency">
                <span class="fa fa-plus"></span>
                Add
            </button>
            <div id="emergency"></div>
        </div>
    </div>

    <div class="panel panel-default">
        <div class="panel-heading">
            RELATIONSHIP
        </div>
        <div class="relationship">
            <button class="btn btn-primary" id="btn-add-relationship" title="Add Relationship" data-url="/Information/InsertRelationship">
                <span class="fa fa-plus"></span>
                Add
            </button>
            <div id="relationship"></div>
        </div>
    </div>

    <div class="panel panel-default">
        <div class="panel-heading">
            LIST FILE(S) UPLOAD
        </div>
        <ul class="list-group">
            <li class="list-group-item">
                <div class="label label-edit">Attachments</div>
                <div class="pcontent">
                    @Html.TextBox("Attachments", null, new { @class = "form-control", @type = "file", @multiple = "multiple" })
                    <p class="note">* The file(s) upload must be less than 5 MB</p>
                    <p class="note">* Accept file type: .jpg; .png; .jpeg; .pdf, .doc, .docx, .xls, .xlxs</p>
                    <p class="note">* Rename the file to meaningful name before upload</p>
                </div>
                <div class="clear"></div>
            </li>
            <li class="list-group-item">
                <ul class="upload-file-list" id="upload-list" data-base-url="@ViewBag.BaseFileLocation"></ul>
            </li>
        </ul>
    </div>
</div>

<div id="create-form"></div>
<div id="edit-form"></div>