@using Fanex.NexHR.Resources
@using Fanex.NexHR.Models.EmployeeInformation
@model IList<EmployeeRelationship>

<table class="table table-custom">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th>@Labels.Name</th>
            <th>@Labels.Phone</th>
            <th>@Labels.Relationship</th>
            <th>@Labels.DateOfBirth</th>
            <th>@Labels.Gender</th>
            <th>@Labels.Emergency</th>
            <th>@Labels.Action</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            var index = 1;
            foreach (var r in Model)
            {
                <tr>
                    <td>@index</td>
                    <td class="align-left">@r.FullName</td>
                    <th>@r.Phone</th>
                    <th>@r.Relationship</th>
                    <td>@r.DateOfBirth.ToDateMonthYearFormatedDate()</td>
                    <td>
                        @if (r.Gender == 0)
                        {
                            <span>@Labels.Female</span>
                        }
                        else
                        {
                            <span>@Labels.Male</span>
                        }
                    </td>
                    <td>
                        @if (r.IsEmergency)
                        {
                            <i class="fa fa-check fa-lg icon-check"></i>
                        }
                    </td>
                    <td class="action-column">
                        <a title="Edit" class="edit-icon" data-id="@r.RelationshipId">
                            <i class="fa fa-pencil fa-lg icon-edit"></i>
                        </a>
                        <a title="Delete" class="delete-icon" data-id="@r.RelationshipId">
                            <i class="fa fa-remove fa-lg icon-delete"></i>
                        </a>
                    </td>
                </tr>
                index++;
            }
        }
        else
        {
            @RazorHelper.DisplayNoInformation(8)
        }
    </tbody>
</table>