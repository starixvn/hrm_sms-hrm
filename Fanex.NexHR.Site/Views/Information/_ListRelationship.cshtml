@using Fanex.NexHR.Core.Enums
@model IList<Fanex.NexHR.Models.EmployeeRelationship.EmployeeRelationship>

    <table class="table table-custom">
        <thead>
            <tr>
                <th>@Labels.SymbolCount</th>
                <th>@Labels.Name</th>
                <th>@Labels.DateOfBirth</th>
                <th>@Labels.Relationship</th>
                <th>@Labels.Phone</th>
                <th>@Labels.Gender</th>
                <th>@Labels.Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                var index = 1;
                foreach (var r in Model)
                {
                    Relationship relationship = (Relationship)r.Relationship;
                    <tr>
                        <td>@index</td>
                        <td class="align-left">@r.FullName</td>
                        <td>@r.DateOfBirth.ToString("dd MMM yyyy")</td>
                        <td>@relationship.ToString()</td>
                        <td>@r.Phone</td>
                        <td>
                            @if (r.Gender == 0)
                            {
                                <span>@Labels.Female</span>
                            }
                            else
                            {
                                <span>@Labels.Male</span>
                            }
                        </td>
                        <td>
                            <a title="Edit" class="edit-relationship" data-id="@r.RelationshipId">
                                <i class="fa fa-pencil fa-lg icon-edit"></i>
                            </a>
                            <a title="Delete" class="delete-relationship" data-id="@r.RelationshipId">
                                <i class="fa fa-remove fa-lg icon-delete"></i>
                            </a>
                        </td>
                    </tr>
                    index++;
                }
            }
            else
            {
                @RazorHelper.DisplayNoInformation(7)
            }
        </tbody>
    </table>