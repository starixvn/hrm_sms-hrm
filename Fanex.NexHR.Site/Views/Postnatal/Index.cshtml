@using Fanex.NexHR.Resources
@{
    ViewBag.Title = "Employee Postnatal";
}
@section css{
    <link href="~/wwwroot/dist/styles/employee.postnatal.css" rel="stylesheet" />
}
@section js{
    <script src="~/wwwroot/dist/js/employee.postnatal.js"></script>
}
@section Breadcrumb {
    <a class="step">@Labels.HRSpace</a>
    <a class="step" href="/employee/usermanagement">@Labels.EmployeeManagement</a>
    <a class="step">@ViewBag.Title</a>
}
<div class="filter">
    @using (Html.BeginGetForm())
    {
        <div class="form-horizontal clearfix">
            <div class="form-group year">
                <div class="label-form">
                    @Html.Label(@Labels.Year, new { @class = "control-label" })
                </div>
                <div class="select-form">
                    @Html.YearPicker("Year", 2010, DateTime.Now.Year)
                </div>
            </div>
            <div class="form-group form-group--m">
                <input class="btn btn-primary" type="submit" id="submit" value="@Labels.Submit" />
                <button class="btn btn-request" id="add-postnatal" type="button">
                    <span class="fa fa-plus"></span>
                    Add Postnatal
                </button>
            </div>
        </div>
    }
</div>
<div id="list-postnatal"></div>
<div id="dialog"></div>