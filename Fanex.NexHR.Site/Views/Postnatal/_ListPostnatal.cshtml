@using Fanex.NexHR.Models
@model IList<EmployeePostnatal>

    <table class="table table-custom" id="data">
        <thead>
            <tr>
                <th>@Labels.SymbolCount</th>
                <th>@Labels.FullName</th>
                <th>@Labels.NickName</th>
                <th>@Labels.From</th>
                <th>@Labels.To</th>
                <th>Creator</th>
                <th>@Labels.CreatedDate</th>
                <th>@Labels.Action</th>
            </tr>
        </thead>
        <tbody>
            @{int index = 1;}
            @if (Model != null && Model.Count > 0)
            {

                foreach (EmployeePostnatal postnatal in Model)
                {

                    <tr>
                        <td>@(index++)</td>
                        <td>@postnatal.Fullname</td>
                        <td>@postnatal.Nickname</td>
                        <td>@postnatal.FromDate.ToString("dd MMM yyyy")</td>
                        <td>@postnatal.ToDate.ToString("dd MMM yyyy")</td>
                        <td>@postnatal.Creator</td>
                        <td>@postnatal.CreatedDate.ToString("dd MMM yyyy")</td>
                        <td>
                            <a data-id="@postnatal.PostnatalId" class="edit-postnatal" title="Edit">
                                <i class="fa fa-pencil fa-lg icon-edit"></i>
                            </a>
                            <a data-id="@postnatal.PostnatalId" class="delete-postnatal" title="Delete">
                                <i class="fa fa-trash fa-lg icon-delete"></i>
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                @RazorHelper.DisplayNoInformation(colspan: 8);
            }
        </tbody>
    </table>