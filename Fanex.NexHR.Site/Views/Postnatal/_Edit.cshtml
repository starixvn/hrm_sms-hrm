@model Fanex.NexHR.ViewModels.Postnatal.PostnatalViewModel

@{
    ViewBag.Title = "Edit";
}
@section css{
    @Url.CombresLink("disciplinecss")
}

@section Breadcrumb {
    <a class="step">@Labels.EmployeeManagement</a>
    <a class="step">Postnatal</a>
    <a class="step">@ViewBag.Title</a>
}
<div>
    @using (Html.BeginForm(null, null, FormMethod.Post, new { id = "edit-form", @class = "dialog-form" }))
    {
        @Html.ValidationSummary()

        <div class="form-horizontal clearfix">
            <div class="form-group form-group--m">
                <div class="label-form">
                    @Html.LabelFor(model => model.Employee, new { @class = "control-label" })
                </div>
                <div class="input-form">
                    @Html.TextBox("Employee", Model.Employee, new { @class = "form-control", placeholder = Messages.SearchEmployeeWatermark })
                    @Html.HiddenFor(model => model.EmployeeId)
                </div>
            </div>
        </div>

        <div class="form-horizontal clearfix">
            <div class="form-group form-group--m">
                <div class="label-form">
                    @Html.LabelFor(model => model.FromDate, new { @class = "control-label" })
                </div>
                <div class="calendar-form">
                    @Html.TextBox(Html.NameFor(model => model.FromDate).ToString(), Model.FromDate.ToString("dd MMM yyyy"), new { @class = "datepicker form-control", mindate = (new DateTime(2010, 1, 1)).ToString("yyyy/MM/dd"), maxdate = "null", disableddate = "" })
                    <i class="icon-calendar glyphicon glyphicon-calendar ui-datepicker-trigger"></i>
                </div>
            </div>
        </div>

        <div class="form-horizontal clearfix">
            <div class="form-group form-group--m">
                <div class="label-form">
                    @Html.LabelFor(model => model.ToDate, new { @class = "control-label" })
                </div>
                <div class="calendar-form">
                    @Html.TextBox(Html.NameFor(model => model.ToDate).ToString(), Model.ToDate.ToString("dd MMM yyyy"), new { @class = "datepicker form-control", mindate = DateTime.Now.ToString("yyyy/MM/dd"), maxdate = "null", disableddate = "" })
                    <i class="icon-calendar glyphicon glyphicon-calendar trigger-todate"></i>
                </div>
            </div>
        </div>

        <div class="form-horizontal clearfix">
            <div class="form-group form-group--m">
                <div class="label-form">
                    @Html.LabelFor(model => model.Remark, new { @class = "control-label" })
                </div>
                <div class="input-form">
                    @Html.TextAreaFor(model => model.Remark, new { @class = "form-control" })
                </div>
            </div>
        </div>
    }
</div>