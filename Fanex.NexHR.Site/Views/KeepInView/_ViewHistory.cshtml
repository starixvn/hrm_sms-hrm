@using Fanex.NexHR.Core
@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Resources
@using Fanex.NexHR.Models.Request
@model IList<KeepInViewRequest>
<table class="table table-custom">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th>@Labels.Team</th>
            <th>@Labels.Employee</th>
            <th>@Labels.KIVType</th>
            <th>@Labels.RequestDate</th>
            <th>@Labels.FromTime</th>
            <th>@Labels.ToTime</th>
            <th>@Labels.Remark</th>
            <th>@Labels.Verifier</th>
            <th>@Labels.Approver</th>
            <th>@Labels.Status</th>
            <th>@Labels.LogDate</th>
        </tr>
    </thead>
    @if (Model != null && Model.Any())
    {
        <tbody>
            @{int index = 1;}
            @foreach (KeepInViewRequest request in Model)
            {
                var fromTime = request.KeepInViewTypeId == (int)KeepInViewTypes.KeepInViewByDay && !request.IsHalfDay ? "-" : request.FromTime.ToString("HH:mm");
                var toTime = request.KeepInViewTypeId == (int)KeepInViewTypes.KeepInViewByDay && !request.IsHalfDay ? "-" : request.ToTime.ToString("HH:mm");
            <tr>
                <td>@(index++)</td>
                <td>
                    <span class="tooltip-tipsy" title="@request.Employee.Team.Name">@request.Employee.Team.Code</span>
                </td>
                <td>
                    <span class="tooltip-tipsy" title="@request.Employee.FullName">@request.Employee.NickName</span>
                </td>
                <td>@request.KeepInViewTypeName</td>
                <td>@request.OnDate.ToDayOfWeekFormatedDate()</td>
                <td>@fromTime</td>
                <td>@toTime</td>
                <td>
                    @if (!string.IsNullOrWhiteSpace(request.Remark))
                    {
                        <span class="fa fa-comment tooltip-tipsy" title="@request.Remark" />
                    }
                    else
                    {
                        <span>-</span>
                    }
                </td>
                <td>
                    @if (request.VerifiedBy != null)
                    {
                        @request.VerifiedBy.NickName
                    }
                </td>
                <td>
                    @if (request.ApprovedBy != null)
                    {
                        @request.ApprovedBy.NickName
                    }
                </td>
                <td>@request.Status.ToString()</td>
                <td>@request.InsertedDate.ToShortFormatedDate()</td>
            </tr>
            }
        </tbody>
    }
    else
    {
        @RazorHelper.DisplayNoInformation(colspan: 13);
    }
</table>