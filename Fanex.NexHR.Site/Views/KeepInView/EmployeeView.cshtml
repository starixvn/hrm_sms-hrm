@using Fanex.NexHR.Resources
@using Fanex.NexHR.Models.Request
@using Fanex.NexHR.Core.Enums
@model IList<KeepInViewModel>
    @{
        ViewBag.Title = Labels.MyKeepInViewRequest;
    }
    @section css{
        @Url.CombresLink("keepinviewcss")
    }
    @section js{
        @Url.CombresLink("keepinviewviewlistjs")
    }
    @section Breadcrumb {
        <a class="step">Personal</a><a class="step">@ViewBag.Title</a>
    }
    <h2>@ViewBag.Title</h2>
    @using (Html.BeginForm())
    {
        <input type="hidden" value="LateInEarlyOut" id="RequestType" />

        <div class="container_24 bunhat">
            <div class="grid_1 gridlabel">
                <label for="Year">@Labels.Year</label>
            </div>
            <div class="grid_2">
                @Html.YearPicker("Year", 2014, (int)ViewBag.Year)
            </div>
            <div class="grid_2">
                <input type="submit" id="submit" value="@Labels.Submit" class="button-primary submit processing-submit" />
            </div>
            <div class="grid_5">
                <div class="button-icon">
                    <span class="icon plus"></span>@Html.ActionLink(Labels.NewRequest, "Create")
                </div>
            </div>
        </div>

        <div class="clear">
        </div>

        <table class="table table-custom">
            <thead>
                <tr>
                    <th>@Labels.SymbolCount</th>
                    <th>@Labels.KIVType</th>
                    <th>@Labels.RequestDate</th>
                    <th>@Labels.FromTime</th>
                    <th>@Labels.ToTime</th>
                    <th>@Labels.Remark</th>
                    <th>@Labels.VerifiedBy</th>
                    <th>@Labels.ApprovedBy</th>
                    <th>@Labels.CreatedDate</th>
                    <th>@Labels.Status</th>
                    <th>@Labels.History</th>
                </tr>
            </thead>
            @if (Model != null && Model.Any())
            {
                <tbody>
                    @{int index = 1;}
                    @foreach (KeepInViewModel request in Model)
                    {
                        var fromTime = request.KeepInViewTypeId == (int)KeepInViewTypes.KeepInViewByDay && !request.IsHalfDay ? "-" : request.FromTime.ToString("HH:mm");
                        var toTime = request.KeepInViewTypeId == (int)KeepInViewTypes.KeepInViewByDay && !request.IsHalfDay ? "-" : request.ToTime.ToString("HH:mm");

                    <tr id="row@(request.RequestId)">
                        <td>
                            @(index++)
                        </td>
                        <td class="align-left">@request.KeepInViewTypeName</td>
                        <td class="ddMMyyyyhhmm">
                            @request.OnDate.ToDayOfWeekFormatedDate()
                        </td>
                        <td>@fromTime</td>
                        <td>@toTime</td>
                        @if (!string.IsNullOrWhiteSpace(request.Remark))
                        {
                            <td class="tooltip" title="@request.Remark">
                                <span class="icon remark" alt="remark" />
                            </td>
                        }
                        else
                        {
                            <td>
                                -
                            </td>
                        }

                        <td>@request.VerifiedBy.NickName</td>
                        <td>@request.ApprovedBy.NickName</td>

                        <td class="ddMMyyyyhhmm">
                            @request.CreatedDate.ToShortFormatedDate()
                        </td>
                        @RazorHelper.RenderRequestStatus(request)
                        <td>
                            <a class="viewhistory" href="javascript:;" id="/keepinview/viewhistory?id=@request.RequestId">
                                @Labels.View
                            </a>
                        </td>
                    </tr>
                    }
                </tbody>
            }
            else
            {
                @RazorHelper.DisplayNoInformation(colspan: 12);
            }
        </table>
    }
    @RazorHelper.EmployeeProcessMenu()
    <div id="dialoghistorycontent" />
