@using Fanex.NexHR.Models.Request
@model IList<RequestEntity>
@{
    ViewBag.Title = Labels.MyKeepInViewRequest;
}
@section css{
    @Url.CombresLink("keepinviewcss")
}
@section js{
    @Url.CombresLink("keepinviewviewlistjs")
}
@section Breadcrumb {
    <a class="step">Personal</a><a class="step">@ViewBag.Title</a>
}
<h2>@ViewBag.Title</h2>
@using (Html.BeginForm())
{
    <input type="hidden" value="LateInEarlyOut" id="RequestType" />

    <span>Year:</span>
    @Html.YearPicker("Year", 2014, (int)ViewBag.Year)
    <input type="submit" id="submit" value="@Labels.Submit" class="button-primary submit processing-submit"/>
    <div class="button-icon">
        <span class="icon plus"></span>@Html.ActionLink(Labels.KeepInViewRequest, "Create")
    </div>   

    <table class="data">
        <thead>
            <tr>
                <th>
                    #
                </th>
                <th>@Labels.Shift
                </th>
                <th>@Labels.RequestDate
                </th>
                <th>@Labels.CreatedDate
                </th>
                <th>@Labels.Remark
                </th>
                <th>@Labels.Status
                </th>
                <th>@Labels.History</th>
            </tr>
        </thead>
        @if (Model != null && Model.Any())
        {
            <tbody>
                @{int index = 1;}
                @foreach (RequestEntity request in Model)
                {
                    var requestDate = request.IsHalfDay
                        ? (request.FromDate.ToDateMonthYearFormatedDate() + " (" + request.FromTime.ToString("HH:mm") + " - " + request.ToTime.ToString("HH:mm") + ")")
                        : request.FromDate.ToDateMonthYearFormatedDate();
                    <tr id="row@(request.Id)">
                        <td>@(index++)
                        </td>
                        <td>@((request.FromShift == null || string.IsNullOrWhiteSpace(request.FromShift.Name)) ? Labels.NA : request.FromShift.Name)
                        </td>
                         <td class="ddMMyyyyhhmm">@requestDate
                        </td>
                        <td class="ddMMyyyyhhmm">@request.CreatedDate.ToShortFormatedDate()
                        </td>
                        @if (!string.IsNullOrWhiteSpace(request.Remark))
                        { 
                            <td class="tooltip" title="@request.Remark">
                                <span class="icon remark" alt="remark" />
                            </td>
                        }
                        else
                        {
                            <td>
                                -
                            </td>
                        }
                        @Html.Partial("_SharedRequestStatus", request)

                        <td>
                            <a class="viewhistory" href="javascript:;" id="/request/hrviewhistory?id=@request.Id&type=@request.RequestType.FilterRequestHistory">
                                @Labels.View </a>
                        </td>
                    </tr>
                }
            </tbody>
        }
        else
        { 
            @RazorHelper.DisplayNoInformation(colspan: 12);
        }
    </table>
}
@RazorHelper.EmployeeProcessMenu()

<div id="dialoghistorycontent" />
