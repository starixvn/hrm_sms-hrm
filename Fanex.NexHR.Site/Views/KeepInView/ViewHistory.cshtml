@using Fanex.NexHR.Resources
@using Fanex.NexHR.Models.Request
@model IList<KeepInViewModel>
@{
    ViewBag.Title = Labels.RequestHistory;
    Layout = null;
}
@section css{
    @Url.CombresLink("sitecss")
}
@section js{
    @Url.CombresLink("sitejs")
}
@section Breadcrumb {
    <span class="step">@ViewBag.Title</span>
}

    <table class="table table-custom">
        <thead>
            <tr>
                <th>@Labels.SymbolCount</th>
                <th>@Labels.Team</th>
                <th>@Labels.Employee</th>
                <th>@Labels.KIVType</th>
                <th>@Labels.RequestDate</th>
                <th>@Labels.FromTime</th>
                <th>@Labels.ToTime</th>
                <th>@Labels.Remark</th>
                <th>@Labels.VerifiedBy</th>
                <th>@Labels.ApprovedBy</th>
                <th>@Labels.Status</th>
                <th>@Labels.LogDate</th>
            </tr>
        </thead>
        @if (Model != null && Model.Any())
        {
            <tbody>
                @{int index = 1;}
                @foreach (KeepInViewModel request in Model)
                {
                    var fromTime = request.KeepInViewTypeId == (int)KeepInViewTypes.KeepInViewByDay && !request.IsHalfDay ? "-" : request.FromTime.ToString("HH:mm");
                    var toTime = request.KeepInViewTypeId == (int)KeepInViewTypes.KeepInViewByDay && !request.IsHalfDay ? "-" : request.ToTime.ToString("HH:mm");
                <tr id="row@(request.RequestId)">
                    <td>@(index++)</td>
                    <td title="@request.Employee.Team.Name">@request.Employee.Team.Code</td>
                    <td title="@request.Employee.FullName">
                        @request.Employee.NickName
                    </td>
                    <td>
                        @request.KeepInViewTypeName
                    </td>
                    <td class="ddMMyyyyhhmm">
                        @request.OnDate.ToDayOfWeekFormatedDate()
                    </td>
                    <td>@fromTime</td>
                    <td>@toTime</td>
                    @if (!string.IsNullOrWhiteSpace(request.Remark))
                    {
                        <td title="@request.Remark">
                            <span class="glyphicon glyphicon-comment tooltip-tipsy icon remark" title="@request.Remark" alt="remark"></span>
                        </td>
                    }
                    else
                    {
                        <td>-</td>
                    }
                    <td>@request.VerifiedBy.NickName</td>
                    <td>@request.ApprovedBy.NickName</td>
                    <td>@request.Status.ToString()</td>
                    <td class="ddMMyyyyhhmm">@request.InsertedDate.ToShortFormatedDate()</td>
                </tr>
                }
            </tbody>
        }
        else
        {
            @RazorHelper.DisplayNoInformation(colspan: 13);
        }
    </table>