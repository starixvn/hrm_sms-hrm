@using Fanex.NexHR.Core
@using Fanex.NexHR.Core.Enums
@model Fanex.NexHR.ViewModels.Employee.LoginViewModel
@{
    Layout = null;
    var title = string.Empty;
    int siteId = ConfigSettings.SiteId;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>
        @switch (siteId)
        {
            case (int)SiteId.SMS:
                title = "Welcome to SMS HRM";
                break;
            case (int)SiteId.HM:
                title = "Welcome to HM HRM";
                break;
            case (int)SiteId.CTS:
                title = "Welcome to CTS HRM";
                break;
        }
        @title
    </title>
    <link href="~/wwwroot/sources/styles/login.css" rel="stylesheet" />
</head>
<body>
    <div id="panel">
        <div class="header-login">
            <div class="header-container">
                <div>
                    @switch (siteId)
                    {
                        case (int)SiteId.SMS:
                            <img src="~/wwwroot/sources/styles/images/SMS-logo.png" />
                            break;
                        case (int)SiteId.HM:
                            <img src="~/wwwroot/sources/styles/images/Hongma-logo.png" />
                            break;
                        case (int)SiteId.CTS:
                            <img src="~/wwwroot/sources/styles/images/CTS-logo.png" />
                            break;
                    }
                </div>
                <div>
                    <img src="~/wwwroot/sources/styles/images/signin_icon.png" alt="" />
                </div>
            </div>
        </div>
        <div id="formContainer">
            @using (Html.BeginForm("Login", "Auth", FormMethod.Post))
            {
                @Html.ValidationSummary()
                <div class="textbox-outer">
                    <div class="username-icon">
                    </div>
                    <div class="username-field">
                        @Html.TextBoxFor(model => model.Username, new { placeholder = "Username" })
                    </div>
                </div>
                <div class="textbox-outer">
                    <div class="password-icon">
                    </div>
                    <div class="password-field">
                        @Html.TextBoxFor(model => model.Password, new { placeholder = "Password", type = "Password" })
                    </div>
                </div>
                <div class="signin-button">
                    <input type="submit" name="submit" class="button" value="LOGIN" />
                </div>
            }
        </div>
    </div>
    <script src="~/wwwroot/dist/js/login.js"></script>
</body>
</html>