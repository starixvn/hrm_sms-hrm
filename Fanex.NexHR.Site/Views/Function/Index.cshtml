@using Fanex.NexHR.Models;

@model IEnumerable<FunctionModel>
@{
    ViewBag.Title = "Function Management";
    var roles = (IEnumerable<SystemRoleModel>)ViewBag.Roles;
    var hasPermission = (bool)ViewBag.HasPermission;
}

@section css{
    @Url.CombresLink("jobtitlecss")
}
@section js{
    @Url.CombresLink("functionjs")
}
@section Breadcrumb {
    <a class="step" href="#">@ViewBag.Title</a>
}
<h2>@ViewBag.Title</h2>
<div class="container_24 bunhat">
    @using (Html.BeginForm())
    {
        <div class="grid_1 gridlabel">
            @Labels.Role
        </div>
        <div class="grid_2">
            @Html.DropDownList("Role", new SelectList(roles, "RoleId", "RoleName"))
        </div>
    }
</div>
<div class="clear">
</div>
<div id="list-functions"></div>
@if (hasPermission)
{
    <div class="menu">
        <div class="input">
            <input type="button" value="Save" class="space" id="save" disabled />
        </div>
    </div>
}