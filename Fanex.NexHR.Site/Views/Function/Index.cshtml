@using Fanex.NexHR.ViewModels.Function
@using Fanex.NexHR.Models

@model TreeFunctionViewModel

@{
    Layout = "~/Views/Shared/_NewLayout.cshtml";
    ViewBag.Title = Labels.FunctionManagement;
    var systemRoles = (IEnumerable<SystemRoleModel>)ViewBag.SystemRoles;
}

@section css{
    <link href="~/wwwroot/dist/styles/function.index.css" rel="stylesheet" />
}
@section js{
    <script src="~/wwwroot/dist/js/function.index.js"></script>
}
@section Breadcrumb {
    <a class="step">@ViewBag.Title</a>
}

<h2 class="page-title">@ViewBag.Title</h2>

<div class="filter">
    <form class="form-horizontal clearfix" id="formFilter">
        <div class="form-group form-group--m">
            <div class="label-form">
                <label class="control-label">@Labels.Role</label>
            </div>
            <div class="select-form">
                @Html.DropDownList("RoleId", new SelectList(systemRoles, "RoleId", "Name"), new { @class = "form-control" })
            </div>
        </div>
    </form>
</div>

<table class="table table-custom" id="functionTable">
    <thead>
        <tr>
            <th rowspan="2">@Labels.Function</th>
            <th colspan="2">@Labels.RolePermission</th>
        </tr>
        <tr>
            <th>@Labels.Read</th>
            <th>@Labels.Host</th>
        </tr>
    </thead>
    @if (Model.Functions.Any())
    {
        <tbody>
            @Html.Partial("_FunctionTrees", Model)
        </tbody>
    }
    else
    {
        @RazorHelper.DisplayNoInformation(colspan: 3);
    }
</table>

@if (Model.IsHost)
{
    <button type="button" id="btnSubmit" class="btn btn-primary">@Labels.Save</button>
}
