@using Fanex.NexHR.ViewModels.Function
@using HRM.UserControl.Client.Core.Enumerables
@using HRM.UserControl.Client.Core.Models

@model TreeFunctionViewModel

@{
    var disabled = Model.IsHost ? string.Empty : "disabled";
}

@foreach (Function function in Model.Functions)
{
    var permission = Model.FunctionPermissions.FirstOrDefault(x => x.FunctionId == function.FunctionId);
    <tr class="@(function.Level == 0 ? "root-row" : "child-row")" data-fid="@function.FunctionId">
        <td class="align-left">
            @if (function.Level > 0)
            {
                for (int i = 0; i < function.Level - 1; i++)
                {
                    <span class="icon-child-level" style="visibility: hidden">&#9495;</span>
                }
                <span class="icon-child-level">&#9495;</span>
            }
            @function.FunctionName
        </td>
        <td>
            @if (!function.Policy.HasValue || function.Policy == (byte)Policy.Read)
            {
                <div class="checkbox">
                    <input type="checkbox" class="checkbox-custom" name="criteria.funcRead" id="funcRead@(function.FunctionId)"
                           data-pid="@function.ParentId" data-fid="@function.FunctionId"
                           @(permission != null && permission.IsRead ? "checked" : string.Empty) @disabled />
                    <label for="funcRead@(function.FunctionId)"></label>
                </div>
            }
        </td>
        <td>
            @if (!function.Policy.HasValue || function.Policy == (byte)Policy.Host)
            {
                <div class="checkbox">
                    <input type="checkbox" class="checkbox-custom" name="criteria.funcHost" id="funcHost@(function.FunctionId)"
                           data-pid="@function.ParentId" data-fid="@function.FunctionId"
                           @(permission != null && permission.IsHost ? "checked" : string.Empty) @disabled />
                    <label for="funcHost@(function.FunctionId)"></label>
                </div>
            }
        </td>
    </tr>

    if (function.Childs != null && function.Childs.Any())
    {
        var functionTrees = new TreeFunctionViewModel
        {
            RoleId = Model.RoleId,
            IsHost = Model.IsHost,
            Functions = function.Childs,
            FunctionPermissions = Model.FunctionPermissions
        };

        @Html.Partial("_FunctionTrees", functionTrees)
    }
}