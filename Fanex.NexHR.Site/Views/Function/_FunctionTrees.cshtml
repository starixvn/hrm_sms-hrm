@using Fanex.NexHR.Models
@using Fanex.NexHR.ViewModels.Function

@model TreeFunctionViewModel

@{
    var disabled = Model.IsHost ? string.Empty : "disabled";
}

@foreach (FunctionModel function in Model.Functions)
{
    <tr class="@(function.Level == 0 ? "root-row" : "child-row")">
        <td class="align-left">
            @if (function.Level > 0)
            {
                for (int i = 0; i < function.Level - 1; i++)
                {
                    <span class="icon-child-level" style="visibility: hidden">&#9495;</span>
                }
                <span class="icon-child-level">&#9495;</span>
            }
            @function.Name
        </td>
        <td>
            <div class="checkbox">
                <input type="checkbox" class="checkbox-custom" name="criteria.funcRead" id="funcRead@(function.FunctionId)"
                       data-pid="@function.ParentFunctionId" data-fid="@function.FunctionId"
                       @(function.IsRead ? "checked" : string.Empty) @disabled />
                <label for="funcRead@(function.FunctionId)"></label>
            </div>
        </td>
        <td>
            @if (!function.IsReadOnly)
            {
                <div class="checkbox">
                    <input type="checkbox" class="checkbox-custom" name="criteria.funcHost" id="funcHost@(function.FunctionId)"
                           data-pid="@function.ParentFunctionId" data-fid="@function.FunctionId"
                           @(function.IsHost ? "checked" : string.Empty) @disabled />
                    <label for="funcHost@(function.FunctionId)"></label>
                </div>
            }
        </td>
    </tr>

    var functionTrees = new TreeFunctionViewModel
    {
        RoleId = Model.RoleId,
        IsHost = Model.IsHost,
        Functions = function.Childs
    };

    @Html.Partial("_FunctionTrees", functionTrees)
}