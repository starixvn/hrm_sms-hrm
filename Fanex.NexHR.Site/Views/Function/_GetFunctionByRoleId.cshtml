@using Nexus.RoleManagement.Services;

@model IEnumerable<FunctionViewModel>
@{
    var hasPermission = (bool)ViewBag.HasPermission;
}
<table id="data" class="table table-custom persist-area" style="width: auto; min-width: 622px;">
    <thead>
        <tr class="persist-header">
            <th rowspan="2">Function</th>
            <th colspan="4">Role Permission</th>
        </tr>
        <tr>
            <th>Read</th>
            <th>Host</th>
        </tr>
    </thead>
    @if (Model.Any())
    {
        <tbody>
            @foreach (FunctionViewModel function in Model)
            {
                <tr>
                    <td class="align-left">
                        @function.Name
                        <input id="functionId" type="hidden" value="@function.FunctionId" />
                        <input id="functionKey" type="hidden" value="@function.FunctionKey" />
                        <input id="functionName" type="hidden" value="@function.Name" />
                    </td>
                    @if (!hasPermission || function.IsReadOnly)
                    {
                        <td>
                            @Html.CheckBox("IsRead", function.IsRead, new { @disabled = "disabled" })
                        </td>
                        <td>
                            @Html.CheckBox("IsHost", function.IsHost, new { @disabled = "disabled" })
                        </td>
                    }
                    else
                    {

                        <td>
                            @if (function.IsHost)
                            {
                                @Html.CheckBox("IsRead", function.IsRead, new { @id = function.FunctionId + "_IsRead", @disabled = "disabled"})
                            }
                            else
                            {
                                @Html.CheckBox("IsRead", function.IsRead, new { @id = function.FunctionId + "_IsRead"})
                            }
                        </td>
                        <td>
                            @Html.CheckBox("IsHost", function.IsHost, new { @id = function.FunctionId + "_IsHost", @data_id = function.FunctionId })
                        </td>
                    }
                </tr>
            }
        </tbody>
    }
    else
    {
        @RazorHelper.DisplayNoInformation(colspan: 3);
    }
</table>