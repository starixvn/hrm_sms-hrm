@using Nexus.RoleManagement.Services;

@model IEnumerable<FunctionViewModel>
@{
    var hasPermission = (bool)ViewBag.HasPermission;
}
<table id="data" class="table table-custom persist-area" style="width: auto; min-width: 622px;">
    <thead>
        <tr class="persist-header">
            <th rowspan="2">Function</th>
            <th colspan="4">Role Permission</th>
        </tr>
        <tr>
            <th>Read</th>
            <th>Host</th>
        </tr>
    </thead>
    @if (Model.Any())
    {
        <tbody>
            @foreach (FunctionViewModel function in Model)
            {
                <tr>
                    <td class="align-left">
                        @function.Name
                        <input id="functionId" type="hidden" value="@function.FunctionId" />
                        <input id="functionKey" type="hidden" value="@function.FunctionKey" />
                        <input id="functionName" type="hidden" value="@function.Name" />
                    </td>
                    <td>
                        @{
                var attributeRead = !hasPermission ? new { @disabled = "disabled" } : null;
                var attributeHost = !hasPermission || function.IsReadOnly ? new { @disabled = "disabled" } : null;
                        }
                        @Html.CheckBox("IsRead", function.IsRead, attributeRead)
                    </td>
                    <td>
                        @Html.CheckBox("IsHost", function.IsHost, attributeHost)
                    </td>
                </tr>
            }
        </tbody>
    }
    else
    {
        @RazorHelper.DisplayNoInformation(colspan: 3);
    }
</table>