@using Nexus.RoleManagement.Services;

@model IEnumerable<FunctionModel>
@{
    var hasPermission = (bool)ViewBag.HasPermission;
    var attribute = hasPermission ? null : new { @disabled = "disabled"};
}
<table id="data" class="table table-custom persist-area" style="width: auto; min-width: 622px;">
    <thead>
        <tr class="persist-header">
            <th rowspan="2">Function</th>
            <th colspan="4">Role Permission</th>
        </tr>
        <tr>
            <th>Create</th>
            <th>Read</th>
            <th>Update</th>
            <th>Delete</th>
        </tr>
    </thead>
    @if (Model.Any())
    {
        <tbody>
            @foreach (FunctionModel function in Model)
            {
                <tr>
                    <td class="align-left">
                        @function.Name
                        <input id="functionId" type="hidden" value="@function.FunctionId" />
                        <input id="functionKey" type="hidden" value="@function.FunctionKey" />
                        <input id="functionName" type="hidden" value="@function.Name" />
                    </td>
                    <td>
                        @Html.CheckBox("IsCreate", function.IsCreate, attribute)
                    </td>
                    <td>
                        @Html.CheckBox("IsRead", function.IsRead)
                    </td>
                    <td>
                        @Html.CheckBox("IsEdit", function.IsEdit)
                    </td>
                    <td>
                        @Html.CheckBox("IsDelete", function.IsDelete)
                    </td>
                </tr>
            }
        </tbody>
    }
    else
    {
        @RazorHelper.DisplayNoInformation(colspan: 5);
    }
</table>