@using Fanex.NexHR.Models;
@using Fanex.NexHR.ViewModels;

@model IEnumerable<MenuViewModel>
@{
    Layout = "~/Views/Shared/_NewLayout.cshtml";
    ViewBag.Title = "Menu Management";
    var hasPermission = (bool)ViewBag.HasPermission;
    var totalColumn = hasPermission ? 7 : 5;
}
@section css{
    <link href="~/wwwroot/dist/styles/menu.index.css" rel="stylesheet"/>
}
@section js{
    <script src="~/wwwroot/dist/js/menu.index.js"></script>
}
@section Breadcrumb {
    <span class="step">@ViewBag.Title</span>
}
<h2 class="page-title">@ViewBag.Title</h2>
@if (hasPermission)
{
    <a href="@Url.Action("Create")" class="btn btn-request">
        <span class="fa fa-plus"></span>
        @Labels.CreateMenu
    </a>
}

<table id="data" class="table table-custom">
    <thead>
        <tr>
            <th>Order. Name</th>
            <th>Link</th>
            <th>Function</th>
            <th>Parent Menu</th>
            <th>Active</th>
            @if (hasPermission)
            {
                <th>@Labels.Edit</th>
                <th>@Labels.Delete</th>
            }
        </tr>
    </thead>

    @if (Model.Any())
    {

        <tbody>
            @foreach (MenuViewModel menu in Model.Where(i => i.ParentMenu == null))
            {
                <tr>
                    <td class="rowdivider align-left" colspan="@totalColumn">
                        <a href="@Url.Action("edit", "menu", new { Id = menu.MenuId })">
                            @(menu.DisplayOrder + ". " + menu.Text)
                        </a>
                    </td>
                </tr>

                foreach (MenuViewModel chilmenu in Model.Where(i => i.ParentMenu != null && i.ParentMenu.MenuId == menu.MenuId))
                {
                    <tr id="row_@chilmenu.MenuId">
                        <td class="sub">
                            @(chilmenu.DisplayOrder + ". " + chilmenu.Text)
                        </td>
                        <td>
                            @chilmenu.Link
                        </td>
                        <td>
                            @(chilmenu.Function != null ? chilmenu.Function.Name : string.Empty)
                        </td>
                        <td>
                            @chilmenu.ParentMenu.Text
                        </td>
                        <td>
                            @chilmenu.IsActive
                        </td>
                        @if (hasPermission)
                        {
                            <td class="cmd" title="Edit">
                                <a href="@Url.Action("edit", "menu", new { Id = chilmenu.MenuId })">
                                    <i class="fa fa-pencil fa-lg icon-edit"></i>
                                </a>
                            </td>
                            <td class="cmd" title="Delete">
                                <a href="javascript:;">
                                    <i class="fa fa-times fa-lg icon-delete" data-id="@chilmenu.MenuId"></i>
                                </a>
                            </td>
                        }
                    </tr>
                }
            }
        </tbody>
    }
    else
    {
        @RazorHelper.DisplayNoInformation(totalColumn)
    }
</table>