@model IList<OtherViolationModel>
<table class="data">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th>@Labels.ViolationDate</th>
            <th>@Labels.ViolationType</th>
            <th>@Labels.MinusScore</th>
            <th>@Labels.Comment</th>
            <th>@Labels.Delete</th>
        </tr>
    </thead>
    @if (Model.Any())
    {
        int index = 0;
        <tbody>
        @foreach (OtherViolationModel item in Model)
        {
            index++;
            <tr>
                <td>@index</td>
                <td>@item.WorkDate.ToDateMonthYearFormatedDate()</td>
                <td>@item.Name</td>
                <td>@item.Score</td>
                <td>@item.Comment</td>
                <td></td>
            </tr>
        }
        </tbody>
    }
    else
    {
        @RazorHelper.DisplayNoInformation(colspan: 6);
    }
</table>