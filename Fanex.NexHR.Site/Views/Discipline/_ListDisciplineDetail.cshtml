@model IList<DisciplineDetailModel>
<table class="data discipline-detail">
    <thead>
        <tr>
            <th>@Labels.Nick</th>
            <th>@Labels.Section</th>
            <th>@Labels.Date</th>
            <th>@Labels.Shift</th>
            <th>@Labels.CheckIn</th>
            <th>@Labels.CheckOut</th>
            <th>@Labels.TotalHours</th>
            <th>@Labels.MissingCheckInOut</th>
            <th>@Labels.WorkingUnderTime</th>
            <th>@Labels.LateIn</th>
            <th>@Labels.EarlyOut</th>
            <th>@Labels.Absent</th>
            <th>@Labels.UPL</th>
            <th>@Labels.UPLAbsent</th>
            <th>@Labels.ChangeShift</th>
            <th>@Labels.MinusScoringSystem</th>
            <th>@Labels.MinusScoringApprover</th>
        </tr>
    </thead>
    @if (Model != null && Model.Any())
    {
        <tbody>
            @foreach (DisciplineDetailModel item in Model)
            {
                <tr>
                    <td class="tooltip" title="@item.Employee.FullName">@item.Employee.NickName</td>
                    <td>@item.Employee.GroupName</td>
                    <td>@item.WorkDate.ToDateMonthYearFormatedDate()</td>
                    <td>@item.ShiftName</td>
                    <td>
                        @if (item.CheckIn.HasValue)
                        {
                            <span>@item.CheckIn.Value.ToString("HH:mm")</span>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                    <td>
                        @if (item.CheckOut.HasValue)
                        {
                            <span>@item.CheckOut.Value.ToString("HH:mm")</span>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.TotalHours.Value))
                        {
                            @RazorHelper.ConvertNumberToTime(double.Parse(item.TotalHours.Value) * 60)
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.MissingCheckInOut.Value) && !item.MissingCheckInOut.Value.Equals("0"))
                        {
                            <span>@item.MissingCheckInOut.Value</span>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                    <td></td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.LateIn.Value) && !item.LateIn.Value.Equals("0"))
                        {
                            @RazorHelper.ConvertNumberToTime(double.Parse(item.LateIn.Value))
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.EarlyOut.Value) && !item.EarlyOut.Value.Equals("0"))
                        {
                            @RazorHelper.ConvertNumberToTime(double.Parse(item.EarlyOut.Value))
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.Absent.Value) && !item.Absent.Value.Equals("0"))
                        {
                            <span>@item.Absent.Value</span>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.UnpaidLeave.Value) && !item.UnpaidLeave.Value.Equals("0"))
                        {
                            <span>@item.UnpaidLeave.Value</span>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.UnpaidLeaveAbsent.Value) && !item.UnpaidLeaveAbsent.Value.Equals("0"))
                        {
                            <span>@item.UnpaidLeaveAbsent.Value</span>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.ChangeShift.Value) && !item.ChangeShift.Value.Equals("0"))
                        {
                            <span>@item.ChangeShift.Value</span>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                    <td>@item.SystemSubtractScore</td>
                    <td>@item.ApproverSubtractScore</td>
                </tr>
            }
        </tbody>
    }
    else
    {
        @RazorHelper.DisplayNoInformation(colspan: 18);
    }
</table>