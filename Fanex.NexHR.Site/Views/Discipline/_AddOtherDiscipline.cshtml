@model AddOtherDisciplineViewModel

<form id="frmAddOtherDiscipline">
    @Html.ValidationSummary()
    <div class="formrow">
        <div class="label">
            @Html.LabelFor(model => model.Employee)
        </div>
        <div class="input">
            @Html.EditorFor(model => model.Employee)
            @Html.HiddenFor(model => model.EmployeeId)
            @Html.ValidationMessageFor(model => model.EmployeeId)
        </div>
        <div class="clear">
        </div>
    </div>
    <div class="formrow">
        <div class="label">
            @Html.LabelFor(model => model.WorkDate, "Discipline Date")
        </div>
        <div class="input">
            @Html.DatePickerFor(model => model.WorkDate, minDate: new DateTime(2010, 1, 1))
            @Html.ValidationMessageFor(model => model.WorkDate)
        </div>
        <div class="clear">
        </div>
    </div>
    <div class="formrow">
        <div class="label">
            @Html.LabelFor(model => model.DisciplineTypeId)
        </div>
        <div class="input">
            <select id="DisciplineTypeId" name="DisciplineTypeId">
                <option value="0" data-score="0">-- Select Other Discipline Type --</option>
                @foreach (DisciplineTypeModel otherDisciplineType in @Model.OtherDisciplineTypes)
                {
                    <option value="@otherDisciplineType.DisciplineTypeId" data-score="@otherDisciplineType.Score">@otherDisciplineType.Name</option>
                }
            </select>
            @Html.ValidationMessageFor(model => model.DisciplineTypeId)
        </div>
        <div class="clear">
        </div>
    </div>
    <div class="formrow">
        <div class="label">
            @Html.LabelFor(model => model.MinusScore)
        </div>
        <div class="input">
            @Html.TextBoxFor(model => model.MinusScore)
        </div>
        <div class="clear">
        </div>
    </div>
    <div class="formrow">
        <div class="label">
            @Html.LabelFor(model => model.Comment)
        </div>
        <div class="input">
            @Html.TextAreaFor(model => model.Comment)
        </div>
        <div class="clear">
        </div>
    </div>
</form>