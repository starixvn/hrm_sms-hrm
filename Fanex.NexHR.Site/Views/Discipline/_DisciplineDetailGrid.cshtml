@using Fanex.NexHR.Core
@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Models.Discipline
@using Fanex.NexHR.Resources
@model IList<DisciplineDetailModel>
    @{
        var hasPermissionToEdit = (bool)ViewBag.HasPermissionToEdit;
        var hasPermissionToUpdateOutOfControlReason = (bool)ViewBag.HasPermissionToUpdateOutOfControlReason;
    }
    <table id="data" class="table table-custom discipline-detail">
        <thead>
            @if (Model != null & Model.Any() && hasPermissionToEdit)
            {
                <tr>
                    <th colspan="23" style="text-align: left;">
                        <input type="button" class="btn btn-primary" id="saveChange" value="@Labels.Save" />
                    </th>
                </tr>
            }
            <tr>
                <th>@Labels.SymbolCount</th>
                @if (hasPermissionToUpdateOutOfControlReason)
                {
                    <th>
                        <input type="checkbox" class="checkbox-custom" id="checkAll"
                               name="checkAll" value="true" />
                        <label for="checkAll" class="header-label">@Labels.OutOfControlReason</label>
                    </th>
                }
                <th>@Labels.Date</th>
                <th>@Labels.Team</th>
                <th>@Labels.Nick</th>
                <th>@Labels.Shift</th>
                <th>@Labels.CheckIn</th>
                <th>@Labels.CheckOut</th>
                <th>@Labels.TotalHours</th>
                <th class="width-80">@Labels.MissingCheckInOut</th>
                <th class="width-80">@Labels.WorkingUnderTime</th>
                <th>@Labels.LateIn</th>
                <th>@Labels.EarlyOut</th>
                <th>@Labels.Absent</th>
                <th>@Labels.UPL</th>
                <th>@Labels.UPLAbsent</th>
                <th>@Labels.ChangeShift</th>
                <th>@Labels.LateRequestLeave</th>
                <th>@Labels.WeekendLeave</th>
                <th class="width-80">@Labels.DisciplinePoint</th>
                <th class="width-80">@Labels.DisciplineByApprover</th>
                <th class="width-80">@Labels.ApproverComment</th>
                <th class="width-80">@Labels.EmployeeComment</th>
            </tr>
        </thead>
        @if (Model != null && Model.Any())
        {
            int rowIndex = 0;
            <tbody>
                @foreach (DisciplineDetailModel item in Model)
                {
                    int colIndex = 1, disciplinetypeId;
                    rowIndex++;
                    var checkboxId = string.Format("checkbox-{0}-{1}", rowIndex, colIndex++);
                    var tooltipChangeShift = string.Empty;
                    var tooltipMissingCheckInOut = string.Empty;
                    var tooltipLateIn = string.Empty;
                    var tooltipEarlyOut = string.Empty;
                    var tooltipAbsent = string.Empty;
                    var tooltipUnpaidLeave = string.Empty;
                    var tooltipWorkingUnderTime = string.Empty;
                    var tooltipUnpaidLeaveAbsent = string.Empty;
                    var tooltipUnplannedLeave = string.Empty;
                    var tooltipWeekendLeave = string.Empty;
                <tr>
                    <td>@rowIndex</td>
                    @if (hasPermissionToUpdateOutOfControlReason)
                    {
                        <td>
                            <input type="checkbox" class="checkbox-custom outOfControlReason" id="@checkboxId"
                                   name="@checkboxId" checked="@item.IsOutOfControlReason" data-changed="false"
                                   data-originchecked="@item.IsOutOfControlReason" />
                            <label for="@checkboxId"></label>
                        </td>
                    }
                    <td class="@(item.IsWeekend ? "weekend" : string.Empty)">@item.WorkDate.ToDayOfWeekFormatedDate()</td>
                    <td>@item.Employee.TeamName</td>
                    <td class="tooltip-tipsy" title="@item.Employee.FullName">@item.Employee.NickName</td>
                    <td>@item.ShiftName</td>
                    <td>
                        @if (item.CheckIn.HasValue)
                        {
                            @item.CheckIn.Value.ToString("HH:mm")
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                    <td>
                        @if (item.CheckOut.HasValue)
                        {
                            @item.CheckOut.Value.ToString("HH:mm")
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.TotalHours))
                        {
                            @item.TotalHours
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                    @if (!string.IsNullOrWhiteSpace(item.MissingCheckInOut.IgnoreBy))
                    {
                        tooltipMissingCheckInOut = string.Format(Messages.IgnoreDisciplineDetail, @item.MissingCheckInOut.IgnoreBy, @item.MissingCheckInOut.IgnoreDate.ToShortFormatedDate());
                    }
                    <td class="tooltip-tipsy" title="@tooltipMissingCheckInOut">
                        @if (item.MissingCheckInOut.Value > 0)
                        {
                            <span class="float-left">@item.MissingCheckInOut.Value</span>
                            if (item.MissingCheckInOut.HasViolated)
                            {
                                disciplinetypeId = (int)DisciplineType.MissingCheckInOut;
                                checkboxId = string.Format("checkbox-{0}-{1}", rowIndex, colIndex++);
                                <input class="float-right ignoredDiscipline checkbox-custom" type="checkbox"
                                       id="@checkboxId" name="@checkboxId"
                                       checked="@item.MissingCheckInOut.HasIgnored"
                                       disabled="@item.MissingCheckInOut.HasApprovedBy.Equals(false)"
                                       data-workdate="@item.WorkDate.Date.ToString("d")" data-employee-id="@item.Employee.EmployeeId"
                                       data-discipline-type-id="@disciplinetypeId" data-discipline-score="@item.MissingCheckInOut.Score"
                                       data-has-ignored="@item.MissingCheckInOut.HasIgnored" data-changed="false" />
                                <label for="@checkboxId"></label>
                            }
                        }
                        else
                        {
                            <span class="float-left">-</span>
                        }
                    </td>
                    @if (!string.IsNullOrWhiteSpace(item.WorkingUnderTime.IgnoreBy))
                    {
                        tooltipWorkingUnderTime = string.Format(Messages.IgnoreDisciplineDetail, @item.WorkingUnderTime.IgnoreBy, @item.WorkingUnderTime.IgnoreDate.ToShortFormatedDate());
                    }
                    <td class="tooltip-tipsy" title="@tooltipWorkingUnderTime">
                        @if (item.WorkingUnderTime.Value > 0)
                        {
                            <span class="float-left">1</span>
                            if (item.WorkingUnderTime.HasViolated)
                            {
                                disciplinetypeId = (int)DisciplineType.WorkingUnderTime;
                                checkboxId = string.Format("checkbox-{0}-{1}", rowIndex, colIndex++);
                                <input class="float-right ignoredDiscipline checkbox-custom" type="checkbox"
                                       id="@checkboxId" name="@checkboxId"
                                       checked="@item.WorkingUnderTime.HasIgnored"
                                       disabled="@item.WorkingUnderTime.HasApprovedBy.Equals(false)"
                                       data-workdate="@item.WorkDate.Date.ToString("d")" data-employee-id="@item.Employee.EmployeeId"
                                       data-discipline-type-id="@disciplinetypeId" data-discipline-score="@item.WorkingUnderTime.Score"
                                       data-has-ignored="@item.WorkingUnderTime.HasIgnored" data-changed="false" />
                                <label for="@checkboxId"></label>
                            }
                        }
                        else
                        {
                            <span class="float-left">-</span>
                        }
                    </td>
                    @if (!string.IsNullOrWhiteSpace(item.LateIn.IgnoreBy))
                    {
                        tooltipLateIn = string.Format(Messages.IgnoreDisciplineDetail, @item.LateIn.IgnoreBy, @item.LateIn.IgnoreDate.ToShortFormatedDate());
                    }
                    <td class="tooltip-tipsy" title="@tooltipLateIn">
                        @if (item.LateIn.Value > 0)
                        {
                            <div class="float-left">@item.MinutesLateIn</div>
                            if (item.LateIn.HasViolated)
                            {
                                disciplinetypeId = (int)DisciplineType.LateIn;
                                checkboxId = string.Format("checkbox-{0}-{1}", rowIndex, colIndex++);
                                <input class="float-right ignoredDiscipline checkbox-custom" type="checkbox"
                                       id="@checkboxId" name="@checkboxId"
                                       checked="@item.LateIn.HasIgnored"
                                       disabled="@item.LateIn.HasApprovedBy.Equals(false)"
                                       data-workdate="@item.WorkDate.Date.ToString("d")" data-employee-id="@item.Employee.EmployeeId"
                                       data-discipline-type-id="@disciplinetypeId" data-discipline-score="@item.LateIn.Score"
                                       data-has-ignored="@item.LateIn.HasIgnored" data-changed="false" />
                                <label for="@checkboxId"></label>
                            }
                        }
                        else
                        {
                            <span class="float-left">-</span>
                        }
                    </td>
                    @if (!string.IsNullOrWhiteSpace(item.EarlyOut.IgnoreBy))
                    {
                        tooltipEarlyOut = string.Format(Messages.IgnoreDisciplineDetail, @item.EarlyOut.IgnoreBy, @item.EarlyOut.IgnoreDate.ToShortFormatedDate());
                    }
                    <td class="tooltip-tipsy" title = "@tooltipEarlyOut">
                        @if (item.EarlyOut.Value > 0)
                        {
                            <div class="float-left">@item.MinutesEarlyOut</div>
                            if (item.EarlyOut.HasViolated)
                            {
                                disciplinetypeId = (int)DisciplineType.EarlyOut;
                                checkboxId = string.Format("checkbox-{0}-{1}", rowIndex, colIndex++);
                                <input class="float-right ignoredDiscipline checkbox-custom" type="checkbox"
                                       id="@checkboxId" name="@checkboxId"
                                       checked="@item.EarlyOut.HasIgnored"
                                       disabled="@item.EarlyOut.HasApprovedBy.Equals(false)"
                                       data-workdate="@item.WorkDate.Date.ToString("d")" data-employee-id="@item.Employee.EmployeeId"
                                       data-discipline-type-id="@disciplinetypeId" data-discipline-score="@item.EarlyOut.Score"
                                       data-has-ignored="@item.EarlyOut.HasIgnored" data-changed="false" />
                                <label for="@checkboxId"></label>
                            }
                        }
                        else
                        {
                            <span class="float-left">-</span>
                        }
                    </td>
                    @if (!string.IsNullOrWhiteSpace(item.Absent.IgnoreBy))
                    {
                        tooltipAbsent = string.Format(Messages.IgnoreDisciplineDetail, @item.Absent.IgnoreBy, @item.Absent.IgnoreDate.ToShortFormatedDate());
                    }
                    <td class="tooltip-tipsy" title="@tooltipAbsent">
                        @if (item.Absent.Value > 0)
                        {
                            <span class="float-left">@item.Absent.Value</span>
                            if (item.Absent.HasViolated)
                            {
                                disciplinetypeId = (int)DisciplineType.Absent;
                                checkboxId = string.Format("checkbox-{0}-{1}", rowIndex, colIndex++);
                                <input class="float-right ignoredDiscipline checkbox-custom" type="checkbox"
                                       id="@checkboxId" name="@checkboxId"
                                       checked="@item.Absent.HasIgnored"
                                       disabled="@item.Absent.HasApprovedBy.Equals(false)"
                                       data-workdate="@item.WorkDate.Date.ToString("d")" data-employee-id="@item.Employee.EmployeeId"
                                       data-discipline-type-id="@disciplinetypeId" data-discipline-score="@item.Absent.Score"
                                       data-has-ignored="@item.Absent.HasIgnored" data-changed="false" />
                                <label for="@checkboxId"></label>
                            }
                        }
                        else
                        {
                            <span class="float-left">-</span>
                        }
                    </td>
                    @if (!string.IsNullOrWhiteSpace(item.UnpaidLeave.IgnoreBy))
                    {
                        tooltipUnpaidLeave = string.Format(Messages.IgnoreDisciplineDetail, @item.UnpaidLeave.IgnoreBy, @item.UnpaidLeave.IgnoreDate.ToShortFormatedDate());
                    }
                    <td class="tooltip-tipsy" title="@tooltipUnpaidLeave">
                        @if (item.UnpaidLeave.Value > 0)
                        {
                            <span class="float-left">@item.UnpaidLeave.Value</span>
                            if (item.UnpaidLeave.HasViolated)
                            {
                                disciplinetypeId = (int)DisciplineType.UnpaidLeave;
                                checkboxId = string.Format("checkbox-{0}-{1}", rowIndex, colIndex++);
                                <input class="float-right ignoredDiscipline checkbox-custom" type="checkbox"
                                       id="@checkboxId" name="@checkboxId"
                                       checked="@item.UnpaidLeave.HasIgnored"
                                       disabled="@item.UnpaidLeave.HasApprovedBy.Equals(false)"
                                       data-workdate="@item.WorkDate.Date.ToString("d")" data-employee-id="@item.Employee.EmployeeId"
                                       data-discipline-type-id="@disciplinetypeId" data-discipline-score="@item.UnpaidLeave.Score"
                                       data-has-ignored="@item.UnpaidLeave.HasIgnored" data-changed="false" />
                                <label for="@checkboxId"></label>
                            }
                        }
                        else
                        {
                            <span class="float-left">-</span>
                        }
                    </td>
                    @if (!string.IsNullOrWhiteSpace(item.UnpaidLeaveAbsent.IgnoreBy))
                    {
                        tooltipUnpaidLeaveAbsent = string.Format(Messages.IgnoreDisciplineDetail, @item.UnpaidLeaveAbsent.IgnoreBy, @item.UnpaidLeaveAbsent.IgnoreDate.ToShortFormatedDate());
                    }
                    <td class="tooltip-tipsy" title="@tooltipUnpaidLeaveAbsent">
                        @if (item.UnpaidLeaveAbsent.Value > 0)
                        {
                            <span class="float-left">@item.UnpaidLeaveAbsent.Value</span>
                            if (item.UnpaidLeaveAbsent.HasViolated)
                            {
                                disciplinetypeId = (int)DisciplineType.UnpaidLeaveAbsent;
                                checkboxId = string.Format("checkbox-{0}-{1}", rowIndex, colIndex++);
                                <input class="float-right ignoredDiscipline checkbox-custom" type="checkbox"
                                       id="@checkboxId" name="@checkboxId"
                                       checked="@item.UnpaidLeaveAbsent.HasIgnored"
                                       disabled="@item.UnpaidLeaveAbsent.HasApprovedBy.Equals(false)"
                                       data-workdate="@item.WorkDate.Date.ToString("d")" data-employee-id="@item.Employee.EmployeeId"
                                       data-discipline-type-id="@disciplinetypeId" data-discipline-score="@item.UnpaidLeaveAbsent.Score"
                                       data-has-ignored="@item.UnpaidLeaveAbsent.HasIgnored" data-changed="false" />
                                <label for="@checkboxId"></label>
                            }
                        }
                        else
                        {
                            <span class="float-left">-</span>
                        }
                    </td>
                    @if (!string.IsNullOrWhiteSpace(item.ChangeShift.IgnoreBy))
                    {
                        tooltipChangeShift = string.Format(Messages.IgnoreDisciplineDetail, @item.ChangeShift.IgnoreBy, @item.ChangeShift.IgnoreDate.ToShortFormatedDate());
                    }
                    <td class="tooltip-tipsy" title="@tooltipChangeShift">
                        @if (item.ChangeShift.Value > 0)
                        {
                            <span class="float-left">@item.ChangeShift.Value</span>
                            if (item.ChangeShift.HasViolated)
                            {
                                disciplinetypeId = (int)DisciplineType.ChangeShift;
                                checkboxId = string.Format("checkbox-{0}-{1}", rowIndex, colIndex++);
                                <input class="float-right ignoredDiscipline checkbox-custom" type="checkbox"
                                       id="@checkboxId" name="@checkboxId"
                                       checked="@item.ChangeShift.HasIgnored"
                                       disabled="@item.ChangeShift.HasApprovedBy.Equals(false)"
                                       data-workdate="@item.WorkDate.Date.ToString("d")" data-employee-id="@item.Employee.EmployeeId"
                                       data-discipline-type-id="@disciplinetypeId" data-discipline-score="@item.ChangeShift.Score"
                                       data-has-ignored="@item.ChangeShift.HasIgnored" data-changed="false" />
                                <label for="@checkboxId"></label>
                            }
                        }
                        else
                        {
                            <span class="float-left">-</span>
                        }
                    </td>
                    @if (!string.IsNullOrWhiteSpace(item.UnplannedLeave.IgnoreBy))
                    {
                        tooltipUnplannedLeave = string.Format(Messages.IgnoreDisciplineDetail, @item.UnplannedLeave.IgnoreBy, @item.UnplannedLeave.IgnoreDate.ToShortFormatedDate());
                    }
                    <td class="tooltip-tipsy" title="@tooltipUnplannedLeave">
                        @if (item.UnplannedLeave.Value > 0)
                        {
                            <span class="float-left">@item.UnplannedLeave.Value</span>
                            if (item.UnplannedLeave.HasViolated)
                            {
                                disciplinetypeId = (int)DisciplineType.UnplannedLeave;
                                checkboxId = string.Format("checkbox-{0}-{1}", rowIndex, colIndex++);
                                <input class="float-right ignoredDiscipline checkbox-custom" type="checkbox"
                                       id="@checkboxId" name="@checkboxId"
                                       checked="@item.UnplannedLeave.HasIgnored"
                                       disabled="@item.UnplannedLeave.HasApprovedBy.Equals(false)"
                                       data-workdate="@item.WorkDate.Date.ToString("d")" data-employee-id="@item.Employee.EmployeeId"
                                       data-discipline-type-id="@disciplinetypeId" data-discipline-score="@item.UnplannedLeave.Score"
                                       data-has-ignored="@item.UnplannedLeave.HasIgnored" data-changed="false" />
                                <label for="@checkboxId"></label>
                            }
                        }
                        else
                        {
                            <span class="float-left">-</span>
                        }
                    </td>
                    @if (!string.IsNullOrWhiteSpace(item.WeekendLeave.IgnoreBy))
                    {
                        tooltipWeekendLeave = string.Format(Messages.IgnoreDisciplineDetail, @item.WeekendLeave.IgnoreBy, @item.WeekendLeave.IgnoreDate.ToShortFormatedDate());
                    }
                    <td class="tooltip-tipsy" title="@tooltipWeekendLeave">
                        @if (item.WeekendLeave.Value > 0)
                        {
                            <span class="float-left">@item.WeekendLeave.Value</span>
                            if (item.WeekendLeave.HasViolated)
                            {
                                disciplinetypeId = (int)DisciplineType.WeekendLeave;
                                checkboxId = string.Format("checkbox-{0}-{1}", rowIndex, colIndex++);
                                <input class="float-right ignoredDiscipline checkbox-custom" type="checkbox"
                                       id="@checkboxId" name="@checkboxId"
                                       checked="@item.WeekendLeave.HasIgnored"
                                       disabled="@item.WeekendLeave.HasApprovedBy.Equals(false)"
                                       data-workdate="@item.WorkDate.Date.ToString("d")" data-employee-id="@item.Employee.EmployeeId"
                                       data-discipline-type-id="@disciplinetypeId" data-discipline-score="@item.WeekendLeave.Score"
                                       data-has-ignored="@item.WeekendLeave.HasIgnored" data-changed="false" />
                                <label for="@checkboxId"></label>
                            }
                        }
                        else
                        {
                            <span class="float-left">-</span>
                        }
                    </td>
                    <td>
                        @if (item.SystemSubtractScore > 0)
                        {
                            <span style="color: red">-@item.SystemSubtractScore.ToString("0.0")</span>
                        }
                        else
                        {
                            <span>@item.SystemSubtractScore.ToString("0.0")</span>
                        }
                    </td>
                    <td class="approverSubtractScore">
                        @if (item.ApproverSubtractScore > 0)
                        {
                            if (item.ApproverSubtractScore <= item.SystemSubtractScore)
                            {
                                <span style="color: red">-@item.ApproverSubtractScore.ToString("0.0")</span>
                            }
                            else
                            {
                                <span style="color: red">-@item.SystemSubtractScore.ToString("0.0")</span>
                            }
                        }
                        else
                        {
                            <span>@item.ApproverSubtractScore.ToString("0.0")</span>
                        }
                    </td>
                    @if (!string.IsNullOrEmpty(item.ApproverComment))
                    {
                        <td>
                            <span class="fa fa-comment tooltip-tipsy" title="@item.ApproverComment"></span>
                        </td>
                    }
                    else
                    {
                        <td></td>
                    }
                    @if (!string.IsNullOrEmpty(item.EmployeeComment))
                    {
                        <td>
                            <span class="fa fa-comment tooltip-tipsy" title="@item.EmployeeComment"></span>
                        </td>
                    }
                    else
                    {
                        <td></td>
                    }
                </tr>
                }
            </tbody>
        }
        else
        {
            @RazorHelper.DisplayNoInformation(colspan: 23);
        }
    </table>
