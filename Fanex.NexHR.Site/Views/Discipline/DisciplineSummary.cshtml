@model DisciplineSummaryViewModel
@{
    ViewBag.Title = Labels.DisciplineSummary;
}
@section css{
    @Url.CombresLink("disciplinecss")
}
@section js{
    @Url.CombresLink("disciplinesummaryjs")
}
@section Breadcrumb {
    <a class="step">@ViewBag.Title</a>
}
<h2>@Labels.DisciplineSummary</h2>
<form class="form-filter">
    <div class="container_24 bunhat">
        <div class="space"></div>
        <div class="grid_2 gridlabel">@Labels.DateRange</div>
        <div class="grid_6">
            @Html.DropDownListFor(model => model.DateRange, Model.DateRange)
        </div>

        <div class="grid_2 gridlabel">
            @Html.LabelFor(model => model.FromDate)
        </div>
        <div class="grid_4">
            @Html.DatePickerFor(model => model.FromDate, minDate: new DateTime(2010, 1, 1))
        </div>
        <div class="grid_2 gridlabel">
            @Html.LabelFor(model => model.ToDate)
        </div>
        <div class="grid_4">
            @Html.DatePickerFor(model => model.ToDate, minDate: new DateTime(2010, 1, 1))
        </div>

        <div class="clear"></div>
        <div class="space"></div>
        <div class="grid_2 gridlabel">
            @Html.LabelFor(model => model.TeamId)
        </div>
        <div class="grid_6">
            @Html.DropDownListFor(model => model.TeamId, new SelectList(Model.Teams, "Id", "Name"), Labels.All)
            @Html.HiddenFor(model => model.TeamName)
        </div>
        <div class="grid_2 gridlabel">@Labels.Category</div>
        <div class="grid_4">
            @{
                var category = new List<SelectListItem>
                {
                    new SelectListItem() {Text = Labels.All, Value = string.Empty},
                    new SelectListItem() {Text = Labels.Expat, Value = "false"},
                    new SelectListItem() {Text = Labels.Local, Value = "true"},
                };
            }
            @Html.DropDownListFor(model => model.IsLocal, category, new { @class = "category" })
        </div>
        <div class="grid_2 gridlabel">
            @Html.LabelFor(model => model.Employee)
        </div>
        <div class="grid_7">
            @Html.TextBoxFor(model => model.Employee, new { placeholder = Messages.SearchEmployeeWatermark })
            @Html.HiddenFor(model => model.EmployeeId)
        </div>

        <div class="clear"></div>
        <div class="space"></div>
        <div class="grid_2 gridlabel">
            @Html.LabelFor(model => model.ReasonId)
        </div>
        <div class="grid_6">
            @Html.DropDownListFor(model => model.ReasonId, new SelectList(Model.DisciplineTypes, "DisciplineTypeId", "Name"), Labels.All)
        </div>
        <div class="grid_2 gridlabel">
            @Html.LabelFor(model => model.IsShowAll, "Show all")
        </div>
        <div class="grid_6" style="padding-top: 5px;">
            @Html.CheckBoxFor(model => model.IsShowAll)
        </div>

        <div class="clear"></div>
        <div class="space"></div>
        <div class="clear"></div>
        <div class="space"></div>
        <div class="prefix_2 grid_6">
            <input type="button" id="submit" value="@Labels.Submit" />
            <input type="button" value="Excel" id="btnExcel" />
        </div>
    </div>
</form>
<div id="discipline-summary">
    <table id="data" class="table table-custom discipline-summary">
        <thead>
            @if ((bool)ViewBag.IsHostOtherDiscipline)
            {
                <tr>
                    <th colspan="18" class="align-left">
                        <a class="button" id="btnAddOtherDiscipline">
                            @Labels.AddOtherDiscipline
                        </a>
                        <a class="button" id="btnAddWeekendLeave">
                            @Labels.AddWeekendLeave
                        </a>
                    </th>
                </tr>
            }

            <tr>
                <th>@Labels.SymbolCount</th>
                <th>@Labels.Section</th>
                <th>@Labels.Code</th>
                <th>@Labels.Nick</th>
                <th>@Labels.MissingCheckInOut</th>
                <th>@Labels.WorkingUnderTime</th>
                <th>@Labels.LateIn</th>
                <th>@Labels.EarlyOut</th>
                <th>@Labels.Absent</th>
                <th>@Labels.UPL</th>
                <th>@Labels.UPLAbsent</th>
                <th>@Labels.ChangeShift</th>
                <th>@Labels.NotFollowingLeaveProcedures</th>
                <th><a href="/report/weekendleavesummary">@Labels.WeekendLeave</a></th>
                <th>@Labels.OtherDiscipline</th>
                <th>@Labels.SystemDeduction</th>
                <th>@Labels.ApproverDeduction</th>
                <th>@Labels.Action</th>
            </tr>
        </thead>
        <tbody id="disciplineTableBody"></tbody>
    </table>
</div>
<div id="dialogAddOtherDiscipline"></div>
<div id="dialogViewOtherDiscipline"></div>