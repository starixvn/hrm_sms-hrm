@model IList<OtherDisciplineModel>
@{
    var hasPermissionToDelete = (bool)ViewBag.HasPermissionToDelete;
}
<table class="data">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th>@Labels.DisciplineDate</th>
            <th>@Labels.DisciplineType</th>
            <th>@Labels.MinusScore</th>
            <th>@Labels.Comment</th>
            <th>@Labels.Delete</th>
        </tr>
    </thead>
    @if (Model.Any())
    {
        int index = 0;
        <tbody>
            @foreach (OtherDisciplineModel item in Model)
            {
                index++;
                <tr id="row_@index">
                    <td>@index</td>
                    <td>@item.WorkDate.ToDateMonthYearFormatedDate()</td>
                    <td>@item.Name</td>
                    <td>@item.Score</td>
                    <td>@item.Comment</td>
                    <td>
                        @if (hasPermissionToDelete)
                        {
                            <a href="javascript:;" class="deleteOtherDiscipline" data-row-index="@index" data-empid="@item.EmployeeId"
                               data-workdate="@item.WorkDate.ToDateMonthYearFormatedDate()" data-disciplinetype="@item.DisciplineTypeId">
                                <i class="fa fa-times fa-lg icon-delete"></i>
                            </a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    }
    else
    {
        @RazorHelper.DisplayNoInformation(colspan: 6);
    }
</table>