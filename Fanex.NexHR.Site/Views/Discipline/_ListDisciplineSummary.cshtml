@model IList<DisciplineSummaryModel>
<table class="data discipline-summary">
    <thead>
        @if (Roles.IsUserInRole(RoleSystem.SystemAdmin.ToString()))
        {
            <tr>
                <th colspan="16" class="align-left">
                    <a class="button" id="btnAddOtherViolation">
                        @Labels.AddOtherViolations
                    </a>
                </th>
            </tr>
        }
        <tr>
            <th>@Labels.SymbolCount</th>
            <th>@Labels.Section</th>
            <th>@Labels.Code</th>
            <th>@Labels.Nick</th>
            <th>@Labels.MissingCheckInOut</th>
            <th>@Labels.WorkingUnderTime</th>
            <th>@Labels.LateIn</th>
            <th>@Labels.EarlyOut</th>
            <th>@Labels.Absent</th>
            <th>@Labels.UPL</th>
            <th>@Labels.UPLAbsent</th>
            <th>@Labels.ChangeShift</th>
            <th>@Labels.OtherViolations</th>
            <th>@Labels.MinusScoringSystem</th>
            <th>@Labels.MinusScoringApprover</th>
            <th>@Labels.Action</th>
        </tr>
    </thead>
    @if (Model != null && Model.Any())
    {
        int index = 0;
        <tbody>
            @foreach (DisciplineSummaryModel item in Model)
            {
                index++;
                <tr>
                    <td>@index</td>
                    <td>@item.Employee.GroupName</td>
                    <td>@item.Employee.Code</td>
                    <td class="tooltip" title="@item.Employee.FullName">@item.Employee.NickName</td>
                    <td>@item.MissingCheckInOut</td>
                    <td>@item.WorkingUnderTime</td>
                    <td>@item.LateIn</td>
                    <td>@item.EarlyOut</td>
                    <td>@item.Absent</td>
                    <td>@item.UnpaidLeave</td>
                    <td>@item.UnpaidLeaveAbsent</td>
                    <td>@item.ChangeShift</td>
                    <td>
                        @if (item.OtherViolationsScore > 0)
                        {
                            <a class="other-violations viewOtherViolation" data-empid="@item.Employee.EmployeeId" data-nickname="@item.Employee.NickName">
                                -@item.OtherViolationsScore
                            </a>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                    <td>@item.SystemSubtractScore</td>
                    <td>@item.ApproverSubtractScore</td>
                    <td>
                        @{
                        var empId = item.Employee.EmployeeId;
                        var employee = item.Employee.NickName + " (" + item.Employee.FullName + ")";
                        }
                        @switch (item.Permission)
                        {
                            case (int)Permision.Host:
                                <a href="javascript:;" class="viewDisciplineDetail" data-empid="@empId" data-employee="@employee">
                                    <img src="/Styles/Images/edit-icon.png" />
                                </a>
                                break;
                            default:
                            <a href="javascript:;" class="icon view viewDisciplineDetail" data-empid="@empId" data-employee="@employee"></a>
                                break;
                        }
                    </td>
                </tr>
            }
        </tbody>
    }
    else
    {
        @RazorHelper.DisplayNoInformation(colspan: 16);
    }
</table>