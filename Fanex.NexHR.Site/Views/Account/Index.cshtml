@using Fanex.NexHR.ViewModels.Employee
@model AccountViewModel
@{
    ViewBag.Title = Labels.MyProfile;
    bool enableGroupDate = ViewBag.EnableGroupDate;
}
@section css{
    <link href="~/wwwroot/dist/styles/account.index.css" rel="stylesheet" />
}
@section js{
    <script src="~/wwwroot/dist/js/account.index.js"></script>
}
@section Breadcrumb {
    <a class="step">@Labels.Personal</a>
    <span class="step">@ViewBag.Title</span>
}

<div class="leftpersonal">
    <div class="panel panel-default">
        <div class="panel-heading avatarbox">
            <div class="avatar">
                <a href="javascript:;" class="fullSizeAvatar" style="display:block" data-code="@Model.Employee.Code" data-nickName="@Model.Employee.NickName">
                    <img src="~/employee/avatar/@(Model.Employee.Code)" alt="@Model.Employee.NickName" />
                </a>
            </div>
            <div class="pinfo">
                <span class="name">@Model.Employee.FullName</span>
                <p class="accinfo">
                    @Model.Employee.DomainUsername
                    <br />
                    Staff ID: @Model.Employee.Code
                </p>
            </div>
        </div>
    </div>
    <div class="panel panel-default">
        <div class="panel-heading">PERSONAL INFORMATION</div>
        <ul class="list-group">
            <li class="list-group-item">
                <div class="plabel">@Labels.FullName:</div>
                <div class="pcontent bold">@Model.Employee.FullName</div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.Nick:</div>
                <div class="pcontent bold">@Model.Employee.NickName</div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.ChineseName:</div>
                <div class="pcontent bold">@Model.Employee.ChineseName</div>
            </li>
            <li class="list-group-item">
                <div class="plabel">D.O.B:</div>
                <div class="pcontent bold">@Model.Employee.DateOfBirth.ToDateMonthYearFormatedDate()</div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.PlaceOfBirth:</div>
                <div class="pcontent">@Model.Employee.PlaceOfBirth</div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.Ethnic:</div>
                <div class="pcontent bold">@Model.Employee.Ethnic</div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.Native:</div>
                <div class="pcontent bold">@Model.Employee.Native</div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.Religion:</div>
                <div class="pcontent">@Model.Employee.Religion</div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.Gender:</div>
                <div class="pcontent bold">@(Model.Employee.Gender == 1 ? Labels.Male : Labels.Female)</div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.Nationality:</div>
                <div class="pcontent bold">@Model.Employee.CountryName</div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.Marriage:</div>
                <div class="pcontent bold">@Model.Employee.MarriageName</div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.CardNo:</div>
                <div class="pcontent">@Model.Employee.CardNo</div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.IDCardIssueDate:</div>
                <div class="pcontent bold">
                    @if (Model.Employee.DateOfIdCard.HasValue)
                    {
                        @Model.Employee.DateOfIdCard.Value.ToDateMonthYearFormatedDate()
                    }
                </div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.IDCardPlaceOfIssue:</div>
                <div class="pcontent bold">@Model.Employee.PlaceOfIdCard</div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.PassportNo:</div>
                <div class="pcontent bold">@Model.Employee.PassportNo</div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.PassportExp:</div>
                <div class="pcontent bold">
                    @if (Model.Employee.PassportExp.HasValue)
                    {
                        @Model.Employee.PassportExp.Value.ToDateMonthYearFormatedDate()
                    }
                </div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.Qualification:</div>
                <div class="pcontent bold">@Model.Employee.Qualification</div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.Major:</div>
                <div class="pcontent bold">@Model.Employee.Major</div>
            </li>
            @if (Model.Employee.WorkingDays > 0)
            {
                <li class="list-group-item">
                    <div class="plabel">@Labels.WorkingDays:</div>
                    <div class="pcontent bold">@Model.Employee.WorkingDays</div>
                </li>
            }
            @if (Model.Employee.WorkingHours > 0)
            {
                <li class="list-group-item">
                    <div class="plabel">@Labels.WorkingHours:</div>
                    <div class="pcontent bold">@Model.Employee.WorkingHours</div>
                </li>
            }
        </ul>
    </div>
</div>
<div class="rightjob">
    <div class="panel panel-default">
        <div class="panel-heading">
            CONTACT DETAILS
            <a class="pull-right" href="/Information/UpdateInformation"><i class="fa fa-pencil fa-lg icon-edit"></i></a>
        </div>
        <ul class="list-group">
            <li class="list-group-item">
                <div class="plabel">@Labels.Email:</div>
                <div class="pcontent bold">
                    <a href="mailto:@Model.Employee.Email">@Model.Employee.Email</a>
                </div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.Phone:</div>
                <div class="pcontent bold">@Model.Employee.Phone</div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.Skype:</div>
                <div class="pcontent bold"><a href="skype:@(Model.Employee.Skype)?chat">@Model.Employee.Skype</a></div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.LetsTalk:</div>
                <div class="pcontent bold">@Model.Employee.LetsTalk</div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.Address:</div>
                <div class="pcontent bold">@Model.Employee.Address</div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.CurrentAddress:</div>
                <div class="pcontent bold">@Model.Employee.CurrentAddress</div>
            </li>
        </ul>
    </div>
    <div class="panel panel-default">
        <div class="panel-heading">JOB INFORMATION</div>
        <ul class="list-group">
            <li class="list-group-item">
                <div class="plabel">@Labels.JobTitle:</div>
                <div class="pcontent bold">@Model.Employee.JobTitle</div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.Team:</div>
                <div class="pcontent bold">@Model.Employee.Team.Name</div>
            </li>
            @if (Model.Employee.TeamDate.HasValue)
            {
                <li class="list-group-item">
                    <div class="plabel">@Labels.TeamDate:</div>
                    <div class="pcontent bold">@Model.Employee.TeamDate.ToDateMonthYearFormatedDate()</div>
                </li>
            }
            <li class="list-group-item">
                <div class="plabel">@Labels.Roles:</div>
                <div class="pcontent bold">@Model.Employee.Roles2String</div>
            </li>
            @if (enableGroupDate)
            {
                <li class="list-group-item">
                    <div class="plabel">@Labels.GroupDate:</div>
                    <div class="pcontent bold">
                        @if (Model.Employee.JoinedDate.HasValue)
                        {
                            @Model.Employee.JoinedDate.Value.ToDateMonthYearFormatedDate()
                        }
                    </div>
                </li>
            }
            <li class="list-group-item">
                <div class="plabel">@Labels.CompanyDate:</div>
                <div class="pcontent bold">
                    @if (Model.Employee.CompanyDate.HasValue)
                    {
                        @Model.Employee.CompanyDate.Value.ToDateMonthYearFormatedDate()
                    }
                </div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.ConfirmedDate:</div>
                <div class="pcontent bold">
                    @if (Model.Employee.ConfirmedDate.HasValue)
                    {
                        @Model.Employee.ConfirmedDate.ToDateMonthYearFormatedDate()
                    }
                </div>
            </li>
            @if (Model.Employee.PromotionDate.HasValue)
            {
                <li class="list-group-item">
                    <div class="plabel">@Labels.PromotionDate:</div>
                    <div class="pcontent bold">
                        @Model.Employee.PromotionDate.Value.ToDateMonthYearFormatedDate()
                    </div>
                </li>
            }
            @if (Model.Employee.ResignedDate.HasValue)
            {
                <li class="list-group-item">
                    <div class="plabel">@Labels.ResignedDate:</div>
                    <div class="pcontent bold">
                        @Model.Employee.ResignedDate.Value.ToDateMonthYearFormatedDate()
                    </div>
                </li>
            }
        </ul>
    </div>
    <div>
        @Html.Partial("_HistoryDetail", Model.Logs)
    </div>
</div>
