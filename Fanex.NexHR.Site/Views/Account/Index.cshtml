@using Fanex.NexHR.Resources
@model Employee
@{
    ViewBag.Title = Labels.MyProfile;
}
@section css{
    <link href="~/wwwroot/dist/styles/account.index.css" rel="stylesheet" />
}
@section js{
    <script src="~/wwwroot/dist/js/account.index.js"></script>
}
@section Breadcrumb {
    <a class="step">@Labels.Personal</a>
    <span class="step">@ViewBag.Title</span>
}

<div class="leftpersonal">
    <div class="panel panel-default">
        <div class="panel-heading avatarbox">
            <div class="avatar">
                <img src="~/employee/avatar/@(Model.Code)" alt="@Model.NickName" />
            </div>
            <input type="hidden" value="@Model.Id" name="Id" class="Id" />
            <div class="pinfo">
                <span class="name">@Model.FullName</span>
                <p class="accinfo">
                    @Model.DomainUsername
                    <br />
                    Staff ID: @Model.Code
                </p>
            </div>
        </div>
    </div>
    <div class="panel panel-default">
        <div class="panel-heading">PERSONAL INFORMATION</div>
        <ul class="list-group">
            <li class="list-group-item">
                <div class="plabel">@Labels.FullName:</div>
                <div class="pcontent bold">@Model.FullName</div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.Nick:</div>
                <div class="pcontent bold">@Model.NickName</div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.ChineseName:</div>
                <div class="pcontent bold">@Model.ChineseName</div>
            </li>
            <li class="list-group-item">
                <div class="plabel">D.O.B:</div>
                <div class="pcontent bold">@Model.DateOfBirth.ToDateMonthYearFormatedDate()</div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.PlaceOfBirth:</div>
                <div class="pcontent">@Model.PlaceOfBirth</div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.Ethnic:</div>
                <div class="pcontent bold">@Model.Ethnic</div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.Native:</div>
                <div class="pcontent bold">@Model.Native</div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.Religion:</div>
                <div class="pcontent">@Model.Religion</div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.Gender:</div>
                <div class="pcontent bold">@(Model.Gender == 1 ? Labels.Male : Labels.Female)</div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.Nationality:</div>
                <div class="pcontent bold">@Model.CountryName</div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.Marriage:</div>
                <div class="pcontent bold">@Model.MarriageName</div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.CardNo:</div>
                <div class="pcontent">@Model.CardNo</div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.IDCardIssueDate:</div>
                <div class="pcontent bold">
                    @if (Model.DateOfIdCard.HasValue)
                    {
                        @Model.DateOfIdCard.Value.ToDateMonthYearFormatedDate()
                    }
                </div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.IDCardPlaceOfIssue:</div>
                <div class="pcontent bold">@Model.PlaceOfIdCard</div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.PassportNo:</div>
                <div class="pcontent bold">@Model.PassportNo</div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.PassportExp:</div>
                <div class="pcontent bold">
                    @if (Model.PassportExp.HasValue)
                    {
                        @Model.PassportExp.Value.ToDateMonthYearFormatedDate()
                    }
                </div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.Qualification:</div>
                <div class="pcontent bold">@Model.Qualification</div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.Major:</div>
                <div class="pcontent bold">@Model.Major</div>
            </li>
            @if (Model.WorkingDays > 0)
            {
                <li class="list-group-item">
                    <div class="plabel">@Labels.WorkingDays:</div>
                    <div class="pcontent bold">@Model.WorkingDays</div>
                </li>
            }
            @if (Model.WorkingHours > 0)
            {
                <li class="list-group-item">
                    <div class="plabel">@Labels.WorkingHours:</div>
                    <div class="pcontent bold">@Model.WorkingHours</div>
                </li>
            }
        </ul>
    </div>
</div>
<div class="rightjob">
    <div class="panel panel-default">
        <div class="panel-heading">
            CONTACT DETAILS
            <a class="pull-right" href="/Information/UpdateInformation"><i class="fa fa-pencil fa-lg icon-edit"></i></a>
        </div>
        <ul class="list-group">
            <li class="list-group-item">
                <div class="plabel">@Labels.Email:</div>
                <div class="pcontent bold">
                    <a href="mailto:@Model.Email">@Model.Email</a>
                </div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.Phone:</div>
                <div class="pcontent bold">@Model.Phone</div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.Skype:</div>
                <div class="pcontent bold"><a href="skype:@(Model.Skype)?chat">@Model.Skype</a></div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.LetsTalk:</div>
                <div class="pcontent bold">@Model.LetsTalk</div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.Address:</div>
                <div class="pcontent bold">@Model.Address</div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.CurrentAddress:</div>
                <div class="pcontent bold">@Model.CurrentAddress</div>
            </li>
        </ul>
    </div>
    <div class="panel panel-default">
        <div class="panel-heading">JOB INFORMATION</div>
        <ul class="list-group">
            <li class="list-group-item">
                <div class="plabel">@Labels.JobTitle:</div>
                <div class="pcontent bold">@Model.JobTitle</div>
            </li>
            @if (Model.PromotionDate.HasValue)
            {
                <li class="list-group-item">
                    <div class="plabel">@Labels.PromotionDate:</div>
                    <div class="pcontent bold">@Model.PromotionDate.ToDateMonthYearFormatedDate()</div>
                </li>
            }
            <li class="list-group-item">
                <div class="plabel">@Labels.Team:</div>
                <div class="pcontent bold">@Model.Team.Name</div>
            </li>
            @if (Model.TeamDate.HasValue)
            {
                <li class="list-group-item">
                    <div class="plabel">@Labels.TeamDate:</div>
                    <div class="pcontent bold">@Model.TeamDate.ToDateMonthYearFormatedDate()</div>
                </li>
            }
            <li class="list-group-item">
                <div class="plabel">@Labels.Roles:</div>
                <div class="pcontent bold">@Model.Roles2String</div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.GroupDate:</div>
                <div class="pcontent bold">
                    @if (Model.JoinedDate.HasValue)
                    {
                        @Model.JoinedDate.Value.ToDateMonthYearFormatedDate()
                    }
                </div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.CompanyDate:</div>
                <div class="pcontent bold">
                    @if (Model.CompanyDate.HasValue)
                    {
                        @Model.CompanyDate.Value.ToDateMonthYearFormatedDate()
                    }
                </div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.ConfirmedDate:</div>
                <div class="pcontent bold">
                    @if (Model.ConfirmedDate.HasValue)
                    {
                        @Model.ConfirmedDate.ToDateMonthYearFormatedDate()
                    }
                </div>
            </li>
            @if (Model.PromotionDate.HasValue)
            {
                <li class="list-group-item">
                    <div class="plabel">@Labels.PromotionDate:</div>
                    <div class="pcontent bold">
                        @Model.PromotionDate.Value.ToDateMonthYearFormatedDate()
                    </div>
                </li>
            }
            @if (Model.ResignedDate.HasValue)
            {
                <li class="list-group-item">
                    <div class="plabel">@Labels.ResignedDate:</div>
                    <div class="pcontent bold">
                        @Model.ResignedDate.Value.ToDateMonthYearFormatedDate()
                    </div>
                </li>
            }
            <li class="list-group-item">
                <div class="plabel">@Labels.Unit:</div>
                <div class="pcontent bold">@Model.Unit</div>
            </li>
        </ul>
    </div>
    <div>
        @Html.Partial("_HistoryDetail", Model.Logs)
    </div>
</div>
