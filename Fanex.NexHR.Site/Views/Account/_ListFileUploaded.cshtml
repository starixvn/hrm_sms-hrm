@model IEnumerable<string>

    @{
        var baseUrl = ViewBag.BaseUrl;
    }

    @if (Model != null && Model.Any())
    {
        foreach (var file in Model)
        {
            var href = baseUrl + file;
            <li>
                <a href="@href" class="file-name" target="_blank" title="@file">@file</a>
                <i class="fa fa-times fa-lg icon-delete delete-file-upload" title="Delete file" data-file-name="@file"></i>
            </li>
        }
    }
    else
    {
        <span class="no-file">No file uploaded</span>
    }