@using Fanex.NexHR.Core
@using Fanex.NexHR.Models.Log
@model IEnumerable<LogObjectDetail>

<table class="table table-custom" id="data">
    <thead>
        <tr>
            <th>@Labels.Date</th>
            <th>@Labels.Actor</th>
            <th>@Labels.OldValue</th>
            <th>@Labels.NewValue</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            var countMoveTeam = 0;
            var countMoveJobTitle = 0;
            foreach (LogObjectDetail item in Model)
            {
                foreach (FieldValue field in item.Fields)
                {
                    if (field.DisplayName == Labels.Team)
                    {
                        countMoveTeam++;
                    }
                    if (field.DisplayName == Labels.JobTitle)
                    {
                        countMoveJobTitle++;
                    }
                }
            }
            if (countMoveTeam > 0)
            {
                <tr>
                    <td class="rowdivider align-left" colspan="5">
                        <b>@Labels.Team.ToUpper()</b>
                    </td>
                </tr>
            }
            foreach (LogObjectDetail item in Model)
            {
                foreach (FieldValue field in item.Fields)
                {
                    if (field.DisplayName == Labels.Team)
                    {
                        <tr>
                            <td>@item.LogDate.ToDetailFormatedDate()</td>
                            <td>@item.Nickname</td>
                            <td class="align-left">@field.OldValue</td>
                            <td class="align-left">@field.Value</td>
                        </tr>
                    }
                }
            }
            if (countMoveJobTitle > 0)
            {
                <tr>
                    <td class="rowdivider align-left" colspan="5">
                        <b>@Labels.JobTitle.ToUpper()</b>
                    </td>
                </tr>
            }
            else if (countMoveTeam < 1)
            {
                @RazorHelper.DisplayNoInformation(5) 
            }

            foreach (LogObjectDetail item in Model)
            {
                foreach (FieldValue field in item.Fields)
                {
                    if (field.DisplayName == Labels.JobTitle)
                    {
                    <tr>
                        <td>@item.LogDate.ToDetailFormatedDate()</td>
                        <td>@item.Nickname</td>
                        <td class="align-left">@field.OldValue</td>
                        <td class="align-left">@field.Value</td>
                    </tr>
                }
            }
        }
    }
    else
    {
        @RazorHelper.DisplayNoInformation(5)
    }
    </tbody>
</table>
