@using Fanex.NexHR.ViewModels.Employee
@model EmployeeContactViewModel

@{
    Layout = "~/Views/Shared/_NewLayout.cshtml";
    ViewBag.Title = "Edit Profile";
    var message = ViewBag.Message;
}
@section css{
    <link href="~/wwwroot/dist/styles/account.editprofile.css" rel="stylesheet" />
}
@section js{
    <script src="~/wwwroot/dist/js/account.edit.js"></script>
}
@section Breadcrumb {
    <a class="step" href="/Account/Index">Personal</a><span class="step">@ViewBag.Title</span>
}
<div>
    @using (Html.BeginForm("EditContact", "Account", FormMethod.Post))
    {
        @Html.AntiForgeryToken();
        @Html.ValidationSummary();

        if (!string.IsNullOrWhiteSpace(message))
        {
            <div class="success">@message</div>
        }
        <div class="form-horizontal clearfix">
            <div class="form-group form-group--m">
                <div class="label-form">
                    @Html.LabelFor(model => model.ChineseName, new { @class = "control-label" })
                </div>
                <div class="input-form">
                    @Html.TextBox("ChineseName", Model.ChineseName, new { @class = "form-control" })
                </div>
            </div>
        </div>

        <div class="form-horizontal clearfix">
            <div class="form-group form-group--m">
                <div class="label-form">
                    @Html.LabelFor(model => model.Email, new { @class = "control-label" })
                </div>
                <div class="input-form">
                    @Html.TextBox("Email", Model.Email, new { @class = "form-control" })
                </div>
            </div>
        </div>

        <div class="form-horizontal clearfix">
            <div class="form-group form-group--m">
                <div class="label-form">
                    @Html.LabelFor(model => model.Phone, new { @class = "control-label" })
                </div>
                <div class="input-form">
                    @Html.TextBox("Phone", Model.Phone, new { @class = "form-control" })
                </div>
            </div>
        </div>

        <div class="form-horizontal clearfix">
            <div class="form-group form-group--m">
                <div class="label-form">
                    @Html.LabelFor(model => model.Skype, new { @class = "control-label" })
                </div>
                <div class="input-form">
                    @Html.TextBox("Skype", Model.Skype, new { @class = "form-control" })
                </div>
            </div>
        </div>

        <div class="form-horizontal clearfix">
            <div class="form-group form-group--m">
                <div class="label-form">
                    @Html.LabelFor(model => model.LetsTalk, new { @class = "control-label" })
                </div>
                <div class="input-form">
                    @Html.TextBox("LetsTalk", Model.LetsTalk, new { @class = "form-control" })
                </div>
            </div>
        </div>

        <div class="form-horizontal clearfix">
            <div class="form-group form-group--m">
                <div class="label-form">
                    @Html.LabelFor(model => model.Address, new { @class = "control-label" })
                </div>
                <div class="input-form">
                    @Html.TextBox("Address", Model.Address, new { @class = "form-control" })
                </div>
            </div>
        </div>

        <div class="form-horizontal clearfix">
            <div class="form-group form-group--m">
                <div class="label-form">
                    @Html.LabelFor(model => model.CurrentAddress, new { @class = "control-label" })
                </div>
                <div class="input-form">
                    @Html.TextBox("CurrentAddress", Model.CurrentAddress, new { @class = "form-control" })
                </div>
            </div>
        </div>

        <div class="form-horizontal clearfix">
            <div class="form-group form-group--m">
                <div class="label-form">
                    <label class="control-label">Attachments</label>
                </div>
                <div class="input-form">
                    @Html.TextBox("Attachments", null, new { @class = "form-control", @type = "file", @multiple = "multiple" })
                    <p class="note">* The file(s) upload must be less than 5 MB</p>
                    <p class="note">* Accept file type: .jpg; .png; .jpeg; .pdf, .doc, .docx, .xls, .xlxs</p>
                    <p class="note">* Rename the file to meaningful name before upload</p>
                </div>
            </div>
        </div>

        <div class="form-horizontal clearfix">
            <div class="form-group form-group--m">
                <div class="label-form">
                    <label class="control-label">Uploaded file(s)</label>
                </div>
                <div class="input-form">
                    <ul class="upload-file-list" id="upload-list" data-base-url="@Model.BaseFileLocation"></ul>
                </div>
            </div>
        </div>

        <div class="form-group form-group--l">
            <div class="button-group">
                <input class="button" type="submit" id="submit" value="@Labels.Submit" />
            </div>
        </div>
    }
</div>