@using Fanex.NexHR.Models.Request
@model IList<RequestEntity>
<table class="data persist-area">
    <thead>
        <tr class="persist-header">
            <th>
                #
            </th>
            <th>@Labels.Team
            </th>
            <th>@Labels.Employee
            </th>
            <th>@Labels.Shift
            </th>
            <th>@Labels.RequestDate
            </th>
            <th>@Labels.CreatedDate
            </th>
            <th>@Labels.Remark
            </th>
            <th>@Labels.Status
            </th>
            <th>@Labels.History
            </th>
        </tr>
    </thead>
    @if (ViewBag.EntityList.Count > 0)
    {
        <tbody>
            @{int index = 1;}
            @foreach (var request in Model)
            {
                var requestDate = request.IsHalfDay
                        ? (request.FromDate.ToDateMonthYearFormatedDate() + " (" + request.FromTime.ToString("HH:mm") + " - " + request.ToTime.ToString("HH:mm") + ")")
                        : request.FromDate.ToDateMonthYearFormatedDate();
                <tr id="row@(request.Id)">
                    <td>@(index++)
                    </td>
                    <td  class="tooltip" title="@request.Requester.Team.Name">@request.Requester.Team.Code</td>
                    <td class="tooltip" title="@request.Requester.FullName">
                        @request.Requester.NickName.ToString()
                    </td>
                    <td>@(request.FromShift == null ? string.Empty : request.FromShift.Name)
                    </td>
                    <td class="ddMMyyyyhhmm">@requestDate
                    </td>
                    <td class="ddMMyyyyhhmm">@request.CreatedDate.ToShortFormatedDate()
                    </td>
                    @if (!string.IsNullOrWhiteSpace(request.Remark))
                    { 
                        <td class="tooltip" title="@request.Remark">
                            <span class="icon remark" alt="remark" />
                        </td>
                    }
                    else
                    {
                        <td>
                            -
                        </td>
                    }
                   @Html.Partial("Request/HR/SharedStatus", request)
                    <td>
                        <a class="viewhistory" href="javascript:;" id="/request/hrviewhistory?id=@request.Id&type=@request.Type.RequestHistoryFilter">
                            @Labels.View </a>
                    </td>
                </tr>
            }
        </tbody>
    }
    else
    { 
        @RazorHelper.DisplayNoInformation(colspan: 13);
    }
</table>
@RazorHelper.HrMenu()
@RazorHelper.ResetMenu()