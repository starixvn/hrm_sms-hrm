@using Fanex.NexHR.Models.Request
@model IList<RequestEntity>
<table class="data persist-area">
    <thead>
        <tr class="persist-header">
            <th>
                #
            </th>
            <th>@Labels.Team
            </th>
            <th>@Labels.Employee
            </th>
            <th>@Labels.Request
            </th>
            <th>@Labels.Time
            </th>
            <th>@Labels.FromDate
            </th>
            <th>@Labels.ToDate
            </th>
            <th>@Labels.Shift
            </th>
            <th>@Labels.CreatedDate
            </th>
            <th>@Labels.Remark
            </th>
            <th>@Labels.Status
            </th>
            <th>@Labels.History
            </th>
        </tr>
    </thead>
    @if (ViewBag.EntityList.Count > 0)
    {
        <tbody>
            @{int index = 1;}
            @foreach (RequestEntity request in Model)
            { 
                <tr id="row@(request.Id)">
                    <td>@(index++)
                    </td>
                    <td class="tooltip" title="@request.Requester.Team.Name">@request.Requester.Team.Code
                    </td>
                    <td class="tooltip" title="@request.Requester.FullName">
                        @request.Requester.NickName.ToString()
                    </td>
                    <td class="highlight">@request.RequestType.ToString()
                    </td>
                    <td class="highlight">@RazorHelper.LateInEarlyOutTimeFormat(request.TotalMins, (short)request.RequestType.Id)
                    </td>
                    <td class="ddMMyyyy highlight">@request.FromDate.ToDateMonthYearFormatedDate()
                    </td>
                    <td class="ddMMyyyy highlight">@request.ToDate.ToDateMonthYearFormatedDate()
                    </td>
                    <td>@request.FromShift.Name
                    </td>
                    <td class="ddMMyyyyhhmm">@request.CreatedDate.ToShortFormatedDate()
                    </td>
                    @*@RazorHelper.ModifierDisplay(request.ModifiedBy.NickName, request.ModifiedBy.FullName, request.ModifiedDate, request.Id)*@
                    @if (!string.IsNullOrWhiteSpace(request.Remark))
                    { 
                        <td class="tooltip" title="@request.Remark">
                            <span class="icon remark" alt="remark" />
                        </td>
                    }
                    else
                    {
                        <td>
                            -
                        </td>
                    }
                    @Html.Partial("Request/HR/SharedStatus", request)
                    <td>
                        <a class="viewhistory" href="javascript:;" id="/request/hrviewhistory?id=@request.Id&type=@request.RequestType.FilterRequestHistory">
                            @Labels.View </a>
                    </td>
                </tr>  
            }
        </tbody>
    }
    else
    { 
        @RazorHelper.DisplayNoInformation(colspan: 12);
    }
</table>
@RazorHelper.HrMenu()
@RazorHelper.ResetMenu()