@model List<Fanex.NexHR.ViewModels.ShiftDetailsViewModel>

<table id="tblchangeshift" class="tabledata">
    <thead>
        <tr>
            <th rowspan="1">
                Date
            </th>
            <th rowspan="1">
                Schedule status
            </th>
            <th rowspan="1">
                Change to shift
            </th>
            <th rowspan="1">
                Remark
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr class='left'>
                <td>@item.Date</td>
                <td>@item.ScheduleStatus</td>
                <td>
                    @Html.DropDownListFor(model => item.ToShift, new SelectList(ViewBag.Shift, "Id", "Code"), new { @class = "item_ToShift", @disabled = "disabled"})
                </td>
                <td>@Html.TextBoxFor(model => item.Remark, new { @readonly = "true" }) </td>
            
                @Html.HiddenFor(model => item.FromShift)

                @Html.HiddenFor(model => item.ShiftId)

                @Html.HiddenFor(model => item.HasData)
                 
            </tr>
           
        }
    </tbody>
</table>
