@using Fanex.NexHR.Services
@using Fanex.NexHR.Models.Request
@model IList<RequestEntity>
<table class="data persist-area">
    <thead>
        <tr class="persist-header">
            <th>
                #
            </th>
            <th>@Labels.Team
            </th>
            <th>@Labels.Employee
            </th>
            <th>
                @Labels.Request
            </th>
            @*<th>@Labels.RequestDate</th>*@
            <th>
                Details
            </th>
            <th>@Labels.Remark
            </th>
            <th>@Labels.CreatedDate
            </th>
            @*<th>Total day(s)</th>*@
            <th>@Labels.Status
            </th>
            <th>@Labels.History
            </th>
			<th></th>
        </tr>
    </thead>
    @if (ViewBag.EntityList.Count > 0)
    {
        <tbody>
            @{int index = 1;
              RequestViewModel options = (RequestViewModel)ViewBag.Options;
            }
            @foreach (RequestEntity request in Model)
            {
                var requestModel = new RequestViewModel
                {
                    DateOption = options.DateOption,
                    FromDate = options.FromDate,
                    ToDate = options.ToDate,
                    EmployeeId = request.Requester.Id,
                    Employee = request.Requester.NickName + " (" + request.Requester.FullName + ")",
                    TeamIds = options.TeamIds == null ? string.Empty : options.TeamIds,
                    StatusId = options.StatusId,
                    RequestType = request.RequestType.RequestFilter
                };

                var requestDetail = new { requestid = @request.Id, type = @request.RequestType.RequestHistoryFilter };
                
                <tr id="row@(request.Id)">
                    <td>@(index++)
                    </td>
                    <td  class="tooltip" title="@request.Requester.Team.Name">
                        @request.Requester.Team.Code
                    </td>
                    <td class="tooltip" title="@request.Requester.FullName">
                        @request.Requester.NickName.ToString()
                    </td>
                    <td class="highlight">
                        @if ((bool)ViewBag.IsAllowChangeStatus)
                        {
                            if (request.RequestType.Id == (int)RequestType.Leave)
                            { 
                                <a href="~/Leave/Detail?requestId=@request.Id">@request.LeaveType.Name</a>
                            }
                            else if (request.RequestType.Id == (int)RequestType.ChangeShift)
                            { 
                                <a href="@Url.Action("hrviewdetail", "request", requestDetail)">@request.RequestType.Name</a>
                            }
                            else
                            {
                                <a href="@Url.Action("hrview", "request", requestModel)">@request.RequestType.Name</a>
                            }
                        }
                        else
                        {
                            if ((bool)ViewBag.IsDailyRequest)
                            {
                                if (request.RequestType.Id == (int)RequestType.Leave)
                                { 
                                    <a href="~/Leave/Detail?requestId=@request.Id">@request.LeaveType.Name</a>
                                }
                                else if (request.RequestType.Id == (int)RequestType.ChangeShift)
                                { 
                                    <a href="@Url.Action("dailyviewdetail", "request", requestDetail)">@request.RequestType.Name</a>
                                }
                                else
                                {
                                    <a href="@Url.Action("dailyview", "request", requestModel)">@request.RequestType.Name</a> 
                                }
                            }
                            else
                            {
                                if (request.RequestType.Id == (int)RequestType.Leave)
                                { 
                                    <a href="~/Leave/Detail?requestId=@request.Id">@request.LeaveType.Name</a>
                                }
                                else if (request.RequestType.Id == (int)RequestType.ChangeShift)
                                { 
                                    <a href="@Url.Action("employeeviewdetail", "request", requestDetail)">@request.RequestType.Name</a>
                                }
                                else
                                {
                                    <a href="@Url.Action("employeeview", "request", requestModel)">@request.RequestType.Name</a> 
                                }
                            }
                        }
                    </td>
                    <td class="left">
                        @Html.Raw(RequestService.ToRequestMessage(request))
                    </td>
                    @if (!string.IsNullOrWhiteSpace(request.Remark))
                    { 
                        <td class="tooltip" title="@request.Remark">
                            <span class="icon remark" alt="remark" />
                        </td>
                    }
                    else
                    {
                        <td>
                            -
                        </td>
                    }
                    <td class="ddMMyyyyhhmm">
                        @request.CreatedDate.ToShortFormatedDate()
                    </td>
                    @Html.Partial("Request/HR/SharedStatus", request)
                    <td>
                        <a class="viewhistory" href="javascript:;" id="/request/hrviewhistory?id=@request.Id&type=@request.RequestType.RequestHistoryFilter">
                            @Labels.View </a>
                    </td>

					<td class="td-warning">
						@if (request.IsWarning)
	  {
						 <span class="icon-warning tooltip" title="@Labels.RequestWarning"/>
	  }
					</td>
                </tr>  
            }
        </tbody>
    }
    else
    { 
        @RazorHelper.DisplayNoInformation(colspan: 9);
    }
</table>
@RazorHelper.HrMenu()
@RazorHelper.ResetMenu()
