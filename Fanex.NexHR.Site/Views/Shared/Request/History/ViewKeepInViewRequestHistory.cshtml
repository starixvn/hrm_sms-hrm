@using Fanex.NexHR.Models.Request
@model IList<RequestEntity>

<table class="data">
    <thead>
        <tr>
            <th>
                #
            </th>
            <th>@Labels.Team
            </th>
            <th>@Labels.Employee
            </th>
            <th>@Labels.Shift
            </th>
            <th>@Labels.RequestDate
            </th>
            <th>@Labels.CreatedDate
            </th>
            <th>@Labels.Remark
            </th>
            <th>@Labels.Status
            </th>
            <th>@Labels.PerformedBy
            </th>
        </tr>
    </thead>
    @if (ViewBag.EntityList.Count > 0)
    {
        <tbody>
            @{int index = 1;}
            @foreach (RequestEntity request in Model)
            {
                var requestDate = request.IsHalfDay
                        ? (request.RequestedDate.ToDateMonthYearFormatedDate() + " (" + request.FromTime.ToString("HH:mm") + " - " + request.ToTime.ToString("HH:mm") + ")")
                        : request.RequestedDate.ToDateMonthYearFormatedDate();
                <tr id="row@(request.Id)">
                    <td>@(index++)
                    </td>
                    <td  class="tooltip" title="@request.Requester.Team.Name">@request.Requester.Team.Code</td>
                    <td class="tooltip" title="@request.Requester.FullName">
                        @request.Requester.NickName.ToString()
                    </td>
                    <td>@(request.FromShift != null ? request.FromShift.Name : string.Empty)
                    </td>
                    <td class="ddMMyyyyhhmm">@requestDate
                    </td>
                    <td class="ddMMyyyyhhmm">@request.CreatedDate.ToShortFormatedDate()
                    </td>
                    @if (!string.IsNullOrWhiteSpace(request.Remark))
                    { 
                        <td class="tooltip" title="@request.Remark">
                            <span class="icon remark" alt="remark" />
                        </td>
                    }
                    else
                    {
                        <td>
                            -
                        </td>
                    }
                    @Html.Partial("Request/History/SharedStatus", request)
                    @Html.Partial("Request/History/SharedPeformedBy", request)
                </tr>  
            }
        </tbody>
    }
    else
    { 
        @RazorHelper.DisplayNoInformation(colspan: 12);
    }
</table>
