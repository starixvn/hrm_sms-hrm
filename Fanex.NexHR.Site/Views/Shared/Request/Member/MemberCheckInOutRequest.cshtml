@using Fanex.NexHR.Models.Request
@model IList<RequestEntity>

<table class="data persist-area">
    <thead>
        <tr class ="persist-header">
            <th>
                #
            </th>
            <th>@Labels.Team
            </th>
            <th>@Labels.Employee
            </th>
            <th>@Labels.Request
            </th>
            <th>@Labels.Shift
            </th>
			<th>@Labels.Date</th>
            <th>@Labels.RequestTime
            </th>
            <th>@Labels.CreatedDate
            </th>
            <th>@Labels.Remark
            </th>
            <th>@Labels.Status
            </th>
            <th>@Labels.History</th>
			<th>
			</th>
        </tr>
    </thead>
    @if (ViewBag.EntityList.Count > 0)
    {
        <tbody>
            @{int index = 1;}
            @foreach (RequestEntity request in Model)
            { 
                <tr id="row@(request.Id)">
                    <td>@(index++)</td>
                    <td  class="tooltip" title="@request.Requester.Team.Name">@request.Requester.Team.Code</td>
                    <td class="tooltip" title="@request.Requester.FullName">
                        @request.Requester.NickName.ToString()
                    </td>
                    <td class="highlight">@request.RequestType.ToString()
                    </td>
                    <td class="highlight">@request.FromShift.Name.ToString()
                    </td>
                    <td class="ddMMyyyyhhmm highlight">@request.FromDate.ToDateMonthYearFormatedDate()
                    </td>
                    <td class="ddMMyyyyhhmm highlight">@request.RequestedDate.ToShortFormatedDate()
                    </td>
                    <td class="ddMMyyyyhhmm">@request.CreatedDate.ToShortFormatedDate()
                    </td>
                    @if (!string.IsNullOrWhiteSpace(request.Remark))
                    { 
                        <td class="tooltip" title="@request.Remark">
                            <span class="icon remark" alt="remark" />
                        </td>
                    }
                    else
                    {
                        <td>
                            -
                        </td>
                    }
                    @Html.Partial("Request/Member/SharedStatus", request)

                    <td>
                    <a class="viewhistory" href="javascript:;" id="/request/hrviewhistory?id=@request.Id&type=@request.RequestType.FilterRequestHistory"> @Labels.View </a>
                    </td>
					<td class="td-warning">
						@if (request.IsWarning)
	  {
						 <span class="icon-warning tooltip" title="@Labels.RequestWarning"/>
	  }
					</td>
                </tr>
            }
        </tbody>
    }
    else
    {             
        @RazorHelper.DisplayNoInformation(colspan: 11);
    }
</table>
@RazorHelper.VerifierAndApproverMenu()
@RazorHelper.ResetMenu()