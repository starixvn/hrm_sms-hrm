@model Fanex.NexHR.ViewModels.LeaveRequestViewModel
@{
    ViewBag.Title = Labels.ViewLeaveDetail;
}
<h2>
    @ViewBag.Title</h2>
<div class="bunhat">
    @using (Html.BeginForm())
    {
        @Html.HiddenFor(model => model.EmployeeId)
        @Html.Hidden("RequestType", (int)RequestTypes.Leave)
        @Html.Hidden("RequestId", Model.RequestId)
        @Html.Hidden("LeaveTypeId", Model.LeaveTypeId)

        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.RefNo, Labels.RefNo1)
            </div>
            <div class="input">
                @Html.DisplayFor(model => model.RefNo)
            </div>
            <div class="clear">
            </div>
        </div>
        
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Employee)
            </div>
            <div class="input">
                @Html.DisplayFor(model => model.Employee)
            </div>
            <div class="clear">
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.LeaveTypeId, Labels.LeaveType)
            </div>
            <div class="input">
                @Html.DropDownListFor(model => model.LeaveTypeId, new SelectList(Model.LeaveTypeList, "Id", "Name"), new { @disabled = "disabled" })
                @Html.HiddenFor(model => model.LeaveTypeName)
            </div>
            <div class="clear">
            </div>
        </div>
        
        <div id="grbHalfDay" class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.HalfDayOff)
            </div>
            <div class="input">
                @Html.CheckBoxFor(model => model.HalfDayOff, new { disabled = "disabled" })
            </div>
            <div class="clear">
            </div>
        </div>
        
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.FromDate, Labels.FromDate)
            </div>
            <div class="input">
                @Html.DatePickerFor(model => model.FromDate)
                <span class="time hide">
                    @Html.DropDownList("FromTime", Utilities.TimeSteps(30))
                </span>
            </div>
            <div class="clear">
            </div>
        </div>

        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.ToDate, Labels.ToDate)
            </div>
            <div class="input">
                @Html.DatePickerFor(model => model.ToDate)
                <span class="time hide">
                    @Html.DropDownList("ToTime", Utilities.TimeSteps(30))
                </span>
            </div>
            <div class="clear">
            </div>
        </div>
        
        <div id="grbTotalDay" class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.TotalDays, Labels.TotalDays, new { id = "lblTotalDay" })
            </div>
            <div class="input">
                @Html.DisplayFor(model => model.TotalDays)
            </div>
            <div class="clear">
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.VerifierId, Labels.VerifiedBy)
            </div>
            <div class="input">
                @Html.DropDownListFor(model => model.VerifierId, Model.VerifierList, new { @disabled = "disabled" })
            </div>
            <div class="clear">
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.ApproverId, Labels.ApprovedBy)
            </div>
            <div class="input">
                @Html.DropDownListFor(model => model.ApproverId, Model.ApproverList, new { @disabled = "disabled" })
            </div>
            <div class="clear">
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Remark)
            </div>
            <div class="input">
                @Html.TextAreaFor(model => model.Remark, new { @readonly = "true" })
            </div>
            <div class="clear">
            </div>
        </div>
        <div class="formrow">
            <div class="label">
            </div>
            <div class="input">
                ※ <span class="infobalance">Annual leave day(s) balance:</span>  <span class="numberbalance" id="lblAnnualBalance">@Model.EmployeeBalance.AnnualBalance.ToString("0.#")</span> &nbsp
                ※ <span class="infobalance">Keep in view day(s) balance:</span>  <span class="numberbalance" id="lblKeepInViewBalance">@Model.EmployeeBalance.KeepInViewBalance.ToString("0.#")</span> &nbsp
                <br />
                ※ <span class="infobalance">Current annual leave day(s) balance can be used:</span>  <span class="numberbalance" id="lblAnnualBalance">@Model.EmployeeBalance.CurrentLeaveBalanceDay.ToString("0.#")</span>
            </div>
            <div class="clear">
            </div>
        </div>
        <div class="formrow">
            <div id="tbldetail">
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Status)
            </div>
            <div class="input">
                @Html.DisplayFor(model => model.FormattedStatus)
            </div>
            <div class="clear">
            </div>
        </div>
        @Html.HiddenFor(model => model.DisplayName)
        <div class="formrow">
            <div class="label">
                &nbsp;
            </div>
            <div class="input">
                @if (Model.Status == (byte)CurrentRequestStatus.Pending)
                {
                    if (Model.VerifierId == Convert.ToInt32(ViewBag.CurrentUserId))
                    {
                        <input roleid="@Convert.ToInt32(Fanex.NexHR.Core.Enums.RolesEnum.Verifier)" id="btnAccept" type="button" value="@Labels.Accept" class="button-primary submit" requestId="@Model.RequestId"/>
                        <input roleid="@Convert.ToInt32(Fanex.NexHR.Core.Enums.RolesEnum.Verifier)" id="btnNotAccept" type="button" value="@Labels.NotAccept" class="button-primary submit" requestId="@Model.RequestId"/>
                    }
                    else if (Model.ApproverId == Convert.ToInt32(ViewBag.CurrentUserId))
                    {
                        <input roleid="@Convert.ToInt32(Fanex.NexHR.Core.Enums.RolesEnum.Approver)" id="btnApprove" type="button" value="@Labels.Approve" class="button-primary submit" requestId="@Model.RequestId"/>
                        <input roleid="@Convert.ToInt32(Fanex.NexHR.Core.Enums.RolesEnum.Approver)" id="btnReject" type="button" value="@Labels.Reject" class="button-primary submit" requestId="@Model.RequestId"/>
                    }
                }
                else if (Model.Status == (byte)CurrentRequestStatus.Accepted || (Model.Status == (byte)CurrentRequestStatus.NotAccepted))
                {
                    if (Model.VerifierId == Convert.ToInt32(ViewBag.CurrentUserId))
                    {
                        <input roleid="@Convert.ToInt32(Fanex.NexHR.Core.Enums.RolesEnum.Verifier)" id="btnReset" type="button" value="@Labels.Reset" class="button-primary submit" requestId="@Model.RequestId"/>
                    }
                    else if (Model.ApproverId == Convert.ToInt32(ViewBag.CurrentUserId))
                    {
                        <input roleid="@Convert.ToInt32(Fanex.NexHR.Core.Enums.RolesEnum.Approver)" id="btnApprove" type="button" value="@Labels.Approve" class="button-primary submit" requestId="@Model.RequestId"/>
                        <input roleid="@Convert.ToInt32(Fanex.NexHR.Core.Enums.RolesEnum.Approver)" id="btnReject" type="button" value="@Labels.Reject" class="button-primary submit" requestId="@Model.RequestId"/>
                    }
                }
                else if (Model.Status == (byte)CurrentRequestStatus.Approved || (Model.Status == (byte)CurrentRequestStatus.Rejected))
                {
                    if (Model.ApproverId == Convert.ToInt32(ViewBag.CurrentUserId))
                    {
                        <input roleid="@Convert.ToInt32(Fanex.NexHR.Core.Enums.RolesEnum.Approver)" id="btnReset" type="button" value="@Labels.Reset" class="button-primary submit" requestId="@Model.RequestId"/>
                    }
                }
                <a href="@Url.Action(ViewBag.ViewName, "request")" class="button">@Labels.Back</a>
            </div>
            <div class="clear">
            </div>
        </div>
    }
</div>
