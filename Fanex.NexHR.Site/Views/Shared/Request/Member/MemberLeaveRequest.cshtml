@using Fanex.NexHR.Models.Request
@model IList<RequestEntity>
<table class="data persist-area">
    <thead>
        <tr class="persist-header">
            <th>
                #
            </th>
            <th>@Labels.Team
            </th>
            <th>@Labels.Employee
            </th>
            <th>@Labels.LeaveType
            </th>
            <th>@Labels.From
            </th>
            <th>@Labels.To
            </th>
            <th>@Labels.Total
            </th>
            <th>@Labels.CreatedDate
            </th>
            <th>@Labels.Remark
            </th>
            <th>@Labels.Status
            </th>
            <th>@Labels.History
            </th>
        </tr>
    </thead>
    @if (ViewBag.EntityList.Count > 0)
    {
        <tbody>
            @{int index = 1;}
            @foreach (RequestEntity request in Model)
            {
                var requestDetail = new { requestid = @request.Id, type = @request.RequestType.RequestHistoryFilter };
                
                <tr id="row@(request.Id)">
                    <td>@(index++)
                    </td>
                    <td  class="tooltip" title="@request.Requester.Team.Name">@request.Requester.Team.Code
                    </td>
                    <td class="tooltip" title="@request.Requester.FullName">@request.Requester.NickName
                    </td>
                    <td>
                        <a href="~/Leave/Detail?requestId=@request.Id">@request.LeaveType.Name</a>
                    </td>
                    <td class="ddMMyyyy highlight">@request.FromDate.ToDateMonthYearFormatedDate()
                    </td>
                    <td class="ddMMyyyy highlight">@request.ToDate.ToDateMonthYearFormatedDate()
                    </td>
                    @if((double)request.TotalDays == 0.5)
                    {
                        var title = request.FromTime.ToDateMonthYearFormatedDate() + " " + request.FromTime.ToString("HH:mm")
                            + " - " + request.ToTime.ToDateMonthYearFormatedDate() + " " + request.ToTime.ToString("HH:mm");
                        <td class="highlight tooltip" title="@title">@request.TotalDays.ToString("0.0")
                        </td>
                    }
                    else
                    {
                        <td class="highlight">@request.TotalDays.ToString("0.0")
                        </td>
                    }
                    
                    <td class="ddMMyyyyhhmm">@request.CreatedDate.ToShortFormatedDate()
                    </td>
                    @if (!string.IsNullOrWhiteSpace(request.Remark))
                    { 
                        <td class="tooltip" title="@request.Remark">
                            <span class="icon remark" alt="remark" />
                        </td>
                    }
                    else
                    {
                        <td>
                            -
                        </td>
                    }
                    @Html.Partial("Request/Member/SharedStatus", request)
                    <td>
                        <a class="viewhistory" href="javascript:;" id="/request/hrviewhistory?id=@request.Id&type=@request.RequestType.RequestHistoryFilter">
                            @Labels.View </a>
                    </td>
                </tr>  
            }
        </tbody>
    }
    else
    { 
        @RazorHelper.DisplayNoInformation(colspan: 12);
    }
</table>
@RazorHelper.VerifierAndApproverMenu()
@RazorHelper.ResetMenu()