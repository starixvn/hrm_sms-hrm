@model IList<Fanex.NexHR.Models.Request.RequestEntity>

<table class="data persist-area">
    <thead>
        <tr class ="persist-header">
            <th>
                #
            </th>
            <th>@Labels.Team
            </th>
            <th>@Labels.Employee
            </th>
            <th>@Labels.FromDate
            </th>
            <th>@Labels.ToDate
            </th>
            <th>@Labels.CreatedDate
            </th>
            <th>@Labels.Remark</th>
            <th>@Labels.Status
            </th>
            <th>@Labels.History</th>
        </tr>
    </thead>
    @if (ViewBag.EntityList.Count > 0)
    {
        <tbody>
            @{int index = 1;}
            @foreach (var request in Model)
            {
                var requestDetail = new { requestid = @request.Id, type = @request.RequestType.RequestHistoryFilter };
                
                <tr id="row@(request.Id)">
                    <td>
                        <a href="@Url.Action("memberdetail", "request", requestDetail)">@(index++)</a>
                    </td>
                    <td  class="tooltip" title="@request.Requester.Team.Name">@request.Requester.Team.Code</td>
                    <td class="tooltip" title="@request.Requester.FullName">
                        @request.Requester.NickName.ToString()
                    </td>
                    <td class="highlight">@request.FromDate.ToDateMonthYearFormatedDate()
                    </td>
                    <td class="highlight">@request.ToDate.ToDateMonthYearFormatedDate()
                    </td>
                    <td class="ddMMyyyyhhmm">@request.CreatedDate.ToShortFormatedDate()
                    </td>
                    @if (!string.IsNullOrWhiteSpace(request.Remark))
                    { 
                                 <td class="tooltip" title="@request.Remark">
                                     <span class="icon remark" alt="remark" />
                                </td>
                    }
                    else
                    {
                                <td>-</td>
                    }
                    @Html.Partial("Request/Member/SharedStatus", request)
                    <td>
                        <a class="viewhistory" href="javascript:;" id="/request/hrviewhistory?id=@request.Id&type=@request.RequestType.RequestHistoryFilter"> @Labels.View </a>
                     </td>
                </tr>  
            }
        </tbody>
    }
    else
    { 
        @RazorHelper.DisplayNoInformation(colspan: 12);
    }
</table>
@RazorHelper.VerifierAndApproverMenu()
@RazorHelper.ResetMenu()