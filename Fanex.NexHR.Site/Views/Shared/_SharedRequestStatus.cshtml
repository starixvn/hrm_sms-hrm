@using Fanex.NexHR.Models.Request
@model RequestEntity

@{
var request = (RequestEntity)Model;
switch (request.Status.Id)
{
    case (byte)CurrentRequestStatus.Pending:
        <td>
            <a requestid="@request.Id" href="javascript:void(0);" class="tooltip @request.Status.ToString()">@request.Status.ToString()</a>
        </td>
        break;
    case (byte)CurrentRequestStatus.Verified:
    case (byte)CurrentRequestStatus.NotVerified:
        <td>
            <a requestid="@request.Id" href="javascript:void(0);" class="tooltip reedit" title="@request.Status.Name by @request.VerifiedBy.NickName (@request.VerifiedDate.ToShortFormatedDate())">@request.Status.ToString()</a>
        </td>
                                                                                                                                                                                               break;
    case (byte)CurrentRequestStatus.Approved:
    case (byte)CurrentRequestStatus.Rejected:
        <td>
            <a requestid="@request.Id" href="javascript:void(0);" class="tooltip reedit" title="@request.Status.Name by @request.ApprovedBy.NickName (@request.ApprovedDate.ToShortFormatedDate())">@request.Status.ToString()</a>
        </td>   
                                                                                                                                                                                               break;

    case (byte)CurrentRequestStatus.Processed:
    case (byte)CurrentRequestStatus.Void:
        <td>
            <a requestid="@request.Id" href="javascript:void(0);" class="tooltip reedit" title="@request.Status.Name by @request.ProcessedBy.NickName (@request.ProcessedDate.ToShortFormatedDate())">@request.Status.ToString()</a>
        </td> 
                                                                                                                                                                                   break;
    default:
     <td>
        <a href="javascript:void(0);" class="tooltip">@request.Status.ToString()</a>
    </td>   
        break;
}
}