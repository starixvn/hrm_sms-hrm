@{
    var title = string.Empty;
    int siteId = ConfigSettings.SiteId;
}

<!DOCTYPE html>
<html xml:lang="en" lang="en">
<head>
    <meta charset="utf-8" />

    @switch (siteId)
    {
        case (int)SiteId.SMS:
            title = "SMS HRMS";
            break;
        case (int)SiteId.HM:
            title = "HM HRM";
            break;
    }

    <title>@title - @ViewBag.Title</title>
    <meta name="viewport" content="width=device-width" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
    @RenderSection("css", false)
    @RenderSection("js", false)
    @Html.Action("GlobalScript", "UI")
    <meta name="description" content="The description of my page" />
</head>
<body class="locale_en production">
    <header>
        @Html.Action("Header", "UI")
    </header>
    <div id="container" class="container">
        <nav id="left-navigation">
            <div class="column_wrap">
                @Html.Action("NavBar", "UI")
            </div>
        </nav>
        <section id="section_content">
            <div id="content-wrapper" class="content_wrap">
                <section id="section_breadcrumb">
                    <div class="separator js-separator">
                        <div class="js-view-title separator-view-title" id="view_title">
                            <div class="breadcrumb">
                                <a id="toggle-left-navigation" class="toggle-left-navigation large-back" href="javascript:;" title="@Labels.HideLeftNavigation"></a>
                                <span class="separate">|</span>
                                @RenderSection("Breadcrumb", required: true)
                            </div>
                        </div>
                        <div class="js-menu separator-menu">
                            @RenderSection("SeparatorMenu", required: false)
                        </div>
                    </div>
                </section>
                <section id="section_body">
                    <div class="content_scroll">
                        @RenderBody()
                    </div>
                </section>
            </div>
        </section>
        <div class="right_wrap">
            @RenderSection("Right", required: false)
        </div>
    </div>
    <footer></footer>
    <div id="message">
    </div>
    <script type="text/javascript">
        function toggleLeftNavigation(isShow) {
            var currentElement = $("#toggle-left-navigation");

            if (isShow) {
                currentElement.removeClass("large-next");
                currentElement.addClass("large-back");
                currentElement.attr({ title: "@Labels.HideLeftNavigation" });
                $("#left-navigation").show();
                $("#content-wrapper").removeClass("expand");
            }
            else {
                currentElement.removeClass("large-back");
                currentElement.addClass("large-next");
                currentElement.attr({ title: "@Labels.ShowLeftNavigation" });
                $("#left-navigation").hide();
                $("#content-wrapper").addClass("expand");
            }
        }

        function updateLeftNavigationSetting(isShow) {
            $.ajax({
                type: "POST",
                url: "@(Url.Action("ToogleLeftNavigation", "Employee"))",
                data: { isShow: isShow }
            });
        }

        $(document).ready(function () {
            if (_global.isShowLeftNavigation == "True") {
                toggleLeftNavigation(true);
            }
            else {
                toggleLeftNavigation(false);
            }

            $("#toggle-left-navigation").bind("click", function () {
                var currentElement = $(this);
                if (currentElement.hasClass("large-back")) {
                    toggleLeftNavigation(false);
                    updateLeftNavigationSetting(false);
                }
                else {
                    toggleLeftNavigation(true);
                    updateLeftNavigationSetting(true);
                }
            });
        });
    </script>
</body>
</html>