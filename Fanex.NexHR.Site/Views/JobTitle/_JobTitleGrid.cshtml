@{
    var hasPermission = (bool)ViewBag.HasPermission;
    var totalColumn = hasPermission ? 8 : 6;
}
@model IList<LookupData>
<table class="table table-custom" style="width: auto; min-width: 622px;">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th>@Labels.JobTitle</th>
            <th>@Labels.Category</th>
            <th>@Labels.TotalExpat</th>
            <th>@Labels.TotalLocal</th>
            <th>@Labels.Total</th>
            @if (hasPermission)
            {
                <th>@Labels.Edit</th>
                <th>@Labels.Delete</th>
            }
        </tr>
    </thead>
    <tbody class="js-job-title-table-body">
        @if (Model.Any())
        {
            for (var index = 0; index < Model.Count; index++)
            {
                var currentIndex = index + 1;
                var job = Model[index];
                <tr>
                    <td>
                        @currentIndex
                    </td>
                    <td class="align-left" style="width: 340px">
                        <span data-id="@job.Id">@job.Name</span>
                    </td>
                    <td class="align-left">
                        @job.CategoryName
                    </td>
                    <td>
                        @job.TotalExpat
                    </td>
                    <td>
                        @job.TotalLocal
                    </td>
                    <td>
                        @if (job.Value != "0")
                        {
                            <a href="@Url.Action("UserManagement", "Employee", new { jobTitleId = job.Id })">@job.Value</a>
                        }
                        else
                        {
                            <span>0</span>
                        }
                    </td>
                    @if (hasPermission)
                    {
                        <td>
                            <a href="javascript:;" class="edit-jobtitle" data-id=@job.Id data-category-id="@job.CategoryId" data-job-title="@job.Name">
                                <i class="fa fa-pencil fa-lg icon-edit"></i>
                            </a>
                        </td>
                        <td>
                            @if (job.Value != "0")
                            {
                                <a href="javascript:;" style="cursor:default">
                                    <i class="fa fa-times fa-lg fa-disabled icon-delete"></i>
                                </a>
                            }
                            else
                            {
                                <a href="javascript:;" class="delete-jobtitle" data-id=@job.Id>
                                    <i class="fa fa-times fa-lg icon-delete"></i>
                                </a>
                            }
                        </td>
                    }
                </tr>
            }
        }
        else
        {
            @RazorHelper.DisplayNoInformation(colspan: totalColumn)
        }
    </tbody>
</table>