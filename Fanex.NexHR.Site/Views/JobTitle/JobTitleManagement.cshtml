@model IList<SelectListItem>
@{
    ViewBag.Title = @Labels.JobTitleManagement;
    var policies = ViewBag.Policies as PoliciesModel;
}
@section css{
    @Url.CombresLink("jobtitlecss")
}
@section js{
    @Url.CombresLink("jobtitle")
}
@section Breadcrumb {
    <a class="step" href="#">@ViewBag.Title</a>
}
<h2>@ViewBag.Title</h2>
<div class="container_24 bunhat">
    @Labels.Keyword
    <input id="keyword" type="text" placeholder="@Messages.JobTitle" />
    @if (policies.CanCreate)
    {
        <div class="button-icon">
            <span class="icon plus"></span><a href="javascript:;" id="btnNewJobTitle">@Labels.NewJobTitle</a>
        </div>
    }
</div>
<div class="clear">
</div>
<table class="table table-custom js-job-title-table" style="width: auto; min-width: 622px;">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th>@Labels.JobTitle</th>
            <th>@Labels.Category</th>
            <th>@Labels.TotalExpat</th>
            <th>@Labels.TotalLocal</th>
            <th>@Labels.Total</th>
            @if (policies.CanEdit)
            {
                <th>@Labels.Edit</th>
            }
            <th>@Labels.Delete</th>
        </tr>
    </thead>
    <tbody class="js-job-title-table-body"></tbody>
</table>
<div id="dialog-form" title="Create an job title" style="display: none">
    <p class="validateTips">
    </p>
    <form>
        <div class="formrow">
            <div class="label">
                <label for="name">@Labels.JobTitle</label>
            </div>
            <div class="input">
                <input type="text" name="name" id="name" class="text ui-widget-content ui-corner-all" />
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                <label for="category">@Labels.Category</label>
            </div>
            <div class="input">
                @Html.DropDownList("category", Model)
                @Html.Hidden("isUpdate")
                @Html.Hidden("jobtitleId")
            </div>
        </div>
    </form>
</div>