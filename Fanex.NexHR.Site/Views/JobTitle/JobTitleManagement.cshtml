@{
    ViewBag.Title = @Labels.JobTitleManagement;
}
@section css{
    @Url.CombresLink("jobtitlecss")
}
@section js{
    @Url.CombresLink("jobtitle")
}
@section Breadcrumb {
    <a class="step" href="#">@ViewBag.Title</a>
}

<h2>@ViewBag.Title</h2>
<div class="container_24 bunhat">
    @Labels.Keyword
    <input id="keyword" type="text" placeholder="@Messages.JobTitle"/>
    <div class="button-icon">
        <span class="icon plus"></span><a href="javascript:;" id="btnNewJobTitle">@Labels.NewJobTitle</a></div>
</div>
<div class="clear">
</div>
<table id="data" class="data persist-area" style="width: auto; min-width: 622px;">
    <thead>
        <tr class="persist-header">
            <th>
                #
            </th>
            <th style="width: 340px">@Labels.JobTitle
            </th>
            <th>@Labels.Category
            </th>
            <th>@Labels.TotalExpat
            </th>
            <th>@Labels.TotalLocal
            </th>
             <th>@Labels.Total
            </th>
            <th>@Labels.Edit
            </th>
            <th>@Labels.Delete
            </th>
        </tr>
    </thead>
    <tbody>
    </tbody>
</table>
<script id="itemTemplate" type="text/x-jquery-tmpl">
     <tr id="row${Id}">
            <td>
              ${index()}
            </td>
            <td class="left" style="width: 340px">
                <span id="spanJobTitle_${Id}"> ${Name}</span>
                <input type="text" value="${Name}" id="txtJobTile_${Id}" style="display:none;height:22px;width: 300px;"/> 
            </td>
            <td class="left">
                ${CategoryName}
            </td>
            <td >
                ${TotalExpat}
            </td>
            <td >
                ${TotalLocal}
            </td>
            <td >
                {{if Value!='0'}}
                    <a href="/employee/usermanagement/?jobtitleid=${Id}">${Value}</a>
                {{else}}
                    0
                {{/if}}
            </td>
           <td class="cmd">
                    <a href="javascript:;" class="lnkEdit" data-id = ${Id} id='btnEditJobTitle_${Id}' data-categoryId="${CategoryId}"><img src="@Url.Content("~/Styles/Images/edit-icon.png")" /></a>
                    <a href="javascript:;" class="lnkSave" data-id = ${Id} id="btnUpdateJT_${Id}" style="display:none" title="Apply">
                        <img src="@Url.Content("~/Styles/Images/approve.png")" />
                    </a>
                    <a href="javascript:;" class="lnkCancel" data-id = ${Id} id="btnCancelUpdateJT_${Id}" style="display:none;margin-left:10px;" title="Cancel">
                        <img src="@Url.Content("~/Styles/Images/reject.png")" />
                    </a>
            </td>
            <td  class="cmd">
             {{if Value!='0'}}
                     <a href="javascript:;" style="cursor:default"><img src="@Url.Content("~/Styles/Images/disabled-delete.png")" /></a> 
                {{else}}
                      <a href="javascript:;" class="lnkDelete" data-id = ${Id} id="${Id}"><img src="@Url.Content("~/Styles/Images/delete-icon.png")" /></a> 
                {{/if}}
            </td>
        </tr>
</script>
<script id="mytemplate" type="text/html">
</script>
<div id="dialog-form" title="Create an job title" style="display: none">
    <p class="validateTips">
    </p>
    <form>
        <div class="formrow">
            <div class="label">
                <label for="name">@Labels.JobTitle</label>
            </div>
            <div class="input">
                <input type="text" name="name" id="name" class="text ui-widget-content ui-corner-all" />
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                <label for="category">@Labels.Category</label>
            </div>
            <div class="input">
                @{
                var types = new List<SelectListItem>
                {
                    new SelectListItem() {Text = Labels.Worker, Value = ((int)JobTitleCategory.Worker).ToString()},
                    new SelectListItem() {Text = Labels.Staff, Value = ((int)JobTitleCategory.Staff).ToString()},
                    new SelectListItem() {Text = Labels.Executive, Value = ((int)JobTitleCategory.Executive).ToString()},
                    new SelectListItem() {Text = Labels.ExecutiveWithPosition, Value = ((int)JobTitleCategory.ExecutiveWithPosition).ToString()},
                    new SelectListItem() {Text = Labels.Management, Value = ((int)JobTitleCategory.Management).ToString()}
                };
            }
            @Html.DropDownList("category", types)
            @Html.Hidden("isUpdate")
            @Html.Hidden("jobtitleId")
            </div>
        </div>

    </form>
</div>
