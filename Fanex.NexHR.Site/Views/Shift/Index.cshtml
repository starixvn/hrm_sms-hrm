@model ShiftByStatusViewModel
@section css{
    @Url.CombresLink("shiftcss")
}
@section js{
    @Url.CombresLink("sitejs")
}
@{
    ViewBag.Title = Labels.ShiftInfo;
    var hasPermission = (bool)ViewBag.HasPermission;
    var totalColumn = hasPermission ? 5 : 4;
}
@section Breadcrumb {
    <a class="step">@Labels.CompanySpace</a>
    <a class="step" href="@Url.Action("workingcalendars", "calendar")">Working calendars</a>
    <span class="step">@ViewBag.Title</span>
}
<h2>@ViewBag.Title</h2>
@using (Html.BeginGetForm())
{
    <div class="bunhat container_24">
        <div class="grid_1 gridlabel">
            @Labels.Status
        </div>
        <div class="grid_3">
            @Html.DropDownListFor(model => model.StatusId, new SelectList(Model.Status, "Value", "Text"))
        </div>
        <div class="grid_2">
            <input type="submit" id="submit" value="@Labels.Submit" />
        </div>
        @if (hasPermission)
        {
            <div class="grid_3">
                <div class="button-icon"><span class="icon plus"></span>@Html.ActionLink("New Shift", "Create")</div>
            </div>
        }
    </div>
}
<div class="grid_24">
    <table id="tblShift" class="table table-custom persist-area">
        <thead class="persist-header">
            <tr>
                <th>@Labels.SymbolCount</th>
                <th class="left">@Labels.Shift</th>
                <th>@Labels.In</th>
                <th>@Labels.Out</th>
                @if (hasPermission)
                {
                    <th>@Labels.Edit</th>
                }
            </tr>
        </thead>
        <tbody>
            @if (Model.Shifts != null && Model.Shifts.Any())
            {
                var i = 0;
                foreach (Shift item in Model.Shifts)
                {
                    i++;
                    <tr>
                        <td>@i</td>
                        <td class="align-left">
                            @item.Name
                        </td>
                        <td>
                            @item.BeginCheckInTime &nbsp;@((item.BeginCheckInTime == item.EndCheckInTime) ? string.Empty : "- " + item.EndCheckInTime)
                        </td>
                        <td>
                            @item.BeginCheckOutTime &nbsp;@((item.BeginCheckOutTime == item.EndCheckOutTime) ? string.Empty : "- " + item.EndCheckOutTime)
                        </td>
                        @if (hasPermission)
                        {
                            <td class="cmd">
                                <a href="@Url.Action("Edit", "Shift", new { shiftId = item.Id })">
                                    <i class="fa fa-pencil fa-lg icon-edit"></i>
                                </a>
                            </td>
                        }
                    </tr>
                }
            }
            else
            {
                @RazorHelper.DisplayNoInformation(colspan: totalColumn);
            }
        </tbody>
    </table>
</div>