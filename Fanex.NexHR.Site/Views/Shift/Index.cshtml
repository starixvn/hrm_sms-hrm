@using Fanex.NexHR.ViewModels.Shifts
@model ShiftByStatusViewModel

@section css{
    @Url.CombresLink("shiftcss")
}
@section js{
    @Url.CombresLink("sitejs")
}
@{
    ViewBag.Title = Labels.ShiftInfo;
}
@section Breadcrumb {
    <a class="step">Company</a> <span class="step">@ViewBag.Title</span>
}
<h2>@ViewBag.Title</h2>
@using (Html.BeginGetForm())
{
    <span style="padding-right: 5px;">@Labels.Status</span>
    @Html.DropDownListFor(model => model.StatusId, new SelectList(Model.Status, "Value", "Text"))
    <input type="submit" id="submit" value="@Labels.Submit"/>
    if (Roles.IsUserInRole("HR"))
    { 
        <div class="button-icon"><span class="icon plus"></span>@Html.ActionLink("New Shift", "Create")</div>
    }
}

<div class="clear">
</div>
<div class="space">
</div>
<div class="clear">
</div>
<div class="space">
</div>
<div class="grid_24">
    <table id="tblShift" class="data persist-area">
        <thead class ="persist-header">
            <tr>
                <th>#</th>
                <th class="left">
                    @Labels.Shift
                </th>
                <th>
                    @Labels.In
                </th>
                <th>
                    @Labels.Out
                </th>
                 @if (Roles.IsUserInRole("SystemAdmin"))
                 { 
                    <th>@Labels.Edit</th>
                 }
            </tr>
        </thead>
        <tbody>
        @if (Model.Shifts != null && Model.Shifts.Any())
        {
            var i = 0;
            foreach (Shift item in Model.Shifts)
            {
                i++;
                <tr>
                    <td>@i</td>
                    <td class="left">@item.Name
                    </td>
                    <td>@item.BeginCheckInTime &nbsp;@((item.BeginCheckInTime == item.EndCheckInTime) ? string.Empty : "- " + item.EndCheckInTime)
                    </td>
                    <td>
                        @item.BeginCheckOutTime &nbsp;@((item.BeginCheckOutTime == item.EndCheckOutTime) ? string.Empty : "- " + item.EndCheckOutTime)
                    </td>
                    @if (Roles.IsUserInRole("SystemAdmin"))
                    {
                        <td class="cmd">
                            <a href="@Url.Action("Edit", "Shift", new { shiftId = item.Id })"><img src="~/Styles/Images/edit-icon.png" /></a>
                        </td>
                    }
                </tr>
            }
        }
        else
        {
            @RazorHelper.DisplayNoInformation(colspan: 7);
        }
        </tbody>
    </table>
</div>
