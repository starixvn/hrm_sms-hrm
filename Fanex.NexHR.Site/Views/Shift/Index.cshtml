@model IList<Fanex.NexHR.Models.Shift>

@section css{
    @Url.CombresLink("sitecss")
}
@section js{
    @Url.CombresLink("sitejs")
}
@{
    ViewBag.Title = Labels.ShiftInfo;
}
@section Breadcrumb {
    <a class="step">Company</a> <span class="step">@ViewBag.Title</span>
}

@using (Html.BeginGetForm())
{
        <span style="padding-right: 5px; vertical-align:8px;">@Labels.Status</span>
        @Html.DropDownListFor(model => model.StatusId, new SelectList(Model.LeaveTypeList, "Id", "Name"))
        <input type="button" id="submit" value="@Labels.Submit" class="processing-submit"/>
    if (Roles.IsUserInRole("HR"))
    { 
            <div class="button-icon"><span class="icon plus"></span>@Html.ActionLink("New Shift", "Create")</div>
    }
}

<div class="clear">
</div>
<div class="space">
</div>
<div class="clear">
</div>
<div class="space">
</div>
<div class="grid_24">
    <table class="shift_table">
        <thead>
            <tr>
                <th class="left">
                    @Labels.Shift
                </th>
                <th>
                    @Labels.In
                </th>
                <th>
                    @Labels.Out
                </th>
                 @if (Roles.IsUserInRole("HR"))
                 { 
                    <th>@Labels.Edit</th>
                 }
            </tr>
        </thead>
        <tbody>
            @foreach (Shift item in Model)
            {
                <tr>
                    <td class="left">@item.Name
                    </td>
                    <td>@item.BeginCheckInTime &nbsp;@((item.BeginCheckInTime == item.EndCheckInTime) ? string.Empty : "- " + item.EndCheckInTime)
                    </td>
                    <td>
                        @item.BeginCheckOutTime &nbsp;@((item.BeginCheckOutTime == item.EndCheckOutTime) ? string.Empty : "- " + item.EndCheckOutTime)
                    </td>
                    @if (Roles.IsUserInRole("HR"))
                    {
                        <td class="cmd">
                            <a href="@Url.Action("Edit", "Shift", new { shiftId = item.Id })"><img src="~/Styles/Images/edit-icon.png" /></a>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>
