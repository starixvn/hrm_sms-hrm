@using Fanex.NexHR.ViewModels.Shifts
@using System.Web.Mvc.Html5
@model ShiftViewModel
@{
    ViewBag.Title = @Labels.Shift;
}

@section css{
    @Url.CombresLink("shiftcss")
}
@section js{
    @Url.CombresLink("shiftjs")
}
@section Breadcrumb {
    <a class="step">@Labels.CompanySpace</a>
    <a class="step" href="@Url.Action("index", "shift")">@Labels.ShiftManagement</a>
    <span class="step">@Labels.Create</span>
}
<h2>@Labels.Create</h2>
@using (Html.BeginForm())
{
<div class="bunhat">
    @Html.ValidationSummary(true)
    @if ((bool)ViewBag.Successed)
    {
    <div class="success">@Messages.ShiftCreated</div> 
    }
    @Html.Hidden("Successed", (bool)ViewBag.Successed)
    <div class="formrow">
        <div class="label">
            @Html.LabelFor(model => model.Name)*
        </div>
        <div class="input">
            @Html.EditorFor(model => model.Name, new { maxlength = "20"})
            @Html.ValidationMessageFor(model => model.Name)
        </div>
    </div>
    
    <div class="formrow">
        <div class="label">
            @Html.LabelFor(model => model.HourTimeIn, @Labels.TimeIn)*
        </div>
        <div class="input">
            @Html.Html5Number(0, 23, 1, Model.HourTimeIn, new { Name = "HourTimeIn", MaxLength = "2", id = "HourTimeIn" })
            :
            @Html.Html5Number(0, 59, 1, Model.MinuteTimeIn, new { Name = "MuniteTimeIn", MaxLength = "2", id = "MuniteTimeIn" })
            @Html.CheckBoxFor(model => model.IsInAfterDay)
            @Html.LabelFor(model => model.IsInAfterDay)
        </div>
    </div>

    <div class="formrow">
        <div class="label">
            @Html.LabelFor(model => model.HourTimeOut, @Labels.TimeOut)*
        </div>
        <div class="input">
            @Html.Html5Number(0, 23, 1, Model.HourTimeOut, new { Name = "HourTimeOut", MaxLength = "2", id = "HourTimeOut" })
            :
            @Html.Html5Number(0, 59, 1, Model.MinuteTimeOut, new { Name = "MinuteTimeOut", MaxLength = "2", id = "MinuteTimeOut" })
            @Html.CheckBoxFor(model => model.IsOutAfterDay)
            @Html.LabelFor(model => model.IsOutAfterDay)
        </div>
    </div>
    <div class="formrow">
        <div class="label">

        </div>
        <div class="input">
            <input type="submit" value="@Labels.Save"/>
            <a href="@Url.Action("index","shift")" class="button">@Labels.Back</a>
        </div>
    </div>

</div>
}