@using Fanex.NexHR.Resources
@using Fanex.NexHR.Models
@using Fanex.NexHR.Core

@model JobLevel
@{
    ViewBag.Title = @Labels.JobLevelManagement;
    var hasPermission = (bool)ViewBag.HasPermission;
}
@section css{
    <link href="~/wwwroot/dist/styles/jobtitle.css" rel="stylesheet" />
}
@section js{
    <script src="~/wwwroot/dist/js/joblevel.js"></script>
}
@section Breadcrumb {
    <a class="step">@Labels.HRSpace</a><span class="step">@ViewBag.Title</span>
}
<h2 class="page-title">@ViewBag.Title</h2>
@using (Html.BeginForm("GetJobLevel", "joblevel", FormMethod.Get, new { @class = "filter", style = "width: 700px;" }))
{
    var status = new List<SelectListItem>
{
            new SelectListItem() {Text = "All", Value = ""},
            new SelectListItem() {Text = "Active", Value = "true"},
            new SelectListItem() {Text = "Inactive", Value = "false"}
        };

<div class="form-horizontal clearfix">
    <div class="form-group">
        <div class="label-form label--xs">
            @Html.Label(@Labels.Status, new { @class = "control-label" })
        </div>
        <div class="select-form">
            @Html.DropDownList("Active", status, new { @class = "form-control" })
        </div>
    </div>
    <div class="form-group form-group--m">
        <button class="btn btn-primary" type="button" id="btnGetJobLevel">@Labels.Submit</button>
        @if (hasPermission)
        {
            <button id="btnNewJobLevel" class="btn btn-request" type="button">
                <span class="fa fa-plus"></span> @Labels.CreateJobLevel
            </button>
        }
    </div>
</div>
}

<div id="data"></div>

<div id="create-dialog" style="display: none" class="dialog-form">
    @Html.ValidationSummary()
    <form>
        <div class="form-horizontal clearfix">
            <div class="form-group">
                <div class="label-form">
                    <label class="control-label" for="name">@Labels.JobLevel</label>
                </div>
                <div class="input-form">
                    <input type="text" name="name" id="name" class="form-control" autocomplete="off" />
                </div>
            </div>
            <div class="form-group">
                <div class="label-form">
                    <label class="control-label" for="IsActive">@Labels.IsActive</label>
                </div>
                <div class="input-form">
                    @Html.CheckBoxCustomFor(model => model.IsActive)
                </div>
            </div>
        </div>
    </form>
</div>

<div id="edit-dialog" style="display: none" class="dialog-form">
    @Html.ValidationSummary()
    <form>
        <div class="form-horizontal clearfix">
            <div class="form-group">
                <div class="label-form">
                    <label class="control-label" for="name">@Labels.JobLevel</label>
                </div>
                <div class="input-form">
                    <input type="text" name="name" id="name" class="form-control" />
                </div>
            </div>
            <div class="form-group">
                <div class="label-form">
                    <label class="control-label" for="IsActive">@Labels.IsActive</label>
                </div>
                <div class="input-form">
                    @Html.CheckBoxCustomFor(model => model.IsActive)
                </div>
            </div>
        </div>
    </form>
</div>

