@using Fanex.NexHR.Resources
@using Fanex.NexHR.Models
@{
    var hasPermission = (bool)ViewBag.HasPermission;
    var totalColumn = hasPermission ? 5 : 7;
}
@model IList<JobLevel>
    <table class="table table-custom" style="width: auto; min-width: 700px;">
        <thead>
            <tr>
                <th>@Labels.SymbolCount</th>
                <th>@Labels.Name</th>
                @if (hasPermission)
                {
                    <th>@Labels.Edit</th>
                    <th>@Labels.Delete</th>
                }
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                int index = 1;
                foreach (JobLevel jobLevel in Model)
                {
                    <tr id="row@(jobLevel.Id)">
                        <td>@(index++)</td>
                        <td>@jobLevel.Name</td>
                        @if (hasPermission)
                        {
                            <td>
                                <a href="javascript:;" class="edit-jobLevel" data-id=@jobLevel.Id data-isActive="@jobLevel.IsActive" data-joblevel-name="@jobLevel.Name">
                                    <i class="fa fa-pencil fa-lg icon-edit"></i>
                                </a>
                            </td>
                            <td>
                                <a href="javascript:;" class="delete-jobLevel" data-id="@jobLevel.Id">
                                    <i class="fa fa-times fa-lg icon-delete"></i>
                                </a>
                            </td>
                        }
                    </tr>
                }
            }
            else
            {
                @RazorHelper.DisplayNoInformation(5)
            }
        </tbody>
    </table>
