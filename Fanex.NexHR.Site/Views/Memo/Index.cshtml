@model MemoViewModel
@{
    ViewBag.Title = "Company Memo";
    var hasPermission = (bool)ViewBag.HasPermission;
    var totalColumn = hasPermission ? 7 : 5;
}
@section css{
    @Url.CombresLink("memoeditcss")
}
@section js{
    @Url.CombresLink("memojs")
}
@section Breadcrumb {
    <a class="step">@Labels.CompanySpace</a> <span class="step">@ViewBag.Title</span>
}
<h2>@ViewBag.Title</h2>
@using (Html.BeginForm())
{
    <div class="container_24 bunhat" style="width: 878px;">
        <div class="grid_8" style="display: none;">
            @Html.LabelFor(model => model.Content)
            @Html.TextBoxFor(model => model.Content)
        </div>
        <div class="grid_1">
            @Html.LabelFor(model => model.Year)
        </div>
        <div class="grid_3">
            @Html.YearPickerFor(model => model.Year, 2010, isShowAll: true)
        </div>
        <div class="grid_2">
            @Html.LabelFor(model => model.Category)
        </div>
        <div class="grid_4">
            @Html.DropDownListFor(model => model.Category, new SelectList(ViewBag.MemoCategories, "id", "Name"), new SelectListItem() { Value = "-1", Text = "All" }, new { @class = "aaaa" })
        </div>
        <div class="grid_6">
            <input type="submit" id="submit" class="processing-submit" value="@Labels.Submit" />
            @if (hasPermission)
            {
                <div class="button-icon">
                    <span class="icon plus"></span>@Html.ActionLink("Create new Memo", "Create")
                </div>
            }
        </div>
    </div>
    <div class="clear">
    </div>
    <table id="memo" class="table table-custom persist-area" style="width: 900px">
        <thead>
            <tr class="persist-header">
                <th>@Labels.SymbolCount</th>
                <th>@Labels.RefNo</th>
                <th>@Labels.Subject</th>
                <th>@Labels.Category</th>
                <th>@Labels.Date</th>
                @if (hasPermission)
                {
                    <th>@Labels.Edit</th>
                    <th>@Labels.Delete</th>
                }
            </tr>
        </thead>
        @if (ViewBag.EntityList.Count > 0)
        {
            <tbody>
                @{int index = 1;}
                @foreach (Memo item in ViewBag.EntityList)
                {
                    <tr id="row_@item.Id">
                        <td>
                            @(index++)
                        </td>
                        <td>
                            @item.RefNo
                        </td>
                        <td class="align-left">
                            <a href="@Url.Action("detail", "memo", new { Id = item.Id })">@item.Subject</a>
                        </td>
                        <td>
                            @item.CategoryName
                        </td>
                        <td class="ddMMyyyy">
                            @item.SentDate.ToDateMonthYearFormatedDate()
                        </td>
                        @if (hasPermission)
                        {
                            <td class="cmd" title="Edit">
                                <a href="@Url.Action("edit", "memo", new { Id = item.Id })">
                                    <i class="fa fa-pencil fa-lg icon-edit"></i>
                                </a>
                            </td>
                            <td class="cmd" title="Delete">
                                <a href="javascript:;" onclick="deleteMemo(@item.Id, '@System.Web.HttpUtility.HtmlEncode(item.Contents)', @item.MemoType);">
                                    <i class="fa fa-times fa-lg icon-delete"></i>
                                </a>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        }
        else
        {
            @RazorHelper.DisplayNoInformation(totalColumn)
        }
    </table>
}