@using Nexus.RoleManagement.Services;
@model IEnumerable<MenuModel>
@{
    var unreadMessage = (int)ViewBag.UnreadMessage;
    var selectedMenu = (MenuModel)ViewBag.SelectedMenu;
    var idSelected = selectedMenu != null ? selectedMenu.Name + "_" + selectedMenu.MenuId : string.Empty;
}
<div class="column">
    <div class="nav_links">
        @foreach (var parentMenu in Model.Where(i => i.ParentId == null).OrderBy(i => i.DisplayOrder))
        {
            if (Model.Any(i => i.ParentId == parentMenu.MenuId))
            {
                <div class="overview_section togglable_section" id="@parentMenu.MenuId">
                    <div class="separator">
                        <strong>@parentMenu.Text</strong>
                    </div>
                </div>
                <div class="navItem">
                    @foreach (var childMenu in Model.Where(i => i.ParentId == parentMenu.MenuId).OrderBy(i => i.DisplayOrder))
                    {
                        var menuText = childMenu.Name.Equals("MyMessage") && unreadMessage > 0 ? childMenu.Text + " (" + unreadMessage + ")" : childMenu.Text;

                        <div id="@(childMenu.Name + "_"+childMenu.MenuId)" class="el">
                            <span class="xicon @childMenu.Name"></span>
                            <a href="@childMenu.Link">@menuText</a>
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        var currentUrl = '@idSelected';
        var selectNavItem = $("#" + currentUrl);
        if (selectNavItem != undefined) {
            selectNavItem.addClass("selected");
        }

        //show/hide navigation secion
        $("div.togglable_section").bind("click", function () {
            var currentSection = $(this);
            var divItems = currentSection.next("div.navItem");
            if (currentSection.hasClass("folded")) {
                currentSection.removeClass("folded");
                divItems.show(200);
            }
            else {
                currentSection.addClass("folded");
                divItems.hide(200);
            }
        });

        //add style for first item section
        $("div.togglable_section:first-child").children(":first").addClass("first");

        $('.el[data-hashovermenu=True], .el[data-hashovermenu=data-hashovermenu]').hover(
        function () {
            $(this).find('.hoveraction').fadeIn(400);
        }, function () {
            $(this).find('.hoveraction').hide();
        });
    });
</script>
