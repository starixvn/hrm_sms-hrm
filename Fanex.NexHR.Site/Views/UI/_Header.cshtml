@using Fanex.NexHR.Core.Models
@using Fanex.NexHR.Models.Message
@model EmployeeSession
@{
    IList<Message> messages = ViewBag.Messages as IList<Message>;
    int siteId = ConfigSettings.SiteId;
}
<div class="header_wrap">
    <div class="logo">
        <a href="~/">
            @switch (siteId)
            {
                case (int)SiteId.SMS:
                    <img src="~/wwwroot/sources/styles/images/SMS-logo.png" width="155" alt="" />
                    break;
                case (int)SiteId.HM:
                    <img src="~/wwwroot/sources/styles/images/Hongma-logo.png" width="155" alt="" />
                    break;
                case (int)SiteId.CTS:
                    <img src="~/wwwroot/sources/styles/images/CTS-logo.png" width="155" alt="" />
                    break;
            }
        </a>
    </div>
    <div class="search_bar">
        <form class="search" method="get" action="/employee/index" accept-charset="UTF-8" id="search">
            <input type="text" autocomplete="off" placeholder="Nickname or full name" name="query" id="searchbox" class="text-field" />
            <a id="searchIcon" class="search_btn"><span class="icon magnifier"></span></a>
        </form>
    </div>

    <div id="user_utilities" class="dropdown_navigation" style="z-index: 1000;">
        <h2>
            @Model.FullName - <i>@Model.Nickname</i>
        </h2>
        <a href="javascript:;" class="dropdown_arrow"></a>
        <ol class="global_navigation">
            <li><a class="" href="@Url.Action("create","leave")">Request leave</a> </li>
            <li><a class="" href="@Url.Action("create","changeshift")">Request change shift</a> </li>
            <li><a class="" href="@Url.Action("create","lateinearlyout")">Request late in - early out</a> </li>
            <li><a class="" href="@Url.Action("create","checkinout")">Request check in/out</a> </li>
            <li><a class="" href="@Url.Action("index","account")">My profile</a> </li>
            <li><a class="" href="@Url.Action("changepwd", "account")">Change Password</a> </li>
            <li><a class="" href="@Url.Action("logout", "auth")">Logout</a> </li>
        </ol>
    </div>
</div>