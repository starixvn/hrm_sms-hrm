@model System.Collections.Generic.IEnumerable<Nexus.RoleManagement.Services.MenuModel>

<div class="column">
    <div class="nav_links">
        @foreach (var parentMenu in Model.Where(i => i.ParentId == null))
        {
            <div class="overview_section togglable_section" id="@parentMenu.MenuId">
                <div class="separator">
                    <strong>@parentMenu.Text</strong>
                </div>
            </div>
            <div class="navItem">
                @foreach (var childMenu in Model.Where(i => i.ParentId == parentMenu.MenuId).OrderBy(i => i.DisplayOrder))
                {
                    <div id="@childMenu.MenuId" class="el">
                        <span class="xicon @childMenu.Name"></span>
                        <a href="@childMenu.Link">@childMenu.Text</a>
                    </div>
                }
            </div>
        }
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        var currentUrl = '@(ViewBag.Controller.ToString().ToLower() + "_" + ViewBag.Action.ToString().ToLower())';
        var selectNavItem = $("#" + currentUrl);
        if (selectNavItem != undefined) {
            selectNavItem.addClass("selected");
        }

        //show/hide navigation secion
        $("div.togglable_section").bind("click", function () {

            var currentSection = $(this);
            var divItems = currentSection.next("div.navItem");
            if (currentSection.hasClass("folded")) {
                currentSection.removeClass("folded");
                divItems.show(200);
            }
            else {

                currentSection.addClass("folded");
                divItems.hide(200);
            }
        });

        //add style for first item section
        $("div.togglable_section:first-child").children(":first").addClass("first");

        $('.el[data-hashovermenu=True], .el[data-hashovermenu=data-hashovermenu]').hover(
        function () {
            $(this).find('.hoveraction').fadeIn(400);
        }, function () {
            $(this).find('.hoveraction').hide();
        });
    });


</script>
