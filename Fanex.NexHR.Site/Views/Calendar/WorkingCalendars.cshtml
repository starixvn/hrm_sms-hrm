@using Fanex.NexHR.Resources
@model WorkingCalendarFilterViewModel
@{
    ViewBag.Title = Labels.WorkingCalendars;
    var hasPermissionToViewHoliday = (bool)ViewBag.HasPermissionToViewHoliday;
    var hasPermissionToViewShift = (bool)ViewBag.HasPermissionToViewShift;
}
@section css{
    <link href="~/wwwroot/dist/styles/workingcalendars.css" rel="stylesheet" />
}
@section js{
    <script src="~/wwwroot/dist/js/workingcalendar.js"></script>
}
@section Breadcrumb {
    <a class="step">@Labels.CompanySpace</a>
    <span class="step">@ViewBag.Title</span>
}

<div class="title">
    <h2 class="page-title">@ViewBag.Title</h2>
    <div>
        @if (hasPermissionToViewHoliday)
        {
            <a href="~/Holiday/index">@Labels.Holiday</a>
        }
        @if (hasPermissionToViewHoliday && hasPermissionToViewShift)
        {
            <span>||</span>
        }
        @if (hasPermissionToViewShift)
        {
            <a href="~/Shift/index">@Labels.Shift</a>
        }
    </div>
</div>

<form class="filter">
    @Html.HiddenFor(model => model.SectionIds)
    @Html.HiddenFor(model => model.JobTitleIds)
    @Html.HiddenFor(model => model.EmployeeId)
    <div class="form-horizontal clearfix">
        <div class="form-group form-group--l">
            <div class="label-form">
                @Html.Label(Labels.Week, new { @class = "control-label" })
            </div>
            <div class="calendar-form weekpicker-wrapper">
                @Html.TextBoxFor(model => model.FromDate, new { @class = "fromDate form-control", @readonly = true })
                @Html.TextBoxFor(model => model.ToDate, new { @class = "toDate form-control", @readonly = true })
                <i class="icon-calendar fa fa-calendar"></i>
                <div id="week-picker"></div>
            </div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                <label class="control-label">@Labels.DepartmentSection</label>
            </div>
            <div class="select-form" id="Section"></div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                <label class="control-label">@Labels.JobTitle</label>
            </div>
            <div class="select-form" id="JobTitle"></div>
        </div>
    </div>
    <div class="form-horizontal clearfix">
        <div class="form-group form-group--l">
            <div class="label-form">
                @Html.Label(Labels.Employee, new { @class = "control-label" })
            </div>
            <div class="input-form">
                @Html.TextBox("Employee", string.Empty,
                    new { placeholder = Messages.SearchEmployeeWatermark, @class = "form-control", @maxlength = 200, autocomplete = "off" })
            </div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.Label(Labels.Category, new { @class = "control-label" })
            </div>
            <div class="input-form">
                @RazorHelper.CategoryDropDownList("IsLocal", "form-control", "")
            </div>
        </div>
        <div class="form-group form-group--m">
            <button type="button" class="btn btn-primary" id="btnSearch">@Labels.Search</button>
            <button type="button" class="btn btn-excel" id="btnExcel">@Labels.Excel</button>
        </div>
    </div>
</form>
<div id="workingCalendarDetails"></div>