@model ShiftStatisticContentViewModel
@{
    Layout = null;
}
@Html.Hidden("PreviousFromDate", Model.FromDate.AddDays(-7).ToDateMonthYearFormatedDate())
@Html.Hidden("PreviousToDate", Model.ToDate.AddDays(-7).ToDateMonthYearFormatedDate())
@Html.Hidden("NextFromDate", Model.FromDate.AddDays(7).ToDateMonthYearFormatedDate())
@Html.Hidden("NextToDate", Model.ToDate.AddDays(7).ToDateMonthYearFormatedDate())
<table id="tblshiftstatistic" class="table table-custom">
    <thead>
        <tr>
            <th colspan="18">
                <div style="float:left;">
                    <a id="lnkPrevious" href="javascript:;"> << Previous </a> ||
                    <span class="chooseweek"> Week: @Model.FromDate.ToDateMonthYearFormatedDate() - @Model.ToDate.ToDateMonthYearFormatedDate() </span>
                    || <a id="lnkNext" href="javascript:;"> Next >> </a>
                </div>
            </th>
        </tr>
        <tr class="headerName">
            <th>
                @Labels.Shift
            </th>
            <th>
                @Model.FromDate.ToDateOfWeek()
            </th>
            <th>
                @Model.FromDate.AddDays(1).ToDateOfWeek()
            </th>
            <th>
                @Model.FromDate.AddDays(2).ToDateOfWeek()
            </th>
            <th>
                @Model.FromDate.AddDays(3).ToDateOfWeek()
            </th>
            <th>
                @Model.FromDate.AddDays(4).ToDateOfWeek()
            </th>
            <th class="weekend">
                @Model.FromDate.AddDays(5).ToDateOfWeek()
            </th>
            <th class="weekend">
                @Model.FromDate.AddDays(6).ToDateOfWeek()
            </th>
        </tr>
    </thead>
    @if (Model.ShiftStatisticModels.Any())
    {
        var totalMonday = 0;
        var totalTuesday = 0;
        var totalWednesday = 0;
        var totalThursday = 0;
        var totalFriday = 0;
        var totalSaturday = 0;
        var totalSunday = 0;
        var url = string.Empty;
        <tbody>
            @foreach (ShiftStatisticModel shiftStatisticModel in Model.ShiftStatisticModels)
            {
                totalMonday += shiftStatisticModel.WorkMonday;
                totalTuesday += shiftStatisticModel.WorkTuesday;
                totalWednesday += shiftStatisticModel.WorkWednesday;
                totalThursday += shiftStatisticModel.WorkThursday;
                totalFriday += shiftStatisticModel.WorkFriday;
                totalSaturday += shiftStatisticModel.WorkSaturday;
                totalSunday += shiftStatisticModel.WorkSunday;
                url = "employeeshift?teamIds=" + @Model.GroupIds + "&islocal=" + @Model.IsLocal + "&isShowWholeCompany=" + @Model.IsShowWholeCompany
                    + "&shiftId=" + @shiftStatisticModel.ShiftId + "&workdate=";
                <tr>
                    <td>@shiftStatisticModel.ShiftCode</td>
                    <td>
                        <a href="@(url + Model.FromDate.ToDateMonthYearFormatedDate())">@shiftStatisticModel.WorkMonday</a>
                    </td>
                    <td>
                        <a href="@(url + Model.FromDate.AddDays(1).ToDateMonthYearFormatedDate())">@shiftStatisticModel.WorkTuesday</a>
                    </td>
                    <td>
                        <a href="@(url + Model.FromDate.AddDays(2).ToDateMonthYearFormatedDate())">@shiftStatisticModel.WorkWednesday</a>
                    </td>
                    <td>
                        <a href="@(url + Model.FromDate.AddDays(3).ToDateMonthYearFormatedDate())">@shiftStatisticModel.WorkThursday</a>
                    </td>
                    <td>
                        <a href="@(url + Model.FromDate.AddDays(4).ToDateMonthYearFormatedDate())">@shiftStatisticModel.WorkFriday</a>
                    </td>
                    <td>
                        <a href="@(url + Model.FromDate.AddDays(5).ToDateMonthYearFormatedDate())">@shiftStatisticModel.WorkSaturday</a>
                    </td>
                    <td>
                        <a href="@(url + Model.FromDate.AddDays(6).ToDateMonthYearFormatedDate())">@shiftStatisticModel.WorkSunday</a>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="summary">
                <td class="align-right">@Labels.Total:</td>
                <td>@totalMonday</td>
                <td>@totalTuesday</td>
                <td>@totalWednesday</td>
                <td>@totalThursday</td>
                <td>@totalFriday</td>
                <td>@totalSaturday</td>
                <td>@totalSunday</td>
            </tr>
        </tfoot>
    }
    else
    {
        @RazorHelper.DisplayNoInformation(colspan: 8);
    }
</table>
@Url.CombresLink("shiftstatisticcontentjs")