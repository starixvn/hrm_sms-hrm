@using Fanex.NexHR.Models.Supervisor
@using Fanex.NexHR.ViewModels.Supervisor
@model ShiftManagerViewModel
@{
    ViewBag.Title = "Update Shift Manager";
    Layout = null;
}
@Url.CombresLink("employeeshiftmanagercss")
@Url.CombresLink("schedulearrangesortjs")

<div class="heightcroll">
    <table id="tblSupervisor" class="datasupervisor">
        <thead>
            <tr>
                <th>
                    #
                </th>
                <th>
                    Order Code
                </th>
                <th rowspan="2" class="supervisor">
                    Priority
                </th>
                <th rowspan="1" class="supervisor">
                    @Html.Label("Employee")
                </th>
                <th rowspan="1" class="supervisor">
                    @Html.Label("Team")
                </th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.ShiftManagerList != null)
            {
                int index = 0;
				foreach (SupervisorModel item in Model.ShiftManagerList)
                {
                    index++;
                <tr>
                    <td>@index</td>
                    <td>
                        <input type="text" class="ordercode" value="@item.OrderCode"/>
                    </td>
                    <td>
                        <a href="javascript:;" class="up">Up |</a> <a href="javascript:;" class="down">Down
                            |</a> <a href="javascript:;" class="moveTop">Top</a>
                    </td>
                    <td class="left" data-id="@item.OwnerId">@item.NickName (@item.FullName)
                    </td>
                    <td class="left">@item.Team
                    </td>
                </tr>
                }
            }
        </tbody>
    </table>
</div>
<br />
<div style="float:right;">
    <input id="btnSaveSort" type="button" value="Save" />
    @*<input id="btnCancel" type="button" value="Cancel" />*@
</div>
