@using Fanex.NexHR.Models.Supervisor
@using Fanex.NexHR.ViewModels.Supervisor
@model ShiftManagerViewModel
@{
    Layout = null;
}
@Url.CombresLink("employeeshiftmanagercss")
@Url.CombresLink("schedulearrangesortjs")

<div class="heightcroll">
    <table id="tblSupervisor" class="table table-custom">
        <thead>
            <tr>
                <th>@Labels.SymbolCount</th>
                <th>
                    Order Code
                </th>
                <th rowspan="2">
                    @Labels.Priority
                </th>
                <th rowspan="1">
                    @Labels.Employee
                </th>
                <th rowspan="1">
                    @Labels.Team
                </th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.ShiftManagerList != null)
            {
                int index = 0;
                foreach (SupervisorModel item in Model.ShiftManagerList)
                {
                    index++;
                <tr>
                    <td>@index</td>
                    <td>
                        <input type="text" class="ordercode" value="@item.OrderCode"/>
                    </td>
                    <td>
                        <a href="javascript:;" class="up">Up |</a> <a href="javascript:;" class="down">Down
                            |</a> <a href="javascript:;" class="moveTop">Top</a>
                    </td>
                    <td class="align-left" data-id="@item.OwnerId">
                        @item.NickName (@item.FullName)
                    </td>
                    <td class="align-left">
                        @item.Team
                    </td>
                </tr>
                }
            }
        </tbody>
    </table>
</div>
