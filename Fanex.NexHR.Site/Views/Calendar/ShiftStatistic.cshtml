@using Fanex.NexHR.ViewModels.Calendar
@model ShiftStatisticViewModel
@{
    ViewBag.Title = @Labels.ShiftStatisticReport;
    var displayFrom = (Model.FromDate).ToString("dd MMM, yyyy");
    var displayTo = (Model.ToDate).ToString("dd MMM, yyyy");
}
@section css{
    @Url.CombresLink("shiftstatisticcss")
}
@section js{
    @Url.CombresLink("shiftstatisticjs")
}
@section Breadcrumb {
    <a class="step">Personal</a><a class="step">@ViewBag.Title</a>
}
<h2>@ViewBag.Title</h2>
<div class="container_24 bunhat">
    <div class="grid_19">
        <div class="row">
            <div class="grid_1 gridlabel">
                @Html.Label("Week")
            </div>
            <div class="grid_7">
                @Html.TextBox("FromDate", displayFrom, new { @class = "startDateOfWeek" })
                @Html.TextBox("ToDate", displayTo, new { @class = "endDateOfWeek" })
                <img alt="" class="weekPickerImg" src="~/images/calendar.png" />
                <div class="week-picker">
                </div>
            </div>
            <div class="grid_2 gridlabel">
                @Labels.Category
            </div>
            <div class="grid_3">
                @RazorHelper.CategoryDropDownList("IsLocal", classHTML: "category", selectedId: string.Empty)
            </div>
        </div>
        <div class="clear">
        </div>
        <div class="space">
        </div>
        <div class="row">
            <div class="grid_1">
                @Labels.Team
            </div>
            <div class="grid_7">
                <select id="GroupId" multiple="multiple" name="GroupId" title="@Labels.Team">
                    @foreach (Team team in Model.Teams)
                    {
                        <option value="@team.Id">@team.Name</option>
                    }
                </select>
            </div>
            <div class="grid_4">
                @Html.CheckBoxFor(model => model.IsShowWholeCompany)
                @Html.LabelFor(model => model.IsShowWholeCompany, Labels.ShowWholeSection)
            </div>
            <div class="grid_2">
                <input type="button" value="@Labels.Submit" id="btnSubmit" />
            </div>
            <div class="clear">
            </div>
        </div>
    </div>
</div>
<div class="clear">
</div>
<div class="space">
</div>
<div class="clear">
</div>
<div class="space">
</div>
<br />
<div id="shiftStatistic">
</div>