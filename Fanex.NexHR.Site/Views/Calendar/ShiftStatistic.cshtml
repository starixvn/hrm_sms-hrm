@using Fanex.NexHR.Resources
@using Fanex.NexHR.Core.Constants

@model ShiftStatisticViewModel
@{
    ViewBag.Title = @Labels.ShiftStatisticReport;
    var displayFrom = Model.FromDate.ToDateMonthYearFormatedDate();
    var displayTo = Model.ToDate.ToDateMonthYearFormatedDate();
}
@section css{
    @Url.CombresLink("shiftstatisticcss")
}
@section js{
    @Url.CombresLink("shiftstatisticjs")
}
@section Breadcrumb {
    <a class="step">Personal</a><a class="step">@ViewBag.Title</a>
}
<h2>@ViewBag.Title</h2>
<div class="container_24 bunhat">
    <div class="grid_19">
        <div class="row">
            <div class="grid_2 gridlabel">
                @Html.Label("Week")
            </div>
            <div class="grid_7">
                @Html.TextBox("FromDate", displayFrom, new { @class = "startDateOfWeek" })
                @Html.TextBox("ToDate", displayTo, new { @class = "endDateOfWeek" })
                <img alt="" class="weekPickerImg" src="~/images/calendar.png" />
                <div class="week-picker"></div>
            </div>
            <div class="grid_2 gridlabel">@Labels.Category</div>
            <div class="grid_3">
                @RazorHelper.CategoryDropDownList("IsLocal", classHTML: "category", selectedId: string.Empty)
            </div>
        </div>
        <div class="clear"></div>
        <div class="space"></div>
        <div class="row">
            <div class="grid_2 gridlabel">@Labels.DepartmentSection</div>
            <div class="grid_7" id="Section"></div>
            <div class="grid_5">
                @Html.CheckBoxFor(model => model.IsShowWholeCompany)
                @Html.LabelFor(model => model.IsShowWholeCompany, Labels.ShowWholeSection)
            </div>
            <div class="grid_2">
                <input type="button" value="@Labels.Submit" id="btnSubmit" />
            </div>
            <div class="clear"></div>
        </div>
    </div>
</div>
<div class="clear"></div>
<div class="space"></div>
<div class="clear"></div>
<div class="space"></div>
<br />
<div id="shiftStatistic"></div>