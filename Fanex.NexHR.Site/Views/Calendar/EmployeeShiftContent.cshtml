@using Fanex.NexHR.Models.Calendar
@model IList<EmployeeShiftModel>
@{
    Layout = null;
}
<table id="tblemployeeshift" class="table table-custom tblemployeeshift">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th>@Labels.Date</th>
            <th>@Labels.Nick</th>
            <th>@Labels.FullName</th>
            <th>@Labels.Team</th>
            <th>@Labels.Shift</th>
        </tr>
    </thead>
    @if (Model.Any())
    {
        int i = 0;
        <tbody>
            @foreach (EmployeeShiftModel model in Model)
            {
                i++;
                <tr>
                    <td>@i</td>
                    <td>
                        @(model.WorkDate.ToDateMonthYearFormatedDate())
                    </td>
                    <td>
                        @(model.Employee.NickName)
                    </td>
                    <td class="align-left">
                        @(model.Employee.FullName)
                    </td>
                    <td class="tooltip" title="@(model.Employee.Team.Name)">
                        @(model.Employee.Team.Code)
                    </td>
                    <td class="align-left">
                        @(model.Shift.Name)
                    </td>
                </tr>
            }
        </tbody>
    }
    else
    {
        @RazorHelper.DisplayNoInformation(colspan: 6);
    }
</table>