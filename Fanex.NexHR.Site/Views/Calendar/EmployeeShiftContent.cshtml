@using Fanex.NexHR.Models.Calendar
@model IList<EmployeeShiftModel>
@{
    Layout = null;
}
<table id="tblemployeeshift" class="data tblemployeeshift">
    <thead>
        <tr>
            <th>
                #
            </th>
            <th>@Labels.Date
            </th>
            <th>@Labels.Nick
            </th>
            <th>@Labels.FullName
            </th>
            <th>@Labels.Team
            </th>
            <th>@Labels.Shift
            </th>
        </tr>
    </thead>

    @if (Model != null && Model.Any())
    {
        int i = 0;
        <tbody>
            @foreach (EmployeeShiftModel model in Model)
            {
                i++;
                <tr>
                    <td>@i
                    </td>
                    <td>@(model.WorkDate.ToDateMonthYearFormatedDate())
                    </td>
                    <td>@(model.Employee.NickName)
                    </td>
                    <td class="left">@(model.Employee.FullName)
                    </td>
                    <td class="tooltip" title="@(model.Employee.Team.Name)">@(model.Employee.Team.Code)
                    </td>
                    <td class="left">@(model.Shift.Name)
                    </td>
                </tr>
            }
        </tbody>
    }
    else
    {
        @RazorHelper.DisplayNoInformation(colspan: 6);
    }
 
</table>