@model ScheduleViewModel
@{
    Layout = null;
    var isSARole = (bool)ViewBag.IsSARole;
    var hasPermission = (bool)ViewBag.HasPermission;
}

@helper RenderShiftInput(WorkingCalendarModel workingCalendarModel, string classOfCheckbox, bool isSARole, bool hasPermission)
{
    var classOfInput = string.Empty;
    var valueOfInput = string.Empty;
    var dataShiftId = string.Empty;
    var disabledAttribute = string.Empty;
    var isShowCheckBox = hasPermission;
    var isShowAddShiftInLeaveHalfday = false;
    var shiftCodeForHalfday = string.Empty;
    var classOfleavetype = string.Empty;

    if (workingCalendarModel.IsLeaveOffDay)
    {
        valueOfInput = "Off";
        classOfInput = "offday";
        disabledAttribute = "disabled";
        isShowCheckBox = false;
    }
    else if (workingCalendarModel.IsLeaveDay)
    {
        disabledAttribute = "disabled";
        isShowCheckBox = false;
        classOfInput = "leaveday";

        if (workingCalendarModel.IsHoliday)
        {
            valueOfInput = "PH";
            classOfInput = "holiday";
        }
        else if (workingCalendarModel.IsOffDay)
        {
            valueOfInput = "Off";
            classOfInput = "offday";
        }
        else if (workingCalendarModel.LeaveDay == (decimal)0.5)
        {
            classOfInput += " shift";
            valueOfInput = workingCalendarModel.LeaveType.Code + "&#189;";
            isShowAddShiftInLeaveHalfday = true;

            if (workingCalendarModel.Shift != null)
            {
                shiftCodeForHalfday = workingCalendarModel.Shift.Code;
            }
        }
        else
        {
            if (workingCalendarModel.LeaveType2 == null)
            {
                valueOfInput = workingCalendarModel.LeaveType.Code;
            }
            else
            {
                classOfInput += " leavehalfday2";
                valueOfInput = workingCalendarModel.LeaveType.Code + " / " + workingCalendarModel.LeaveType2.Code;
            }
        }
    }
    else if (workingCalendarModel.IsHoliday)
    {
        classOfInput = "shift holiday";
        if (workingCalendarModel.Shift != null && workingCalendarModel.Shift.Id != -1)
        {
            dataShiftId = "data-shiftid=" + workingCalendarModel.Shift.Id;
            valueOfInput = workingCalendarModel.Shift.Code;
        }
        else
        {
            valueOfInput = "PH";
        }

        if (workingCalendarModel.IsKeepInViewDay)
        {
            classOfInput = "holiday keepinviewday";
            disabledAttribute = "disabled";
        }
    }
    else if (workingCalendarModel.IsOffDay)
    {
        if (workingCalendarModel.Shift != null)
        {
            dataShiftId = "data-shiftid=" + workingCalendarModel.Shift.Id;
            valueOfInput = workingCalendarModel.Shift.Code;
        }
        else
        {
            valueOfInput = "Off";
        }

        if (workingCalendarModel.IsKeepInViewDay)
        {
            isShowCheckBox = false;
            classOfInput = "offday keepinviewday";
            disabledAttribute = "disabled";
        }
        else
        {
            classOfInput = "shift offday";
        }
    }
    else if (workingCalendarModel.IsKeepInViewDay)
    {
        classOfInput = "shift keepinviewday";
        valueOfInput = "KIV";
    }
    else if (workingCalendarModel.IsChangeShift)
    {
        classOfInput = "changeshift";
        valueOfInput = workingCalendarModel.Shift.Code;
        disabledAttribute = "disabled";
        isShowCheckBox = false;
    }
    else if (workingCalendarModel.Shift != null)
    {
        classOfInput = "shift";
        valueOfInput = workingCalendarModel.Shift.Code;
        dataShiftId = "data-shiftid=" + workingCalendarModel.Shift.Id;
    }
    else
    {
        classOfInput = "shift";
    }

    if (workingCalendarModel.IsOvertime)
    {
        disabledAttribute = "disabled";
        isShowCheckBox = false;
    }

    if (workingCalendarModel.LeaveType != null && workingCalendarModel.LeaveType2 == null)
    {
        switch (workingCalendarModel.LeaveType.Id)
        {
            case Constants.AnnualLeave:
                classOfleavetype = "annualleave";
                break;
            case Constants.UnpaidLeave:
                classOfleavetype = "unpaidleave";
                break;
            case Constants.BusinessTrip:
                classOfleavetype = "businesstrip";
                break;
            case Constants.WeddingLeave:
                classOfleavetype = "weddingleave";
                break;
        }
    }

    classOfInput += " tooltip";
    if (!string.IsNullOrWhiteSpace(classOfleavetype))
    {
        classOfInput += " " + classOfleavetype;
    }

    if (!isSARole && workingCalendarModel.WorkDate.Date <= DateTime.Now.Date.AddDays(-28))
    {
        isShowCheckBox = false;
        disabledAttribute = "disabled";
    }

    if (!hasPermission)
    {
        disabledAttribute = "disabled";
    }

    <td class="shiftdate">
        <input type="text" class="@classOfInput" value="@HttpUtility.HtmlDecode(valueOfInput)" 
               data-date="@workingCalendarModel.WorkDate.ToDateMonthYearFormatedDate()" @dataShiftId @disabledAttribute />
    </td>
    if (hasPermission)
    {
        <td class="noneborderleft">
            @if (isShowCheckBox)
            {
                <input type="checkbox" class="@classOfCheckbox" />
            }
            else if (isShowAddShiftInLeaveHalfday)
            {
                <a class="lnkAddShift tooltip" title="@shiftCodeForHalfday" href="javascript:;">+</a>
            }
        </td>
    }
}

@Html.Hidden("PreviousFromDate", Model.FromDate.AddDays(-7).ToDateMonthYearFormatedDate())
@Html.Hidden("PreviousToDate", Model.ToDate.AddDays(-7).ToDateMonthYearFormatedDate())
@Html.Hidden("CurrentFromDate", Model.FromDate.ToDateMonthYearFormatedDate())
@Html.Hidden("CurrentToDate", Model.ToDate.ToDateMonthYearFormatedDate())
@Html.Hidden("NextFromDate", Model.FromDate.AddDays(7).ToDateMonthYearFormatedDate())
@Html.Hidden("NextToDate", Model.ToDate.AddDays(7).ToDateMonthYearFormatedDate())

<div class="summary">
    <br />
    <span class="success">Saved successfully!</span>
    <span class="validation-summary-errors">Saved not successfully!</span>
</div>
<br />
<table id="tblScheduleArrange" class="table table-custom persist-area">
    <thead class="persist-header">
        <tr>
            <th colspan="21">
                <div style="float:left;">
                    @if (hasPermission)
                    {
                        <a class="lnkSave" href="javascript:;" title="Save all"><img src="../../Images/icon-save.png" /></a><span>  &nbsp; ||</span>
                        <a class="lnkCheckAll" href="javascript:;"> Check all </a><span>  &nbsp; ||</span>
                        <a class="lnkUnCheckAll" href="javascript:;"> Uncheck all </a><span>  &nbsp; ||</span>
                        <a class="lnkOffAndNoShift" href="javascript:;"> Off No Shift </a><span>  &nbsp; ||</span>
                        <a class="lnkOffday" href="javascript:;"> Offday OT</a><span>  &nbsp; ||</span>
                        <a class="lnkUnOffday" href="javascript:;"> Workday </a>
                    }
                </div>
                <div style="float:right;">
                    <a class="lnkPrevious" href="javascript:;"> << Previous </a> ||
                    <span class="chooseweek"> Week: @Model.FromDate.ToDateMonthYearFormatedDate() - @Model.ToDate.ToDateMonthYearFormatedDate() </span>
                    || <a class="lnkNext" href="javascript:;"> Next >> </a>
                </div>
            </th>
        </tr>
        <tr>
            @if (hasPermission)
            {
                <th></th>
            }
            <th><a href="javascript:;" class="lnkDepartment">Dept.</a></th>
            @if (hasPermission)
            {
                <th><a href="javascript:;" class="lnkSort">@Labels.Nick</a></th>
                <th><a href="javascript:;" class="lnkmultiple">@Labels.ShiftMultiple</a></th>
            }
            else
            {
                <th>@Labels.Nick</th>
                <th>@Labels.ShiftMultiple</th>
            }
            <th class="nopaddingright">
                @Model.FromDate.ToDateOfWeek()
            </th>
            @if (hasPermission)
            {
                <th class="noneborderleft">
                    @Html.CheckBox("chkAllMonday", new { @class = "chkAllMonday" })
                </th>
                <th class="nopaddingright">
                    @Model.FromDate.AddDays(1).ToDateOfWeek()
                </th>
                <th class="noneborderleft">
                    @Html.CheckBox("chkAllTuesday", new { @class = "chkAllTuesday" })
                </th>
                <th class="nopaddingright">
                    @Model.FromDate.AddDays(2).ToDateOfWeek()
                </th>
                <th class="noneborderleft">
                    @Html.CheckBox("chkAllWednesday", new { @class = "chkAllWednesday" })
                </th>
                <th class="nopaddingright">
                    @Model.FromDate.AddDays(3).ToDateOfWeek()
                </th>
                <th class="noneborderleft">
                    @Html.CheckBox("chkAllThursday", new { @class = "chkAllThursday" })
                </th>
                <th class="nopaddingright">
                    @Model.FromDate.AddDays(4).ToDateOfWeek()
                </th>
                <th class="noneborderleft">
                    @Html.CheckBox("chkAllFriday", new { @class = "chkAllFriday" })
                </th>
                <th class="nopaddingright">
                    @Model.FromDate.AddDays(5).ToDateOfWeek()
                </th>
                <th class="noneborderleft">
                    @Html.CheckBox("chkAllSaturday", new { @class = "chkAllSaturday" })
                </th>
                <th class="nopaddingright">
                    @Model.FromDate.AddDays(6).ToDateOfWeek()
                </th>
                <th class="noneborderleft">
                    @Html.CheckBox("chkAllSunday", new { @class = "chkAllSunday" })
                </th>
                <th>
                    <a href="javascript:;" class="lnkPublicAll">@Labels.Public</a>
                </th>
                <th></th>
            }
            else
            {
                for (var index = 1; index < 7; index++)
                {
                    <th>
                        @Model.FromDate.AddDays(index).ToDateOfWeek()
                    </th>
                }
            }
            <th>@Labels.ModifiedBy</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.ScheduleArranges.Any())
        {
            foreach (ScheduleArrangeViewModel scheduleModel in Model.ScheduleArranges)
            {
                var isPublic = scheduleModel.MondaySchedule.IsPublic ? "checked" : string.Empty;
                <tr>
                    @if (hasPermission)
                    {
                        <td>
                            <a class="lnkremove" href="javascript:;"></a>
                        </td>
                    }
                    <td class="tooltip" title="@scheduleModel.TeamName">@scheduleModel.TeamCode</td>
                    <td class="tdemployee" data-employeeid="@scheduleModel.EmployeeId">
                        <a href="/employee/detail/@scheduleModel.EmployeeId" class="tooltip" title="@scheduleModel.NickName">@scheduleModel.NickName</a>
                    </td>
                    <td>
                        <input type="text" class="shift multipleShift"
                               @(!hasPermission ? "disabled" : string.Empty)
                               value="@scheduleModel.MondaySchedule.ShiftMultipleCode"
                               data-numberoffbyweek="@scheduleModel.MondaySchedule.OffDaysbyWeek"
                               data-shiftid="@scheduleModel.MondaySchedule.ShiftMultipleID"
                               data-date="@scheduleModel.MondaySchedule.WorkDate.ToDateMonthYearFormatedDate()" />
                        @if (hasPermission)
                        {
                            <a class="copyrow" href="javascript:;"> >> </a>
                        }
                    </td>

                    @RenderShiftInput(scheduleModel.MondaySchedule, "chkMonday multiple", isSARole, hasPermission)
                    @RenderShiftInput(scheduleModel.TuesdaySchedule, "chkTuesday multiple", isSARole, hasPermission)
                    @RenderShiftInput(scheduleModel.WednesdaySchedule, "chkWednesday multiple", isSARole, hasPermission)
                    @RenderShiftInput(scheduleModel.ThursdaySchedule, "chkThursday multiple", isSARole, hasPermission)
                    @RenderShiftInput(scheduleModel.FridaySchedule, "chkFriday multiple", isSARole, hasPermission)
                    @RenderShiftInput(scheduleModel.SaturdaySchedule, "chkSaturday multiple", isSARole, hasPermission)
                    @RenderShiftInput(scheduleModel.SundaySchedule, "chkSunday multiple", isSARole, hasPermission)
                    @if (hasPermission)
                    {
                        <td>
                            <input class="chkIsPublic" @isPublic type="checkbox" />
                        </td>
                        <td>
                            <a class="lnkSaveRow" href="javascript:;"><img src="../../Images/icon-save.png" /></a>
                        </td>
                    }
                    @if (string.IsNullOrWhiteSpace(scheduleModel.MondaySchedule.ModifierName))
                    {
                        <td></td>
                    }
                    else
                    {
                        <td class="tooltip" title="@scheduleModel.MondaySchedule.ModifiedDate.ToShortFormatedDate()">@scheduleModel.MondaySchedule.ModifierName</td>
                    }
                </tr>
            }
        }
    </tbody>
</table>
<br />
<hr />
<div class="container_24" id="colordef">
    <div class="grid_2 holiday tooltip" title="Public Holiday">
        PH
    </div>
    <div class="grid_2 offday tooltip" title="Off Day">
        OFF
    </div>
    <div class="grid_2 leaveday annualleave tooltip alpha" title="Annual Leave">
        AL
    </div>
    <div class="grid_2 leaveday unpaidleave tooltip alpha" title="Unpaid Leave">
        UPL
    </div>
    <div class="grid_2 leaveday businesstrip tooltip" title="Business Trip">
        BT
    </div>
    <div class="grid_2 leaveday weddingleave tooltip" title="Wedding Leave">
        WL
    </div>
    <div class="grid_2 leaveday leavehalfday2 tooltip" title="2 Leave half day">
        H/H
    </div>
    <div class="grid_2 changeshift tooltip" title="Change Shift">
        CS
    </div>
</div>

<div id="dialog-multiple" title="Shift multiple" style="display:none;">
    <form>
        <fieldset>
            <label for="name">Shift</label>
            <input type="text" id="shiftmulti" class="shift" />
            <input type="checkbox" id="chkIsShiftInOffday" />
            <label for="chkIsShiftInOffday">Is Offday</label>
        </fieldset>
    </form>
</div>
<div id="dialog-halfday" title="Add Shift" style="display:none;">
    <form>
        <fieldset>
            <label for="name">Shift</label>
            <input type="text" id="shifthalfday" class="shift" />
        </fieldset>
    </form>
</div>
<div id="dialogSortcontent" />

