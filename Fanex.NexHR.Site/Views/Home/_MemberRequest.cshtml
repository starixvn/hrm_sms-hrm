@using Fanex.NexHR.Core
@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Models.Dashboard
@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels.Request
@model IEnumerable<MemberRequest>
@{ 
    var today = DateTime.Now;
}
@if (Model.Any())
{
    IEnumerable<MemberRequest> verifiers = Model.Where(x => x.RoleId == (ushort)RoleSystem.Verifier);
    IEnumerable<MemberRequest> approvers = Model.Where(x => x.RoleId == (ushort)RoleSystem.Approver);
    <h2 class="section page-title">My members' requests</h2>
    if (verifiers.Any())
    {
        <h4>
            Verification List
        </h4>
        <table class="table table-custom">
            <thead>
                <tr>
                    <th rowspan="2" class="align-left">@Labels.Request</th>
                    <th rowspan="2">@Labels.Pending</th>
                    <th colspan="3" class="center">
                        @DateTime.Now.AddDays(-7).Day - @DateTime.Now.ToDateMonthYearFormatedDate()
                    </th>
                </tr>
                <tr>
                    <th>@Labels.Verified</th>
                    <th>@Labels.NotVerified</th>
                </tr>
            </thead>
            <tbody>
                @foreach (MemberRequest item in verifiers)
                {
                    var requestModel = new RequestViewModel
                    {
                        DateOption = 0,
                        FromDate = item.FromDate.HasValue ? item.FromDate.Value : today.AddMonths(-4).Date,
                        ToDate = item.ToDate.HasValue ? item.ToDate.Value : today,
                        RequestType = item.RequestFilterTypeId,
                        StatusId = (byte)CurrentRequestStatus.Pending,
                        TeamIds = string.Empty,
                        ViewType = RequestViewType.PersonalSpace
                    };
                    <tr>
                        <td class="align-left">@item.RequestType</td>
                        <td>
                            @if (item.TotalPending > 0)
                            {
                                if (item.RequestTypeId == (ushort)RequestType.Overtime)
                                {
                                    @Html.ActionLink(item.TotalPending.ToString(), "memberovertime", "overtime", new { }, new { @class = "pending" })
                                }
                                else
                                {
                                    <a href="@Url.Action("member", "request", requestModel)" class="pending">@item.TotalPending.ToString()</a>
                                }
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                        <td>@RazorHelper.DisplayZeroCell(item.TotalApproved)</td>
                        <td>@RazorHelper.DisplayZeroCell(item.TotalRejected)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    if (approvers.Any())
    {
        <h4>
            Approval List
        </h4>
        <table class="table table-custom">
            <thead>
                <tr>
                    <th rowspan="2" class="align-left">@Labels.Request</th>
                    <th rowspan="2">@Labels.Pending</th>
                    <th colspan="3" class="center">
                        @DateTime.Now.AddDays(-7).Day - @DateTime.Now.ToDateMonthYearFormatedDate()
                    </th>
                </tr>
                <tr>
                    <th>@Labels.Approved</th>
                    <th>@Labels.Rejected</th>
                </tr>
            </thead>
            <tbody>
                @foreach (MemberRequest item in approvers)
                {
                    var requestModel = new RequestViewModel
                    {
                        DateOption = 0,
                        FromDate = item.FromDate.HasValue ? item.FromDate.Value : today.AddMonths(-4).Date,
                        ToDate = item.ToDate.HasValue ? item.ToDate.Value : today,
                        RequestType = item.RequestFilterTypeId,
                        StatusId = -1,
                        TeamIds = string.Empty,
                        ViewType = RequestViewType.PersonalSpace
                    };
                    <tr>
                        <td class="align-left">@item.RequestType</td>
                        <td>
                            @if (item.TotalPending > 0)
                            {
                                if (item.RequestTypeId == (ushort)RequestType.Overtime)
                                {
                                    @Html.ActionLink(item.TotalPending.ToString(), "memberovertime", "overtime", new { }, new { @class = "pending" })
                                }
                                else
                                {
                                    <a href="@Url.Action("member", "request", requestModel)" class="pending">@item.TotalPending.ToString()</a>
                                }
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                        <td>@RazorHelper.DisplayZeroCell(item.TotalApproved)</td>
                        <td>@RazorHelper.DisplayZeroCell(item.TotalRejected)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}
