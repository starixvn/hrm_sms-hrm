@using Fanex.NexHR.Models.Dashboard
@model MySpaceModel
@{
    Layout = "~/Views/Shared/_NewLayout.cshtml";
    ViewBag.Title = Labels.Dashboard;
    var isResetPassword = (bool)ViewBag.IsResetPassword;
}
@section css{
    <link href="~/wwwroot/dist/styles/home.index.css" rel="stylesheet" />
}
@section js{
    <script src="~/wwwroot/dist/js/home.index.js"></script>
}
@section Breadcrumb {
    <a class="step">@Labels.Personal</a> <span class="step">@ViewBag.Title</span>
}
<h2 class="page-title">@Labels.MySpace</h2>

<table class="table table-custom">
    <thead>
        <tr>
            <th class="align-left">@Labels.Request</th>
            <th>@DateTime.Now.ToString("MMM yyyy")</th>
            <th>@Labels.Pending</th>
            <th>@Labels.CreateRequest</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td class="align-left">
                @Labels.CheckInOut
            </td>
            <td>
                @RazorHelper.DisplayZeroCell(Model.TotalCheckInOutRequest)
            </td>
            <td>
                @if (Model.TotalPendingCheckInOutRequest > 0)
                {
                    @Html.ActionLink(Model.TotalPendingCheckInOutRequest.ToString(), "employeeView", "checkinout")
                }
                else
                {
                    <span>-</span>
                }
            </td>
            <td>
                @Html.ActionLink(Labels.Request, "create", "checkinout")
            </td>
        </tr>
        <tr>
            <td class="align-left">
                @Labels.LateInEarlyOut
            </td>
            <td>
                @RazorHelper.DisplayZeroCell(Model.TotalLateInEarlyOutRequest)
            </td>
            <td>
                @RazorHelper.DisplayZeroCell(Model.TotalPendingLateInEarlyOutRequest)
            </td>
            <td>
                @Html.ActionLink(Labels.Request, "create", "lateinearlyout")
            </td>
        </tr>
        <tr>
            <td class="align-left">
                @Labels.ChangeShift
            </td>
            <td>
                @RazorHelper.DisplayZeroCell(Model.TotalChangedShiftRequest)
            </td>
            <td>
                @if (Model.TotalPendingChangedShiftRequest > 0)
                {
                    @Html.ActionLink(Model.TotalPendingChangedShiftRequest.ToString(), "employeeView", "changeshift")
                }
                else
                {
                    <span>-</span>
                }
            </td>
            <td>
                @Html.ActionLink(Labels.Request, "create", "changeshift")
            </td>
        </tr>
        <tr>
            <td class="align-left">
                @Labels.Leave
            </td>
            <td>
                @RazorHelper.DisplayZeroCell(Model.TotalLeaveRequest)
            </td>
            <td>
                @if (Model.TotalPendingLeaveRequest > 0)
                {
                    @Html.ActionLink(Model.TotalPendingLeaveRequest.ToString(), "employeeView", "leave")
                }
                else
                {
                    <span>-</span>
                }
            </td>
            <td>
                @Html.ActionLink(Labels.Request, "create", "leave")
            </td>
        </tr>
        <tr>
            <td class="align-left">
                @Labels.KeepInView
            </td>
            <td>
                @RazorHelper.DisplayZeroCell(Model.TotalKivRequest)
            </td>
            <td>
                @if (Model.TotalPendingKivRequest > 0)
                {
                    @Html.ActionLink(Model.TotalPendingKivRequest.ToString(), "employeeView", "KeepInView")
                }
                else
                {
                    <span>-</span>
                }
            </td>
            <td>
                @Html.ActionLink(Labels.Request, "create", "KeepInView")
            </td>
        </tr>
        <tr>
            <td class="align-left">
                @Labels.Overtime
            </td>
            <td>-</td>
            <td>
                @if (Model.TotalPendingOverTimeRequest > 0)
                {
                    @Html.ActionLink(Model.TotalPendingOverTimeRequest.ToString(), "employeeView", "overtime")
                }
                else
                {
                    <span>-</span>
                }
            </td>
            <td>
                @Html.ActionLink(Labels.Request, "employeeView", "overtime")
            </td>
        </tr>
    </tbody>
</table>
@if ((bool)ViewBag.IsVerifierApprover)
{
    @Html.Action("MemberRequest")
}
<input type="checkbox" class="hidden" id="IsResetPassword" @(isResetPassword ? "checked" : string.Empty) />
<div id="changePasswordModal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog-centered modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title">SMS HRM</h4>
            </div>
            <div class="modal-body">
                <p>
                    <strong>
                        The password for your account has been recently reset.
                        For security reasons please change it now.
                    </strong>
                </p>
                <div class="checkbox">
                    <input type="checkbox" class="checkbox-custom" id="ckb-dontshowagain" />
                    <label for="ckb-dontshowagain"> Don't show me this again</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" id="btnSubmit" class="btn btn-primary">OK</button>
                <button type="button" id="btnCancel" class="btn btn-default">Cancel</button>
            </div>
        </div>
    </div>
</div>