@model OvertimeDetailReportViewModel
@{
    ViewBag.Title = "Overtime Report Details";
}
@section css{
    @Url.CombresLink("overtimereportcss")
}
@section js{
    @Url.CombresLink("overtimereportdetailsjs")
}
@section Breadcrumb {
    <a class="step">HR</a>
    <a class="step" href="@Url.Action("index", "report")">@Labels.Reports</a>
    <a class="step">@ViewBag.Title</a>
}
<h2>@ViewBag.Title</h2>
<form class="form-filter">
    @Html.HiddenFor(model => model.EmployeeId)
    @Html.HiddenFor(model => model.SectionIds)
    @Html.HiddenFor(model => model.IsLocal)
    @Html.HiddenFor(model => model.JobTitleIds)
    <div class="container_24 bunhat">
        <div class="grid_24">
            <div class="grid_2 gridlabel">@Labels.Employee</div>
            <div class="grid_6">
                @Html.TextBox("Employee", "", new { placeholder = Messages.SearchEmployeeWatermark })
            </div>
            <div class="grid_2 gridlabel">@Labels.Section</div>
            <div class="grid_6">
                <select id="section" multiple="multiple" class="team-select">
                    @foreach (Team item in Model.Sections)
                    {
                        <option value="@item.Id">@item.Name</option>
                    }
                </select>
            </div>
            <div class="grid_2 gridlabel">@Labels.JobTitle</div>
            <div class="grid_5">
                @Html.DropDownList("title", Model.JobTitles, new { @class = "title-select", multiple = "multiple" })
            </div>
            <div class="clear"></div>
            <div class="space"></div>
            <div class="clear"></div>
            <div class="space"></div>
            <div class="grid_2 gridlabel">@Labels.Category</div>
            <div class="grid_6">
                @RazorHelper.CategoryDropDownList("category", "category", "")
            </div>
            <div class="grid_2 gridlabel">@Labels.FromDate</div>
            <div class="grid_6">
                @Html.DatePicker("fromDate", Model.FromDate)
            </div>
            <div class="grid_2 gridlabel">@Labels.ToDate</div>
            <div class="grid_4">
                @Html.DatePicker("toDate", Model.ToDate)
            </div>
            <div class="clear"></div>
            <div class="space"></div>
            <div class="clear"></div>
            <div class="space"></div>
            <div class="grid_2 gridlabel">&nbsp;</div>
            <div class="grid_6">
                <input type="button" value="Submit" id="btnSubmit" />
                <input type="button" id="btnExcel" value="Excel" />
            </div>
        </div>
    </div>
</form>
<div id="OTExcelReportDetails"></div>
