@using Fanex.NexHR.Models.Request
@model IList<RequestEntity>
@{
    Layout = null;
    var hasVerfifyPermision = (bool)ViewBag.HasVerfifyPermision;
    var hasApprovePermision = (bool)ViewBag.HasApprovePermision;
}
<table class="tabledata">
        <thead>
            <tr class="headermenu">
                <th colspan="11">
                    <div style="float:right;">
                    @if (hasApprovePermision && hasVerfifyPermision)
                    {
                         <div>
                            <a id="lnkAccept" href="javascript:;"> Verify </a> || 
                            <a id="lnkNotAccept" href="javascript:;"> Not verify </a> || 
                            <a id="lnkApprove" href="javascript:;"> @Labels.Approve </a> ||
                            <a id="lnkReject" href="javascript:;"> @Labels.Reject </a>
                        </div>
                    }
                    else if (hasVerfifyPermision)
                    {
                        <div>
                            <a id="lnkAccept" href="javascript:;"> @Labels.Accept </a> || 
                            <a id="lnkNotAccept" href="javascript:;"> @Labels.NotAccept </a>
                        </div>
                    }
                    else if (hasApprovePermision)
                    {
                        <div>
                            <a id="lnkApprove" href="javascript:;"> @Labels.Approve </a> ||
                            <a id="lnkReject" href="javascript:;"> @Labels.Reject </a>
                        </div>
                    }
                     
                </div>
                </th>
            </tr>
            <tr>
                <th>
                    <input id="chkAll" type="checkbox" />
                </th>
                <th>@Labels.FullName
                </th>
                <th>@Labels.Nick
                </th>
                <th>
                    @Labels.Team
                </th>
                <th>@Labels.NormalDay
                </th>
                <th>@Labels.OffDay
                </th>
                <th>@Labels.PublicHoliday
                </th>
                <th>@Labels.Details
                </th>
                <th>
                    @Labels.Verifier
                </th>
                <th>
                    @Labels.Approver
                </th>
                <th>
                </th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                foreach (RequestEntity item in Model)
                {
                <tr>
                    <td>
                        <input type="checkbox" class="chkSelect" data-requestId = "@item.Id" />
                    </td>
                    <td class="left">
                        @item.Requester.FullName
                    </td>
                    <td>
                        @item.Requester.NickName
                    </td>
                    <td class="tooltip" title="@item.Requester.Team.Name">
                        @item.Requester.Team.Code
                    </td>
                    <td>
                    @if (item.NormalHours > 0)
                    {
                        <span class="sumnormal">@item.NormalHours</span>
                    }
                    </td>
                    <td>
                    @if (item.OffHours > 0)
                    {
                        <span class="sumoff">@item.OffHours</span>
                    }
                    </td>
                    <td>
                    @if (item.PublicHours > 0)
                    {
                        <span class="sumpublic">@item.PublicHours</span>
                    }
                    </td>
                    <td>
                        <a href="@Url.Action("MemberDailyOvertime", "Overtime", new { requestId = item.Id, isHRView = false })">
                            @Labels.View </a>
                    </td>

                    @Html.Partial("SharedVerifierStatus", item)
                    @Html.Partial("SharedApproverStatus", item)

                    <td>
                        @if (item.IsShowWarning)
                        { 
                            <a href="@Url.Action("MemberDailyOvertime", "Overtime", new { requestId = item.Id, isHRView = false })">
                                <img src="../../Images/warning.png" width="16px;" height="16px;"/>
                            </a>
                        }
                    </td>
                </tr>
                }
            }
            else
            { 
                @RazorHelper.DisplayNoInformation(colspan: 12);
            }
        </tbody>
        <tfoot>
            <tr class="sum">
                <td colspan="1" class="sumhours">@Labels.TotalOvertimeHours:
                </td>
                <td colspan="1">
                </td>
                <td colspan="1">
                </td>
                <td colspan="1">
                </td>
                <td colspan="1" id="sumnormal">
                </td>
                <td colspan="1" id="sumoff">
                </td>
                <td colspan="1" id="sumpublic">
                </td>
                <td colspan="1">
                </td>
                <td colspan="1">
                </td>
                <td colspan="1">
                </td>
                <td colspan="1">
                </td>
            </tr>
        </tfoot>

    </table>
@RazorHelper.VerifierAndApproverOvertimeMenu()

@Url.CombresLink("monthlyovertimememberdetailjs")