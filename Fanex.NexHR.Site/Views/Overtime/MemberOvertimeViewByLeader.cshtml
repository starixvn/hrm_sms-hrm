@model IList<OvertimeRequest>
    @{
        Layout = null;
        var hasVerfifyPermision = (bool)ViewBag.HasVerfifyPermision;
        var hasApprovePermision = (bool)ViewBag.HasApprovePermision;
    }
    <table class="table table-custom">
        <thead>
            <tr>
                <th colspan="12">
                    <div style="float:right;">
                        @if (hasApprovePermision && hasVerfifyPermision)
                        {
                            <div>
                                <input type="button" id="lnkAccept" value="Verify" />
                                <input type="button" id="lnkNotAccept" value="Not Verify">
                                <input type="button" id="lnkApprove" value="@Labels.Approve" />
                                <input type="button" id="lnkReject" value="@Labels.Reject" />
                            </div>
                        }
                        else if (hasVerfifyPermision)
                        {
                            <div>
                                <input id="lnkAccept" value="Verify" />
                                <input id="lnkNotAccept" vocab="Not verify" />
                            </div>
                        }
                        else if (hasApprovePermision)
                        {
                            <div>
                                <input id="lnkApprove" value="@Labels.Approve">
                                <input id="lnkReject" vocab="@Labels.Reject" />
                            </div>
                        }
                    </div>
                </th>
            </tr>
            <tr>
                <th>
                    <input id="chkAll" type="checkbox" />
                </th>
                <th>@Labels.FullName</th>
                <th>@Labels.Nick</th>
                <th>@Labels.Team</th>
                <th>@Labels.Month</th>
                <th>@Labels.NormalDay</th>
                <th>@Labels.OffDay</th>
                <th>@Labels.PublicHoliday</th>
                <th>@Labels.Details</th>
                <th>@Labels.Verifier</th>
                <th>@Labels.Approver</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                foreach (OvertimeRequest item in Model)
                {
                    <tr>
                        <td>
                            <input type="checkbox" class="chkSelect" data-requestid="@item.RequestId" />
                        </td>
                        <td class="align-left">
                            @item.Employee.FullName
                        </td>
                        <td>
                            @item.Employee.NickName
                        </td>
                        <td class="tooltip" title="@item.Employee.Team.Name">
                            @item.Employee.Team.Code
                        </td>
                        <td>
                            @item.RequestedDate.ToString("MM-yyyy")
                        </td>
                        <td>
                            @if (item.NormalHours > 0)
                            {
                                <span class="sumnormal">@item.NormalHours</span>
                            }
                        </td>
                        <td>
                            @if (item.OffHours > 0)
                            {
                                <span class="sumoff">@item.OffHours</span>
                            }
                        </td>
                        <td>
                            @if (item.PublicHours > 0)
                            {
                                <span class="sumpublic">@item.PublicHours</span>
                            }
                        </td>
                        <td>
                            <a href="@Url.Action("MemberDailyOvertime", "Overtime", new { requestId = item.RequestId, isHRView = false })">
                                @Labels.View
                            </a>
                        </td>
                        <td>
                            <span class="tooltip-tipsy" original-title="@item.VerifiedBy.FullName">@item.VerifiedBy.NickName</span>
                            @if (item.VerifiedStatus == 2)
                            {
                                <i class="fa fa-check-circle green-checked-icon"></i>
                            }
                        </td>
                        <td>
                            <span class="tooltip-tipsy" original-title="@item.ApprovedBy.FullName">@item.ApprovedBy.NickName</span>
                            @if (item.ApprovedStatus == 2)
                            {
                                <i class="fa fa-check-circle green-checked-icon"></i>
                            }
                        </td>
                        @*@Html.Partial("SharedVerifierStatus", item)
                            @Html.Partial("SharedApproverStatus", item)*@
                        <td>
                            @if (item.IsShowWarning)
                            {
                                <a href="@Url.Action("MemberDailyOvertime", "Overtime", new { requestId = item.RequestId, isHRView = false })">
                                    <img src="../../Images/warning.png" width="16" height="16" />
                                </a>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                @RazorHelper.DisplayNoInformation(colspan: 12);
            }
        </tbody>
        <tfoot>
            <tr class="summary">
                <td class="sumhours align-right">
                    @Labels.TotalOvertimeHours:
                </td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td id="sumnormal"></td>
                <td id="sumoff"></td>
                <td id="sumpublic"></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
            </tr>
        </tfoot>
    </table>
    @RazorHelper.VerifierAndApproverOvertimeMenu()

    @Url.CombresLink("monthlyovertimememberdetailjs")