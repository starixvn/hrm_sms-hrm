@model IList<OvertimeDaily>
<table class="table table-custom" id="data">
    <thead>
        <tr>
            <th>@Labels.Date</th>
            <th>@Labels.Code</th>
            <th>@Labels.Employee</th>
            <th>@Labels.Shift</th>
            <th>@Labels.TimeIn</th>
            <th>@Labels.TimeOut</th>
            <th>@Labels.TotalHours</th>
            <th>@Labels.NormalDay</th>
            <th>@Labels.OffDay</th>
            <th>@Labels.PublicHoliday</th>
            <th>@Labels.Remark</th>
            <th>@Labels.Status</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (OvertimeDaily item in Model)
            {
                <tr>
                    <td>
                        @item.OvertimeDate.ToDateMonthYearFormatedDate()
                    </td>
                    <td>@item.Code</td>
                    <td class="align-left">
                        @item.FullName (@item.NickName)
                    </td>
                    <td>@item.Schedule</td>
                    <td>@item.TimeIn</td>
                    <td>@item.TimeOut</td>
                    <td>
                        @if (item.TotalWorkHours > 0)
                        {
                            <span>@item.TotalWorkHours</span>
                        }
                    </td>
                    <td>
                        @if (item.NormalHours > 0)
                        {
                            <span>@item.NormalHours</span>
                        }
                    </td>
                    <td>
                        @if (item.OffHours > 0)
                        {
                            <span>@item.OffHours</span>
                        }
                    </td>
                    <td>
                        @if (item.PublicHours > 0)
                        {
                            <span>@item.PublicHours</span>
                        }
                    </td>
                    <td class="align-left">@item.Remark</td>
                    <td>
                        @if (item.Status != 0)
                        {
                            CurrentRequestStatus status = (CurrentRequestStatus)item.Status;
                            <span>@status</span>
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            @RazorHelper.DisplayNoInformation(colspan: 12)
        }
    </tbody>
</table>
