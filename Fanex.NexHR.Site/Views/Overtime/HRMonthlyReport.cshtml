@{
    ViewBag.Title = Labels.OvertimeReport;
}
@section css{
    @Url.CombresLink("overtimereportcss")
}
@section js{
    @Url.CombresLink("monthlyovertimehrreportjs")
}
@section Breadcrumb {
    <a class="step">HR Space</a> <a class="step" href="@Url.Action("yearlyreport", "overtime")">@Labels.OvertimeReport</a>
    <a class="step">@ViewBag.Title Summary in @ViewBag.Date</a>
}
@using (Html.BeginForm())
{
    <h2>
        Overtime Report in @ViewBag.Date</h2>
    
    <div class="container_24 bunhat">
        <div class="grid_24">
            <div class="grid_2 gridlabel">
                Calendar:
            </div>
            <div class="grid_3">
                @{
    var calendarType = new List<SelectListItem>
                    {
                        new SelectListItem() {Text = "Fiscal", Value = "1"}, 
                        new SelectListItem() {Text = "Normal", Value = "0"},
                    };
                }
                @Html.DropDownList("calendar", calendarType)
            </div>
            <div id="displayCalendar">
                <div class="grid_2 gridlabel">
                    From Date:
                </div>
                <div class="grid_4">
                    @Html.DatePicker("fromDate", (DateTime)ViewBag.FromDate, (DateTime)ViewBag.FromDate, (DateTime)ViewBag.ToDate)
                </div>
                <div class="grid_2 gridlabel">
                    To Date:
                </div>
                <div class="grid_4">
                    @Html.DatePicker("toDate", (DateTime)ViewBag.ToDate, (DateTime)ViewBag.FromDate, (DateTime)ViewBag.ToDate)
                </div>
            </div>
            <input type="button" value="@Labels.Submit" id="submitMonthlyReport"/>
            @*<input type="button" id="exportExcel" value="Excel"/>*@
            <input type="button" id="backPrevious" value="@Labels.Back"/>
        </div>
    </div>
    @Html.Hidden("FiscalDate", (string)ViewBag.Date);
    
    <div class="clear">
    </div>
    <div class="space">
    </div>
    <div class="clear">
    </div>
    
    <div id="HRMonthlyReportDetails">
    </div>
    
}
