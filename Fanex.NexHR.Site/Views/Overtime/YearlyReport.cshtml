@model YearlyOvertimeReportViewModel
@{
    ViewBag.Title = "Yearly Overtime Report";
}
@section css{
    @Url.CombresLink("overtimereportcss")
}
@section js{
    @Url.CombresLink("yearlyovertimereportjs")
}
@section Breadcrumb {
    <a class="step">HR Space</a>
    <a class="step" href="@Url.Action("index", "report")">@Labels.Reports</a>
    <a class="step">@ViewBag.Title</a>
}
<h2>@ViewBag.Title</h2>
<form class="form-filter">
    @Html.HiddenFor(model => model.EmployeeId)
    @Html.HiddenFor(model => model.SectionIds)
    <div class="container_24 bunhat">
        <div class="grid_24">
            <div class="grid_1 gridlabel">@Labels.Year:</div>
            <div class="grid_2">
                @Html.YearPicker("Year", 2010, Model.Year)
            </div>
            <div class="grid_2 gridlabel">Calendar</div>
            <div class="grid_3">
                @{
                    var calendarType = new List<SelectListItem>
                    {
                        new SelectListItem() {Text = "Fiscal", Value = "1"},
                        new SelectListItem() {Text = "Normal", Value = "0"},
                    };
                }
                @Html.DropDownList("Calendar", calendarType)
            </div>
            <div class="grid_2 gridlabel">@Labels.Section</div>
            <div class="grid_6">
                <select id="section" multiple="multiple" class="team-select">
                    @foreach (Team item in Model.Sections)
                    {
                        <option value="@item.Id">@item.Name</option>
                    }
                </select>
            </div>
            <div class="grid_2 gridlabel">@Labels.Employee</div>
            <div class="grid_4">
                @Html.TextBox("Employee", string.Empty, new { @placeholder = Messages.SearchEmployeeWatermark })
            </div>
            <div class="clear"></div>
            <div class="space"></div>
            <div class="clear"></div>
            <div class="grid_5 prefix_1">
                <input type="button" value="@Labels.Submit" id="btnSubmit" />
                <input type="button" id="btnExcel" value="Excel" />
            </div>
        </div>
    </div>
</form>
<div id="yearlyReportDetails">
</div>