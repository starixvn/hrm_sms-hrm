@using Fanex.NexHR.Resources;
@using Fanex.NexHR.Models.Overtime;
@using Fanex.NexHR.ViewModels.Overtime;
@using System.Configuration;

@model OvertimeReportViewModel
@{
    ViewBag.Title = Labels.MyOvertimeRequest;
}
@section css{
    @Url.CombresLink("myovertimecss")
}
@section js{
    @Url.CombresLink("myovertimerequestjs")
}
@section Breadcrumb {
    <a class="step">Personal</a> <a class="step">@ViewBag.Title</a>
}
@*<script type="text/javascript">
    $(document).ready(function () {
        initMonthPick('@ViewBag.MaxDate', '@ViewBag.CurrentDate');
    });
</script>*@
<h2>@ViewBag.Title</h2>
@using (Html.BeginForm())
{ 
@*    <input type="hidden" id="Year" name="Year" value="@ViewBag.Year" />
    <input type="hidden" id="Month" name="Month" value="@ViewBag.Month" />
    <input type="hidden" id="maxDate" value="@ViewBag.MaxDate" />*@
    
    <div class="grid_1 gridlabel">
        Year:
    </div>
    <div class="grid_4">
        @Html.YearPicker("Year", 2010, (int)ViewBag.Year)
    </div>
    
    <div class="grid_1 gridlabel">
        @Html.LabelFor(model => model.Employee)
    </div>
    <div class="grid_4">
        @Html.EditorFor(model => model.Employee)
        @Html.HiddenFor(model => model.EmpId)
    </div>

    <input type="submit" name="submit" value="@Labels.Submit" class="button-primary button"/>

    <div class="clear">
    </div>
    <div class="space">
    </div>
    <div class="clear">
    </div>
    
    
    <table class="data" id="data">
        <thead>
            <tr>
                <th>@Labels.Month
                </th>
                <th>@Labels.TotalHours
                </th>
                <th>@Labels.NormalDay
                </th>
                <th>@Labels.OffDay
                </th>
                <th>@Labels.PublicHoliday
                </th>
                <th>
                    @Labels.Details
                </th>
                <th>@Labels.Edit
                </th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                foreach (var request in Model.TotalRequest)
                {                   
                <tr id="row@(request.Id)">
                    <td>@request.RequestedDate.ToString("MMM-yyyy")
                    </td>
                    <td class="sumtotal">
                        @{
                    if (request.ToTalHours > 0)
                    {
                            <span>@request.ToTalHours</span>
                    }
                        }
                    </td>
                    <td class="sumnormal">
                        @{
                    if (request.NormalHours > 0)
                    {
                            <span>@request.NormalHours</span>
                    }
                        }
                    </td>
                    <td class="sumoff">
                        @{
                    if (request.OffHours > 0)
                    {
                            <span>@request.OffHours</span>
                    }
                        }
                    </td>
                    <td class="sumpublic">
                        @{
                    if (request.PublicHours > 0)
                    {
                            <span>@request.PublicHours</span>
                    }
                        }
                    </td>
                    <td>
                        <a href="@Url.Action("View", "Overtime", new { requestDate = request.RequestedDate, empId = request.Requester.Id })">
                            View </a>
                    </td>
                    <td>
                        @{
                    var currentDate = DateTime.Now.Date;
                    var requestDate = request.RequestedDate.Date;
                    var requestDatePreviousOneMonth = requestDate.AddMonths(-1).Date;
                    var canEditFrom = new DateTime();
                    if (requestDate.Month == 1)
                    {
                        canEditFrom = new DateTime(requestDatePreviousOneMonth.Year, requestDatePreviousOneMonth.Month, 10);
                    }
                    else
                    {
                        canEditFrom = new DateTime(requestDate.Year, requestDate.AddMonths(-1).Month, 10);
                    }
                    var OvertimeClaimDate = Convert.ToInt32(ConfigurationManager.AppSettings["OvertimeClaimDate"]);
                    var canEditTo = new DateTime(requestDate.Year, requestDate.Month, OvertimeClaimDate);
					
					//if (currentDate >= canEditFrom && currentDate <= canEditTo)
					if (request.Status == null || (int)(request.Status.Id) == 1)
					{
                            <a href="@Url.Action("Update", "Overtime", new { requestDate = request.RequestedDate, empId = request.Requester.Id })">
                                <img src="/Styles/Images/edit-icon.png"></a>
                    }
                    else
                    {
                            <span>-</span>
                    }
                        }
                    </td>
                </tr>
                }

            }
            else
            { 
                @RazorHelper.DisplayNoInformation(colspan: 12);
            }
        </tbody>
        <tfoot>
            <tr class="sum">
                <td colspan="1" class="sumhours">@Labels.TotalOvertimeHours:
                </td>
                <td colspan="1" id="sumtotal">
                </td>
                <td colspan="1" id="sumnormal">
                </td>
                <td colspan="1" id="sumoff">
                </td>
                <td colspan="1" id="sumpublic">
                </td>
                <td colspan="1">
                </td>
                <td colspan="1">
                </td>
            </tr>
        </tfoot>
    </table>
}
@RazorHelper.EmployeeProcessMenu()
