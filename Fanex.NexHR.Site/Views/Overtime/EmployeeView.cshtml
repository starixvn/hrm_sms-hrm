@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Models.Overtime
@using Fanex.NexHR.ViewModels.Overtime
@model EmployeeMonthlyOvertimeViewModel
@{
    Layout = "~/Views/Shared/_NewLayout.cshtml";
    ViewBag.Title = Labels.MyOvertimeRequest;
}
@section css{
    <link href="~/wwwroot/dist/styles/overtime.myrequest.css" rel="stylesheet" />
}
@section js{
    <script src="~/wwwroot/dist/js/overtime.myrequest.js"></script>
}
@section Breadcrumb {
    <a class="step">Personal</a> <a class="step">@ViewBag.Title</a>
}
<h2 class="page-title">@ViewBag.Title</h2>
@using (Html.BeginForm("EmployeeView", "overtime", FormMethod.Get, new { @class = "filter" }))
{
    <div class="form-horizontal clearfix">
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.Label(Labels.Year, new { @class = "control-label" })
            </div>
            <div class="select-form">
                @Html.YearPicker("Year", 2010, Model.Year)
            </div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.Label(Labels.Employee, new { @class = "control-label" })
            </div>
            <div class="input-form">
                @Html.TextBoxFor(model => model.Employee, new { placeholder = Messages.SearchEmployeeWatermark, @class = "form-control" })
                @Html.HiddenFor(model => model.EmployeeId)
            </div>
        </div>
        <div class="form-group form-group--m">
            <button class="btn btn-primary">@Labels.Search</button>
        </div>
    </div>
}
<table class="table table-custom" id="data">
    <thead>
        <tr>
            <th>@Labels.Month</th>
            <th>@Labels.TotalHours</th>
            <th>@Labels.NormalDay</th>
            <th>@Labels.OffDay</th>
            <th>@Labels.PublicHoliday</th>
            <th>@Labels.Verifier</th>
            <th>@Labels.VerifiedDate</th>
            <th>@Labels.Approver</th>
            <th>@Labels.ApprovedDate</th>
            <th>@Labels.Status</th>
            <th>@Labels.Details</th>
            <th>@Labels.Edit</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null)
        {
            foreach (MonthlyOvertimeRequest request in Model.OvertimeRequests)
            {
                <tr id="row@(request.RequestId)">
                    <td>
                        @request.Month.ToString("MMM-yyyy")
                    </td>
                    <td class="sumtotal">
                        @if (request.TotalHours > 0)
                        {
                            @request.TotalHours
                        }
                    </td>
                    <td class="sumnormal">
                        @if (request.NormalHours > 0)
                        {
                            @request.NormalHours
                        }
                    </td>
                    <td class="sumoff">
                        @if (request.OffHours > 0)
                        {
                            @request.OffHours
                        }
                    </td>
                    <td class="sumpublic">
                        @if (request.PublicHours > 0)
                        {
                            @request.PublicHours
                        }
                    </td>
                    <td>
                        @if (request.Verifier != null)
                        {
                            @request.Verifier.Nickname
                        }
                    </td>
                    <td>
                        @if (request.VerifiedDate.HasValue)
                        {
                            @request.VerifiedDate.Value.ToShortFormatedDate()
                        }
                    </td>
                    <td>
                        @if (request.Approver != null)
                        {
                            @request.Approver.Nickname
                        }
                    </td>
                    <td>
                        @if (request.ApprovedDate.HasValue)
                        {
                            @request.ApprovedDate.Value.ToShortFormatedDate()
                        }
                    </td>
                    <td>
                        <span>@request.Status</span>
                    </td>
                    <td>
                        <a href="@Url.Action("Details", "Overtime", new { employeeId = Model.EmployeeId, month = request.Month })">
                            View
                        </a>
                    </td>
                    <td>
                        @if (request.Status == null || request.Status.Id == (byte)CurrentRequestStatus.Pending)
                        {
                            <a href="@Url.Action("Edit", "Overtime", new { employeeId = Model.EmployeeId, month = request.Month })">
                                <i class="fa fa-pencil fa-lg icon-edit"></i>
                            </a>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                </tr>
            }

        }
        else
        {
            @RazorHelper.DisplayNoInformation(colspan: 12);
        }
    </tbody>
    <tfoot>
        <tr class="summary">
            <td class="sumhours align-right">
                @Labels.TotalOvertimeHours:
            </td>
            <td id="sumtotal"></td>
            <td id="sumnormal">@Model.OvertimeRequests.Sum(t => t.NormalHours).ToString("0.00")</td>
            <td id="sumoff">@Model.OvertimeRequests.Sum(t => t.OffHours).ToString("0.00")</td>
            <td id="sumpublic">@Model.OvertimeRequests.Sum(t => t.PublicHours).ToString("0.00")</td>
            <td colspan="7"></td>
        </tr>
    </tfoot>
</table>