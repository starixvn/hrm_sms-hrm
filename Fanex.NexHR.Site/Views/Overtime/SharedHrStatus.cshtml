@model OvertimeRequest
@{
    var request = (OvertimeRequest)Model;
    switch (request.CurrentStatus)
    {
        case (byte)CurrentRequestStatus.Approved:
            <td>
                <a roleid="@Convert.ToInt32(RoleSystem.HR)" requestid="@request.RequestId" href="javascript:void(0);" class="hr-pending menu">@Utilities.GetCurrentStatusName(request.CurrentStatus)</a>
            </td>
            break;
        case (byte)CurrentRequestStatus.Processed:
        <td>
            <a roleid="@Convert.ToInt32(RoleSystem.HR)" requestid="@request.RequestId" href="javascript:void(0);" class="hr-processed menu">@Utilities.GetCurrentStatusName(request.CurrentStatus)</a>
        </td>
            break;
        case (byte)CurrentRequestStatus.Void:
        <td>
            <a roleid="@Convert.ToInt32(RoleSystem.HR)" requestid="@request.RequestId" href="javascript:void(0);" class="hr-void menu">@Utilities.GetCurrentStatusName(request.CurrentStatus)</a>
        </td>
            break;

        case (byte)CurrentRequestStatus.Pending:
        case (byte)CurrentRequestStatus.Verified:
        case (byte)CurrentRequestStatus.NotVerified:
        default:
        <td class="tooltip"> <span class="status">@Utilities.GetCurrentStatusName(request.CurrentStatus)</span> </td>
            break;
    }
}