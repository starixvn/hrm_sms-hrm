@using Fanex.NexHR.Models.Request
@model RequestEntity

@{
    var request = (RequestEntity)Model;

    switch (request.Status.Id)
    {
        case (byte)CurrentRequestStatus.Approved:
            <td>
                <a roleid="@Convert.ToInt32(RoleSystem.HR)" requestid="@request.Id" href="javascript:void(0);" class="hr-pending menu">@request.Status.ToString()</a>
            </td>
            break;
        case (byte)CurrentRequestStatus.Processed:
            <td>
                <a roleid="@Convert.ToInt32(RoleSystem.HR)" requestid="@request.Id" href="javascript:void(0);" class="hr-processed menu">@request.Status.ToString()</a>
            </td>
            break;
        case (byte)CurrentRequestStatus.Void:
            <td>
                <a roleid="@Convert.ToInt32(RoleSystem.HR)" requestid="@request.Id" href="javascript:void(0);" class="hr-void menu">@request.Status.ToString()</a>
            </td>
            break;
                
        case (byte)CurrentRequestStatus.Pending:
        case (byte)CurrentRequestStatus.Verified:
        case (byte)CurrentRequestStatus.NotVerified:
        default:
            <td class="tooltip"> <span class="status">@request.Status.ToString()</span> </td>
                            break;
    }
}