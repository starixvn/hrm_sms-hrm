@using Fanex.NexHR.Models.Overtime
@using Fanex.NexHR.ViewModels.Overtime
@model MemberMonthlyOvertimeRequestViewModel
@{
    Layout = "~/Views/Shared/_NewLayout.cshtml";
    ViewBag.Title = "Members' overtime";
    HtmlHelper.ClientValidationEnabled = false;
}
@section css{
    <link href="~/wwwroot/dist/styles/overtime.member.index.css" rel="stylesheet" />
}
@section js{
    <script src="~/wwwroot/dist/js/overtime.member.index.js"></script>
}
@section Breadcrumb {
    <a class="step">Personal</a> <a class="step">@ViewBag.Title</a>
}

<h2 class="page-title">@ViewBag.Title</h2>
@Html.Hidden("MinDate", new DateTime(2010, 1, 1).ToDateMonthYearFormatedDate())
@Html.Hidden("MaxDate", DateTime.Now.AddYears(1).ToDateMonthYearFormatedDate())
<form class="filter">
    @Html.HiddenFor(model => model.SectionIds)
    @Html.HiddenFor(model => model.Month)
    <div class="form-horizontal clearfix">
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.Label(Labels.Month, new { @class = "control-label" })
            </div>
            <div class="select-form">
                <div id="MonthControl"></div>
            </div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.Label(Labels.Status, new { @class = "control-label" })
            </div>
            <div class="select-form">
                @RazorHelper.StatusDropDownList(Model.StatusId, controlName: "statusId", htmlClass: "form-control")
            </div>
        </div>
    </div>
    <div class="form-horizontal clearfix">
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.Label(Labels.Section, new { @class = "control-label" })
            </div>
            <div class="select-form">
                @Html.DropDownList("Section", new SelectList(Model.Sections, "Id", "Name"), new { multiple = "multiple" })
            </div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.Label(Labels.Employee, new { @class = "control-label" })
            </div>
            <div class="input-form">
                @Html.TextBoxFor(model => model.Employee, new { placeholder = Messages.SearchEmployeeWatermark, @class = "form-control" })
                @Html.Hidden("EmployeeId", Model.EmployeeId, new { data_val = "false" })
            </div>
        </div>
        <div class="form-group form-group--m">
            <button class="btn btn-primary" id="btnSearch">@Labels.Search</button>
        </div>
    </div>
</form>
<table class="table table-custom" id="data">
    <thead>
        <tr>
            <th>
                <div class="checkbox">
                    <input type="checkbox" class="checkbox-custom" id="chkAll" />
                    <label for="chkAll"></label>
                </div>
            </th>
            <th>@Labels.FullName</th>
            <th>@Labels.NickName</th>
            <th>@Labels.Team</th>
            <th>@Labels.Month</th>
            <th>@Labels.NormalDay</th>
            <th>@Labels.OffDay</th>
            <th>@Labels.PublicHoliday</th>
            <th>@Labels.Verifier</th>
            <th>@Labels.Approver</th>
            <th>@Labels.Status</th>
            <th>@Labels.Details</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.MemberRequests.Any())
        {
            foreach (MonthlyOvertimeRequest request in Model.MemberRequests)
            {
                <tr>
                    <td>
                        <div class="checkbox">
                            <input type="checkbox" class="checkbox-custom" id="chk@(request.RequestId)" />
                            <label for="chk@(request.RequestId)"></label>
                        </div>
                    </td>
                    <td class="align-left">@request.Requester.FullName</td>
                    <td class="align-left">@request.Requester.Nickname</td>
                    <td class="align-left">@request.Requester.Section.Name</td>
                    <td>@request.Month.ToString("MMM-yyyy")</td>
                    <td>
                        @if (request.NormalHours > 0)
                        {
                            @request.NormalHours
                        }
                    </td>
                    <td>
                        @if (request.OffHours > 0)
                        {
                            @request.OffHours
                        }
                    </td>
                    <td>
                        @if (request.PublicHours > 0)
                        {
                            @request.PublicHours
                        }
                    </td>
                    <td class="align-left">
                        @if (request.Verifier != null)
                        {
                            @request.Verifier.Nickname
                        }
                    </td>
                    <td class="align-left">
                        @if (request.Approver != null)
                        {
                            @request.Approver.Nickname
                        }
                    </td>
                    <td>
                        <span>@request.Status</span>
                    </td>
                    <td></td>
                    <td></td>
                </tr>
            }
        }
        else
        {
            @RazorHelper.DisplayNoInformation(colspan: 12);
        }
    </tbody>
    <tfoot>
        <tr class="summary">
            <td class="align-right">
                @Labels.TotalOvertimeHours:
            </td>
            <td colspan="4"></td>
            <td>@Model.MemberRequests.Sum(t => t.NormalHours).ToString("0.00")</td>
            <td>@Model.MemberRequests.Sum(t => t.OffHours).ToString("0.00")</td>
            <td>@Model.MemberRequests.Sum(t => t.PublicHours).ToString("0.00")</td>
            <td colspan="5"></td>
        </tr>
    </tfoot>
</table>