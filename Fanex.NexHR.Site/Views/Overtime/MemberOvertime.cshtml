@using Fanex.NexHR.Core
@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Resources
@using Fanex.NexHR.Models.Overtime
@using Fanex.NexHR.ViewModels.Overtime
@model MemberMonthlyOvertimeRequestViewModel
@{
    ViewBag.Title = "Members' overtime";
    HtmlHelper.ClientValidationEnabled = false;
    var showCheckAll = Model.MemberRequests.Any(x => x.IsHost);
    var currentUserId = (int)ViewBag.CurrentUserId;
    var isVerifier = (bool)ViewBag.IsVerifier;
    var isApprover = (bool)ViewBag.IsApprover;
}
@section css{
    <link href="~/wwwroot/dist/styles/overtime.member.index.css" rel="stylesheet" />
}
@section js{
    <script src="~/wwwroot/dist/js/overtime.member.index.js"></script>
}
@section Breadcrumb {
    <a class="step">@Labels.Personal</a> <a class="step">@ViewBag.Title</a>
}
<h2 class="page-title">@ViewBag.Title</h2>
@Html.Hidden("CurrentUserId", currentUserId)
@Html.Hidden("MinDate", new DateTime(2010, 1, 1).ToDateMonthYearFormatedDate())
@Html.Hidden("MaxDate", DateTime.Now.AddYears(1).ToDateMonthYearFormatedDate())
<form class="filter">
    @Html.HiddenFor(model => model.SectionIds)
    @Html.HiddenFor(model => model.Month)
    <div class="form-horizontal clearfix">
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.Label(Labels.Month, new { @class = "control-label" })
            </div>
            <div class="select-form">
                <div id="MonthControl"></div>
            </div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.Label(Labels.Status, new { @class = "control-label" })
            </div>
            <div class="select-form">
                @RazorHelper.StatusDropDownList(Model.StatusId, controlName: "StatusId", htmlClass: "form-control")
            </div>
        </div>
    </div>
    <div class="form-horizontal clearfix">
        <div class="form-group form-group--m">
            <div class="label-form">
                <label class="control-label">@Labels.DepartmentSection</label>
            </div>
            <div class="select-form" id="Section"></div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.Label(Labels.Employee, new { @class = "control-label" })
            </div>
            <div class="input-form">
                @Html.TextBoxFor(model => model.Employee, new { placeholder = Messages.SearchEmployeeWatermark, @class = "form-control" })
                @Html.Hidden("EmployeeId", Model.EmployeeId, new { data_val = "false" })
            </div>
        </div>
        <div class="form-group form-group--m">
            <button type="button" class="btn btn-primary" id="btnSearch">@Labels.Search</button>
        </div>
    </div>
</form>
<table class="table table-custom" id="data">
    <thead>
        @if (showCheckAll && (isVerifier || isApprover))
        {
            <tr>
                <th colspan="14">
                    <div style="float:right;">
                        @if (isVerifier)
                        {
                            <input type="button" class="btn btn-primary" id="btnVerify" value="@Labels.Verify" />
                            <input type="button" class="btn btn-primary" id="btnNotVerify" value="@Labels.NotVerify" />
                        }
                        @if (isApprover)
                        {
                            <input type="button" class="btn btn-primary" id="btnApprove" value="@Labels.Approve" />
                            <input type="button" class="btn btn-primary" id="btnReject" value="@Labels.Reject" />
                        }
                    </div>
                </th>
            </tr>
        }
        <tr>
            @if (showCheckAll)
            {
                <th>
                    <div class="checkbox">
                        <input type="checkbox" class="checkbox-custom" id="ckbAll" />
                        <label for="ckbAll"></label>
                    </div>
                </th>
            }
            <th>@Labels.FullName</th>
            <th>@Labels.NickName</th>
            <th>@Labels.Team</th>
            <th>@Labels.Month</th>
            <th>@Labels.NormalDay</th>
            <th>@Labels.OffDay</th>
            <th>@Labels.PublicHoliday</th>
            <th>@Labels.SpecialOT</th>
            <th>@Labels.Verifier</th>
            <th>@Labels.Approver</th>
            <th>@Labels.Status</th>
            <th>@Labels.Details</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.MemberRequests.Any())
        {
            foreach (MonthlyOvertimeRequest request in Model.MemberRequests)
            {
                <tr>
                    @if (showCheckAll)
                    {
                        <td>
                            @if (request.IsHost)
                            {
                                <div class="checkbox">
                                    <input type="checkbox" class="checkbox-custom" id="ckb@(request.RequestId)"
                                           data-requestid="@request.RequestId" data-statusid="@request.Status.Id"
                                           data-verifierid="@request.Verifier.EmployeeId" data-approverid="@request.Approver.EmployeeId" />
                                    <label for="ckb@(request.RequestId)"></label>
                                </div>
                            }
                        </td>
                    }
                    <td class="align-left">@request.Requester.FullName</td>
                    <td>@request.Requester.Nickname</td>
                    <td>@request.Requester.Section.Name</td>
                    <td>@request.Month.ToString("MMM-yyyy")</td>
                    <td>
                        @if (request.NormalHours > 0)
                        {
                            @request.NormalHours
                        }
                    </td>
                    <td>
                        @if (request.OffHours > 0)
                        {
                            @request.OffHours
                        }
                    </td>
                    <td>
                        @if (request.PublicHours > 0)
                        {
                            @request.PublicHours
                        }
                    </td>
                    <td>
                        @if (request.SpecialHours > 0)
                        {
                            @request.SpecialHours
                        }
                    </td>
                    <td>@request.Verifier.Nickname</td>
                    <td>@request.Approver.Nickname</td>
                    <td>@RenderStatus(request, currentUserId)</td>
                    <td>
                        <a href="@Url.Action("MemberDetails", "Overtime", new { id = request.RequestId })">
                            @Labels.View
                        </a>
                    </td>
                    <td>
                        @if (request.IsWarning)
                        {
                            <i class="fa fa-exclamation-triangle"></i>
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            @RazorHelper.DisplayNoInformation(colspan: 14);
        }
    </tbody>
    <tfoot>
        <tr class="summary">
            <td colspan="@(showCheckAll ? 5 : 4)" class="align-right">@Labels.TotalOvertimeHours:</td>
            <td>@Model.MemberRequests.Sum(t => t.NormalHours).ToString("0.00")</td>
            <td>@Model.MemberRequests.Sum(t => t.OffHours).ToString("0.00")</td>
            <td>@Model.MemberRequests.Sum(t => t.PublicHours).ToString("0.00")</td>
            <td>@Model.MemberRequests.Sum(t => t.SpecialHours).ToString("0.00")</td>
            <td colspan="5"></td>
        </tr>
    </tfoot>
</table>
@Html.Partial("_ConfirmModal")
@helper RenderStatus(MonthlyOvertimeRequest request, int currentUserId)
{
    if (request.Approver.EmployeeId == currentUserId)
    {
        switch (request.Status.Id)
        {
            case (byte)CurrentRequestStatus.Pending:
            case (byte)CurrentRequestStatus.Verified:
                <a roleid="@Convert.ToByte(RoleSystem.Approver)" requestid="@request.RequestId" href="javascript:;" class="approver-pending">
                    @request.Status
                    <span class="caret"></span>
                </a>
                break;
            case (byte)CurrentRequestStatus.Approved:
                <a roleid="@Convert.ToByte(RoleSystem.Approver)" requestid="@request.RequestId" href="javascript:;" class="approver-approved">
                    @request.Status
                    <span class="caret"></span>
                </a>
                break;
            case (byte)CurrentRequestStatus.Rejected:
                <a roleid="@Convert.ToByte(RoleSystem.Approver)" requestid="@request.RequestId" href="javascript:;" class="approver-rejected">
                    @request.Status
                    <span class="caret"></span>
                </a>
                break;
            default:
                @request.Status
                break;
        }
    }
    else if (request.Verifier.EmployeeId == currentUserId)
    {
        switch (request.Status.Id)
        {
            case (byte)CurrentRequestStatus.Pending:
                <a roleid="@Convert.ToByte(RoleSystem.Verifier)" requestid="@request.RequestId" href="javascript:;" class="verifier-pending">
                    @request.Status
                    <span class="caret"></span>
                </a>
                break;
            case (byte)CurrentRequestStatus.Verified:
                <a roleid="@Convert.ToByte(RoleSystem.Verifier)" requestid="@request.RequestId" href="javascript:;" class="verifier-verified">
                    @request.Status
                    <span class="caret"></span>
                </a>
                break;
            case (byte)CurrentRequestStatus.NotVerified:
                <a roleid="@Convert.ToByte(RoleSystem.Verifier)" requestid="@request.RequestId" href="javascript:;" class="verifier-notverified">
                    @request.Status
                    <span class="caret"></span>
                </a>
                break;
            default:
                @request.Status
                break;
        }

    }
    else
    {
        @request.Status
    }
}