@using Fanex.NexHR.ViewModels.Overtime
@model MyOverTimeViewModel
@{
    ViewBag.Title = Model.Employee + "'s Overtime Request in " + Model.Month.ToString("MMM-yyyy");
}
@section css{
    @Url.CombresLink("myovertimecss")
}
@section js{
    @Url.CombresLink("myovertimerequestjs")
}
@section Breadcrumb {
    <a class="step">Personal</a> <a class="step" href="@Url.Action("employeeview", "overtime")">@Labels.MyOvertimeRequest</a>
    <a class="step">Update My Overtime Request</a>
}
<h2>@ViewBag.Title</h2>
@using (Html.BeginForm())
{
    @Html.Hidden("WorkingHours", (double)ViewBag.WorkingHours)
    @Html.HiddenFor(x => x.EmpId)
    <div class="grid_2 gridlabel fontbold">
        @Html.LabelFor(model => model.VerifierId)
    </div>
    <div class="grid_5">
        @if (Model.VerifierAndApprover.Verifiers.Count() > 1)
        {
            @Html.DropDownListFor(x => x.VerifierId, new SelectList(Model.VerifierAndApprover.Verifiers, "OwnerId", "DisplayName"), Labels.SelectVerifier, new { @class = "dropdown" })
        }
        else
        {
            @Html.DropDownListFor(x => x.VerifierId, new SelectList(Model.VerifierAndApprover.Verifiers, "OwnerId", "DisplayName"), new { @class = "dropdown" })
        }
    </div>
    <div class="grid_2 gridlabel fontbold">@Html.LabelFor(model => model.ApproverId)</div>
    <div class="grid_5">
        @if (Model.VerifierAndApprover.Approvers.Count() > 1)
        {
            @Html.DropDownListFor(x => x.ApproverId, new SelectList(Model.VerifierAndApprover.Approvers, "OwnerId", "DisplayName"), Labels.SelectApprover, new { @class = "dropdown" })
        }
        else
        {
            @Html.DropDownListFor(x => x.ApproverId, new SelectList(Model.VerifierAndApprover.Approvers, "OwnerId", "DisplayName"), new { @class = "dropdown" })
        }
    </div>
    <div class="grid_1 gridlabel fontbold statusmargin">
        @Labels.Status:
    </div>
    <div class="grid_7 gridlabel">@Model.Status</div>
    <div class="float-right">
        <input type="button" id="savefooter" value="@Labels.Save" />
        <input type="button" id="backfooter" value="@Labels.Back" />
    </div>
    <div class="clear">
    </div>
    <div class="space">
    </div>
    <div class="clear">
    </div>
    <div class="formrow" id="overtimeDetails">
        <table class="table table-custom" id="data">
            <thead>
                <tr>
                    <th>
                        @Labels.Date
                    </th>
                    <th>
                        @Labels.Schedule
                    </th>
                    <th>
                        @Labels.TimeIn
                    </th>
                    <th>
                        @Labels.TimeOut
                    </th>
                    <th>
                        @Labels.TotalHours
                    </th>
                    <th>
                        @Labels.NormalDay
                    </th>
                    <th>
                        @Labels.OffDay
                    </th>
                    <th>
                        @Labels.PublicHoliday
                    </th>
                    <th>
                        @Labels.Remark
                    </th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    foreach (OvertimeDaily request in Model.OvertimeRequest)
                    {
                        <tr id="row@(request.Id)">
                            @Html.HiddenFor(model => request.ShiftId)
                            @if (request.OvertimeDate.DayOfWeek == DayOfWeek.Saturday || request.OvertimeDate.DayOfWeek == DayOfWeek.Sunday)
                            {
                                <td class="weekend">
                                    @request.OvertimeDate.ToString("dd-MMM-yyyy") (@request.OvertimeDate.ToString("ddd"))
                                </td>
                            }
                            else
                            {
                                <td>
                                    @request.OvertimeDate.ToString("dd-MMM-yyyy") (@request.OvertimeDate.ToString("ddd"))
                                </td>
                            }
                            <td>
                                @request.Schedule
                            </td>
                            <td>
                                @request.TimeIn
                            </td>
                            <td>
                                @request.TimeOut
                            </td>
                            <td class="totalHours">
                                @if (request.TotalWorkHours > 0)
                                {
                                    @request.TotalWorkHours
                                }
                            </td>
                            @if (request.TotalWorkHours > 0 && !request.IsKeepInView)
                            {
                                @Html.HiddenFor(model => request.TotalShiftHours)

                                //for normal day.
                                if (!request.IsOffDay && !request.IsHoliday)
                                {
                                    <td class="sumnormal">
                                        @Html.TextBoxFor(model => request.NormalHours, new { @class = "inputDay sumnormal" })
                                    </td>
                                }
                                else
                                {
                                    <td class="sumnormal">
                                        @request.NormalHours
                                    </td>
                                }
                                // for Off day.
                                if (request.IsOffDay)
                                {
                                    <td class="sumoff">
                                        @Html.TextBoxFor(model => request.OffHours, new { @class = "inputDay sumoff" })
                                    </td>
                                }
                                else
                                {
                                    <td class="sumoff">
                                        @request.OffHours
                                    </td>
                                }

                                //for Public Holiday.
                                if (request.IsHoliday)
                                {
                                    <td class="sumpublic">
                                        @Html.TextBoxFor(model => request.PublicHours, new { @class = "inputDay sumpublic" })
                                    </td>
                                }
                                else
                                {
                                    <td class="sumpublic">
                                        @request.PublicHours
                                    </td>
                                }
                                <td>
                                    @Html.TextBoxFor(model => request.Remark)
                                </td>
                            }
                            else
                            {
                                <td class="sumnormal">
                                    @if (request.NormalHours > 0)
                                    {
                                        @request.NormalHours
                                    }
                                </td>
                                <td class="sumoff">
                                    @if (request.OffHours > 0)
                                    {
                                        @request.OffHours
                                    }
                                </td>
                                <td class="sumpublic">
                                    @if (request.PublicHours > 0)
                                    {
                                        @request.PublicHours
                                    }
                                </td>
                                if (!string.IsNullOrWhiteSpace(request.Remark))
                                {
                                    <td>
                                        @request.Remark
                                    </td>
                                }
                                else
                                {
                                    <td></td>
                                }
                            }
                        </tr>
                    }
                }
                else
                {
                    @RazorHelper.DisplayNoInformation(colspan: 12)
                }
            </tbody>
            <tfoot>
                <tr class="summary">
                    <td class="sumhours align-right">
                        @Labels.TotalOvertimeHours:
                    </td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td ></td>
                    <td id="sumnormal">
                        @Model.OvertimeRequest.Sum(t => t.NormalHours).ToString("0.00")
                    </td>
                    <td id="sumoff">
                        @Model.OvertimeRequest.Sum(t => t.OffHours).ToString("0.00")
                    </td>
                    <td id="sumpublic">
                        @Model.OvertimeRequest.Sum(t => t.PublicHours).ToString("0.00")
                    </td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
    <div class="clear">
    </div>
    <div class="space">
    </div>
    <div class="clear">
    </div>
    <div class="float-right">
        <input type="button" id="save" value="@Labels.Save" />
        <input type="button" id="back" value="@Labels.Back" />
    </div>
    <div id="errordialog" title="Update Failure!">
    </div>
}
@RazorHelper.EmployeeProcessMenu()