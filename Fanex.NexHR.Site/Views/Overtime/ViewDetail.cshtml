@using Fanex.NexHR.ViewModels.Overtime
@model MyOverTimeViewModel
@{
    ViewBag.Title = Labels.MyOvertimeRequest + " in " + Model.Month.ToString("MMM-yyyy");
}
@section css{
    @Url.CombresLink("myovertimecss")
}
@section js{
    @Url.CombresLink("myovertimerequestjs")
}
@section Breadcrumb {
    <a class="step">Personal</a>
    <a class="step" href="@Url.Action("employeeview", "overtime")">@Labels.MyOvertimeRequest</a>
    <a class="step">View My Overtime Request</a>
}
<h2>@ViewBag.Title</h2>
@using (Html.BeginForm())
{
    <div class="grid_1 gridlabel fontbold">@Labels.Status: </div>
    <div class="grid_7 gridlabel">@Model.Status</div>
    <input type="button" id="back" class="float-right" value="@Labels.Back" />
    <div class="clear">
    </div>
    <div class="space">
    </div>
    <div class="clear">
    </div>
    <div class="formrow" id="overtimeDetails">
        <table class="table table-custom" id="data">
            <thead>
                <tr>
                    <th>@Labels.Date</th>
                    <th>@Labels.Schedule</th>
                    <th>@Labels.TimeIn</th>
                    <th>@Labels.TimeOut</th>
                    <th>@Labels.TotalHours</th>
                    <th>@Labels.NormalDay</th>
                    <th>@Labels.OffDay</th>
                    <th>@Labels.PublicHoliday</th>
                    <th>@Labels.Remark</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.OvertimeRequest != null && Model.OvertimeRequest.Any())
                {
                    foreach (OvertimeDaily request in Model.OvertimeRequest)
                    {
                        <tr id="row@(request.Id)">
                            @Html.HiddenFor(model => request.ShiftId)
                            @if (request.OvertimeDate.DayOfWeek == DayOfWeek.Saturday || request.OvertimeDate.DayOfWeek == DayOfWeek.Sunday)
                            {
                                <td class="weekend">
                                    @request.OvertimeDate.ToString("dd-MMM-yyyy") (@request.OvertimeDate.ToString("ddd"))
                                </td>
                            }
                            else
                            {
                                <td>
                                    @request.OvertimeDate.ToString("dd-MMM-yyyy") (@request.OvertimeDate.ToString("ddd"))
                                </td>
                            }
                            <td>@request.Schedule</td>
                            <td>@request.TimeIn</td>
                            <td>@request.TimeOut</td>
                            <td class="totalHours">
                                @if (request.TotalWorkHours > 0)
                                {
                                    @request.TotalWorkHours
                                }
                            </td>
                            <td class="sumnormal">
                                @if (request.NormalHours > 0)
                                {
                                    @request.NormalHours
                                }
                            </td>
                            <td class="sumoff">
                                @if (request.OffHours > 0)
                                {
                                    @request.OffHours
                                }
                            </td>
                            <td class="sumpublic">
                                @if (request.PublicHours > 0)
                                {
                                    @request.PublicHours
                                }
                            </td>
                            @if (!string.IsNullOrWhiteSpace(request.Remark))
                            {
                                <td>
                                    @request.Remark
                                </td>
                            }
                            else
                            {
                                <td></td>
                            }
                        </tr>
                    }
                }
                else
                {
                    @RazorHelper.DisplayNoInformation(colspan: 11)
                }
            </tbody>
            @if (Model != null && Model.OvertimeRequest != null)
            {
                <tfoot>
                    <tr class="summary">
                        <td class="sumhours align-right">
                            @Labels.TotalOvertimeHours:
                        </td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td id="sumnormal">
                            @Model.OvertimeRequest.Sum(t => t.NormalHours).ToString("0.00")
                        </td>
                        <td id="sumoff">
                            @Model.OvertimeRequest.Sum(t => t.OffHours).ToString("0.00")
                        </td>
                        <td id="sumpublic">
                            @Model.OvertimeRequest.Sum(t => t.PublicHours).ToString("0.00")
                        </td>
                        <td></td>
                    </tr>
                </tfoot>
            }
            else
            {
                <tfoot>
                    <tr class="summary">
                        <td class="sumhours align-right">
                            @Labels.TotalOvertimeHours:
                        </td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td id="sumnormal"></td>
                        <td id="sumoff"></td>
                        <td id="sumpublic"></td>
                        <td></td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
}
@RazorHelper.EmployeeProcessMenu()