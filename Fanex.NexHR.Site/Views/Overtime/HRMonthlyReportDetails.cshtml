@model IList<RequestEntity>
@{
    ViewBag.Title = Labels.OvertimeReport;
}
@section css{
    @Url.CombresLink("overtimereportcss")
}
@section js{
    @Url.CombresLink("monthlyovertimehrreportjs")
}
@section Breadcrumb {
    <a class="step">HR Space</a> <a class="step" href="@Url.Action("yearlyreport", "overtime")">@Labels.OvertimeReport</a>
    <a class="step">@ViewBag.Title Summary in @ViewBag.Date</a>
}
<table class="pretty" id="hrMonthlyReport">
    <thead>
        <tr>
            <th>@Labels.Date</th>
            <th>@Labels.FullName</th>
            <th>@Labels.Nick</th>
            <th>@Labels.NormalDay</th>
            <th>@Labels.OffDay</th>
            <th>@Labels.PublicHoliday</th>
            @if (ViewBag.Calendar != 0)
            {
                <th>@Labels.Verified</th>
                <th>@Labels.Approved</th>
            }
        </tr>
    </thead>
    <tbody>
        @if (Model != null)
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>
                        @item.RequestedDate.ToString("dd MMM, yyyy")
                    </td>
                    <td>
                        @item.Requester.FullName
                    </td>
                    <td>
                        @item.Requester.NickName
                    </td>
                    <td class="sumnormal">
                        @if (item.NormalHours > 0)
                        {
                            @item.NormalHours
                        }
                    </td>
                    <td class="sumoff">
                        @if (item.OffHours > 0)
                        {
                            @item.OffHours
                        }
                    </td>
                    <td class="sumpublic">
                        @if (item.PublicHours > 0)
                        {
                            @item.PublicHours
                        }
                    </td>
                    @if (ViewBag.Calendar != 0)
                    {
                        <td>
                            @{VerifiedStatus verifiedStatus = (VerifiedStatus)item.VerifiedStatus;}
                            <span class="hyperlink">@verifiedStatus</span>
                        </td>
                        <td>
                            @{ApprovedStatus approvedstatus = (ApprovedStatus)item.ApprovedStatus;}
                            <span class="hyperlink">@approvedstatus</span>
                        </td>
                    }
                </tr>
            }
        }
        else
        {
            @RazorHelper.DisplayNoInformation(colspan: 12);
        }
    </tbody>
    <tfoot>
        <tr class="sum">
            <th class="sumhours">
                @Labels.TotalOvertimeHours:
            </th>
            <th></th>
            <th></th>
            <th id="sumnormal"></th>
            <th id="sumoff"></th>
            <th id="sumpublic"></th>
            @if (ViewBag.Calendar != 0)
            {
                <th></th>
                <th></th>
            }
        </tr>
    </tfoot>
</table>