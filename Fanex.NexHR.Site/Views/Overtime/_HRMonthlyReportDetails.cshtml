@model IList<RequestEntity>
<table class="pretty" id="hrMonthlyReport">
    <thead>
        <tr>
            <th>@Labels.Date</th>
            <th>@Labels.FullName</th>
            <th>@Labels.Nick</th>
            <th>@Labels.NormalDay</th>
            <th>@Labels.OffDay</th>
            <th>@Labels.PublicHoliday</th>
            @if (ViewBag.Calendar != 0)
            {
                <th>@Labels.Verified</th>
                <th>@Labels.Approved</th>
            }
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (RequestEntity item in Model)
            {
                <tr>
                    <td>
                        @item.RequestedDate.ToString("dd MMM, yyyy")
                    </td>
                    <td class="align-left">
                        @item.Requester.FullName
                    </td>
                    <td>
                        @item.Requester.NickName
                    </td>
                    <td class="sumnormal">
                        @if (item.NormalHours > 0)
                        {
                            @item.NormalHours
                        }
                    </td>
                    <td class="sumoff">
                        @if (item.OffHours > 0)
                        {
                            @item.OffHours
                        }
                    </td>
                    <td class="sumpublic">
                        @if (item.PublicHours > 0)
                        {
                            @item.PublicHours
                        }
                    </td>
                    @if (ViewBag.Calendar != 0)
                    {
                        <td>
                            @{VerifiedStatus verifiedStatus = (VerifiedStatus)item.VerifiedStatus;}
                            <span class="hyperlink">@verifiedStatus</span>
                        </td>
                        <td>
                            @{ApprovedStatus approvedstatus = (ApprovedStatus)item.ApprovedStatus;}
                            <span class="hyperlink">@approvedstatus</span>
                        </td>
                    }
                </tr>
            }
        }
        else
        {
            @RazorHelper.DisplayNoInformation(colspan: 12);
        }
    </tbody>
    <tfoot>
        <tr class="summary">
            <th colspan="3" class="sumhours align-right">
                @Labels.TotalOvertimeHours:
            </th>
            <th id="sumnormal"></th>
            <th id="sumoff"></th>
            <th id="sumpublic"></th>
            @if (ViewBag.Calendar != 0)
            {
                <th></th>
                <th></th>
            }
        </tr>
    </tfoot>
</table>