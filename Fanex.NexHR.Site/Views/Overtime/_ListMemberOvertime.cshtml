@using Fanex.NexHR.Resources
@using Fanex.NexHR.Models.Overtime
@model IEnumerable<MonthlyOvertimeRequest>

@{ 
    var showCheckAll = Model.Any(x => x.IsHost);
    var currentUserId = (int)ViewBag.CurrentUserId;
}

@if (Model.Any())
{
    int index = 0;
    foreach (MonthlyOvertimeRequest request in Model)
    {
        index++;
    <tr>
        @if (showCheckAll)
        {
            <td>
                @if (request.IsHost)
                {
                    <div class="checkbox">
                        <input type="checkbox" class="checkbox-custom" id="ckb@(request.RequestId)"
                               data-requestid="@request.RequestId" data-statusid="@request.Status.Id"
                               data-verifierid="@request.Verifier.EmpId" data-approverid="@request.Approver.EmpId" />
                        <label for="ckb@(request.RequestId)"></label>
                    </div>
                }
            </td>
        }
        <td>@index</td>
        <td>@request.Requester.Department</td>
        <td>@request.Requester.Section</td>
        <td>@request.Requester.Team</td>
        <td class="align-left">@request.Requester.FullName</td>
        <td>@request.Requester.Nickname</td>
        <td data-datetime="@request.Month">@request.Month.ToString("MMM-yyyy")</td>
        <td>
            @if (request.NormalHours > 0)
            {
                @request.NormalHours
            }
        </td>
        <td>
            @if (request.OffHours > 0)
            {
                @request.OffHours
            }
        </td>
        <td>
            @if (request.PublicHours > 0)
            {
                @request.PublicHours
            }
        </td>
        <td>
            @if (request.SpecialHours > 0)
            {
                @request.SpecialHours
            }
        </td>
        <td>@request.Verifier.Nickname</td>
        <td>@request.Approver.Nickname</td>
        <td>@RenderStatus(request, currentUserId)</td>
        <td>
            <a href="@Url.Action("MemberDetails", "Overtime", new { id = request.RequestId })">
                @Labels.View
            </a>
        </td>
        <td>
            @if (request.IsWarning)
            {
                <i class="fa fa-exclamation-triangle"></i>
            }
        </td>
    </tr>
    }
}
else
{
    @RazorHelper.DisplayNoInformation(colspan: 16);
}

@helper RenderStatus(MonthlyOvertimeRequest request, int currentUserId)
{
    if (request.Approver.EmpId == currentUserId)
    {
        switch (request.Status.Id)
        {
            case (byte)CurrentRequestStatus.Pending:
            case (byte)CurrentRequestStatus.Verified:
                <a roleid="@Convert.ToByte(RoleSystem.Approver)" requestid="@request.RequestId" href="javascript:;" class="approver-pending">
                    @request.Status
                    <span class="caret"></span>
                </a>
                break;
            case (byte)CurrentRequestStatus.Approved:
                <a roleid="@Convert.ToByte(RoleSystem.Approver)" requestid="@request.RequestId" href="javascript:;" class="approver-approved">
                    @request.Status
                    <span class="caret"></span>
                </a>
                break;
            case (byte)CurrentRequestStatus.Rejected:
                <a roleid="@Convert.ToByte(RoleSystem.Approver)" requestid="@request.RequestId" href="javascript:;" class="approver-rejected">
                    @request.Status
                    <span class="caret"></span>
                </a>
                break;
            default:
                @request.Status
                break;
        }
    }
    else if (request.Verifier.EmpId == currentUserId)
    {
        switch (request.Status.Id)
        {
            case (byte)CurrentRequestStatus.Pending:
                <a roleid="@Convert.ToByte(RoleSystem.Verifier)" requestid="@request.RequestId" href="javascript:;" class="verifier-pending">
                    @request.Status
                    <span class="caret"></span>
                </a>
                break;
            case (byte)CurrentRequestStatus.Verified:
                <a roleid="@Convert.ToByte(RoleSystem.Verifier)" requestid="@request.RequestId" href="javascript:;" class="verifier-verified">
                    @request.Status
                    <span class="caret"></span>
                </a>
                break;
            case (byte)CurrentRequestStatus.NotVerified:
                <a roleid="@Convert.ToByte(RoleSystem.Verifier)" requestid="@request.RequestId" href="javascript:;" class="verifier-notverified">
                    @request.Status
                    <span class="caret"></span>
                </a>
                break;
            default:
                @request.Status
                break;
        }

    }
    else
    {
        @request.Status
    }
}