@model OvertimeRequest
@{
    var request = (OvertimeRequest)Model;
    if (request.ApprovedBy.Id == Convert.ToInt32(ViewBag.CurrentUserId))
    {
        switch (request.CurrentStatus)
        {
            case (byte)CurrentRequestStatus.Verified:
                <td>
                    <a roleid="@Convert.ToInt32(RoleSystem.Approver)" requestid="@request.RequestId" href="javascript:void(0);" class="approver-pending menu">
                        @Utilities.GetCurrentStatusName(request.CurrentStatus)
                    </a>
                </td>
                break;
            case (byte)CurrentRequestStatus.Pending:
                if (request.VerifiedBy.Id == Convert.ToInt32(ViewBag.CurrentUserId))
                {
                    <td>
                        <a roleid="@Convert.ToInt32(RoleSystem.Approver)" requestid="@request.RequestId" href="javascript:void(0);" class="approver-pending menu">
                            @Utilities.GetCurrentStatusName(request.CurrentStatus)
                        </a>
                    </td>
                }
                break;
            case (byte)CurrentRequestStatus.Approved:
            <td>
                <a roleid="@Convert.ToInt32(RoleSystem.Approver)" requestid="@request.RequestId" href="javascript:void(0);" class="approver-approved menu">
                    @Utilities.GetCurrentStatusName(request.CurrentStatus)
                </a>
            </td>
                break;
            case (byte)CurrentRequestStatus.Rejected:
            <td>
                <a roleid="@Convert.ToInt32(RoleSystem.Approver)" requestid="@request.RequestId" href="javascript:void(0);" class="approver-rejected menu">
                    @Utilities.GetCurrentStatusName(request.CurrentStatus)
                </a>
            </td>
                break;
            case (byte)CurrentRequestStatus.NotVerified:
            case (byte)CurrentRequestStatus.Processed:
            case (byte)CurrentRequestStatus.Void:
            default:
            <td class="tooltip"><span class="status">@Utilities.GetCurrentStatusName(request.CurrentStatus)</span> </td>
                break;
        }
    }
    else
    {
        <td class="tooltip"><span class="status">@Utilities.GetCurrentStatusName(request.CurrentStatus)</span> </td>
    }
}