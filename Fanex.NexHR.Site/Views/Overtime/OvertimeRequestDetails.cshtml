@using Fanex.NexHR.Models.Request
@model IList<OvertimeRequest>
@using (Html.BeginForm())
{ 
    <table class="data" id="data">
        <thead>
            <tr>
                <th>@Labels.Date
                </th>
                <th>@Labels.Schedule
                </th>
                <th>@Labels.TimeIn
                </th>
                <th>@Labels.TimeOut
                </th>
                <th>
                    Total Time
                </th>
                <th>
                    Working Hours
                </th>
                <th>@Labels.NormalDay
                </th>
                <th>@Labels.OffDay
                </th>
                <th>@Labels.PublicHoliday
                </th>
                <th>@Labels.Remark
                </th>
                <th>@Labels.Status
                </th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                foreach (OvertimeRequest request in Model)
                {                   
                <tr id="row@(request.Id)">
                    @if (request.OvertimeDate.DayOfWeek == DayOfWeek.Saturday || request.OvertimeDate.DayOfWeek == DayOfWeek.Sunday)
                    {
                        <td class="dateColumn weekend">@request.OvertimeDate.ToString("dd-MMM-yyyy") (@request.OvertimeDate.ToString("ddd"))
                        </td>
                    }
                    else
                    {
                        <td class="dateColumn">@request.OvertimeDate.ToString("dd-MMM-yyyy") (@request.OvertimeDate.ToString("ddd"))
                        </td>
                    }
                    <td>
                        @request.Schedule
                    </td>
                    <td>@request.TimeIn
                    </td>
                    <td>@request.TimeOut
                    </td>
                    <td>
                        @request.TotalWorkHours_Time
                    </td>
                    <td class="totalHours">
                        @if (request.TotalWorkHours > 0)
                        {
                            @request.TotalWorkHours
                        }
                    </td>
                    @if (request.TotalWorkHours > 0 && (ViewBag.Update) && (string)ViewBag.RequestStatus == "Pending")
                    {
                        @Html.HiddenFor(model => request.TotalShiftHours)

                        
                        //for normal day.
                        if (!request.IsOffDay && !request.IsHoliday)
                        {
                        <td>
                            @Html.TextBoxFor(model => request.NormalHours, new { @class = "inputDay" })
                        </td>
                        }
                        else
                        {
                        <td>
                            @request.NormalHours
                        </td>
                        }

                        // for Off day.
                        if (request.IsOffDay)
                        {
                        <td>
                            @Html.TextBoxFor(model => request.OffHours, new { @class = "inputDay" })
                        </td>
                        }
                        else
                        {
                        <td>
                            @request.OffHours
                        </td>
                        }

                        //for Public Holiday.
                        if (request.IsHoliday)
                        {
                        <td>
                            @Html.TextBoxFor(model => request.PublicHours, new { @class = "inputDay" })
                        </td>
                        }
                        else
                        {
                        <td>
                            @request.PublicHours
                        </td>
                        }

                        <td>
                            @Html.TextBoxFor(model => request.Remark)
                        </td>
                    }
                    else
                    {
                        <td>
                            @if (request.NormalHours > 0)
                            {
                                @request.NormalHours
                            }
                        </td>
                        <td>
                            @if (request.OffHours > 0)
                            {
                                @request.OffHours
                            }
                        </td>
                        <td>
                            @if (request.PublicHours > 0)
                            {
                                @request.PublicHours
                            }
                        </td>

                            if (!string.IsNullOrWhiteSpace(request.Remark))
                            { 
                        <td>
                            @request.Remark
                        </td>
                            }
                            else
                            {
                        <td>
                        </td>
                            }
                    }
                    <td>
                        @{
                    if (request.Status != 0)
                    {
                        CurrentRequestStatus status = (CurrentRequestStatus)request.Status;
                            <span>@status</span>
                    }
                        }
                    </td>
                    @Html.HiddenFor(model => request.ShiftId)
                </tr>
                }

            }
            else
            { 
                @RazorHelper.DisplayNoInformation(colspan: 12);
            }
        </tbody>
    </table>
}