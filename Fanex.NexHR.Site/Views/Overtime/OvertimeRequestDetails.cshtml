@model IList<OvertimeDaily>
@using (Html.BeginForm())
{
    <table class="table table-custom" id="data">
        <thead>
            <tr>
                <th>@Labels.Date</th>
                <th>@Labels.Schedule</th>
                <th>@Labels.TimeIn</th>
                <th>@Labels.TimeOut</th>
                <th>@Labels.TotalHours</th>
                <th>@Labels.NormalDay</th>
                <th>@Labels.OffDay</th>
                <th>@Labels.PublicHoliday</th>
                <th>@Labels.Remark</th>
                <th>@Labels.Status</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                foreach (OvertimeDaily request in Model)
                {
                    <tr id="row@(request.Id)">
                        @Html.HiddenFor(model => request.ShiftId)
                        @if (request.OvertimeDate.DayOfWeek == DayOfWeek.Saturday || request.OvertimeDate.DayOfWeek == DayOfWeek.Sunday)
                        {
                            <td class="weekend">
                                @request.OvertimeDate.ToString("dd-MMM-yyyy") (@request.OvertimeDate.ToString("ddd"))
                            </td>
                        }
                        else
                        {
                            <td>
                                @request.OvertimeDate.ToString("dd-MMM-yyyy") (@request.OvertimeDate.ToString("ddd"))
                            </td>
                        }
                        <td>@request.Schedule</td>
                        <td>@request.TimeIn</td>
                        <td>@request.TimeOut</td>
                        <td class="totalHours">
                            @if (request.TotalWorkHours > 0)
                            {
                                @request.TotalWorkHours
                            }
                        </td>
                        <td class="sumnormal">
                            @if (request.NormalHours > 0)
                            {
                                @request.NormalHours
                            }
                        </td>
                        <td class="sumoff">
                            @if (request.OffHours > 0)
                            {
                                @request.OffHours
                            }
                        </td>
                        <td class="sumpublic">
                            @if (request.PublicHours > 0)
                            {
                                @request.PublicHours
                            }
                        </td>
                        @if (!string.IsNullOrWhiteSpace(request.Remark))
                        {
                            <td>@request.Remark</td>
                        }
                        else
                        {
                            <td></td>
                        }
                        <td>
                            @if (request.Status != 0)
                            {
                                CurrentRequestStatus status = (CurrentRequestStatus)request.Status;
                                <span>@status</span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                @RazorHelper.DisplayNoInformation(colspan: 12)
            }
        </tbody>
        <tfoot>
            <tr class="summary">
                <td class="sumhours align-right">
                    @Labels.TotalOvertimeHours:
                </td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td id="sumnormal">
                    @Model.Sum(t => t.NormalHours).ToString("0.00")
                </td>
                <td id="sumoff">
                    @Model.Sum(t => t.OffHours).ToString("0.00")
                </td>
                <td id="sumpublic">
                    @Model.Sum(t => t.PublicHours).ToString("0.00")
                </td>
                <td></td>
                <td></td>
            </tr>
        </tfoot>
    </table>
}