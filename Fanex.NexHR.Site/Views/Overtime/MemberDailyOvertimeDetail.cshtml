@using Fanex.NexHR.Models.Request
@model IList<OvertimeRequest>
@using (Html.BeginForm())
{
    var isShowWarning = false; 
    <table class="data" id="data">
        <thead>
            <tr>
                <th>@Labels.Date
                </th>
                <th>@Labels.Schedule
                </th>
                <th>@Labels.TimeIn
                </th>
                <th>@Labels.TimeOut
                </th>
                <th>@Labels.TotalHours
                </th>
                <th>@Labels.NormalDay
                </th>
                <th>@Labels.OffDay
                </th>
                <th>@Labels.PublicHoliday
                </th>
                <th>@Labels.Remark
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                foreach (OvertimeRequest request in Model)
                {
                    isShowWarning = false;
                <tr id="row@(request.Id)">
                    @if (request.OvertimeDate.DayOfWeek == DayOfWeek.Saturday || request.OvertimeDate.DayOfWeek == DayOfWeek.Sunday)
                    {
                        <td class="dateColumn weekend">@request.OvertimeDate.ToString("dd-MMM-yyyy") (@request.OvertimeDate.ToString("ddd"))
                        </td>
                    }
                    else
                    {
                        <td class="dateColumn">@request.OvertimeDate.ToString("dd-MMM-yyyy") (@request.OvertimeDate.ToString("ddd"))
                        </td>
                    }
                    <td>
                        @request.Schedule
                    </td>
                    <td>@request.TimeIn
                        @*<td class="highlight">@request.ToDate.ToString("HH:mm")</td>*@
                    </td>
                    <td>@request.TimeOut
                    </td>
                    <td class="totalHours">
                        @request.TotalWorkHours
                    </td>
                   
                        <td class="sumnormal">
                            @if (request.NormalHours > 0)
                            {
                                @request.NormalHours
                            }
                        </td>
                        <td class="sumoff">
                            @if (request.OffHours > 0)
                            {
                                @request.OffHours
                            }
                        </td>
                        <td class="sumpublic">
                            @if (request.PublicHours > 0)
                            {
                                @request.PublicHours
                            }
                        </td>

                        @if (!string.IsNullOrWhiteSpace(request.Remark))
                        { 
                            <td>
                                @request.Remark
                            </td>
                        }
                        else
                        {
                            <td>
                            </td>
                        }

                        @if (request.TotalShiftHours != 0 && ((request.TotalWorkHours >= request.TotalShiftHours + 1)
                            || ((request.NormalHours > request.TotalWorkHours - request.WorkingHoursContract) 
                            && request.TotalWorkHours >= request.WorkingHoursContract)))
                        {
                            var tooltip = "[Total Working Hours]/[Shift Hours]: " + request.TotalWorkHours + " / " + request.TotalShiftHours;
                            <td class="td-warning tooltip" title="@tooltip">
                                <span class="icon-warning"></span>
                            </td>
                        }
                        else
                        {
                            <td></td>
                        }
                        
                    @Html.HiddenFor(model => request.ShiftId)
                </tr>
                }

            }
            else
            { 
                @RazorHelper.DisplayNoInformation(colspan: 10);
            }
        </tbody>
        <tfoot>
            <tr class="sum">
                <td colspan="1" class="sumhours">@Labels.TotalOvertimeHours:
                </td>
                <td colspan="1">
                </td>
                <td colspan="1">
                </td>
                <td colspan="1">
                </td>
                <td colspan="1" >
                </td>
                <td colspan="1" id="sumnormal">
                </td>
                <td colspan="1" id="sumoff">
                </td>
                <td colspan="1" id="sumpublic">
                </td>
                <td colspan="1">
                </td>
                <td colspan="1">
                </td>
            </tr>
        </tfoot>
    </table>
}