@model IList<OvertimeDaily>
@using (Html.BeginForm())
{
    <table class="data" id="data">
        <thead>
            <tr>
                <th>@Labels.Date</th>
                <th>@Labels.Schedule</th>
                <th>@Labels.TimeIn</th>
                <th>@Labels.TimeOut</th>
                <th>@Labels.TotalHours</th>
                <th>@Labels.NormalDay</th>
                <th>@Labels.OffDay</th>
                <th>@Labels.PublicHoliday</th>
                <th>@Labels.Remark</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                foreach (OvertimeDaily request in Model)
                {
                    <tr id="row@(request.Id)">
                        @Html.HiddenFor(model => request.ShiftId)
                        @if (request.OvertimeDate.DayOfWeek == DayOfWeek.Saturday || request.OvertimeDate.DayOfWeek == DayOfWeek.Sunday)
                        {
                            <td class="dateColumn weekend">
                                @request.OvertimeDate.ToString("dd-MMM-yyyy") (@request.OvertimeDate.ToString("ddd"))
                            </td>
                        }
                        else
                        {
                            <td class="dateColumn">
                                @request.OvertimeDate.ToString("dd-MMM-yyyy") (@request.OvertimeDate.ToString("ddd"))
                            </td>
                        }
                        <td>
                            @request.Schedule
                        </td>
                        <td>
                            @request.TimeIn
                            @*<td class="highlight">@request.ToDate.ToString("HH:mm")</td>*@
                        </td>
                        <td>
                            @request.TimeOut
                        </td>
                        <td class="totalHours">
                            @if (request.TotalWorkHours > 0)
                            {
                                @request.TotalWorkHours
                            }
                        </td>

                        <td class="sumnormal">
                            @if (request.NormalHours > 0)
                            {
                                @request.NormalHours
                            }
                        </td>
                        <td class="sumoff">
                            @if (request.OffHours > 0)
                            {
                                @request.OffHours
                            }
                        </td>
                        <td class="sumpublic">
                            @if (request.PublicHours > 0)
                            {
                                @request.PublicHours
                            }
                        </td>
                        @if (!string.IsNullOrWhiteSpace(request.Remark))
                        {
                            <td>
                                @request.Remark
                            </td>
                        }
                        else
                        {
                            <td></td>
                        }
                        @if (request.TotalShiftHours != 0 && ((request.TotalWorkHours >= request.TotalShiftHours + 1)
                            || ((request.NormalHours > request.TotalWorkHours - request.WorkingHoursContract)
                            && request.TotalWorkHours >= request.WorkingHoursContract)))
                        {
                            var tooltip = "[Total Working Hours]/[Shift Hours]: " + request.TotalWorkHours + " / " + request.TotalShiftHours;
                            <td class="td-warning tooltip" title="@tooltip">
                                <span class="icon-warning"></span>
                            </td>
                        }
                        else
                        {
                            <td></td>
                        }
                    </tr>
                }
            }
            else
            {
                @RazorHelper.DisplayNoInformation(colspan: 10);
            }
        </tbody>
        <tfoot>
            <tr class="sum">
                <td class="sumhours">
                    @Labels.TotalOvertimeHours:
                </td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td id="sumnormal"></td>
                <td id="sumoff"></td>
                <td id="sumpublic"></td>
                <td></td>
                <td></td>
            </tr>
        </tfoot>
    </table>
}