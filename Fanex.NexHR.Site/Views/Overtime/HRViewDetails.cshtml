@model OvertimeRequest
@{
    ViewBag.Title = Model.Employee.DisplayName + " 's " + Labels.OvertimeReport + " in " + Model.Month.ToString("MMM-yyyy");
}
@section css{
    @Url.CombresLink("myovertimecss")
}
@section js{
    @Url.CombresLink("myovertimerequestjs")
}
@section Breadcrumb {
    <a class="step">Personal</a>
    <a class="step" href="@Url.Action("yearlyreport", "overtime")">Yearly Overtime Report</a>
    <a class="step">@(Model.Employee.NickName + " (" + Model.Employee.FullName + ")")'s @Labels.OvertimeReport Details</a>
}

@using (Html.BeginForm())
{
    <div class="grid_2 gridlabel title">
        @ViewBag.Title
    </div>
    <input type="button" id="backHrReport" class="float-right" value="@Labels.Back" />
    <div class="clear"></div>
    <div class="space"></div>
    <div class="clear"></div>
    <div class="formrow" id="overtimeDetails">
        @Html.Partial("OvertimeRequestDetails", Model.OvertimeDaily)
    </div>
}
@RazorHelper.EmployeeProcessMenu()