@using Fanex.NexHR.Models.Overtime
@model IList<OvertimeRequest>
@{
    ViewBag.Title = "Overtime Report Details";
}
@section css{
    @Url.CombresLink("overtimereportcss")
}
@section js{
    @Url.CombresLink("overtimereportdetailsjs")
}
@section Breadcrumb {
    <a class="step">HR Space</a> <a class="step" href="@Url.Action("yearlyreport", "overtime")">@Labels.OvertimeReport</a>
    <a class="step">@ViewBag.Title</a>
}
@using (Html.BeginForm())
{
    <table class="data" id="reportDetaisl">
        <thead>
            <tr>
                <th>
                    @Labels.Date
                </th>
                <th>
                    @Labels.Code
                </th>
                <th>
                    @Labels.Employee
                </th>
                <th>
                    @Labels.Shift
                </th>
                <th>
                    @Labels.TimeIn
                </th>
                <th>
                    @Labels.TimeOut
                </th>
                <th>
                    @Labels.TotalHours
                </th>
                <th>
                    @Labels.NormalDay
                </th>
                <th>
                    @Labels.OffDay
                </th>
                <th>
                    @Labels.PublicHoliday
                </th>
                <th>
                    @Labels.Remark
                </th>
                <th>
                    @Labels.Status
                </th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                foreach (OvertimeRequest item in Model)
                {
                <tr>
                    <td>
                        @item.OvertimeDate.ToString("dd MMM, yyyy")
                    </td>
                    <td>
                        @item.Code
                    </td>
                    <td class="left">
                        @item.FullName (@item.NickName)
                    </td>
                    <td>
                        @item.Schedule
                    </td>
                    <td>
                        @item.TimeIn
                    </td>
                    <td>
                        @item.TimeOut
                    </td>
                    <td>
                        @if(item.TotalWorkHours > 0)
                        {
                            <span>@item.TotalWorkHours</span>
                        }
                    </td>
                    <td>
                        @if (item.NormalHours > 0)
                        {
                            <span>@item.NormalHours</span>
                        }
                    </td>
                    <td>
                        @if (item.OffHours > 0)
                        {
                            <span>@item.OffHours</span>
                        }
                    </td>
                    <td>
                        @if (item.PublicHours > 0)
                        {
                            <span>@item.PublicHours</span>
                        }
                    </td>
                    <td>
                        @item.Remark
                    </td>
                    <td>
                        @if (item.Status != 0)
                        {
                            CurrentRequestStatus status = (CurrentRequestStatus)item.Status;
                            <span>@status</span>
                        }
                    </td>
                </tr>
                }
            }
            else
            { 
                @RazorHelper.DisplayNoInformation(colspan: 11)    
            }
        </tbody>
    </table>
}