@section Breadcrumb {
    <a class="step">HR Space</a> <a class="step">@ViewBag.Title</a>
}
@functions 
 {
    private DateTime DisplayDate(int Year, int Month)
    {
        if (Year != null && Year > 0)
        {
            var firstDayInMonth = Convert.ToDateTime(new System.Text.StringBuilder().AppendFormat("{0}/1/{1}", Month, Year).ToString());
            return firstDayInMonth;
        }
        return new DateTime();
    }
 }
