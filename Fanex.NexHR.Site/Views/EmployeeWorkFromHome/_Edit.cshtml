@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels.EmployeeWorkFromHome
@model EmployeeWorkFromHomeViewModel

@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "edit-form", @class = "dialog-form" }))
{
    @Html.ValidationSummary()
    @Html.HiddenFor(model => model.EmployeeWorkFromHomeId)
    <div class="form-horizontal clearfix">
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.LabelFor(model => model.Employee, new { @class = "control-label" })
            </div>
            <div class="input-form">
                @Html.TextBox("Employee", Model.Employee, new { @class = "form-control", placeholder = Messages.SearchEmployeeWatermark })
                @Html.HiddenFor(model => model.EmployeeId)
            </div>
        </div>
    </div>

    <div class="form-horizontal clearfix">
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.LabelFor(model => model.FromDate, new { @class = "control-label" })
            </div>
            <div class="calendar-form">
                @Html.TextBox("FromDate", Model.FromDate.ToDateMonthYearFormatedDate(),
                    new
                         {
                        @class = "datepicker form-control"
                    })
                <i class="icon-calendar fa fa-calendar"></i>
            </div>
        </div>
    </div>

    <div class="form-horizontal clearfix">
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.LabelFor(model => model.ToDate, new { @class = "control-label" })
            </div>
            <div class="calendar-form">
                @Html.TextBox("ToDate", Model.ToDate.ToDateMonthYearFormatedDate(),
                    new
                         {
                        @class = "datepicker form-control"
                    })
                <i class="icon-calendar fa fa-calendar"></i>
            </div>
        </div>
    </div>
    <div class="form-horizontal clearfix">
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.LabelFor(model => model.Remark, new { @class = "control-label" })
            </div>
            <div class="input-form">
                @Html.TextAreaFor(model => model.Remark, new { @class = "form-control" })
            </div>
        </div>
    </div>
}