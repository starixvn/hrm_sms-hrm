@using Fanex.NexHR.Core
@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels.NewDepartment
@model EditNewDepartmentViewModel

@{
    ViewBag.Title = @Labels.EditDepartment;
}
@section css{
    <link href="~/wwwroot/dist/styles/newdepartment.create.css" rel="stylesheet" />
}
@section js{
    <script src="~/wwwroot/dist/js/newdepartment.edit.js"></script>
}
@section Breadcrumb {
    <a class="step">@Labels.SASpace</a>
    <a class="step" href="@Url.Action("index", "newdepartment")">@Labels.NewDepartmentManagement</a>
    <span class="step">@ViewBag.Title</span>
}

<h2 class="page-title">@Labels.Edit</h2>
<div class="card">
    @using (Html.BeginForm("Edit", "newdepartment", FormMethod.Post, new { @class = "form-horizontal", @id = "EditForm" }))
    {
        @Html.ValidationSummary()
        <div class="form-group">
            <div class="label-form">
                @Html.LabelFor(model => model.Code, new { @class = "control-label" })
                <input type="hidden" value="@Model.DepartmentId" name="DepartmentId" />
            </div>
            <div class="input-form">
                @Html.TextBoxFor(model => model.Code, new { maxlength = "50", @class = "form-control", @autocomplete = "off" })
            </div>
            @Html.ValidationMessageFor(model => model.Name)
        </div>
        <div class="form-group">
            <div class="label-form">
                @Html.LabelFor(model => model.Name, new { @class = "control-label" })
            </div>
            <div class="input-form">
                @Html.TextBoxFor(model => model.Name, new { maxlength = "200", @class = "form-control", @autocomplete = "off" })
            </div>
            @Html.ValidationMessageFor(model => model.Name)
        </div>
        <div class="form-group">
            <div class="label-form">
                @Html.LabelFor(model => model.UnitId, "Unit", new { @class = "control-label" })
            </div>
            <div class="select-form">
                @Html.DropDownListFor(model => model.UnitId, new SelectList(Model.Unit, "Id", "Name"), string.Empty, new { @class = "form-control" })
            </div>
            @Html.ValidationMessageFor(model => model.UnitId)
        </div>
        <div id="groupHalfDay" class="form-group">
            <div class="label-form">
                @Html.LabelFor(model => model.IsActive, new { @class = "control-label" })
            </div>
            <div class="input-form">
                <div class="checkbox">@Html.CheckBoxCustomFor(model => model.IsActive)</div>
            </div>
        </div>

        <div class="form-group">
            <div>
                <button type="button" class="btn btn-primary" id="btnSubmit">@Labels.Update</button>
                <button type="button" class="btn btn-default" onclick="window.history.back()">@Labels.Back</button>
            </div>
        </div>
    }
</div>