@model List<RequestsMonitoring>
<table class="data persist-area" id="HrRequestTable">
	<thead>
		<tr class="persist-header">
			<th>
				#
			</th>
			<th>@Labels.Name
			</th>
			<th>@Labels.Nick
			</th>
			<th>@Labels.Team
			</th>
			<th>@Labels.Leave
			</th>
			<th>
				Unpaid Leave
			</th>
			<th>@Labels.ChangeShift
			</th>
			<th>
				Late-in
			</th>
			<th>
				Early-out
			</th>
			<th>@Labels.CheckInOut
			</th>
		</tr>
	</thead>
	<tbody>
		@if (Model.Count > 0)
  {
	  int index = 1;
	  var requestModel = new RequestViewModel();

	  foreach (Fanex.NexHR.Models.RequestsMonitoring request in Model)
	  {

		  requestModel = new RequestViewModel
		  {
			  DateOption = 0,
			  FromDate = ViewBag.FromDate,
			  ToDate = ViewBag.ToDate,
			  EmployeeId = request.Requester.Id,
			  Employee = request.Requester.NickName + " (" + request.Requester.FullName + ")",
			  TeamIds = string.Empty,
			  StatusId = (byte)CurrentRequestStatus.Approved
		  };

			<tr>
				<td>@(index++)
				</td>
				<td class="left">@request.Requester.FullName
				</td>
				<td>@request.Requester.NickName
				</td>
				<td>@request.Requester.Team.Name
				</td>
				<td class="@(request.TotalLeave > ViewBag.MaxRequest ? "overloadRequest" : string.Empty)">
					@if (request.TotalLeave > 0)
	 {
		 requestModel.RequestType = 4;

		 if ((bool)ViewBag.isLeader)
		 {
						<a href="@Url.Action("member", "request", requestModel)">@request.TotalLeave</a>
		 }
		 else
		 {
						<a href="@Url.Action("hrview", "request", requestModel)">@request.TotalLeave</a>
		 }
	 }
				</td>
				<td class="@(request.TotalUnpaidLeave > ViewBag.MaxRequest ? "overloadRequest" : string.Empty)">
					@if (request.TotalUnpaidLeave > 0)
	 {
		 requestModel.RequestType = 4;

		 if ((bool)ViewBag.isLeader)
		 {
						<a href="@Url.Action("member", "request", requestModel)">@request.TotalUnpaidLeave</a>
		 }
		 else
		 {
						<a href="@Url.Action("hrview", "request", requestModel)">@request.TotalUnpaidLeave</a>
		 }
	 }
				</td>
				<td class="@(request.TotalChangeShift > ViewBag.MaxRequest ? "overloadRequest" : string.Empty)">
					@if (request.TotalChangeShift > 0)
	 {
		 requestModel.RequestType = 3;

		 if ((bool)ViewBag.isLeader)
		 {
						<a href="@Url.Action("member", "request", requestModel)">@request.TotalChangeShift</a>
		 }
		 else
		 {
						<a href="@Url.Action("hrview", "request", requestModel)">@request.TotalChangeShift</a>
		 }
	 }
				</td>
				<td class="@(request.TotalLateIn > ViewBag.MaxRequest ? "overloadRequest" : string.Empty)">
					@if (request.TotalLateIn > 0)
	 {
		 requestModel.RequestType = 2;

		 if ((bool)ViewBag.isLeader)
		 {
						<a href="@Url.Action("member", "request", requestModel)">@request.TotalLateIn</a>
		 }
		 else
		 {
						<a href="@Url.Action("hrview", "request", requestModel)">@request.TotalLateIn</a>
		 }
	 }
				</td>
				<td class="@(request.TotalEarlyOut > ViewBag.MaxRequest ? "overloadRequest" : string.Empty)">
					@if (request.TotalEarlyOut > 0)
	 {
		 requestModel.RequestType = 2;

		 if ((bool)ViewBag.isLeader)
		 {
						<a href="@Url.Action("member", "request", requestModel)">@request.TotalEarlyOut</a>
		 }
		 else
		 {
						<a href="@Url.Action("hrview", "request", requestModel)">@request.TotalEarlyOut</a>
		 }
	 }
				</td>
				<td class="@(request.TotalCheckInOut > ViewBag.MaxRequest ? "overloadRequest" : string.Empty)">
					@if (request.TotalCheckInOut > 0)
	 {
		 requestModel.RequestType = 1;

		 if ((bool)ViewBag.isLeader)
		 {
						<a href="@Url.Action("member", "request", requestModel)">@request.TotalCheckInOut</a>
		 }
		 else
		 {
						<a href="@Url.Action("hrview", "request", requestModel)">@request.TotalCheckInOut</a>
		 }
	 }
				</td>
			</tr>  
	  }
  }
  else
  { 
			@RazorHelper.DisplayNoInformation(colspan: 10);
  }
	</tbody>
</table>
