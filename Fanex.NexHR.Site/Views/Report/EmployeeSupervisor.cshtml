@using Fanex.NexHR.Resources
@model EmployeeAndSectionSupervisorViewModel

@{
    Layout = "~/Views/Shared/_NewLayout.cshtml";
    ViewBag.Title = Labels.EmployeeSupervisor;
}
@section css{
    @Url.CombresLink("reportsupervisorcss")
}
@section js{
    @Url.CombresLink("employeesupervisorreportjs")
}
@section Breadcrumb {
    <a class="step">@Labels.HRSpace</a>
    <a class="step" href="@Url.Action("index", "report")">@Labels.Reports</a>
    <a class="step">@ViewBag.Title</a>
}
<h2>@ViewBag.Title</h2>
<form class="form-filter">
    @Html.HiddenFor(model => model.SectionIds)
    @Html.HiddenFor(model => model.IsLocal)
    @Html.HiddenFor(model => model.EmployeeId)
    <div class="container_24 bunhat">
        <div class="grid_2 gridlabel">
            <label for="Employee">@Labels.Employee</label>
        </div>
        <div class="grid_6">
            @Html.TextBox("Employee", "", new { placeholder = Messages.SearchEmployeeWatermark })
        </div>
        <div class="grid_2 gridlabel">@Labels.DepartmentSection</div>
        <div class="grid_6" id="Section"></div>
        <div class="grid_2 gridlabel">@Labels.Category</div>
        <div class="grid_3">
            @RazorHelper.CategoryDropDownList("category", "category", "")
        </div>
        <div class="clear"></div>
        <div class="space"></div>
        <div class="clear"></div>
        <div class="space"></div>
        <div class="grid_2 gridlabel">&nbsp;</div>
        <div class="grid_5">
            <input id="btnSubmit" type="button" value="@Labels.Submit" />
            <input id="btnExcel" type="button" value="@Labels.Excel" />
        </div>
        <div class="clear"></div>
    </div>
</form>
<div id="EmployeeSupervisorDetails"></div>