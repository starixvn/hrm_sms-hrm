@using Fanex.NexHR.ViewModels.Request
@model ReportFilterViewModel

@{
    ViewBag.Title = Labels.ReportWorkingHours;
    var hasPermission = (bool)ViewBag.HasPermission;
}
@section css{
    @Url.CombresLink("totalworkinghourcss")
    @Url.CombresLink("sitecss")
}
@section js{
    @Url.CombresLink("totalworkinghourjs")
}

@section Breadcrumb {
    <a class="step">HR</a>
    <a class="step" href="@Url.Action("index", "report")">@Labels.Reports</a>
    <a class="step">@ViewBag.Title</a>
}
<h2>@ViewBag.Title</h2>
@using (Html.BeginForm())
{
    @Html.Hidden("DateTime-Now", DateTime.Now.ToString("MMMM dd, yyyy"))
    <div class="container_24 bunhat">
        <div class="grid_2 gridlabel">
            @Labels.DateRange
        </div>
        <div class="grid_7">
            <select id="Date" name="Date">
                <option value="0">
                    @Labels.DateRange
                </option>
                <option value="1">
                    @Labels.ToDay
                </option>
                <option value="2">
                    @Labels.Yesterday
                </option>
                <option value="3">
                    @Labels.CurrentWeek
                </option>
                <option value="4">
                    @Labels.LastWeek
                </option>
                <option value="5">
                    @Labels.CurrentMonth
                </option>
                <option value="6">
                    @Labels.LastMonth
                </option>
                <option value="7">
                    @Labels.SinceLastMonth
                </option>
            </select>
            @Html.Hidden("DateOption", Model.DateOption)
        </div>
        <div class="grid_2 gridlabel">
            @Html.LabelFor(model => model.FromDate)
        </div>
        <div class="grid_6">
            @Html.DatePickerFor(model => model.FromDate, minDate: new DateTime(2010, 01, 01), maxDate: DateTime.Now)
        </div>
        <div class="grid_2 gridlabel">
            @Html.LabelFor(model => model.ToDate)
        </div>
        <div class="grid_4">
            @Html.DatePickerFor(model => model.ToDate, minDate: new DateTime(2010, 01, 01), maxDate: DateTime.Now)
        </div>
        <div class="clear"></div>
        <div class="space"></div>
        <div class="grid_2 gridlabel">
            <label for="IsLocal">@Labels.Category</label>
        </div>
        <div class="grid_7">
            @RazorHelper.CategoryDropDownList("IsLocal", Model.IsLocal.ToString())
        </div>
        <div class="grid_2 gridlabel">
            @Labels.Section
        </div>
        <div class="grid_6">
            <select id="TeamId" multiple="multiple" name="TeamId">
                @{
                    var teamIds = ViewBag.TeamIds != null ? ((string)ViewBag.TeamIds).Split(',') : null;
                    var selected = string.Empty;
                    foreach (Team team in ViewBag.Groups)
                    {
                        selected = string.Empty;
                        if (teamIds != null)
                        {
                            int pos = Array.IndexOf(teamIds, team.Id.ToString());
                            if (pos > -1)
                            {
                                selected = "selected";
                            }
                        }
                        <option @selected value="@team.Id">@team.Name</option>
                    }
                }
            </select>
        </div>
        <div class="grid_2 gridlabel">
            @Html.LabelFor(model => model.Employee)
        </div>
        <div class="grid_4">
            @Html.TextBox("Employee", Model.Employee, new { placeholder = Messages.SearchEmployeeWatermark })
            @Html.HiddenFor(model => model.EmployeeId)
        </div>
        <div class="clear"></div>
        <div class="space"></div>
        <div class="clear"></div>
        <div class="space"></div>

        <div class="grid_5 prefix_2">
            <input id="btnSubmit" type="submit" value="@Labels.Submit" class="processing-submit" />
            <input id="btnExcel" type="button" value="Excel" />
        </div>
        <div class="clear"></div>
    </div>
                    }
<table class="table table-custom persist-area">
    <thead class="persist-header">
        <tr>
            <th colspan="5">Employee Info</th>
            <th colspan="2">Contract Working Agreement</th>
            <th colspan="2">Actual Working Time in/out</th>
            <th colspan="7">Total Working Days for Salary Payment</th>
            <th colspan="5">Unpaid Leave</th>
            <th colspan="4">Over Time</th>
        <tr>
        <tr>
            <th rowspan="2">@Labels.SymbolCount</th>
            <th>@Labels.Code</th>
            <th>@Labels.FullName</th>
            <th>@Labels.NickName</th>
            <th>@Labels.Section</th>
            <th>@Labels.WorkingDaysMonth</th>
            <th>@Labels.HoursPerDay</th>
            <th>@Labels.TotalOvertimeHours</th>
            <th>@Labels.ExcelTotalDays</th>
            <th>@Labels.WorkingDays</th>
            <th>@Labels.AL</th>
            <th>@Labels.BusinessTrip</th>
            <th>@Labels.ShortBereavementLeave</th>
            <th>@Labels.ShortCompensationLeave</th>
            <th>@Labels.ShortWeddingLeave</th>
            <th>@Labels.ExcelTotalDays</th>
            <th>@Labels.UPL</th>
            <th>@Labels.ExcelSick</th>
            <th>@Labels.Paternity</th>
            <th>@Labels.Maternity</th>
            <th>@Labels.ExcelTotalDays</th>
            <th>@Labels.Normal</th>
            <th>@Labels.Off</th>
            <th>@Labels.ShortOTPublicHours</th>
            <th>@Labels.Tax</th>
        </tr>
    </thead>
    @if (ViewBag.EntityList.Count > 0)
    {
        <tbody>
            @{int index = 1;}
            @foreach (TotalWorkingHours item in ViewBag.EntityList)
            {
                var requestModel = new RequestViewModel
                {
                    DateOption = Model.DateOption,
                    FromDate = Model.FromDate,
                    ToDate = Model.ToDate,
                    EmployeeId = item.Employee.Id,
                    Employee = item.Employee.NickName + " (" + item.Employee.FullName + ")",
                    TeamIds = string.Empty,
                    StatusId = 0,
                    RequestType = (int)RequestFilter.Leave,
                    ViewType = RequestViewType.CompanySpace
                };
                <tr>
                    <td>
                        @(index++)
                    </td>
                    <td>@item.Employee.Code</td>
                    <td class="align-left">@item.Employee.FullName</td>
                    <td>@item.Employee.NickName</td>
                    <td>@item.Employee.Team.Name</td>
                    <td>@item.WorkingDay</td>
                    <td>@item.WorkingHours</td>
                    <td>@Utilities.DisplayFloatNumber(item.TotalHours)</td>
                    <td>@Utilities.DisplayFloatNumber(item.ActualWorkingDay)</td>
                    <td>@Utilities.DisplayFloatNumber(item.PaymentWorkingDay)</td>
                    <td>@Utilities.DisplayEmptyFloatNumber(item.AnnualLeave)</td>
                    <td>@Utilities.DisplayEmptyFloatNumber(item.BusinessTrip)</td>
                    <td>@Utilities.DisplayEmptyFloatNumber(item.BereavementLeave)</td>
                    <td>@Utilities.DisplayEmptyFloatNumber(item.Compensationleave)</td>
                    <td>@Utilities.DisplayEmptyFloatNumber(item.WeddingLeave)</td>
                    <td>@Utilities.DisplayFloatNumber(item.TotalPaymentWorkingDay)</td>
                    <td>
                        @if (item.UnpaidLeave > 0 && hasPermission)
                        {
                            <a href="@Url.Action("hrview", "request", requestModel)">
                                @Utilities.DisplayEmptyFloatNumber(item.UnpaidLeave)
                            </a>
                        }
                        else
                        {
                            @Utilities.DisplayEmptyFloatNumber(item.UnpaidLeave)
                        }
                    </td>
                    <td>@Utilities.DisplayEmptyFloatNumber(item.TotalUnpaidLeaveInsurance)</td>
                    <td>@Utilities.DisplayEmptyFloatNumber(item.PeternityLeave)</td>
                    <td>@Utilities.DisplayEmptyFloatNumber(item.MaternityLeave)</td>
                    <td>@Utilities.DisplayFloatNumber(item.TotalUnpaidLeaveInsurance)</td>
                    <td>@Utilities.DisplayFloatNumber(item.OTNormalHours)</td>
                    <td>@Utilities.DisplayFloatNumber(item.OTOffHours)</td>
                    <td>@Utilities.DisplayFloatNumber(item.OTPublicHours)</td>
                    <td></td>
                </tr>
            }
        </tbody>
                }
                else
                {
                    @RazorHelper.DisplayNoInformation(colspan: 13);
                }
</table>