@using Fanex.NexHR.Resources
@using Fanex.NexHR.Core
@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Models.Report.Overtime
@using Fanex.NexHR.ViewModels.Report.Overtime
@model DailyOvertimeDetailsViewModel
@{
    Layout = "~/Views/Shared/_NewLayout.cshtml";
    ViewBag.Title = Labels.OvertimeDetailsReport;
    HtmlHelper.ClientValidationEnabled = false;
}
@section css{
    <link href="~/wwwroot/dist/styles/report.dailyovertime.css" rel="stylesheet" />
}
@section js{
    <script src="~/wwwroot/dist/js/report.dailyovertime.js"></script>
}
@section Breadcrumb {
    <a class="step">@Labels.HRSpace</a>
    <a class="step" href="@Url.Action("index", "report")">@Labels.Reports</a>
    <a class="step">@ViewBag.Title</a>
}
<h2 class="page-title">@ViewBag.Title</h2>
<form class="filter">
    @Html.HiddenFor(model => model.SectionIds)
    <div class="form-horizontal clearfix">
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.Label(Labels.FromDate, new { @class = "control-label" })
            </div>
            <div class="calendar-form">
                @Html.TextBox("FromDate", Model.FromDate.ToDateMonthYearFormatedDate(),
                    new {
                        @class = "datepicker form-control",
                        mindate = new DateTime(2010, 1, 1).ToString("yyyy/MM/dd"),
                        maxdate = DateTime.Now.ToString("yyyy/MM/dd"),
                        disabledDate = string.Empty
                    })
                <i class="icon-calendar fa fa-calendar"></i>
            </div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.Label(Labels.ToDate, new { @class = "control-label" })
            </div>
            <div class="calendar-form">
                @Html.TextBox("ToDate", Model.ToDate.ToDateMonthYearFormatedDate(),
                    new {
                        @class = "datepicker form-control",
                        mindate = new DateTime(2010, 1, 1).ToString("yyyy/MM/dd"),
                        maxdate = DateTime.Now.ToString("yyyy/MM/dd"),
                        disabledDate = string.Empty
                    })
                <i class="icon-calendar fa fa-calendar"></i>
            </div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.Label(Labels.Category, new { @class = "control-label" })
            </div>
            <div class="select-form">
                @RazorHelper.CategoryDropDownList("IsLocal", classHTML: "form-control",
                    selectedId: Model.IsLocal.HasValue ? Model.IsLocal.Value.ToString(): string.Empty)
            </div>
        </div>
    </div>
    <div class="form-horizontal clearfix">
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.Label(Labels.Section, new { @class = "control-label" })
            </div>
            <div class="select-form">
                @Html.DropDownList("Section", new SelectList(Model.Sections, "Id", "Name"), new { multiple = "multiple" })
            </div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.Label(Labels.Employee, new { @class = "control-label" })
            </div>
            <div class="input-form">
                @Html.TextBox("Employee", string.Empty, new { placeholder = Messages.SearchEmployeeWatermark, @class = "form-control" })
                @Html.HiddenFor(model => model.EmployeeId)
            </div>
        </div>
        <div class="form-group form-group--m">
            <button class="btn btn-primary">@Labels.Search</button>
            <button type="button" class="btn btn-excel" id="btnExcel">@Labels.Excel</button>
        </div>
    </div>
</form>
<table class="table table-custom" id="data">
    <thead>
        <tr>
            <th>@Labels.Date</th>
            <th>@Labels.Code</th>
            <th>@Labels.FullName</th>
            <th>@Labels.NickName</th>
            <th>@Labels.Shift</th>
            <th>@Labels.TimeIn</th>
            <th>@Labels.TimeOut</th>
            <th>@Labels.TotalHours</th>
            <th>@Labels.NormalDay</th>
            <th>@Labels.OffDay</th>
            <th>@Labels.PublicHoliday</th>
            <th>@Labels.SpecialOT</th>
            <th>@Labels.Remark</th>
            <th>@Labels.Status</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Overtimes.Any())
        {
            foreach (DailyOvertimeDetails request in Model.Overtimes)
            {
                <tr>
                    <td>@request.WorkDate.ToDateMonthYearFormatedDate()</td>
                    <td>@request.Code</td>
                    <td class="align-left">@request.FullName</td>
                    <td class="align-left">@request.Nickname</td>
                    <td>@request.ShiftCode</td>
                    <td>@request.TimeIn</td>
                    <td>@request.TimeOut</td>
                    <td>
                        @if (request.ActualWorkingHours > 0)
                        {
                            @request.ActualWorkingHours
                        }
                    </td>
                    <td>
                        @if (request.NormalHours > 0)
                        {
                            @request.NormalHours
                        }
                    </td>
                    <td>
                        @if (request.OffHours > 0)
                        {
                            @request.OffHours
                        }
                    </td>
                    <td>
                        @if (request.PublicHours > 0)
                        {
                            @request.PublicHours
                        }
                    </td>
                    <td>
                        @if (request.SpecialHours > 0)
                        {
                            @request.SpecialHours
                        }
                    </td>
                    <td class="align-left">@request.Remark</td>
                    <td>
                        @if (request.StatusId != 0)
                        {
                            CurrentRequestStatus status = (CurrentRequestStatus)request.StatusId;
                            @status
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            @RazorHelper.DisplayNoInformation(colspan: 14)
        }
    </tbody>
</table>