@using Fanex.NexHR.Resources
@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Models.Report.Overtime
@model IEnumerable<DailyOvertimeDetails>
@{
    var month = (DateTime)ViewBag.Month;
    var employee = Model != null && Model.Any() ? string.Format("{0} ({1})", Model.First().Nickname, Model.First().FullName) : string.Empty;
    ViewBag.Title = employee + " 's " + Labels.OvertimeReport + " in " + month.ToString("MMM-yyyy");
}
@section css{
    <link href="~/wwwroot/dist/styles/overtime.details.css" rel="stylesheet" />
}
@section js{
}
@section Breadcrumb {
    <a class="step">@Labels.Personal</a>
    <a class="step" href="@Url.Action("index", "report")">@Labels.Reports</a>
    <a class="step" href="@Url.Action("YearlyOvertime", "OvertimeReport")">@Labels.YearlyOvertimeReport</a>
    <a class="step">@employee's @Labels.OvertimeReport Details</a>
}

<div class="header-control">
    <h2 class="page-title">@ViewBag.Title</h2>
    <button type="button" class="btn btn-default" onclick="window.history.back()">@Labels.Back</button>
</div>

<table class="table table-custom" id="data">
    <thead>
        <tr>
            <th>@Labels.Date</th>
            <th>@Labels.Shift</th>
            <th>@Labels.TimeIn</th>
            <th>@Labels.TimeOut</th>
            <th>@Labels.TotalHours</th>
            <th>@Labels.NormalDay</th>
            <th>@Labels.OffDay</th>
            <th>@Labels.PublicHoliday</th>
            <th>@Labels.SpecialOT</th>
            <th>@Labels.Remark</th>
            <th>@Labels.Status</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (DailyOvertimeDetails request in Model)
            {
                <tr>
                    @{
                        var className = string.Empty;
                        if (request.IsHoliday)
                        {
                            className = "holiday";
                        }
                        else if (request.WorkDate.DayOfWeek == DayOfWeek.Saturday || request.WorkDate.DayOfWeek == DayOfWeek.Sunday)
                        {
                            className = "weekend";
                        }
                    }
                    <td class="@className">
                        @request.WorkDate.ToString("dd-MMM-yyyy (ddd)")
                    </td>
                    <td>@request.ShiftCode</td>
                    <td>@request.TimeIn</td>
                    <td>@request.TimeOut</td>
                    <td>
                        @if (request.ActualWorkingHours > 0)
                        {
                            @request.ActualWorkingHours
                        }
                    </td>
                    <td>
                        @if (request.NormalHours > 0)
                        {
                            @request.NormalHours
                        }
                    </td>
                    <td>
                        @if (request.OffHours > 0)
                        {
                            @request.OffHours
                        }
                    </td>
                    <td>
                        @if (request.PublicHours > 0)
                        {
                            @request.PublicHours
                        }
                    </td>
                    <td>
                        @if (request.SpecialHours > 0)
                        {
                            @request.SpecialHours
                        }
                    </td>
                    <td class="align-left">@request.Remark</td>
                    <td>
                        @if (request.StatusId != 0)
                        {
                            CurrentRequestStatus status = (CurrentRequestStatus)request.StatusId;
                            @status
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            @RazorHelper.DisplayNoInformation(colspan: 11)
        }
    </tbody>
    <tfoot>
        <tr class="summary">
            <td class="align-right" colspan="5">@Labels.TotalOvertimeHours:</td>
            <td>@Model.Sum(t => t.NormalHours).ToString("0.00")</td>
            <td>@Model.Sum(t => t.OffHours).ToString("0.00")</td>
            <td>@Model.Sum(t => t.PublicHours).ToString("0.00")</td>
            <td>@Model.Sum(t => t.SpecialHours).ToString("0.00")</td>
            <td></td>
            <td></td>
        </tr>
    </tfoot>
</table>