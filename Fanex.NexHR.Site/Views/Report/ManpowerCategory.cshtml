@model ManpowerCategoryViewModel
@{
    ViewBag.Title = @Labels.ManpowerCategory;
}
@section css{
    @Url.CombresLink("manpowerreportcss")
}
@section js{
    @Url.CombresLink("manpowercategoryreportjs")
}
@section Breadcrumb {
    <a class="step">@Labels.HRSpace</a> <a class="step" href="@Url.Action("index", "report")">@Labels.Reports</a>
    <a class="step">@ViewBag.Title</a>
}
<h2>
    @ViewBag.Title
</h2>
@using (Html.BeginGetForm())
{
    <div class="container_24 bunhat">
        <div class="grid_1 gridlabel">
            @Labels.Year
        </div>
        <div class="grid_2">
            @Html.YearPicker("Year", 2010, Model.Year)
        </div>
        <div class="grid_6">
            <input type="submit" value="@Labels.Submit" id="btnSubmit" />
            <input type="button" value="Excel" id="btnExcel" />
        </div>
    </div>
}
<div class="clear"></div>
<div class="space"></div>
<table id="data" class="table table-custom persist-area">
    <thead class="persist-header">
        <tr>
            <th rowspan="2">@Labels.SymbolCount</th>
            <th rowspan="2">@Labels.Team</th>
            <th colspan="3">@Labels.TotalManpower</th>
            <th colspan="10">@Labels.JobCategory</th>
        </tr>
        <tr>
            <th>@Labels.Expat</th>
            <th>@Labels.Local</th>
            <th>@Labels.Total</th>
            <th colspan="2">@Labels.Management</th>
            <th colspan="2">@Labels.ExecutiveWithPosition</th>
            <th colspan="2">@Labels.Executive</th>
            <th colspan="2">@Labels.Staff</th>
            <th colspan="2">@Labels.Worker</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Manpowers != null && Model.Manpowers.Any())
        {
            int index = 0;
            foreach (ManpowerCategoryModel manpower in Model.Manpowers)
            {
                index++;
                <tr>
                    <td>@index</td>
                    <td class="tooltip" title="@manpower.GroupName">
                        @manpower.GroupCode
                    </td>
                    <td class="align-right">
                        @manpower.TotalExpat
                    </td>
                    <td class="align-right">
                        @manpower.TotalLocal
                    </td>
                    <td class="align-right">
                        @manpower.Total
                    </td>
                    <td class="align-right">
                        @manpower.Management
                    </td>
                    <td class="align-right">
                        @if (manpower.Total != 0)
                        {
                            @((manpower.Management * 100.00 / manpower.Total).ToString("0.0") + "%")
                        }
                        else
                        {
                            @("0.0%")
                        }
                    </td>
                    <td class="align-right">
                        @manpower.ExecutiveWithPosition
                    </td>
                    <td class="align-right">
                        @if (manpower.Total != 0)
                        {
                            @((manpower.ExecutiveWithPosition * 100.00 / manpower.Total).ToString("0.0") + "%")
                        }
                        else
                        {
                            @("0.0%")
                        }
                    </td>
                    <td class="align-right">
                        @manpower.Executive
                    </td>
                    <td class="align-right">
                        @if (manpower.Total != 0)
                        {
                            @((manpower.Executive * 100.00 / manpower.Total).ToString("0.0") + "%")
                        }
                        else
                        {
                            @("0.0%")
                        }
                    </td>
                    <td class="align-right">
                        @manpower.Staff
                    </td>
                    <td class="align-right">
                        @if (manpower.Total != 0)
                        {
                            @((manpower.Staff * 100.00 / manpower.Total).ToString("0.0") + "%")
                        }
                        else
                        {
                            @("0.0%")
                        }
                    </td>
                    <td class="align-right">
                        @manpower.Worker
                    </td>
                    <td class="align-right">
                        @if (manpower.Total != 0)
                        {
                            @((manpower.Worker * 100.00 / manpower.Total).ToString("0.0") + "%")
                        }
                        else
                        {
                            @("0.0%")
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            @RazorHelper.DisplayNoInformation(colspan: 42)
        }
    </tbody>
    <tfoot>
        <tr class="summary">
            @{
                int total = Model.Manpowers.Sum(t => t.Total),
                    management = Model.Manpowers.Sum(t => t.Management),
                    executiveWithPosition = Model.Manpowers.Sum(t => t.ExecutiveWithPosition),
                    executive = Model.Manpowers.Sum(t => t.Executive),
                    staff = Model.Manpowers.Sum(t => t.Staff),
                    worker = Model.Manpowers.Sum(t => t.Worker);
            }
            <td colspan="2" class="align-right">
                @Labels.Total
            </td>
            <td class="align-right">@Model.Manpowers.Sum(t => t.TotalExpat)</td>
            <td class="align-right">@Model.Manpowers.Sum(t => t.TotalLocal)</td>
            <td class="align-right">@Model.Manpowers.Sum(t => t.Total)</td>
            <td class="align-right">@management</td>
            <td class="align-right">
                @if (total != 0)
                {
                @((management * 100.00 / total).ToString("0.0") + "%")
                }
                else
                {
                @("0.0%")
                }
            </td>
            <td class="align-right">@executiveWithPosition</td>
            <td class="align-right">
                @if (total != 0)
                {
                @((executiveWithPosition * 100.00 / total).ToString("0.0") + "%")
                }
                else
                {
                @("0.0%")
                }
            </td>
            <td class="align-right">@executive</td>
            <td class="align-right">
                @if (total != 0)
                {
                @((executive * 100.00 / total).ToString("0.0") + "%")
                }
                else
                {
                @("0.0%")
                }
            </td>
            <td class="align-right">@staff</td>
            <td class="align-right">
                @if (total != 0)
                {
                    @((staff * 100.00 / total).ToString("0.0") + "%")
                }
                else
                {
                    @("0.0%")
                }
            </td>
            <td class="align-right">@worker</td>
            <td class="align-right">
                @if (total != 0)
                {
                    @((worker * 100.00 / total).ToString("0.0") + "%")
                }
                else
                {
                    @("0.0%")
                }
            </td>
        </tr>
    </tfoot>
</table>