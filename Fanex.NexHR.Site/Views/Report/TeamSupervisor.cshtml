@{
	ViewBag.Title = "Staff Supervisor";
}
@section css{
	@Url.CombresLink("staffrepresentativecss")
}
@section js{
	@Url.CombresLink("staffrepresentativjs")
}
@section Breadcrumb {
	<a class="step">HR</a>
	<a class="step">@ViewBag.Title</a>
}
@using (Html.BeginForm())
{        
	<div class="container_24 bunhat">
		<div class="grid_1 gridlabel">@Labels.Team</div>
		<div class="grid_6">
			<select id="group" multiple="multiple" class="team-select">
				@foreach (Team item in ViewBag.Groups)
	{ 
					<option value="@item.Id">@item.Name</option>
	}
			</select>
		</div>
		<div class="grid_5">
			<input id="submitTeam" type="button" value="@Labels.Submit"/>
			<input id="excelTeam" type="button" value="Excel" />
		</div>
		<div class="clear">
		</div>
	</div>
}
<div id="TeamSupervisorDetails">
</div>
