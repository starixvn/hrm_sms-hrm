@model IList<Fanex.NexHR.Models.Report.WeekendLeaveDetail>

<table id="data" class="table table-custom discipline-summary">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th>@Labels.Section</th>
            <th>@Labels.Code</th>
            <th>@Labels.Nick</th>
            <th>@Labels.FullName</th>
            <th>@Labels.Category</th>
            <th>@Labels.LeaveDate</th>
            <th>@Labels.LeaveType</th>
            <th>@Labels.LeaveDay</th>
        </tr>
    </thead>
    @if (Model != null && Model.Any())
    {
        int index = 0;
        <tbody>
            @foreach (Fanex.NexHR.Models.Report.WeekendLeaveDetail item in Model)
                {
                    index++;
                <tr>
                    <td>@index</td>
                    <td>@item.GroupName</td>
                    <td>@item.Code</td>
                    <td>@item.NickName</td>
                    <td class="align-left">@item.FullName</td>
                    <td>
                        @if (item.IsLocal)
                        {
                            <span>@Labels.Local</span>
                        }
                        else
                        {
                            <span>@Labels.Expat</span>
                        }
                    </td>
                    <td>@item.LeaveDate</td>
                    <td>@item.LeaveType</td>
                    <td>@item.LeaveDay</td>
                </tr>
                }
        </tbody>
                }
                else
                {
                    @RazorHelper.DisplayNoInformation(colspan: 18);
                }
</table>