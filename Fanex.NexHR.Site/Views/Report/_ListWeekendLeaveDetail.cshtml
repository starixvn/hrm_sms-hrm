@using Fanex.NexHR.Models.Report;
@model IList<WeekendLeaveDetail>

<table id="data" class="table table-custom discipline-summary">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th>@Labels.Section</th>
            <th>@Labels.Code</th>
            <th>@Labels.Nick</th>
            <th>@Labels.FullName</th>
            <th>@Labels.Category</th>
            <th>@Labels.LeaveDate</th>
            <th>@Labels.LeaveType</th>
            <th>@Labels.LeaveDay</th>
            <th>@Labels.EmployeeComment</th>
            <th>@Labels.ApproverComment</th>
        </tr>
    </thead>
    @if (Model != null && Model.Any())
    {
        int index = 0;
        <tbody>
            @foreach (WeekendLeaveDetail item in Model)
                {
                    index++;
            <tr>
                <td>@index</td>
                <td>@item.GroupName</td>
                <td>@item.Code</td>
                <td>@item.NickName</td>
                <td class="align-left">@item.FullName</td>
                <td>
                    @if (item.IsLocal)
                    {
                        <span>@Labels.Local</span>
                    }
                    else
                    {
                        <span>@Labels.Expat</span>
                    }
                </td>
                <td>@item.LeaveDate.ToDateMonthYearFormatedDate()</td>
                <td>@item.LeaveType</td>
                <td>@item.LeaveDay</td>
                <td class="align-left">@item.Remark</td>
                <td class="align-left">@item.ApproverComment</td>
            </tr>
                }
        </tbody>
                }
                else
                {
                    @RazorHelper.DisplayNoInformation(colspan: 9);
                }
</table>