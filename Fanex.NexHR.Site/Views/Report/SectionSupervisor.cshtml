@using Fanex.NexHR.Resources
@model EmployeeAndSectionSupervisorViewModel
@{
    Layout = "~/Views/Shared/_NewLayout.cshtml";
    ViewBag.Title = Labels.SectionSupervisor;
}
@section css{
    <link href="~/wwwroot/dist/styles/report.employee.supervisor.css" rel="stylesheet" />
}
@section js{
    <script src="~/wwwroot/dist/js/report.section.supervisor.js"></script>
}
@section Breadcrumb {
    <a class="step">@Labels.HRSpace</a>
    <a class="step" href="@Url.Action("index", "report")">@Labels.Reports</a>
    <a class="step">@ViewBag.Title</a>
}
<h2 class="page-title">@ViewBag.Title</h2>
<form class="filter">
    <div class="form-horizontal clearfix">
        @Html.HiddenFor(model => model.SectionIds)
        <div class="form-group form-group--m">

            <div class="label-form">
                <label class="control-label">@Labels.DepartmentSection</label>
            </div>
            <div class="input-form">
                <div class="grid_6" id="Section"></div>
            </div>
        </div>
        <div class="form-group form-group--m">
            <button id="btnSubmit" type="button" class="btn btn-primary">@Labels.Submit</button>
            <button id="btnExcel" type="button" class="btn btn-excel">@Labels.Excel</button>
        </div>
        <div class="clear"></div>
    </div>
</form>
<div id="SectionSupervisorDetails"></div>