@model TimesheetViewModel
@{
    ViewBag.Title = "My timesheet";
}
@section css{
    @Url.CombresLink("timesheetcss")
}
@section js{
    @Url.CombresLink("timesheetjs")
}
@section Breadcrumb {
    <a class="step">Personal</a> <span class="step">@ViewBag.Title</span>
}
<h2>@ViewBag.Title</h2>

<form class="form-filter" action="" novalidate="novalidate">
    <div class="container_24 bunhat">
        <div class="grid_1 gridlabel">@Labels.Month</div>
        <div class="grid_4">
            <div id="monthPickr"></div>
            <input type="hidden" id="Year" name="Year" value="@DateTime.Now.Year" />
            <input type="hidden" id="Month" name="Month" value="@DateTime.Now.Month" />
            <input type="hidden" id="maxDate" value="@DateTime.Now.GetMaxDate().ToString("yyyy/MM/dd")" />
            @Html.HiddenFor(model => model.EmpId)
        </div>
        <div class="grid_3">
            <input type="submit" id="btnSubmit" value="@Labels.Submit" />
        </div>
        <div class="clear"></div>
    </div>
</form>
<div id="timesheetDetails">
</div>