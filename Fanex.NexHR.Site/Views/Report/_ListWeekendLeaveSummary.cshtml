@model IList<Fanex.NexHR.Models.Report.WeekendLeaveSummary>
<table id="data" class="table table-custom discipline-summary">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th>@Labels.Section</th>
            <th>@Labels.Code</th>
            <th>@Labels.Nick</th>
            <th>@Labels.FullName</th>
            <th>@Labels.TotalWeekendLeave</th>
            <th>@Labels.Action</th>
        </tr>
    </thead>
    @if (Model != null && Model.Any())
    {
        int index = 0;
        <tbody>
            @foreach (Fanex.NexHR.Models.Report.WeekendLeaveSummary item in Model)
                {
                    index++;
                <tr>
                    <td>@index</td>
                    <td>@item.GroupName</td>
                    <td>@item.Code</td>
                    <td>@item.NickName</td>
                    <td>@item.FullName</td>
                    <td>@item.TotalWeekendLeave</td>
                    <td>
                        @{
                            var empId = item.EmployeeId;
                            var employee = item.NickName + " (" + item.FullName + ")";
                        }
                        <a href="javascript:;" class="icon view viewWeekendLeaveDetail" data-empid="@empId" data-employee="@employee"></a>
                    </td>
                </tr>
                }
        </tbody>
    }
    else
    {
        @RazorHelper.DisplayNoInformation(colspan: 18);
    }
</table>