@using Fanex.NexHR.Resources
@model LeaveSummaryViewModel
@{
    ViewBag.Title = Labels.UnpaidLeave;
    var hasPermission = (bool)ViewBag.HasPermission;
}
@section css{
    <link href="~/wwwroot/dist/styles/report.unpaid.leave.summary.css" rel="stylesheet" />
}
@section js{
    <script src="~/wwwroot/dist/js/report.unpaid.leave.summary.js"></script>
}
@section Breadcrumb {
    <a class="step">@Labels.CompanySpace</a> <a class="step">@ViewBag.Title</a>
}
<h2 class="page-title">@ViewBag.Title</h2>
@if (hasPermission)
{
    <form class="filter">
        @Html.HiddenFor(model => model.SectionIds)
        <div class="form-horizontal clearfix">
            <div class="form-group form-group--m">
                <div class="label-form">
                    @Html.Label(@Labels.Year, new { @class = "control-label" })
                </div>
                <div class="select-form">
                    @Html.YearPicker("Year", 2010, DateTime.Now.Year)
                </div>
            </div>

            <div class="form-group form-group--m">
                <div class="label-form">
                    @Html.Label(@Labels.Category, new { @class = "control-label" })
                </div>
                <div class="select-form">
                    @RazorHelper.CategoryDropDownList("Category", classHTML: "form-control", selectedId: string.Empty)
                </div>
            </div>

            <div class="form-group form-group--m">
                <div class="label-form">
                    <label class="control-label">@Labels.DepartmentSection</label>
                </div>
                <div class="select-form" id="Section"></div>
            </div>
        </div>
        <div class="form-horizontal clearfix">
            <div class="form-group form-group--m">
                <div class="label-form">
                    @Html.Label(@Labels.Type, new { @class = "control-label" })
                </div>
                <div class="select-form">
                    @Html.EnumDropDownFor(model => model.LeaveType, null, null, new { @class = "form-control" })
                </div>
            </div>
            <div class="form-group form-group--m">
                <div class="label-form">
                    @Html.Label(@Labels.Employee, new { @class = "control-label" })
                </div>
                <div class="input-form">
                    @Html.TextBox("Employee", Model.Employee, new { placeholder = Messages.SearchEmployeeWatermark, @class = "form-control" })
                    @Html.HiddenFor(model => model.EmployeeId)
                </div>
            </div>

            <div class="form-group form-group--m">
                <input type="button" class="btn btn-primary" id="btnSearch" value="@Labels.Submit" />
                <input type="button" class="btn btn-excel" id="btnExcel" value="@Labels.Excel" />
            </div>
        </div>
    </form>
}

<div id="UnpaidLeaveSummaryDetails"></div>