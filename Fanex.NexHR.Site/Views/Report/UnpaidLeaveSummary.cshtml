@model LeaveSummaryViewModel
@{
    ViewBag.Title = "Unpaid Leave";
    var hasPermission = (bool)ViewBag.HasPermission;
}
@section css{
    @Url.CombresLink("sitecss")
}
@section js{
    @Url.CombresLink("leavesummaryjs")
}
@section Breadcrumb {
    <a class="step">@Labels.CompanySpace</a> <a class="step">@ViewBag.Title</a>
}
<h2>@ViewBag.Title</h2>
@if (hasPermission)
{
    <div class="container_24 bunhat">
        @using (Html.BeginForm())
        {
            <div class="grid_2 gridlabel">
                @Html.LabelFor(model => model.Year)
            </div>
            <div class="grid_3">
                @Html.YearPickerFor(model => model.Year, 2010)
            </div>
            <div class="grid_2 gridlabel">
                @Labels.Category
            </div>
            <div class="grid_3">
                <select id="Category" name="Category" class="category">
                    <option value="">-- All --</option>
                    <option selected="@(Model.Category == 1)" value="1">@Labels.Local</option>
                    <option selected="@(Model.Category == 0)" value="0">@Labels.Expat</option>
                </select>
            </div>
            <div class="grid_2 gridlabel">
                @Labels.Section
            </div>
            <div class="grid_6">
                <select id="SectionId" multiple="multiple" name="SectionId">
                    @{
                        var sectionIds = !string.IsNullOrEmpty(Model.SectionIds) ? Model.SectionIds.Split(',') : null;
                        var selected = string.Empty;
                        foreach (Team team in Model.Sections)
                        {
                            selected = string.Empty;
                            if (sectionIds != null)
                            {
                                int pos = Array.IndexOf(sectionIds, team.Id.ToString());
                                if (pos > -1)
                                {
                                    selected = "selected";
                                }
                            }
                            <option @selected value="@team.Id">@team.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="clear"></div>
            <div class="space"></div>
            <div class="grid_2 gridlabel">
                @Html.LabelFor(model => model.Employee)
            </div>
            <div class="grid_7">
                @Html.TextBox("Employee", Model.Employee, new { placeholder = Messages.SearchEmployeeWatermark })
                @Html.HiddenFor(model => model.EmployeeId)
            </div>
            <div class="grid_5 prefix_1">
                <input type="submit" value="@Labels.Submit" class="processing-submit" />
                <input type="button" value="Excel" id="btnExcel" />
            </div>
            <div class="clear"></div>
            <div class="space"></div>
        }
    </div>
    <div class="clear">
    </div>
}
<table class="table table-custom persist-area">
    <thead class="persist-header">
        <tr>
            <th rowspan="2">
                @Labels.SymbolCount
            </th>
            <th rowspan="2">
                @Labels.NickName
            </th>
            <th rowspan="2">
                @Labels.FullName
            </th>
            <th colspan="12">
                Take Unpaid Leave @Model.Year
            </th>
            <th rowspan="2">
                Total of UPL @Model.Year
            </th>
        </tr>
        <tr>
            <th>@Labels.Jan</th>
            <th>@Labels.Feb</th>
            <th>@Labels.Mar</th>
            <th>@Labels.Apr</th>
            <th>@Labels.May</th>
            <th>@Labels.Jun</th>
            <th>@Labels.Jul</th>
            <th>@Labels.Aug</th>
            <th>@Labels.Sep</th>
            <th>@Labels.Oct</th>
            <th>@Labels.Nov</th>
            <th>@Labels.Dec</th>
        </tr>
    </thead>
    @{
        bool checkSummaryList = true;
        foreach (LeaveSummaryByTeam leaveSumaryByTeam in ViewBag.LeaveSummaryByTeamList)
        {
            if (leaveSumaryByTeam.LeaveSummaryInTeam.Count > 0)
            {
                checkSummaryList = true;
                break;
            }
            else
            {
                checkSummaryList = false;
            }
        }
    }
    @if (checkSummaryList)
    {
        <tbody>
            @{int index = 1;}
            @foreach (LeaveSummaryByTeam item in ViewBag.LeaveSummaryByTeamList)
            {
                if (item.LeaveSummaryInTeam.Count > 0)
                {
                    <tr>
                        <td class="rowdivider align-left" colspan="18">
                            <b>@item.Team.Name.ToUpper()</b>
                        </td>
                    </tr>
                }
                foreach (LeaveSummary leave in item.LeaveSummaryInTeam)
                {
                    <tr>
                        <td>
                            @(index++)
                        </td>
                        <td class="tooltip align-left" title="@leave.Employee.FullName">
                            @leave.Employee.NickName
                        </td>
                        <td class="align-left">
                            @leave.Employee.FullName
                        </td>
                        @if (leave.Jan > 0)
                        {
                            <td>
                                @leave.Jan.ToString("0.0")
                            </td>
                        }
                        else
                        {
                            <td></td>
                        }
                        @if (leave.Feb > 0)
                        {
                            <td>
                                @leave.Feb.ToString("0.0")
                            </td>
                        }
                        else
                        {
                            <td></td>
                        }
                        @if (leave.Mar > 0)
                        {
                            <td>
                                @leave.Mar.ToString("0.0")
                            </td>
                        }
                        else
                        {
                            <td></td>
                        }
                        @if (leave.Apr > 0)
                        {
                            <td>
                                @leave.Apr.ToString("0.0")
                            </td>
                        }
                        else
                        {
                            <td></td>
                        }
                        @if (leave.May > 0)
                        {
                            <td>
                                @leave.May.ToString("0.0")
                            </td>
                        }
                        else
                        {
                            <td></td>
                        }
                        @if (leave.Jun > 0)
                        {
                            <td>
                                @leave.Jun.ToString("0.0")
                            </td>
                        }
                        else
                        {
                            <td></td>
                        }
                        @if (leave.Jul > 0)
                        {
                            <td>
                                @leave.Jul.ToString("0.0")
                            </td>
                        }
                        else
                        {
                            <td></td>
                        }
                        @if (leave.Aug > 0)
                        {
                            <td>
                                @leave.Aug.ToString("0.0")
                            </td>
                        }
                        else
                        {
                            <td></td>
                        }
                        @if (leave.Sep > 0)
                        {
                            <td>
                                @leave.Sep.ToString("0.0")
                            </td>
                        }
                        else
                        {
                            <td></td>
                        }
                        @if (leave.Oct > 0)
                        {
                            <td>
                                @leave.Oct.ToString("0.0")
                            </td>
                        }
                        else
                        {
                            <td></td>
                        }
                        @if (leave.Nov > 0)
                        {
                            <td>
                                @leave.Nov.ToString("0.0")
                            </td>
                        }
                        else
                        {
                            <td></td>
                        }
                        @if (leave.Dec > 0)
                        {
                            <td>
                                @leave.Dec.ToString("0.0")
                            </td>
                        }
                        else
                        {
                            <td></td>
                        }
                        @if (leave.LeaveBalance > 0)
                        {
                            <td>
                                @leave.LeaveBalance.ToString("0.0")
                            </td>
                        }
                        else
                        {
                            <td></td>
                        }
                    </tr>
                }
            }
        </tbody>
    }
    else
    {
        @RazorHelper.DisplayNoInformation(18)
    }
</table>