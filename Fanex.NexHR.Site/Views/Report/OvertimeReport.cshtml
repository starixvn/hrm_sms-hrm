@using Fanex.NexHR.Resources
@{
    ViewBag.Title = "Monthly Overtime Report";
}
@section css{
    @Url.CombresLink("reportovertimerequestcss")
}
@section js{
    @Url.CombresLink("reportovertimerequestjs")
}
@section Breadcrumb {
    <a class="step">HR</a> <a class="step" href="@Url.Action("index", "report")">@Labels.Reports</a>
    <a class="step">@ViewBag.Title</a>
}
<h2>@ViewBag.Title</h2>
@using (Html.BeginForm())
{
    <div class="container_24 bunhat">
        <div class="grid_2 gridlabel">@Labels.Month</div>
        <div class="grid_7">
            <div id="DateControl"></div>
            <input type="hidden" id="Year" name="Year" value="@ViewBag.Year" />
            <input type="hidden" id="Month" name="Month" value="@ViewBag.Month" />
            @Html.Hidden("MinDate", DateTime.Now.AddYears(-2).ToDateMonthYearFormatedDate())
            @Html.Hidden("MaxDate", DateTime.Now.AddMonths(1).ToDateMonthYearFormatedDate())
        </div>
        <div class="grid_2 gridlabel">Calendar</div>
        <div class="grid_5">
            @{
                var calendarType = new List<SelectListItem>
                {
                    new SelectListItem() {Text = "Fiscal", Value = "1"}, 
                    new SelectListItem() {Text = "Normal", Value = "0"},
                };
            }
            @Html.DropDownList("calendar", calendarType)
        </div>
        <div class="clear"></div>
        <div class="space"></div>
        <div class="grid_2 gridlabel">@Labels.Employee</div>
        <div class="grid_7">
            @Html.TextBox("Employee", string.Empty, new { placeholder = Messages.SearchEmployeeWatermark })
            @Html.Hidden("EmployeeId")
        </div>
        <div class="grid_2 gridlabel">&nbsp;</div>
        <div class="grid_6">
            <input id="btnExcel" type="button" value="Excel" />
        </div>
        <div class="clear"></div>
    </div>
}
