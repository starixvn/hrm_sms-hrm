@model TotalWorkingHourMonthlyViewModel
@{
    ViewBag.Title = Labels.TotalWorkingHourMonthly;
}
@section css{
    @Url.CombresLink("totalworkinghourmonthlycss")
    @Url.CombresLink("sitecss")
}
@section js{
    @Url.CombresLink("totalworkinghourmonthlyjs")
}

@section Breadcrumb {
    <a class="step">HR</a>
    <a class="step" href="@Url.Action("index", "report")">@Labels.Reports</a>
    <a class="step">@ViewBag.Title</a>
}
<h2>@ViewBag.Title</h2>
<form class="form-filter">
    @Html.HiddenFor(model => model.SectionIds)
    @Html.HiddenFor(model => model.Month)
    @Html.HiddenFor(model => model.Year)
    <div class="container_24 bunhat">
        <div class="grid_2 gridlabel">@Labels.Month</div>
        <div class="grid_6">
            <div id="DateControl"></div>
            @Html.Hidden("MinDate", DateTime.Now.AddYears(-1).ToDateMonthYearFormatedDate())
            @Html.Hidden("MaxDate", DateTime.Now.ToDateMonthYearFormatedDate())
        </div>
        <div class="grid_2 gridlabel">@Labels.Category</div>
        <div class="grid_3">
            @{
                var category = new List<SelectListItem>
                {
                    new SelectListItem() {Text = "-- All --", Value = string.Empty},
                    new SelectListItem() {Text = "Expat", Value = "0"},
                    new SelectListItem() {Text = "Local", Value = "1"},
                };
            }
            @Html.DropDownList("IsLocal", category, new { @class = "category" })
        </div>
        <div class="clear"></div>
        <div class="space"></div>
        <div class="grid_2 gridlabel">@Labels.Section</div>
        <div class="grid_6">
            @Html.DropDownList("section", new SelectList(Model.Sections, "Id", "Name"), new { multiple = "multiple" })
        </div>
        <div class="grid_2 gridlabel">
            @Html.LabelFor(model => model.Employee)
        </div>
        <div class="grid_4">
            @Html.TextBox("Employee", Model.Employee, new { placeholder = Messages.SearchEmployeeWatermark })
            @Html.HiddenFor(model => model.EmployeeId)
        </div>
        <div class="grid_5">
            <input id="btnSubmit" type="button" value="@Labels.Submit" />
            <input id="btnExcel" type="button" value="Excel" />
        </div>
        <div class="clear"></div>
    </div>
</form>
<div id="TotalWorkingHourMonthlyDetails">
</div>