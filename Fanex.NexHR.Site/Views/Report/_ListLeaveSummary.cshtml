@using Fanex.NexHR.Models
@model IList<LeaveSummaryByTeam>

    <table class="table table-custom persist-area">
        <thead class="persist-header">
            <tr>
                <th rowspan="2">
                    @Labels.SymbolCount
                </th>
                <th rowspan="2">
                    @Labels.NickName
                </th>
                <th rowspan="2">
                    @Labels.FullName
                </th>
                <th colspan="12">
                    Take @ViewBag.HeaderTitle
                </th>
                <th rowspan="2">
                    Total of @ViewBag.HeaderTitle
                </th>
            </tr>
            <tr>
                <th>@Labels.Jan</th>
                <th>@Labels.Feb</th>
                <th>@Labels.Mar</th>
                <th>@Labels.Apr</th>
                <th>@Labels.May</th>
                <th>@Labels.Jun</th>
                <th>@Labels.Jul</th>
                <th>@Labels.Aug</th>
                <th>@Labels.Sep</th>
                <th>@Labels.Oct</th>
                <th>@Labels.Nov</th>
                <th>@Labels.Dec</th>
            </tr>
        </thead>
        @{
            bool checkSummaryList = true;
            foreach (LeaveSummaryByTeam leaveSumaryByTeam in Model)
            {
                if (leaveSumaryByTeam.LeaveSummaryInTeam.Count > 0)
                {
                    checkSummaryList = true;
                    break;
                }
                else
                {
                    checkSummaryList = false;
                }
            }
        }
        @if (checkSummaryList)
        {
            <tbody>
                @{int index = 1;}
                @foreach (LeaveSummaryByTeam item in Model)
                {
                    if (item.LeaveSummaryInTeam.Count > 0)
                    {
                        <tr>
                            <td class="rowdivider align-left" colspan="18">
                                <b>@item.Team.Name.ToUpper()</b>
                            </td>
                        </tr>
                    }
                    foreach (LeaveSummary leave in item.LeaveSummaryInTeam)
                    {
                        <tr>
                            <td>
                                @(index++)
                            </td>
                            <td class="center" title="@leave.Employee.FullName">
                                @leave.Employee.NickName
                            </td>
                            <td class="align-left">
                                @leave.Employee.FullName
                            </td>
                            @if (leave.Jan > 0)
                            {
                                <td>
                                    @leave.Jan.ToString("0.0")
                                </td>
                            }
                            else
                            {
                                <td></td>
                            }
                            @if (leave.Feb > 0)
                            {
                                <td>
                                    @leave.Feb.ToString("0.0")
                                </td>
                            }
                            else
                            {
                                <td></td>
                            }
                            @if (leave.Mar > 0)
                            {
                                <td>
                                    @leave.Mar.ToString("0.0")
                                </td>
                            }
                            else
                            {
                                <td></td>
                            }
                            @if (leave.Apr > 0)
                            {
                                <td>
                                    @leave.Apr.ToString("0.0")
                                </td>
                            }
                            else
                            {
                                <td></td>
                            }
                            @if (leave.May > 0)
                            {
                                <td>
                                    @leave.May.ToString("0.0")
                                </td>
                            }
                            else
                            {
                                <td></td>
                            }
                            @if (leave.Jun > 0)
                            {
                                <td>
                                    @leave.Jun.ToString("0.0")
                                </td>
                            }
                            else
                            {
                                <td></td>
                            }
                            @if (leave.Jul > 0)
                            {
                                <td>
                                    @leave.Jul.ToString("0.0")
                                </td>
                            }
                            else
                            {
                                <td></td>
                            }
                            @if (leave.Aug > 0)
                            {
                                <td>
                                    @leave.Aug.ToString("0.0")
                                </td>
                            }
                            else
                            {
                                <td></td>
                            }
                            @if (leave.Sep > 0)
                            {
                                <td>
                                    @leave.Sep.ToString("0.0")
                                </td>
                            }
                            else
                            {
                                <td></td>
                            }
                            @if (leave.Oct > 0)
                            {
                                <td>
                                    @leave.Oct.ToString("0.0")
                                </td>
                            }
                            else
                            {
                                <td></td>
                            }
                            @if (leave.Nov > 0)
                            {
                                <td>
                                    @leave.Nov.ToString("0.0")
                                </td>
                            }
                            else
                            {
                                <td></td>
                            }
                            @if (leave.Dec > 0)
                            {
                                <td>
                                    @leave.Dec.ToString("0.0")
                                </td>
                            }
                            else
                            {
                                <td></td>
                            }
                            @if (leave.LeaveBalance > 0)
                            {
                                <td>
                                    @leave.LeaveBalance.ToString("0.0")
                                </td>
                            }
                            else
                            {
                                <td></td>
                            }
                        </tr>
                    }
                }
            </tbody>
        }
        else
        {
            @RazorHelper.DisplayNoInformation(18)
        }
    </table>