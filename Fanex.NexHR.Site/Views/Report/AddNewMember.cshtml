@model ExtensionNoModel
@{
    ViewBag.Title = "New Extension Number";
}
@section css{
    @Url.CombresLink("extensionnocss")
}
@section js{
    @Url.CombresLink("addextensionnojs")
}
@section Breadcrumb {
    <a class="step">Company</a> 
    <a class="step" href="@Url.Action("extensionno", "report")">Extension Numbers</a>
    <span class="step">@ViewBag.Title</span>
}
<h2>@ViewBag.Title</h2>
<div class="bunhat container_24">
@{ Html.EnableClientValidation(false); }
    @using (Html.BeginForm())
    {
        @Html.ValidationSummary()

        if ((bool)ViewBag.Requested)
        {
        <div class="success">@Fanex.NexHR.Resources.Messages.RequestCreated</div>
        <input type="hidden" id="successed" value="true" />
        }
        
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.IsInternal)
            </div>
            <div class="input">
                @Html.CheckBoxFor(model => model.IsInternal)
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.Label("Group")
            </div>
            <div class="input">
                @Html.DropDownListFor(model => model.TeamId, new List<SelectListItem>())
            </div>
        </div>
        
        <div class="formrow" id="EmployeeField">
            <div class="label">
                @Html.LabelFor(model => model.Employee)
            </div>
            <div class="input">
                @Html.TextBoxFor(model => model.Employee)
            </div>
        </div>
        
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.FullName)
            </div>
            <div class="input">
                @Html.TextBoxFor(model => model.FullName)
            </div>
        </div>
        
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.NickName)
            </div>
            <div class="input">
                @Html.TextBoxFor(model => model.NickName)
            </div>
        </div>
        
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.ExtensionNo)
            </div>
            <div class="input">
                @Html.TextBoxFor(model => model.ExtensionNo)
            </div>
        </div>
        
        <div class="formrow">
            <div class="label">
                @Html.Hidden("EmpId")
                @Html.Hidden("IsAddForm", true)
            </div>
            <div class="input">
                <input type="submit" value="@Fanex.NexHR.Resources.Labels.Add"/>
                <a href="~/report/extensionno" class="button">@Labels.Back</a>
            </div>
        </div>
    }
</div>
