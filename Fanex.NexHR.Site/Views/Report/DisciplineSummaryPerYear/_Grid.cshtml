@using Fanex.NexHR.Models.Report
@model IList<DisciplineSummaryPerYear>

<table id="data" class="table table-custom discipline-summary">
    <thead>
        <tr>
            <th rowspan="2">@Labels.SymbolCount</th>
            <th rowspan="2">@Labels.Section</th>
            <th rowspan="2">@Labels.Team</th>
            <th rowspan="2">@Labels.Code</th>
            <th rowspan="2">@Labels.FullName</th>
            <th rowspan="2">@Labels.NickName</th>
            <th rowspan="2">@Labels.Category</th>
            <th rowspan="2">@Labels.LengthOfService</th>
            <th colspan="5">Total Discipline by Approver</th>
        </tr>
        <tr>
            @for (var i = (int)ViewBag.ToYear; i >= (int)ViewBag.FromYear; i--)
            {
                var diff = DateTime.Today.Year - i;
                if (diff == 1)
                {
                    <th>Last Year</th>
                }
                else
                {
                    <th>Last @diff Years</th>
                }
            }
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            int index = 0;
            foreach (DisciplineSummaryPerYear item in Model)
            {
                index++;
                <tr>
                    <td>@index</td>
                    <td class="align-left">@item.Section</td>
                    <td class="align-left">@item.Team</td>
                    <td>@item.Code</td>
                    <td class="align-left">@item.FullName</td>
                    <td>@item.Nickname</td>
                    <td>@(item.IsLocal ? Labels.Local : Labels.Expat)</td>
                    <td>@item.LengthOfService</td>
                    @for (var i = (int)ViewBag.ToYear; i >= (int)ViewBag.FromYear; i--)
                    {
                        var discipline = item.Disciplines.Where(x => x.Year >= i).Sum(x => x.ApproverSubtractScore);
                        <td>
                            @if(discipline > 0)
                            {
                                <span style="color: red">-@discipline</span>
                            }
                            else
                            {
                                <span>0</span>
                            }
                        </td>
                    }
                </tr>
            }
        }
        else
        {
            @RazorHelper.DisplayNoInformation(colspan: 19);
        }
    </tbody>
</table>