@model TotalWorkingHourWeeklyViewModel
@{
    ViewBag.Title = "Total Working Hour Weekly";
}
@section css{
    @Url.CombresLink("totalworkinghourweeklycss")
}
@section js{
    @Url.CombresLink("totalworkinghourweeklyjs")
}
@section Breadcrumb {
    <a class="step">HR</a>
    <a class="step" href="@Url.Action("index", "report")">@Labels.Reports</a>
    <a class="step">@ViewBag.Title</a>
}
<h2>@ViewBag.Title</h2>
<form class="form-filter">
    @Html.HiddenFor(model => model.SectionIds)
    <div class="container_24 bunhat">
        <div class="grid_1">
            @Html.Label("Week")
        </div>
        <div class="grid_6">
            @Html.TextBoxFor(model => model.FromDate, new { @class = "startDateOfWeek" })
            @Html.TextBoxFor(model => model.ToDate, new { @class = "endDateOfWeek" })
            <img class="weekPickerImg" src="~/images/calendar.png" />
            <div class="week-picker"></div>
        </div>
        <div class="grid_2 gridlabel">
            @Labels.Category
        </div>
        <div class="grid_4">
            @{
                var category = new List<SelectListItem>
                {
                    new SelectListItem() {Text = "-- All --", Value = string.Empty},
                    new SelectListItem() {Text = "Expat", Value = "0"},
                    new SelectListItem() {Text = "Local", Value = "1"},
                };
            }
            @Html.DropDownListFor(model => model.IsLocal, category, new { @class = "category" })
        </div>
        <div class="clear">
        </div>
        <div class="space">
        </div>
        <div class="grid_1">
            @Labels.Section
        </div>
        <div class="grid_6">
            @Html.DropDownList("section", new SelectList(Model.Sections, "Id", "Name"), new { multiple = "multiple" })
        </div>
        <div class="grid_2">
            @Html.LabelFor(model => model.Employee)
        </div>
        <div class="grid_4">
            @Html.TextBox("Employee", Model.Employee, new { placeholder = Messages.SearchEmployeeWatermark })
            @Html.HiddenFor(model => model.EmployeeId)
        </div>
        <div class="grid_5">
            <input id="btnSubmit" type="button" value="@Labels.Submit" />
            <input id="btnExcel" type="button" value="Excel" />
        </div>
        <div class="clear">
        </div>
    </div>
</form>
<div id="TotalWorkingHourWeeklyDetails">
</div>