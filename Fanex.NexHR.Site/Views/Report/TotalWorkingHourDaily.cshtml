@model TotalWorkingHourDailyViewModel
@{
    ViewBag.Title = Labels.TotalWorkingHourDaily;
}
@section css{
    @Url.CombresLink("totalworkinghourmonthlycss")
    @Url.CombresLink("managerequestscss")
}
@section js{
    @Url.CombresLink("totalworkinghourdailyjs")
}

@section Breadcrumb {
    <a class="step">@Labels.HRSpace</a>
    <a class="step" href="@Url.Action("index", "report")">@Labels.Reports</a>
    <a class="step">@ViewBag.Title</a>
}
<h2>@ViewBag.Title</h2>
<form class="form-filter">
    @Html.HiddenFor(model => model.SectionIds)
    <div class="container_24 bunhat">
        <div class="grid_2">@Labels.Date</div>
        <div class="grid_6">
            @Html.DatePicker("WorkDate", Model.WorkDate, minDate: new DateTime(2010, 01, 01), maxDate: DateTime.Now)
        </div>
        <div class="grid_2 gridlabel">@Labels.Category</div>
        <div class="grid_3">
            @{
                var category = new List<SelectListItem>
                {
                    new SelectListItem() {Text = "-- All --", Value = string.Empty},
                    new SelectListItem() {Text = "Expat", Value = "0"},
                    new SelectListItem() {Text = "Local", Value = "1"},
                };
            }
            @Html.DropDownList("IsLocal", category, new { @class = "category" })
        </div>
        <div class="clear"></div>
        <div class="space"></div>
        <div class="grid_2 gridlabel">@Labels.Section</div>
        <div class="grid_6">
            @Html.DropDownList("section", new SelectList(Model.Sections, "Id", "Name"), new { multiple = "multiple" })
        </div>
        <div class="grid_2">
            @Html.LabelFor(model => model.Employee)
        </div>
        <div class="grid_4">
            @Html.TextBox("Employee", Model.Employee, new { placeholder = Messages.SearchEmployeeWatermark })
            @Html.HiddenFor(model => model.EmployeeId)
        </div>
        <div class="grid_5">
            <input id="btnExcel" type="button" value="Excel" />
        </div>
        <div class="clear"></div>
    </div>
</form>