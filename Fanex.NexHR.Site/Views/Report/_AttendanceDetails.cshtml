@model IList<EmployeeAttendanceModel>

    <table id="data" class="table table-custom">
        <thead>
            <tr>
                <th>@Labels.SymbolCount</th>
                <th>@Labels.Date</th>
                <th>@Labels.NickName</th>
                <th>@Labels.Section</th>
                <th>@Labels.Shift</th>
                <th>@Labels.CheckIn</th>
                <th>@Labels.CheckOut</th>
                <th>@Labels.TotalHours</th>
                <th>@Labels.LateIn</th>
                <th>@Labels.EarlyOut</th>
                <th>@Labels.Request</th>
                <th>@Labels.Overtime</th>
                <th>@Labels.Note</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                int index = 0;
                foreach (EmployeeAttendanceModel item in Model)
                {
                    index++;
                    var trClass = (item.LateIn > 0 || item.EarlyOut > 30) ? "highlight" : string.Empty;

                    <tr class="@trClass">
                        <td>@index</td>
                        @if (item.IsWeekend)
                        {
                            <td class="weekend">@item.AttendanceDate.Value.ToString("ddd, dd MMM, yyyy")</td>
                        }
                        else
                        {
                            <td>@item.AttendanceDate.Value.ToString("ddd, dd MMM, yyyy")</td>
                        }
                        <td>
                            <span class="tooltip-tipsy" title="@item.FullName">@item.NickName</span>
                        </td>
                        <td>
                            <span class="tooltip-tipsy" title="@item.Team">@item.TeamCode</span>
                        </td>

                        @if (item.IsOffdayOT)
                        {
                            var title = !string.IsNullOrEmpty(item.ShiftCode) && !string.IsNullOrEmpty(item.ExpectedInTime) ? (item.ExpectedInTime + "-" + item.ExpectedOutTime) : string.Empty;
                            var className = string.Format("{0} {1}", "mytimesheet-workinginoffday",
                                item.IsPublicHoliday ? "orange-highlight" : "");
                            <td class="@className">
                                <span class="tooltip-tipsy" title="@title">@item.ShiftCode</span>
                            </td>
                        }
                        else
                        {
                            var title = !string.IsNullOrEmpty(item.ShiftCode) && !string.IsNullOrEmpty(item.ExpectedInTime) ? (item.ExpectedInTime + "-" + item.ExpectedOutTime) : string.Empty;
                            var className = string.Format("{0} {1}", "",
                                item.IsPublicHoliday && !string.IsNullOrEmpty(item.ExpectedInTime) ? "orange-highlight" : "");
                            <td class="@className">
                                <span class="tooltip-tipsy" title="@title">@item.ShiftCode</span>
                            </td>
                        }
                        @if (item.InFixed.HasValue)
                        {
                            <td>
                                <span class="tooltip-tipsy" title="@item.InFixed.Value.ToString("ddd, dd MMM, yyyy HH:mm:ss")">@item.InFixed.Value.ToString("HH:mm")</span>
                            </td>
                        }
                        else
                        {
                            <td></td>
                        }

                        @if (item.OutFixed.HasValue)
                        {
                            <td>
                                <span class="tooltip-tipsy"
                                      title="@item.OutFixed.Value.ToString("ddd, dd MMM, yyyy HH:mm:ss")">
                                    @item.OutFixed.Value.ToString("HH:mm")
                                </span>
                            </td>
                        }
                        else
                        {
                            <td></td>
                        }
                        <td>
                            @if (item.TotalWorkHours > 0)
                            {
                                @Utilities.TotalHoursToTime((float)item.TotalWorkHours)
                            }
                        </td>
                        <td>
                            @if (item.LateIn > 0)
                            {
                                @Utilities.MinuteToTime(item.LateIn)
                            }
                        </td>
                        <td>
                            @if (item.EarlyOut > 0)
                            {
                                @Utilities.MinuteToTime(item.EarlyOut)
                            }
                        </td>
                        <td>
                            @if (item.RequestList != null && item.RequestList.Any())
                            {
                                foreach (EmployeeAttendanceRequest request in item.RequestList)
                                {
                                    var statusClass = request.CurrentStatus == 1 || request.CurrentStatus == 2 ?
                                        " status-highlight" : string.Empty;
                                    var className = "tooltip-request req" + statusClass;
                                    <a href='#' class="@className"
                                       data-requesttype="@request.RequestType.Id"
                                       data-fromdate="@request.FromDate.ToFormatedDate()"
                                       data-todate="@request.ToDate.ToFormatedDate()"
                                       data-createddate="@request.CreatedDateTime"
                                       data-fromshift="@request.FromShift"
                                       data-toshift="@request.ToShift"
                                       data-fromtime="@request.FromTime"
                                       data-totime="@request.ToTime"
                                       data-totaldays="@request.TotalDays"
                                       data-totalmins="@request.TotalMins"
                                       data-actualLateInEarlyOut="@(request.RequestType.Id == 3 ? item.LateIn : item.EarlyOut)"
                                       data-remark='@request.Remark'
                                       data-currentStatus="@request.CurrentStatus">
                                        @request.RequestType.Name
                                    </a>
                                }
                            }
                        </td>
                        <td>
                            @if (item.IsOvertime)
                            {
                                <span title="@item.FormattedOvertimeStatus" class="req mytimesheet-@item.FormattedOvertimeStatus tooltip">
                                    @item.OvertimeHours
                                </span>
                            }
                        </td>
                        <td class="align-left">
                            @item.Notes
                        </td>
                        <td class="td-warning">
                            @if (item.IsWarning)
                            {
                                <span class="icon-warning" />
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                @RazorHelper.DisplayNoInformation(colspan: 14)
            }
        </tbody>
    </table>