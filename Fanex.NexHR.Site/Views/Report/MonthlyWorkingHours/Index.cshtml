@using Fanex.NexHR.ViewModels.Report.WorkingHours
@model MonthlyFilterViewModel
@{
    Layout = "~/Views/Shared/_NewLayout.cshtml";
    ViewBag.Title = Labels.EmployeeMonthlyWorkingHours;
}
@section css{
    <link href="~/wwwroot/dist/styles/report.monthlyworkinghours.css" rel="stylesheet" />
}
@section js{
    <script src="~/wwwroot/dist/js/report.monthlyworkinghours.js"></script>
}
@section Breadcrumb {
    <a class="step">HR</a>
    <a class="step" href="@Url.Action("index", "report")">@Labels.Reports</a>
    <a class="step">@ViewBag.Title</a>
}
<h2 class="page-title">@ViewBag.Title</h2>
<form class="filter">
    @Html.HiddenFor(model => model.SectionIds)
    @Html.HiddenFor(model => model.Month)
    @Html.HiddenFor(model => model.Year)
    <div class="form-horizontal clearfix">
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.Label(Labels.Month, new { @class = "control-label" })
            </div>
            <div class="select-form">
                <div id="MonthControl"></div>
                @Html.Hidden("MinDate", DateTime.Now.AddYears(-1).ToDateMonthYearFormatedDate())
                @Html.Hidden("MaxDate", DateTime.Now.ToDateMonthYearFormatedDate())
            </div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.Label(Labels.Category, new { @class = "control-label" })
            </div>
            <div class="select-form">
                @RazorHelper.CategoryDropDownList("IsLocal", classHTML: "form-control", selectedId: string.Empty)
            </div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.Label(Labels.Calendar, new { @class = "control-label" })
            </div>
            <div class="select-form">
                @{
                    var calendarType = new List<SelectListItem>
                    {
                        new SelectListItem() {Text = Labels.Fiscal, Value = "1"},
                        new SelectListItem() {Text = Labels.Normal, Value = "0"},
                    };
                }
                @Html.DropDownListFor(model => model.Calendar, calendarType, new { @class = "form-control" })
            </div>
        </div>
    </div>
    <div class="form-horizontal clearfix">
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.Label(Labels.Section, new { @class = "control-label" })
            </div>
            <div class="select-form">
                @Html.DropDownList("Section", new SelectList(Model.Sections, "Id", "Name"), new { multiple = "multiple" })
            </div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.Label(Labels.Employee, new { @class = "control-label" })
            </div>
            <div class="input-form">
                @Html.TextBox("Employee", string.Empty, new { placeholder = Messages.SearchEmployeeWatermark, @class = "form-control" })
                @Html.HiddenFor(model => model.EmployeeId)
            </div>
        </div>
        <div class="form-group form-group--m">
            <button type="button" class="btn btn-primary" id="btnSearch">@Labels.Search</button>
            <button type="button" class="btn btn-excel" id="btnExcel">@Labels.Excel</button>
        </div>
    </div>
</form>
<div id="MonthlyWorkingHoursDetails"></div>