@using Fanex.NexHR.Models.Report.MonthlyWorkingHours
@model IEnumerable<MonthlyWorking>
@{
    var fromDate = (DateTime)ViewBag.FromDate;
    var toDate = (DateTime)ViewBag.ToDate;
}
<table id="data" class="table table-custom">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th>@Labels.Code</th>
            <th>@Labels.Section</th>
            <th>@Labels.FullName</th>
            <th>@Labels.NickName</th>
            <th>@Labels.ActualWorkingDays</th>
            @for (var day = fromDate.Date; day.Date <= toDate.Date; day = day.AddDays(1))
            {
                <th class="@(day.DayOfWeek == DayOfWeek.Saturday || day.DayOfWeek == DayOfWeek.Sunday ? "weekend" : string.Empty)">
                    @day.ToString("dd MMM, yyyy (ddd)")
                </th>
            }
        </tr>
    </thead>
    @if (Model != null && Model.Any())
    {
        int index = 0;
        <tbody>
            @foreach (MonthlyWorking monthlyWorking in Model)
            {
                index++;
                <tr>
                    <td>@index</td>
                    <td class="align-left">@monthlyWorking.Code</td>
                    <td class="align-left">@monthlyWorking.Section.Name</td>
                    <td class="align-left">@monthlyWorking.FullName</td>
                    <td class="align-left">@monthlyWorking.Nickname</td>
                    <td>@monthlyWorking.ActualWorkingDays.ToString("0.0")</td>
                    @foreach (DailyWorking dailyWorking in monthlyWorking.DailyWorkings)
                    {
                        var className = string.Empty;
                        var value = string.Empty;
                        if (dailyWorking.IsLeaveDay)
                        {
                            value = dailyWorking.LeaveType.Code;
                            switch (dailyWorking.LeaveType.Id)
                            {
                                case (int)LeaveTypes.AnnualLeave:
                                    className = "annualleave";
                                    break;
                                case (int)LeaveTypes.UnpaidLeave:
                                    className = "unpaidleave";
                                    break;
                                case (int)LeaveTypes.BusinessTrip:
                                    className = "businesstrip";
                                    break;
                                case (int)LeaveTypes.WeddingLeave:
                                    className = "weddingleave";
                                    break;
                                default:
                                    className = "leaveday";
                                    break;
                            }

                            if (dailyWorking.IsLeaveHalfDay)
                            {
                                value = string.Format("{0} ½", dailyWorking.LeaveType.Code);
                            }
                        }
                        else if (dailyWorking.IsMissingCheckIn)
                        {
                            value = "Check In";
                        }
                        else if (dailyWorking.IsMissingCheckOut)
                        {
                            value = "Check Out";
                        }
                        else if (dailyWorking.IsAbsent)
                        {
                            value = "Absent";
                        }
                        else if (dailyWorking.IsHoliday)
                        {
                            value = "PH";
                            className = "holiday";
                        }
                        else if (dailyWorking.IsOffDay)
                        {
                            value = "OFF";
                            className = "offday";
                        }
                        else if(dailyWorking.TotalWorkingHours > 0)
                        {
                            value = dailyWorking.TotalWorkingHoursToDisplay;
                        }
                        <td class="@className">@value</td>
                    }
                </tr>
            }
        </tbody>
    }
    else
    {
        @RazorHelper.DisplayNoInformation(colspan: 40);
    }
</table>