@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Resources
@using Fanex.NexHR.Models.Report.MonthlyWorkingHours
@model IEnumerable<MonthlyWorking>
    @{
        var fromDate = (DateTime)ViewBag.FromDate;
        var toDate = (DateTime)ViewBag.ToDate;
    }
    <table id="data" class="table table-custom">
        <thead>
            <tr>
                <th>@Labels.SymbolCount</th>
                <th class="col-sorter">
                    <div class="cell-control-wrapper">
                        <div>@Labels.Department</div>
                        <div class="fa fa-sort"></div>
                    </div>
                </th>
                <th class="col-sorter">
                    <div class="cell-control-wrapper">
                        <div>@Labels.Section</div>
                        <div class="fa fa-sort"></div>
                    </div>
                </th>
                <th class="cell-section">@Labels.Team</th>
                <th>@Labels.Code</th>
                <th class="cell-fullname">@Labels.FullName</th>
                <th>@Labels.NickName</th>
                <th>@Labels.ActualWorkingDays</th>
                @for (var day = fromDate.Date; day.Date <= toDate.Date; day = day.AddDays(1))
                {
                    <th class="@(day.DayOfWeek == DayOfWeek.Saturday || day.DayOfWeek == DayOfWeek.Sunday ? "weekend" : string.Empty)">
                        @day.ToString("dd MMM, yyyy (ddd)")
                    </th>
                }
            </tr>
        </thead>
        @if (Model != null && Model.Any())
        {
            int index = 0;
            <tbody>
                @foreach (MonthlyWorking monthlyWorking in Model)
                {
                    index++;
                    <tr>
                        <td>@index</td>
                        <td class="align-left">@monthlyWorking.Department</td>
                        <td class="align-left">@monthlyWorking.Section</td>
                        <td class="align-left">@monthlyWorking.Team.Name</td>
                        <td class="align-left">@monthlyWorking.Code</td>
                        <td class="align-left">@monthlyWorking.FullName</td>
                        <td class="align-left">@monthlyWorking.Nickname</td>
                        <td>@monthlyWorking.ActualWorkingDays.ToString("0.0")</td>
                        @foreach (DailyWorking dailyWorking in monthlyWorking.DailyWorkings)
                        {
                            var className = string.Empty;
                            var value = string.Empty;
                            if (dailyWorking.IsLeaveDay)
                            {
                                if (dailyWorking.IsHoliday)
                                {
                                    value = "PH";
                                }
                                else if (dailyWorking.IsOffDay)
                                {
                                    value = "OFF";
                                }
                                else
                                {
                                    if (dailyWorking.RequestStatusId == (byte)CurrentRequestStatus.Pending)
                                    {
                                        className = "pending";
                                    }

                                    if (dailyWorking.LeaveType.Id == (byte)LeaveTypes.UnpaidLeave
                                        || dailyWorking.LeaveType.Id == (byte)LeaveTypes.UnpaidLeaveInsurance
                                        || dailyWorking.LeaveType.Id == (byte)LeaveTypes.MaternityLeave
                                        || dailyWorking.LeaveType.Id == (byte)LeaveTypes.PaternityLeave
                                        || (dailyWorking.LeaveType2 != null
                                            && (dailyWorking.LeaveType2.Id == (byte)LeaveTypes.UnpaidLeave
                                                || dailyWorking.LeaveType2.Id == (byte)LeaveTypes.UnpaidLeaveInsurance
                                                || dailyWorking.LeaveType2.Id == (byte)LeaveTypes.MaternityLeave
                                                || dailyWorking.LeaveType2.Id == (byte)LeaveTypes.PaternityLeave)))
                                    {
                                        className += " unpaidleave";
                                    }
                                    if (dailyWorking.IsLeaveHalfDay)
                                    {
                                        if (dailyWorking.LeaveType.Id != (byte)LeaveTypes.KeepInViewByHour)
                                        {
                                            value = string.Format("{0}½", dailyWorking.LeaveType.Code);
                                        }
                                    }
                                    else
                                    {
                                        value = dailyWorking.LeaveType.Code;
                                        if (dailyWorking.LeaveType2 != null && dailyWorking.LeaveType.Id != dailyWorking.LeaveType2.Id)
                                        {
                                            value = string.Format("{0}½/{1}½", dailyWorking.LeaveType.Code, dailyWorking.LeaveType2.Code);
                                        }
                                    }
                                }
                            }
                            else if (dailyWorking.TotalWorkingHours > 0)
                            {
                                value = dailyWorking.TotalWorkingHoursToDisplay;
                            }
                            else if (dailyWorking.IsMissingCheckIn)
                            {
                                value = "Check In";
                            }
                            else if (dailyWorking.IsMissingCheckOut)
                            {
                                value = "Check Out";
                            }
                            else if (dailyWorking.IsAbsent)
                            {
                                value = "Absent";
                            }
                            else if (dailyWorking.IsHoliday)
                            {
                                value = "PH";
                            }
                            else if (dailyWorking.IsOffDay)
                            {
                                value = "OFF";
                            }
                            <td class="@className">@value</td>
                        }
                    </tr>
                }
            </tbody>
        }
        else
        {
            @RazorHelper.DisplayNoInformation(colspan: 40);
        }
    </table>
