@using Fanex.NexHR.Resources
@using Fanex.NexHR.Models
@model LeaveSummaryViewModel

<table class="table table-custom" id="data">
    <thead>
        <tr>
            <th rowspan="2">@Labels.SymbolCount</th>
            <th rowspan="2">@Labels.Department</th>
            <th rowspan="2">@Labels.Section</th>
            <th rowspan="2">@Labels.Team</th>
            <th rowspan="2">@Labels.FullName</th>
            <th rowspan="2">@Labels.NickName</th>
            <th colspan="@((Model.Period == "1" || Model.Period == "2" ) ? "6" : "12" )">
                Take @ViewBag.HeaderTitle
            </th>
            <th rowspan="2">
                Total of @ViewBag.HeaderTitle
            </th>
        </tr>
        <tr>
            @if (Model.Period == "1")
            {
                <th>@Labels.Jan</th>
                <th>@Labels.Feb</th>
                <th>@Labels.Mar</th>
                <th>@Labels.Apr</th>
                <th>@Labels.May</th>
                <th>@Labels.Jun</th>
            }
            else if (Model.Period == "2")
            {
                <th>@Labels.Jul</th>
                <th>@Labels.Aug</th>
                <th>@Labels.Sep</th>
                <th>@Labels.Oct</th>
                <th>@Labels.Nov</th>
                <th>@Labels.Dec</th>
            }
            else
            {
                <th>@Labels.Jan</th>
                <th>@Labels.Feb</th>
                <th>@Labels.Mar</th>
                <th>@Labels.Apr</th>
                <th>@Labels.May</th>
                <th>@Labels.Jun</th>
                <th>@Labels.Jul</th>
                <th>@Labels.Aug</th>
                <th>@Labels.Sep</th>
                <th>@Labels.Oct</th>
                <th>@Labels.Nov</th>
                <th>@Labels.Dec</th>
            }

        </tr>
    </thead>
    @if (Model.LeaveSumaries != null)
    {
        <tbody>
            @{int index = 1;}
            @foreach (LeaveSummary item in Model.LeaveSumaries)
            {
                double balance = 0;
            <tr>
                <td>@(index++)</td>
                <td>@item.Department</td>
                <td>@item.Section</td>
                <td>@item.Team</td>
                <td class="align-left">@item.FullName</td>
                <td class="align-left">@item.Nickname</td>
                @if (Model.Period == "1")
                {
                    balance = item.Jan + item.Feb + item.Mar + item.Apr + item.May + item.Jun;
                    <td>
                        @if (item.Jan > 0)
                        {
                            @item.Jan.ToString("0.0")
                        }
                    </td>
                    <td>
                        @if (item.Feb > 0)
                        {
                            @item.Feb.ToString("0.0")
                        }
                    </td>
                    <td>
                        @if (item.Mar > 0)
                        {
                            @item.Mar.ToString("0.0")
                        }
                    </td>
                    <td>
                        @if (item.Apr > 0)
                        {
                            @item.Apr.ToString("0.0")
                        }
                    </td>
                    <td>
                        @if (item.May > 0)
                        {
                            @item.May.ToString("0.0")
                        }
                    </td>
                    <td>
                        @if (item.Jun > 0)
                        {
                            @item.Jun.ToString("0.0")
                        }
                    </td>
                }
                else if (Model.Period == "2")
                {
                    balance = item.Jul + item.Aug + item.Sep + item.Oct + item.Nov + item.Dec;
                    <td>
                        @if (item.Jul > 0)
                        {
                            @item.Jul.ToString("0.0")
                        }
                    </td>
                    <td>
                        @if (item.Aug > 0)
                        {
                            @item.Aug.ToString("0.0")
                        }
                    </td>
                    <td>
                        @if (item.Sep > 0)
                        {
                            @item.Sep.ToString("0.0")
                        }
                    </td>
                    <td>
                        @if (item.Oct > 0)
                        {
                            @item.Oct.ToString("0.0")
                        }
                    </td>
                    <td>
                        @if (item.Nov > 0)
                        {
                            @item.Nov.ToString("0.0")
                        }
                    </td>
                    <td>
                        @if (item.Dec > 0)
                        {
                            @item.Dec.ToString("0.0")
                        }
                    </td>
                }
                else
                {
                    balance = item.LeaveBalance;
                    <td>
                        @if (item.Jan > 0)
                        {
                            @item.Jan.ToString("0.0")
                        }
                    </td>
                    <td>
                        @if (item.Feb > 0)
                        {
                            @item.Feb.ToString("0.0")
                        }
                    </td>
                    <td>
                        @if (item.Mar > 0)
                        {
                            @item.Mar.ToString("0.0")
                        }
                    </td>
                    <td>
                        @if (item.Apr > 0)
                        {
                            @item.Apr.ToString("0.0")
                        }
                    </td>
                    <td>
                        @if (item.May > 0)
                        {
                            @item.May.ToString("0.0")
                        }
                    </td>
                    <td>
                        @if (item.Jun > 0)
                        {
                            @item.Jun.ToString("0.0")
                        }
                    </td>
                    <td>
                        @if (item.Jul > 0)
                        {
                            @item.Jul.ToString("0.0")
                        }
                    </td>
                    <td>
                        @if (item.Aug > 0)
                        {
                            @item.Aug.ToString("0.0")
                        }
                    </td>
                    <td>
                        @if (item.Sep > 0)
                        {
                            @item.Sep.ToString("0.0")
                        }
                    </td>
                    <td>
                        @if (item.Oct > 0)
                        {
                            @item.Oct.ToString("0.0")
                        }
                    </td>
                    <td>
                        @if (item.Nov > 0)
                        {
                            @item.Nov.ToString("0.0")
                        }
                    </td>
                    <td>
                        @if (item.Dec > 0)
                        {
                            @item.Dec.ToString("0.0")
                        }
                    </td>
                }

                <td style="width: 250px">
                    @balance.ToString("0.0")
                </td>
            </tr>
            }
        </tbody>
    }
    else
    {
        @RazorHelper.DisplayNoInformation(18)
    }
</table>