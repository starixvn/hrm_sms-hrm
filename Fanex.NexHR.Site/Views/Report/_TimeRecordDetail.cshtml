@using Fanex.NexHR.Models
@using Fanex.NexHR.Resources
@model IList<TimeRecordModel>
@{
    Layout = null;
    var hasPermission = (bool)ViewBag.HasPermission;
    var pagerOption = (PagerOptionModel)ViewBag.PagerOption;
}
<table id="data" class="table table-custom">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th>@Labels.Code</th>
            <th>@Labels.NickName</th>
            <th>@Labels.Team</th>
            <th>@Labels.TimeRecord</th>
            <th>@Labels.InOut</th>
        </tr>
    </thead>
    @if (Model != null && Model.Any())
    {
        int index = (pagerOption.CurrentPage - 1) * pagerOption.ItemsPerPage;
        <tbody>
            @foreach (TimeRecordModel item in Model)
            {
                index++;
                <tr>
                    <td>@index</td>
                    <td>@item.Code</td>
                    <td>
                        <span class="tooltip-tipsy" title="@item.FullName">@item.Nickname</span>
                    </td>
                    <td class="align-left">@item.Section</td>
                    <td>@item.RecordTime.ToDetailFormatedDate()</td>
                    <td>
                        @if (hasPermission)
                        {
                            if (item.InOutType == 0)
                            {
                                <a data-id="@item.RecordTimeId" href="javascript:void(0);" class="out-action">
                                    @item.GetInOutName
                                </a>
                            }
                            else
                            {
                                <a data-id="@item.RecordTimeId" href="javascript:void(0);" class="in-action">
                                    @item.GetInOutName
                                </a>
                            }
                        }
                        else
                        {
                            @item.GetInOutName
                        }
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="11" id="pagination">
                    @{
                        int from = (pagerOption.CurrentPage - 1) * pagerOption.ItemsPerPage + 1;
                        int to = from + (Model.Count - 1);
                        IList<SelectListItem> itemsPerPageArray = pagerOption.ItemsPerPageArray.Select(x => new SelectListItem
                        {
                            Text = x.Text,
                            Value = x.Value,
                            Selected = x.Value == pagerOption.ItemsPerPage.ToString()
                        }).ToList();
                    }
                    @Html.Hidden("CurrentPage", (int)pagerOption.CurrentPage)
                    @Html.Hidden("ItemsPerPage", (int)pagerOption.ItemsPerPage)
                    @Html.Hidden("TotalItem", (int)pagerOption.TotalItem)
                    @Html.DropDownList("ItemsPerPageOption", itemsPerPageArray, new { @class = "itemsPerPageOption" })
                    <div class="detailtext">
                        Showing <strong>@from</strong> to <strong>@to</strong> of <strong>@pagerOption.TotalItem</strong> entries
                    </div>
                    <ul id="numberlist" class="pagination"></ul>
                </td>
            </tr>
        </tfoot>
    }
    else
    {
        @RazorHelper.DisplayNoInformation(colspan: 6);
    }
</table>