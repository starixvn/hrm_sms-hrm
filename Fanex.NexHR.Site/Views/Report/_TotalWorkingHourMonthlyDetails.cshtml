@model IList<TotalWorkingHourMonthly>
@{
    var firstRecord = (TotalWorkingHourMonthly)ViewBag.FirstRecord;
}
<table id="data" class="table table-custom">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th>@Labels.StaffId</th>
            <th>@Labels.Section</th>
            <th>@Labels.FullName</th>
            <th>@Labels.Nick</th>
            <th>@Labels.CountWorkDay</th>
            @for (int i = 0; i < firstRecord.WorkingHours.Count; i++)
            {
                var stringDate = firstRecord.WorkingHours[i].Split('(')[1].Split(')')[0].Trim();
                if (stringDate == "Sat" || stringDate == "Sun")
                {
                    <th class="weekend">@firstRecord.WorkingHours[i]</th>
                }
                else
                {
                    <th>@firstRecord.WorkingHours[i]</th>
                }
            }
        </tr>
    </thead>
    @if (Model != null && Model.Any())
    {
        int index = 0;
        <tbody>
            @foreach (TotalWorkingHourMonthly item in Model)
            {
                index++;
                <tr>
                    <td>@index</td>
                    <td class="align-left">@item.StaffId</td>
                    <td class="align-left">@item.Section</td>
                    <td class="align-left">@item.FullNameNick</td>
                    <td class="align-left">@item.Nick</td>
                    <td>@item.CountWorkDay.ToString("0.0")</td>
                    @for (int i = 0; i < item.WorkingHours.Count; i++)
                    {
                        <td>@item.WorkingHours[i]</td>
                    }
                </tr>
            }
        </tbody>
    }
    else
    {
        @RazorHelper.DisplayNoInformation(colspan: firstRecord.WorkingHours.Count + 31);
    }
</table>