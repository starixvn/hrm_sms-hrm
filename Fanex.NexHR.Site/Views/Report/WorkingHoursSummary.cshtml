@using Fanex.NexHR.Resources
@using Fanex.NexHR.Core
@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Models.Report
@using Fanex.NexHR.ViewModels.Report
@using Fanex.NexHR.ViewModels.Request
@model WorkingHoursSummaryViewModel
@{
    var isHR = (bool)ViewBag.IsHR;
    ViewBag.Title = "Attendance Statistic for Payroll";
    HtmlHelper.ClientValidationEnabled = false;
}
@section css{
    <link href="~/wwwroot/dist/styles/report.dailyovertime.css" rel="stylesheet" />
}
@section js{
    <script src="~/wwwroot/dist/js/report.workinghours.summary.js"></script>
}
@section Breadcrumb {
    <a class="step">@Labels.Personal</a>
    <a class="step" href="@Url.Action("index", "report")">@Labels.Reports</a>
    <a class="step">@ViewBag.Title</a>
}
<h2 class="page-title">@ViewBag.Title</h2>
@Html.Hidden("Today", DateTime.Now.ToString("MMMM dd, yyyy"))
<form class="filter">
    @Html.HiddenFor(model => model.TeamIds)
    @Html.Hidden("DateOption", Model.DateOption)
    <div class="form-horizontal clearfix">
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.Label(Labels.DateRange, new { @class = "control-label" })
            </div>
            <div class="select-form">
                <select id="Date" name="Date" class="form-control">
                    <option value="0">@Labels.DateRange</option>
                    <option value="@((byte)DateRangeOption.Today)">@Labels.ToDay</option>
                    <option value="@((byte)DateRangeOption.Yesterday)">@Labels.Yesterday</option>
                    <option value="@((byte)DateRangeOption.CurrentWeek)">@Labels.CurrentWeek</option>
                    <option value="@((byte)DateRangeOption.LastWeek)">@Labels.LastWeek</option>
                    <option value="@((byte)DateRangeOption.CurrentMonth)">@Labels.CurrentMonth</option>
                    <option value="@((byte)DateRangeOption.LastMonth)">@Labels.LastMonth</option>
                    <option value="@((byte)DateRangeOption.SinceLastMonth)">@Labels.SinceLastMonth</option>
                </select>
            </div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.Label(Labels.FromDate, new { @class = "control-label" })
            </div>
            <div class="calendar-form">
                @Html.TextBox("FromDate", Model.FromDate.ToDateMonthYearFormatedDate(),
                    new {
                        @class = "datepicker form-control",
                        mindate = new DateTime(2010, 1, 1).ToString("yyyy/MM/dd"),
                        maxdate = DateTime.Now.ToString("yyyy/MM/dd"),
                        disabledDate = string.Empty
                    })
                <i class="icon-calendar fa fa-calendar"></i>
            </div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.Label(Labels.ToDate, new { @class = "control-label" })
            </div>
            <div class="calendar-form">
                @Html.TextBox("ToDate", Model.ToDate.ToDateMonthYearFormatedDate(),
                    new {
                        @class = "datepicker form-control",
                        mindate = new DateTime(2010, 1, 1).ToString("yyyy/MM/dd"),
                        maxdate = DateTime.Now.ToString("yyyy/MM/dd"),
                        disabledDate = string.Empty
                    })
                <i class="icon-calendar fa fa-calendar"></i>
            </div>
        </div>
    </div>
    <div class="form-horizontal clearfix">
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.Label(Labels.Category, new { @class = "control-label" })
            </div>
            <div class="select-form">
                @RazorHelper.CategoryDropDownList("IsLocal", classHTML: "form-control",
                    selectedId: Model.IsLocal.HasValue ? Model.IsLocal.Value.ToString(): string.Empty)
            </div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                <label class="control-label">@Labels.SectionTeam</label>
            </div>
            <div class="select-form" id="Team"></div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.Label(Labels.Keyword, new { @class = "control-label" })
            </div>
            <div class="input-form">
                @Html.TextBoxFor(model => model.Employee,
                    new { placeholder = Messages.SearchEmployeeWatermark, @class = "form-control", @maxlength = 200, autocomplete = "off" })
            </div>
        </div>
    </div>
    <div class="form-horizontal clearfix">
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.Label(Labels.UserStatus, new { @class = "control-label" })
            </div>
            <div class="input-form">
                @RazorHelper.UserStatusDropDownList("EmployeeStatusId", classHTML: "form-control", selectedId: Model.EmployeeStatusId)
            </div>
        </div>
        <div class="form-group form-group--m">
            <button type="button" class="btn btn-primary" id="btnSearch">@Labels.Search</button>
            <button type="button" class="btn btn-excel" id="btnExcel">@Labels.Excel</button>
        </div>
    </div>
</form>
<table class="table table-custom" id="data">
    <thead>
        <tr>
            <th colspan="7">Employee Info</th>
            <th colspan="2">Contract Working Agreement</th>
            <th colspan="2">Actual Working Time in/out</th>
            <th colspan="10">Total Working Days for Salary Payment</th>
            <th colspan="5">@Labels.UnpaidLeave</th>
            <th colspan="5">@Labels.Overtime</th>
        <tr>
        <tr>
            <th rowspan="2">@Labels.SymbolCount</th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    <div>@Labels.Department</div>
                    <div class="fa fa-sort"></div>
                </div>
            </th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    <div>@Labels.Section</div>
                    <div class="fa fa-sort"></div>
                </div>
            </th>
            <th>@Labels.Team</th>
            <th>@Labels.Code</th>
            <th>@Labels.FullName</th>
            <th>@Labels.NickName</th>
            <th>@Labels.WorkingDaysMonth</th>
            <th>@Labels.HoursPerDay</th>
            <th>@Labels.TotalOvertimeHours</th>
            <th>@Labels.ExcelTotalDays</th>
            <th>@Labels.WorkingDays</th>
            <th>@Labels.AL</th>
            <th>@Labels.BT</th>
            <th>@Labels.ShortBereavementLeave</th>
            <th>OL</th>
            <th>WL</th>
            <th>SW</th>
            <th>HL</th>
            <th>CE</th>
            <th>@Labels.ExcelTotalDays</th>
            <th>@Labels.UPL</th>
            <th>UPLI</th>
            <th>@Labels.Paternity</th>
            <th>@Labels.Maternity</th>
            <th>@Labels.ExcelTotalDays</th>
            <th>@Labels.Normal</th>
            <th>@Labels.Off</th>
            <th>@Labels.ShortOTPublicHours</th>
            <th>SO</th>
            <th>Total OT</th>
        </tr>
    </thead>
    @if (Model.WorkingHours.Any())
    {
        <tbody>
            @{int index = 1;}
            @foreach (WorkingHoursSummary item in Model.WorkingHours)
            {
                var requestModel = new RequestViewModel
                {
                    DateOption = Model.DateOption,
                    FromDate = Model.FromDate,
                    ToDate = Model.ToDate,
                    EmployeeId = item.EmpId,
                    Employee = item.Nickname + " (" + item.FullName + ")",
                    TeamIds = string.Empty,
                    StatusId = 0,
                    RequestType = (int)RequestFilter.Leave,
                    ViewType = RequestViewType.CompanySpace
                };
                <tr>
                    <td>
                        @(index++)
                    </td>
                    <td class="align-left">@item.DepartmentCode</td>
                    <td class="align-left">@item.Section</td>
                    <td class="align-left">@item.Team</td>
                    <td>@item.Code</td>
                    <td class="align-left">@item.FullName</td>
                    <td class="align-left">@item.Nickname</td>
                    <td>@item.WorkingDays</td>
                    <td>@item.WorkingHours</td>
                    <td>@Utilities.DisplayFloatNumber(item.TotalWorkingHours)</td>
                    <td>@item.ActualWorkingDays.ToString("0.0")</td>
                    <td>@Utilities.DisplayFloatNumber(item.PaymentWorkingDays)</td>
                    <td>@Utilities.DisplayEmptyFloatNumber(item.AnnualLeave)</td>
                    <td>@Utilities.DisplayEmptyFloatNumber(item.BusinessTrip)</td>
                    <td>@Utilities.DisplayEmptyFloatNumber(item.BereavementLeave)</td>
                    <td>@Utilities.DisplayEmptyFloatNumber(item.OffsetLeave)</td>
                    <td>@Utilities.DisplayEmptyFloatNumber(item.WeddingLeave)</td>
                    <td>@Utilities.DisplayEmptyFloatNumber(item.SuspendWork)</td>
                    <td>@Utilities.DisplayEmptyFloatNumber(item.HospitalizationLeave)</td>
                    <td>@Utilities.DisplayEmptyFloatNumber(item.CompanyEvent)</td>
                    <td>@Utilities.DisplayFloatNumber(item.TotalPayments)</td>
                    <td>
                        @if (item.UnpaidLeave > 0 && isHR)
                        {
                            <a href="@Url.Action("hrview", "request", requestModel)">
                                @Utilities.DisplayEmptyFloatNumber(item.UnpaidLeave)
                            </a>
                        }
                        else
                        {
                            @Utilities.DisplayEmptyFloatNumber(item.UnpaidLeave)
                        }
                    </td>
                    <td>@Utilities.DisplayEmptyFloatNumber(item.UnpaidLeaveInsurance)</td>
                    <td>@Utilities.DisplayEmptyFloatNumber(item.PaternityLeave)</td>
                    <td>@Utilities.DisplayEmptyFloatNumber(item.MaternityLeave)</td>
                    <td>@Utilities.DisplayFloatNumber(item.TotalUnpaidLeaves)</td>
                    <td>@Utilities.DisplayEmptyFloatNumber(item.NormalOvertimeHours)</td>
                    <td>@Utilities.DisplayEmptyFloatNumber(item.OffOvertimeHours)</td>
                    <td>@Utilities.DisplayEmptyFloatNumber(item.PublicOvertimeHours)</td>
                    <td>@Utilities.DisplayEmptyFloatNumber(item.SpecialOvertimeHours)</td>
                    <td>@Utilities.DisplayFloatNumber(item.TotalOvertimes)</td>
                </tr>
            }
        </tbody>
    }
    else
    {
        @RazorHelper.DisplayNoInformation(colspan: 31);
    }
</table>