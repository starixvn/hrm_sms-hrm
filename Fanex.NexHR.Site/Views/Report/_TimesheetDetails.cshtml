@using Fanex.NexHR.Core
@using Fanex.NexHR.Models
@using Fanex.NexHR.Models.Request
@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Services
@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels
@model IList<EmployeeAttendanceModel>
<table id="data" class="table table-custom">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th>@Labels.Date</th>
            <th>@Labels.Nick</th>
            <th>@Labels.Team</th>
            <th>@Labels.Shift</th>
            <th>@Labels.CheckIn</th>
            <th>@Labels.CheckOut</th>
            <th>@Labels.TotalHours</th>
            <th>@Labels.LateIn</th>
            <th>@Labels.EarlyOut</th>
            <th>@Labels.Request</th>
            <th>@Labels.Overtime</th>
            <th>@Labels.Note</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Count > 0)
        {
            int index = 0;

            foreach (EmployeeAttendanceModel item in Model)
            {
                index++;

                <tr>
                    <td>@index</td>
                    <td class="@(item.IsWeekend ? "weekend" : string.Empty)">
                        <a class="time-record-link" href="@Url.Action("timerecord", "report", new {
                            EmployeeId = item.EmpId,
                            Employee = string.Format("{0} ({1})", item.NickName, item.FullName),
                            FromDate = item.AttendanceDate.ToDateMonthYearFormatedDate(),
                            ToDate = item.AttendanceDate.AddDays(1).ToDateMonthYearFormatedDate() })"
                            title="Link to time records">
                            @item.AttendanceDate.ToDayOfWeekFormatedDate()
                        </a>
                    </td>
                    <td>
                        <span class="tooltip-tippy" data-tippy-content="@item.FullName">@item.NickName</span>
                    </td>
                    <td>
                        <span class="tooltip-tippy" data-tippy-content="@item.Team">@item.TeamCode</span>
                    </td>
                    @if (item.IsOffDay != 0 && item.ShiftId.HasValue)
                    {
                        <td class="mytimesheet-workinginoffday">@item.ShiftCode</td>
                    }
                    else
                    {
                        <td>@item.ShiftCode</td>
                    }
                    @if (item.InFixed.HasValue)
                    {
                        <td>
                            <span class="tooltip-tippy" data-tippy-content="@item.InFixed.Value.ToString("ddd, dd MMM, yyyy HH:mm:ss")">
                                @item.InFixed.Value.ToString("HH:mm")
                            </span>
                        </td>
                    }
                    else
                    {
                        <td></td>
                    }
                    @if (item.OutFixed.HasValue)
                    {
                        <td>
                            <span class="tooltip-tippy" data-tippy-content="@item.OutFixed.Value.ToString("ddd, dd MMM, yyyy HH:mm:ss")">
                                @item.OutFixed.Value.ToString("HH:mm")
                            </span>
                        </td>
                    }
                    else
                    {
                        <td></td>
                    }
                    <td>
                        @if (item.TotalWorkHours > 0)
                        {
                            @Utilities.TotalHoursToTime((float)item.TotalWorkHours)
                        }
                    </td>
                    <td>
                        @if (item.LateIn > 0)
                        {
                            @Utilities.MinuteToTime(item.LateIn)
                        }
                    </td>
                    <td>
                        @if (item.EarlyOut > 0)
                        {
                            @Utilities.MinuteToTime(item.EarlyOut)
                        }
                    </td>
                    <td>
                        @if (item.RequestList != null && item.RequestList.Any())
                        {
                            foreach (EmployeeAttendanceRequest request in item.RequestList)
                            {
                                var statusClass = request.CurrentStatus == (byte)CurrentRequestStatus.Pending || request.CurrentStatus == (byte)CurrentRequestStatus.Verified
                                    ? " pending-request" : string.Empty;
                                var className = "tooltip-request req" + statusClass;
                                var requestEntity = new RequestEntity
                                {
                                    RequestType = request.RequestType,
                                    TotalDays = request.TotalDays ?? 0,
                                    TotalMins = request.TotalMins ?? 0,
                                    FromDate = request.FromDate.Value,
                                    ToDate = request.ToDate.Value,
                                    FromTime = request.FromTime ?? request.FromDate.Value,
                                    ToTime = request.ToTime ?? request.ToDate.Value,
                                    RequestedDate = request.RequestDate,
                                    CreatedDate = request.CreatedDate,
                                    FromShift = new Shift { Name = request.FromShift },
                                    ToShift = new Shift { Name = request.ToShift },
                                    LeaveType = request.LeaveType,
                                    ActualLateInEarlyOut = request.RequestType.Id == (byte)RequestType.LateIn ? item.LateIn : item.EarlyOut
                                };
                                var requestdetail = RequestService.ToRequestMessage(requestEntity);
                                <div class="@className"
                                        data-requestdetail="@Html.Encode(requestdetail)"
                                        data-leavetype="@(request.LeaveType != null ? request.LeaveType.Name : string.Empty)"
                                        data-createddate="@request.CreatedDateTime"
                                        data-remark='@request.Remark'
                                        data-currentStatus="@request.CurrentStatus">
                                    @request.RequestType.Name
                                </div>
                            }
                        }
                    </td>
                    <td>
                        @if (item.IsOvertime)
                        {
                            <span data-tippy-content="@item.FormattedOvertimeStatus"
                                  class="req mytimesheet-@item.FormattedOvertimeStatus.Replace(" ", "") tooltip-tippy">
                                @item.OvertimeHours
                            </span>
                        }
                    </td>
                    <td class="align-left">
                        @Extensions.AttendanceNoteHtml(item.Notes)
                    </td>
                    <td class="td-warning">
                        @if (item.IsWarning)
                        {
                            <span class="icon-warning" />
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            @RazorHelper.DisplayNoInformation(colspan: 14);
        }
    </tbody>
</table>