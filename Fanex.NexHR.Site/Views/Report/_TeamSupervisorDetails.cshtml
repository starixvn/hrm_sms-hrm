@model List<TeamSupervisorReportModel>
    <div>
        <table id="data" class="table table-custom">
            <thead>
                <tr>
                    <th>@Labels.SymbolCount</th>
                    <th class="col-sorter">
                        <div class="cell-control-wrapper">
                            <div>@Labels.Department</div>
                            <div class="fa fa-sort"></div>
                        </div>
                    </th>
                    <th class="col-sorter">
                        <div class="cell-control-wrapper">
                            <div>@Labels.Section</div>
                            <div class="fa fa-sort"></div>
                        </div>
                    </th>
                    <th>@Labels.Team</th>
                    <th class="width-15-percent">@Labels.VerifiedBy</th>
                    <th class="width-15-percent">@Labels.ApprovedBy</th>
                    <th class="width-15-percent">@Labels.ShiftArrangement</th>
                    <th class="width-15-percent">@Labels.OnBehalfRequest</th>
                    <th class="width-15-percent">@Labels.DisciplineManager</th>
                </tr>
            </thead>
            @if (Model != null && Model.Any())
            {
                int index = 0;
                <tbody>
                    @foreach (TeamSupervisorReportModel item in Model)
                    {
                        index++;
                        <tr>
                            <td>@index</td>
                            <td>@item.Department</td>
                            <td>@item.Section</td>
                            <td>@item.Code</td>
                            <td class="align-left">
                                @string.Join(", ", item.Supervisors.Where(x => x.ActionType == (int)SupervisorActionType.Verifier).Select(x => x.NickName))
                            </td>
                            <td class="align-left">
                                @string.Join(", ", item.Supervisors.Where(x => x.ActionType == (int)SupervisorActionType.Approver).Select(x => x.NickName))
                            </td>
                            <td class="align-left">
                                @string.Join(", ", item.Supervisors.Where(x => x.ActionType == (int)SupervisorActionType.ShiftArrangement).Select(x => x.NickName))
                            </td>
                            <td class="align-left">
                                @string.Join(", ", item.Supervisors.Where(x => x.ActionType == (int)SupervisorActionType.OnBehalfRequest).Select(x => x.NickName))
                            </td>
                            <td class="align-left">
                                @string.Join(", ", item.Supervisors.Where(x => x.ActionType == (int)SupervisorActionType.DisciplineManager).Select(x => x.NickName))
                            </td>
                        </tr>
                    }
                </tbody>
            }
            else
            {
                @RazorHelper.DisplayNoInformation(colspan: 9);
            }
        </table>
    </div>
