@using Fanex.NexHR.Models.Supervisor
@model List<TeamSupervisorReportModel>
<div>
    <table class="data">
        <thead>
            <tr>
                <th>@Labels.SymbolCount</th>
                <th>@Labels.Team</th>
                <th class="actionName">
                    @Labels.Roles
                </th>
                <th>
                    @Labels.Nick
                </th>
            </tr>
        </thead>
        @if (Model != null)
        {
            <tbody>
                @{int index = 1;}
                @foreach (TeamSupervisorReportModel item in Model)
                {
                    int rowCount = 0;
                    var rowSpan = item.SupervisorAction.Count();
                    string rowClass = string.Empty;
                    if (index % 2 == 0)
                    {
                        rowClass = "evenRow";
                    }
                    else
                    {
                        rowClass = "oddRow";
                    }
                    <tr class="@rowClass">
                        <td rowspan="@rowSpan">
                            <span>@(index++)</span>
                        </td>
                        <td rowspan="@rowSpan">
                            <span>@item.SupervisorAction[0].Code</span>
                        </td>
                        @foreach (var supervisorAction in item.SupervisorAction)
                        {

                            if (rowCount == 0)
                            {
                            <td>
                                @supervisorAction.ActionName
                            </td>
                            <td class="supervisorName">
                                @supervisorAction.Supervisors
                            </td>
                                rowCount++;
                            }
                            else
                            {
                            <tr class="@rowClass">
                                <td>
                                    @supervisorAction.ActionName
                                </td>
                                <td class="supervisorName">
                                    @supervisorAction.Supervisors
                                </td>
                            </tr>
                            }

                        }
                    </tr>
                }
            </tbody>
        }
        else
        { 
            @RazorHelper.DisplayNoInformation(colspan: 4);
        }
    </table>
</div>
