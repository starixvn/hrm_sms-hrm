@using Fanex.NexHR.Resources
@using Fanex.NexHR.Models.Report.MealAllowance;

@model IEnumerable<MealAllowanceSummary>
@{
    var fromDate = (DateTime)ViewBag.FromDate;
    var toDate = (DateTime)ViewBag.ToDate;
}

<table id="data" class="table table-custom">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    <div>@Labels.Department</div>
                    <div class="fa fa-sort"></div>
                </div>
            </th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    <div>@Labels.Section</div>
                    <div class="fa fa-sort"></div>
                </div>
            </th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    <div>@Labels.Team</div>
                    <div class="fa fa-sort"></div>
                </div>
            </th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    <div>@Labels.Code</div>
                    <div class="fa fa-sort"></div>
                </div>
            </th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    <div>@Labels.FullName</div>
                    <div class="fa fa-sort"></div>
                </div>
            </th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    <div>@Labels.NickName</div>
                    <div class="fa fa-sort"></div>
                </div>
            </th>
            <th class="col-sorter width-7-percent">
                <div class="cell-control-wrapper">
                    <div>@Labels.TotalDays</div>
                    <div class="fa fa-sort"></div>
                </div>
            </th>
            <th>@Labels.Details</th>
        </tr>
    </thead>
    @if (Model != null && Model.Any())
    {
        int index = 0;
        <tbody>
            @foreach (var summary in Model)
            {
                index++;
            <tr>
                <td>@index</td>
                <td class="align-left">@summary.Department</td>
                <td class="align-left">@summary.Section</td>
                <td class="align-left">@summary.Team</td>
                <td class="align-center">@summary.Code</td>
                <td class="align-left">@summary.FullName</td>
                <td class="align-left">@summary.NickName</td>
                <td class="align-center">@summary.TotalDays</td>
                <td>
                    @{
                        var empId = summary.EmpId;
                        var employee = summary.NickName + " (" + summary.FullName + ")";
                    }
                    <a href="javascript:;" class="viewdetails" data-empid="@empId" data-employee="@employee">
                        <i class="fa-lg fa fa-search"></i>
                    </a>
                </td>
            </tr>
            }
        </tbody>
    }
    else
    {
        @RazorHelper.DisplayNoInformation(colspan: 11);
    }
</table>
<div id="dialog-meal-allowance-details"></div>
