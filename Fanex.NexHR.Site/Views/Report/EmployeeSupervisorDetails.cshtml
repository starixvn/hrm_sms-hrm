@using Fanex.NexHR.Models.Supervisor
@model IList<SupervisorReportModel>
<div>
    <table class="data">
        <thead>
            <tr>
                <th>
                    #
                </th>
                <th>@Labels.Nick
                </th>
                <th>@Labels.FullName
                </th>
                <th>@Labels.Team
                </th>
                <th>
                    @Labels.AuthorityLevel
                </th>
                <th class="actionName">
                    @Labels.Roles
                </th>
                <th>
                    @Labels.Nick
                </th>
            </tr>
        </thead>
        @if (Model != null && Model.Any())
        {
            <tbody>
                @{int index = 1;
                  int rowCount = 0;
                  }
                @foreach (SupervisorReportModel item in Model)
                {
                    
                    var rowSpan = 4;
                    string rowClass = string.Empty;
                    if (index % 2 == 0)
                    {
                        rowClass = "evenRow";
                    }
                    else
                    {
                        rowClass = "oddRow";
                    }

                    if (rowCount == 0)
                    {
                        rowCount++;
                    <tr class="@rowClass">
                        <td rowspan="@rowSpan">
                            <span>@index</span>
                        </td>
                        <td rowspan="@rowSpan">
                            <span>@item.Employee.NickName</span>
                        </td>
                        <td rowspan="@rowSpan" class="left">
                            <span>@item.Employee.FullName</span>
                        </td>
                        <td rowspan="@rowSpan">
                            <span>@item.Employee.Team.Code</span>
                        </td>
                        <td rowspan="@rowSpan">@item.Employee.NX_Roles2String;
                        </td>
                       <td>
                                @item.ActionName
                            </td>
                            <td class="supervisorName">
                                @item.Supervisors.Trim()
                            </td>
                        </tr>
                    }
                    else if (rowCount == 3)
                    {
                        rowCount = 0;
                        index++;
                        <tr class="@rowClass">
                                <td>
                                    @item.ActionName
                                </td>
                                <td class="supervisorName">
                                    @item.Supervisors.Trim()
                                </td>
                            </tr>
                    }
                    else
                    {
                        rowCount++;
                            <tr class="@rowClass">
                                <td>
                                    @item.ActionName
                                </td>
                                <td class="supervisorName">
                                    @item.Supervisors.Trim()
                                </td>
                            </tr>
                    }
                }
            </tbody>
        }
        else
        { 
            @RazorHelper.DisplayNoInformation(colspan: 7);
        }
    </table>
</div>
