@model List<SupervisorReportGroupModel>
<div>
	<table class="data">
		<thead>
			<tr>
				<th>
					#
				</th>
				<th>@Labels.Nick
				</th>
				<th class="actionName">@Labels.FullName
				</th>
				<th>@Labels.Team
				</th>
				<th class="actionName">
					Action
				</th>
				<th>
					Supervisors Name
				</th>
			</tr>
		</thead>
		@if (Model != null)
  {
			<tbody>
				@{int index = 1;}
				@foreach (SupervisorReportGroupModel item in Model)
	{
		int rowCount = 0;
		var rowSpan = item.SupervisorAction.Count();
		string rowClass = string.Empty;
		if (index % 2 == 0)
		{
			rowClass = "evenRow";
		}
		else
		{
			rowClass = "oddRow";
		}
					<tr class="@rowClass">
						<td rowspan="@rowSpan">
							<span>@(index++)</span>
						</td>
						<td rowspan="@rowSpan">
							<span>@item.SupervisorAction[0].NickName</span>
						</td>
						<td rowspan="@rowSpan">
							<span>@item.SupervisorAction[0].FullName</span>
						</td>
						<td rowspan="@rowSpan">
							<span>@item.SupervisorAction[0].Code</span>
						</td>
						@foreach (var supervisorAction in item.SupervisorAction)
	  {

		  if (rowCount == 0)
		  {
							<td>
								@supervisorAction.ActionName
							</td>
							<td class="supervisorName">
								@supervisorAction.Supervisors.Trim()
							</td>
			  rowCount++;
		  }
		  else
		  {
							<tr class="@rowClass">
								<td>
									@supervisorAction.ActionName
								</td>
								<td class="supervisorName">
									@supervisorAction.Supervisors.Trim()
								</td>
							</tr>
		  }

	  }
					</tr>
	   
	   
	   
	}
			</tbody>
  }
  else
  { 
			@RazorHelper.DisplayNoInformation(colspan: 4);
  }
	</table>
</div>
