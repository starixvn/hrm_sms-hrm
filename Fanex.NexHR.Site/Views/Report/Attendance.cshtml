@using Fanex.NexHR.Resources
@model EmployeeAttendanceViewModel
@{
    Layout = "~/Views/Shared/_NewLayout.cshtml";
    ViewBag.Title = @Labels.AttendanceReport;
}
@section css{
    @Url.CombresLink("attendancereportcss")
}
@section js{
    @Url.CombresLink("attendancereportjs")
}
@section Breadcrumb {
    <a class="step">@Labels.CompanySpace</a> <span class="step">@ViewBag.Title</span>
}
<h2>
    @ViewBag.Title
</h2>
<form class="form-filter">
    <div class="container_24 bunhat">
        @Html.Hidden("DateTime-Now", DateTime.Now.ToString("MMMM dd, yyyy"))
        @Html.HiddenFor(model => model.SupervisorId)
        @Html.HiddenFor(model => model.GroupIds)
        @Html.HiddenFor(model => model.IsLocal)
        <div class="grid_2 gridlabel">
            @Labels.DateRange
        </div>
        <div class="grid_4">
            <select id="Date" name="Date">
                <option value="0">@Labels.DateRange</option>
                <option value="1">@Labels.ToDay</option>
                <option value="2">@Labels.Yesterday</option>
                <option value="3">@Labels.CurrentWeek</option>
                <option value="4">@Labels.LastWeek</option>
                <option value="5">@Labels.CurrentMonth</option>
                <option value="6">@Labels.LastMonth</option>
                <option value="7">@Labels.SinceLastMonth</option>
            </select>
            @Html.Hidden("DateOption", Model.DateOption)
        </div>
        <div class="grid_2">@Labels.FromDate</div>
        <div class="grid_4">
            @Html.DatePicker("FromDate", Model.FromDate, minDate: new DateTime(2010, 01, 01), maxDate: DateTime.Now)
        </div>
        <div class="grid_2">@Labels.ToDate</div>
        <div class="grid_4">
            @Html.DatePicker("ToDate", Model.ToDate, minDate: new DateTime(2010, 01, 01), maxDate: DateTime.Now)
        </div>
        <div class="clear"></div>
        <div class="space"></div>
        <div class="grid_2">
            @Html.LabelFor(model => model.AttendanceType, "Request")
        </div>
        <div class="grid_4">
            @{
                var types = new List<SelectListItem>
                            {
                                new SelectListItem() {Text = Labels.All, Value = ((short)AttendanceFilter.All).ToString()},
                                new SelectListItem() {Text = Labels.MissingCheckIn, Value = ((short)AttendanceFilter.MissingCheckIn).ToString()},
                                new SelectListItem() {Text = Labels.MissingCheckOut, Value = ((short)AttendanceFilter.MissingCheckOut).ToString()},
                                new SelectListItem() {Text = Labels.LateIn, Value = ((short)AttendanceFilter.LateIn).ToString()},
                                new SelectListItem() {Text = Labels.EarlyOut, Value = ((short)AttendanceFilter.EarlyOut).ToString()},
                                new SelectListItem() {Text = Labels.NotWork, Value = ((short)AttendanceFilter.NotWork).ToString()},
                            };
            }
            @Html.DropDownListFor(model => model.AttendanceType, types)
        </div>
        <div class="grid_2">@Labels.DepartmentSection</div>
        <div class="grid_4" id="Section"></div>
        <div class="grid_2">
            @Html.LabelFor(model => model.EmployeeId)
        </div>
        <div class="grid_4">
            @Html.TextBox("Employee", Model.Employee, new { placeholder = Messages.SearchEmployeeWatermark })
            @Html.Hidden("EmployeeId", Model.EmployeeId)
        </div>
        <div class="clear"></div>
        <div class="space"></div>
        <div class="clear"></div>
        <div class="space"></div>
        <div class="grid_2 gridlabel">@Labels.Category</div>
        <div class="grid_4">
            @RazorHelper.CategoryDropDownList("category", "category")
        </div>
        <div class="grid_6" style="margin-top: 5px;">
            @Html.CheckBoxFor(model => model.ExcludeDeletedUsers)
            <label for="ExcludeDeletedUsers">@Labels.ExcludeDeletedUsers</label>
        </div>
        <div class="grid_6">
            <input type="button" value="@Labels.Submit" id="btnSubmit" />
            <input type="button" value="Excel" id="btnExcel" />
        </div>
        <div class="clear"></div>
    </div>
</form>
<div id="attendanceDetails"></div>