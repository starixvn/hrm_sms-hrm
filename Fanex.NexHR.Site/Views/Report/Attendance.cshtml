@using Fanex.NexHR.Core;
@model Fanex.NexHR.ViewModels.EmployeeAttendanceViewModel
@{
    ViewBag.Title = "Attendance report";
}

@section css{
    @Url.CombresLink("attendancereportcss")
}
@section js{
    @Url.CombresLink("attendancereportjs")
}

@section Breadcrumb {
    <a class="step">Member Request</a> <span class="step">@ViewBag.Title</span>
}

<h2>Attendance report</h2>

<div class="container_24 bunhat">
    @using (Html.BeginGetForm())
    {
        @Html.ValidationSummary(true)
        
        @Html.Hidden("DateTime-Now", DateTime.Now.ToString("MMMM dd, yyyy"))
        <div class="grid_2 gridlabel">
            @Labels.DateRange
        </div>
        <div class="grid_4">
            <select id="Date" name="Date">
                <option value="0">
                    @Labels.DateRange</option>
                <option value="1">
                    @Labels.ToDay</option>
                <option value="2">
                    @Labels.Yesterday</option>
                <option value="3">
                    @Labels.CurrentWeek</option>
                <option value="4">
                    @Labels.LastWeek</option>
                <option value="5">
                    @Labels.CurrentMonth</option>
                <option value="6">
                    @Labels.LastMonth</option>
                <option value="7">
                    @Labels.SinceLastMonth</option>
            </select>
            @Html.Hidden("DateOption", Model.DateOption)
        </div>
        
        <div class="grid_2">
            From date
        </div>
        <div class="grid_6">
            @Html.DatePicker("FromDate", Model.FromDate, minDate: new DateTime(2010, 01, 01), maxDate: DateTime.Now)
            @*<input type="text" id="pickdate" />*@
        </div>
        <div class="grid_2">
            To date 
        </div>
        <div class="grid_4">
            @Html.DatePicker("ToDate", Model.ToDate, minDate: new DateTime(2010, 01, 01), maxDate: DateTime.Now)
        </div>
        
        <div class="clear"></div>
        <div class="space"></div>
        
        <div class="grid_2">
            @Html.LabelFor(model => model.Type, "Request")
        </div>
        <div class="grid_4">
            @{
    var types = new List<SelectListItem>
                {
                    new SelectListItem() {Text = Labels.All, Value = ((short)AttendanceFilterEnums.All).ToString()},
                    new SelectListItem() {Text = Labels.MissingCheckIn, Value = ((short)AttendanceFilterEnums.MissingCheckIn).ToString()},
                    new SelectListItem() {Text = Labels.MissingCheckOut, Value = ((short)AttendanceFilterEnums.MissingCheckOut).ToString()},
                    new SelectListItem() {Text = Labels.LateIn, Value = ((short)AttendanceFilterEnums.LateIn).ToString()},
                    new SelectListItem() {Text = Labels.EarlyOut, Value = ((short)AttendanceFilterEnums.EarlyOut).ToString()},
                    new SelectListItem() {Text = Labels.NotWork, Value = ((short)AttendanceFilterEnums.NotWork).ToString()},
                };
            }
            @Html.DropDownListFor(model => model.Type, types)
        </div>
        
        <div class="grid_2">
            @Labels.Team
        </div>
        <div class="grid_6">
            @if (Model.IsMember)
            {
               <span class="isMember">@Model.TeamName</span>
               @Html.HiddenFor(model => model.CurrentUserId)
            }
            else
            {
                <select id="GroupId" multiple="multiple" name="GroupId" title="@Labels.Team">
                    @foreach (Team item in ViewBag.Groups)
                    { 
                        <option value="@item.Id">@item.Name</option>
                    }
                </select>
            }
        </div>
        <div class="grid_2">
            @Html.LabelFor(model => model.EmpId)
        </div>
        <div class="grid_4">
            @Html.TextBox("Employee", Model.Employee, new { placeholder = @Fanex.NexHR.Resources.Messages.SearchEmployeeWatermark })
            @Html.HiddenFor(model => model.EmpId)
            @Html.ValidationMessageFor(model => model.EmpId)
        </div>
        
        <div class="clear"></div>
        <div class="space"></div>
        <div class="clear"></div>
        <div class="space"></div>
        
        <div class="grid_2">&nbsp</div>
        
        <div class="grid_4">
            @Html.CheckBoxFor(model => model.ExcludeDeletedUsers)
            <label for="ExcludeDeletedUsers">@Labels.ExcludeDeletedUsers</label>
        </div>
        
        <div class="grid_2">&nbsp</div>
        
        <div class="grid_6">
            <input type="button" value="@Labels.Submit" id="view"/>
            <input type="button" value="Excel" id="btnExcel"/>
        </div>
        <div class="clear"></div>
    }
</div>

<div class="clear"></div>
<div class="space"></div>

<table id="data" class="data persist-area">
    <thead>
        <tr class = "persist-header">
            <th>
                #
            </th>
            <th>
                @Labels.Date
            </th>
            <th>
                @Labels.Nick
            </th>
            <th>
                @Labels.Team
            </th>
            <th>
                @Labels.Shift
            </th>
            <th>
                @Labels.CheckIn
            </th>
            <th>
                @Labels.CheckOut
            </th>
            <th>
                @Labels.TotalHours
            </th>
            <th>
                @Labels.LateIn
            </th>
            <th>
                @Labels.EarlyOut
            </th>
            <th>
                @Labels.Request
            </th>
            <th>
                @Labels.Overtime
            </th>
            <th>
                @Labels.Note
            </th>
        </tr>
    </thead>
    <tbody>
    </tbody>
</table>
<script id="itemTemplate" type="text/x-jquery-tmpl">
    <tr {{if LateIn > 30 || EarlyOut > 30}}class="highlight-row"{{/if}}>
        <td>${index()}</td>
        <td class="ddMMyyyy">            
            ${jsonToDetailsDate(AttendanceDate)}
        </td>
        <td title="${FullName}" class="left tooltip">
            ${NickName}
        </td>
        <td class="tooltip" title="${Team}">
            ${TeamCode}
        </td>
        {{if IsOffDay != 0 && ShiftId != null}}
            <td class=" mytimesheet-workinginoffday tooltip" {{if ShiftCode != null}} title="${ExpectedInTime}-${ExpectedOutTime}" {{/if}}>
                ${ShiftCode}
            </td>
        {{else}}
            <td class="tooltip" {{if ShiftCode != null}} title="${ExpectedInTime}-${ExpectedOutTime}" {{/if}}>
                ${ShiftCode}
            </td>
        {{/if}}
        <td>
            {{if InFixed}}${jsonTojsDate(InFixed).format("HH:MM")}{{/if}}
        </td>
        <td>
            {{if OutFixed}}${jsonTojsDate(OutFixed).format("HH:MM")}{{/if}}
        </td>
        <td>
            {{if TotalWorkHours > 0}}
                ${totalHoursToTime(TotalWorkHours)}
            {{/if}}
        </td>
        <td>
            {{if LateIn > 0}}
                ${displayMinute(LateIn)}
            {{/if}}
        </td>
        <td>
            {{if EarlyOut > 0}}
                ${displayMinute(EarlyOut)}
            {{/if}}
        </td>
        <td>
            {{if RequestList != null > 0}}
                {{each RequestList}}
                    <a href='#' class="tooltip-request req" 
                            data-requesttype="${RequestType.Id}"
                            data-fromdate="${FromDate}"
                            data-todate="${ToDate}" 
                            data-createddate="${CreatedDate}" 
                            data-fromshift="${FromShift}"
                            data-toshift="${ToShift}"
                            data-leavetype="${LeaveType}"
                            data-totaldays="${TotalDays}"
                            data-totalmins="${TotalMins}"
                            data-remark='${Remark}'>
                            {{if RequestType.Id == 6}}
                                ${LeaveType}
                            {{else}}
                                ${RequestType.Name}
                            {{/if}}
                        </a> 
                {{/each}}
               
            {{/if}}
        </td>
        <td>
            {{if IsOvertime != 0}}
                <span title="${FormattedOvertimeStatus}" class="req mytimesheet-${FormattedOvertimeStatus} tooltip">${OvertimeHours}</span>
            {{/if}}
        </td>
        <td class="left">
            ${Notes}
        </td>
    </tr>
</script>
