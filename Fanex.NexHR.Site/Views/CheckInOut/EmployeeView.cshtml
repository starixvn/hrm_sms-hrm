@using Fanex.NexHR.Models.Request
@model IList<CheckInOutModel>
@{
    ViewBag.Title = Labels.MyCheckInOutRequests;
}
@section css{
    @Url.CombresLink("myrequestcss")
}
@section js{
    @Url.CombresLink("empcheckinoutjs")
}
@section Breadcrumb {
    <a class="step">@Labels.Personal</a> <a class="step">@ViewBag.Title</a>
}
<h2>@ViewBag.Title</h2>
@using (Html.BeginForm())
{
    <input type="hidden" value="CheckInOut" id="RequestType" />

    <div class="container_24 bunhat">
        <div class="grid_1 gridlabel">
            <label for="Year">@Labels.Year</label>
        </div>
        <div class="grid_2">
            @Html.YearPicker("Year", 2010, (int)ViewBag.Year)
        </div>
        <div class="grid_2">
            <input type="submit" id="submit" value="@Labels.Submit" class="button-primary submit processing-submit" />
        </div>
        <div class="grid_5">
            <div class="button-icon">
                <span class="icon plus"></span>@Html.ActionLink("Check In/Out Request", "Create")
            </div>
        </div>
    </div>

    <div class="clear">
    </div>

    <table class="table table-custom">
        <thead>
            <tr>
                <th>@Labels.SymbolCount</th>
                <th>@Labels.Request</th>
                <th>@Labels.Shift</th>
                <th>@Labels.ScheduleDate</th>
                <th>
                    @Labels.RequestTime
                </th>
                <th>@Labels.CreatedDate</th>
                <th>@Labels.Remark</th>
                <th>@Labels.Status</th>
                <th>@Labels.History</th>
            </tr>
        </thead>
        @if (Model.Count > 0)
        {
            <tbody>
                @{int index = 1;}
                @{string selectedClass = string.Empty;}
                @foreach (CheckInOutModel request in Model)
                {
                <tr id="row@(request.RequestId)">
                    <td>@(index++)</td>
                    <td>
                        @request.RequestTypeName.ToString()
                    </td>
                    <td>
                        @request.ShiftName
                    </td>
                    <td class="ddMMyyyyhhmm">
                        @request.OnDate.ToDateMonthYearFormatedDate()
                    </td>
                    <td class="ddMMyyyyhhmm">
                        @request.RequestTime.ToShortFormatedDate()
                    </td>
                    <td class="ddMMyyyyhhmm">
                        @request.CreatedDate.ToShortFormatedDate()
                    </td>
                    @if (!string.IsNullOrWhiteSpace(request.Remark))
                    {
                        <td class="tooltip" title="@request.Remark">
                            <span class="icon remark" alt="remark" />
                        </td>
                    }
                    else
                    {
                        <td>-</td>
                    }
                    @RazorHelper.RenderRequestStatus(request)
                    <td>
                        <a class="viewhistory" href="javascript:;" id="/CheckInOut/viewhistory?id=@request.RequestId">
                            @Labels.View
                        </a>
                    </td>
                </tr>
                }
            </tbody>
        }
        else
        {
            @RazorHelper.DisplayNoInformation(colspan: 11)
        }
    </table>
}
@RazorHelper.EmployeeProcessMenu()
<div id="dialoghistorycontent" />