@using Fanex.NexHR.Core
@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels.Request
@model CheckInOutRequestViewModel
@using System.Web.Mvc.Html5;
@{
    ViewBag.Title = Labels.Edit;
    var today = DateTime.Today;
}
@section css{
    @Url.CombresLink("checkinoutrequestcss")
}
@section js{
    @Url.CombresLink("checkinoutrequestjs")
}
@section Breadcrumb {
    <a class="step">@Labels.Personal</a> <a class="step" href="@Url.Action("employeeview", "checkinout")">@Labels.MyCheckInOutRequests</a>
    <a class="step">@ViewBag.Title</a>
}
<h2>@Labels.Edit</h2>
<div class="bunhat">
    @using (Html.BeginForm())
    {
        @Html.ValidationSummary()
        if (ViewBag.Updated != null && (bool)ViewBag.Updated)
        {
            <div class="success">@Messages.RequestUpdated</div>
            <input type="hidden" id="successed" value="true" />
            <input type="hidden" id="year" value="@Model.ForDate.Year" />
        }
        <div id="model-state-error" class="ui-state-error ui-corner-all">
            @Labels.CannotCreateRequest
        </div>

        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.RefNO, Labels.RequestCode)
            </div>
            <div class="input">
                @Html.TextBoxFor(model => model.RefNO)
            </div>
        </div>

        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.RequestTypeId)
            </div>
            <div class="input">
                @Model.RequestTypeName
            </div>
        </div>

        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Employee)
            </div>
            <div class="input">
                @Html.DisplayFor(model => model.Employee)
            </div>
            <div class="clear">
            </div>
        </div>

        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.AttendantDate, Labels.OnDate)
            </div>
            <div class="input">
                @Html.DatePickerFor(model => model.AttendantDate, today.FirstDayOfMonth().AddMonths(-1), today)
            </div>
        </div>

        <div class="formrow">
            <div class="label">
                @Labels.RequestTime
            </div>
            <div class="input">
                @Html.DatePickerFor(model => model.ForDate, today.FirstDayOfMonth().AddMonths(-1), today)
                @Html.Html5Number(0, 23, 1, Model.Hour, new { Name = "Hour", MaxLength = "2", id = "Hour" })
                :
                @Html.Html5Number(0, 59, 1, Model.Minute, new { Name = "Minute", MaxLength = "2", id = "Minute" })
            </div>
        </div>

        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Shift)
            </div>
            <div class="input">
                <span id="shiftname">@Model.Shift</span>
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Labels.Reason
            </div>
            <div class="input">
                @RazorHelper.CheckInOutReasonDropDownList(Model.ReasonId)
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.VerifierAndApprover.Verifiers)
            </div>
            <div class="input">
                @Html.DropDownListFor(x => x.VerifierId, new SelectList(Model.VerifierAndApprover.Verifiers, "OwnerId", "DisplayName"), new { @class = "dropdown" })
            </div>
        </div>

        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.VerifierAndApprover.Approvers)
            </div>
            <div class="input">
                @Html.DropDownListFor(x => x.ApproverId, new SelectList(Model.VerifierAndApprover.Approvers, "OwnerId", "DisplayName"), new { @class = "dropdown" })
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Remark)
            </div>
            <div class="input">
                @Html.TextAreaFor(model => model.Remark)
            </div>
            <div class="clear">
            </div>
        </div>
        <div class="formrow">
            <div class="label">
            </div>
            <div class="input">
                @Html.HiddenFor(model => model.Employee)
                @Html.HiddenFor(model => model.EmployeeId)
                @Html.HiddenFor(model => model.RequestTypeId)
                @Html.HiddenFor(model => model.RequestId)
                @Html.HiddenFor(model => model.Shift)
                <input type="submit" value="@Labels.Update" />
                <a href="javascript:;" class="button" id="backPrevious">@Labels.Back</a>
            </div>
        </div>
    }
</div>