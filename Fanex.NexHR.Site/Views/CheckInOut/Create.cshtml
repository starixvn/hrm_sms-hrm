@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Resources
@using System.Web.Mvc.Html5
@using Fanex.NexHR.ViewModels.Request
@model CheckInOutRequestViewModel
@{
    ViewBag.Title = Labels.NewCheckInOutRequest;
}
@section css{
    @Url.CombresLink("checkinoutrequestcss")
}
@section js{
    @Url.CombresLink("checkinoutrequestjs")
}
@section Breadcrumb {
<a class="step">Personal</a> <a class="step" href="@Url.Action(" employeeview", "checkinout" )">@Labels.MyCheckInOutRequests</a>
<a class="step">@ViewBag.Title</a>
}
<h2>@ViewBag.Title</h2>
<div class="bunhat container_24">
    @using (Html.BeginForm())
    {
        @Html.ValidationSummary()
        if (ViewBag.Requested != null && (bool)ViewBag.Requested)
        {
            <div class="success">@Messages.RequestCreated</div>
            <input type="hidden" id="successed" value="true" />
            <input type="hidden" id="year" value="@Model.ForDate.Year" />
        }

        <div id="model-state-error" class="ui-state-error ui-corner-all">
            @Labels.CannotCreateRequest
        </div>

        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.RefNO)
            </div>
            <div class="input">
                @Html.TextBoxFor(model => model.RefNO)
            </div>
        </div>

        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.RequestTypeId)
            </div>
            <div class="input">
                @Html.RadioButtonList(model => model.RequestTypeId, Utilities.CheckInOutTypes)
            </div>
        </div>
        <div class="clear">
        </div>
        <div class="space">
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Employee)
            </div>
            <div class="input">
                @Html.EditorFor(model => model.Employee)
            </div>
        </div>

        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.AttendantDate, Labels.ScheduleDate)
            </div>
            <div class="input">
                @Html.DatePickerFor(model => model.AttendantDate, new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(-6), DateTime.Now)
            </div>
        </div>
        <div class="clear">
        </div>
        <div class="space">
        </div>
        <div class="formrow">
            <div class="label">
                @Labels.RequestTime
            </div>
            <div class="input">
                @Html.DatePickerFor(model => model.ForDate, new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(-6), DateTime.Now)
                @Html.Html5Number(0, 23, 1, Model.Hour, new { Name = "Hour", MaxLength = "2", id = "Hour" })
                :
                @Html.Html5Number(0, 59, 1, Model.Minute, new { Name = "Minute", MaxLength = "2", id = "Minute" })
            </div>
        </div>
        <div class="clear">
        </div>
        <div class="space">
        </div>

        <div class="formrow">
            <div class="label">
                @Labels.Shift
            </div>
            <div class="input">
                <span id="shiftname">@Model.Shift</span>
            </div>
            <div class="clear">
            </div>
        </div>

        <div class="clear">
        </div>
        <div class="space">
        </div>
        <div class="formrow">
            <div class="label">
                @Labels.Reason
            </div>
            <div class="input">
                @RazorHelper.CheckInOutReasonDropDownList()
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.VerifierId)
            </div>
            <div class="input">
                @if (Model.VerifierAndApprover.Verifiers.Count() > 1)
                {
                    @Html.DropDownListFor(x => x.VerifierId, new SelectList(Model.VerifierAndApprover.Verifiers, "OwnerId", "DisplayName"), Labels.SelectVerifier, new { @class = "dropdown" })
                }
                else
                {
                    @Html.DropDownListFor(x => x.VerifierId, new SelectList(Model.VerifierAndApprover.Verifiers, "OwnerId", "DisplayName"), new { @class = "dropdown" })
                }
            </div>
        </div>

        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.ApproverId)
            </div>
            <div class="input">
                @if (Model.VerifierAndApprover.Approvers.Count() > 1)
                {
                    @Html.DropDownListFor(x => x.ApproverId, new SelectList(Model.VerifierAndApprover.Approvers, "OwnerId", "DisplayName"), Labels.SelectApprover, new { @class = "dropdown" })
                }
                else
                {
                    @Html.DropDownListFor(x => x.ApproverId, new SelectList(Model.VerifierAndApprover.Approvers, "OwnerId", "DisplayName"), new { @class = "dropdown" })
                }
            </div>
        </div>

        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Remark)
            </div>
            <div class="input">
                @Html.TextAreaFor(model => model.Remark)
            </div>
            <div class="clear">
            </div>
        </div>

        <div class="formrow">
            <div class="label">
                @Html.HiddenFor(model => model.EmployeeId)
                @Html.HiddenFor(model => model.Employee)
                @Html.HiddenFor(model => model.Shift)
                @Html.Hidden("InTime")
                @Html.Hidden("OutTime")
                @Html.Hidden("CrossDay")
                @Html.Hidden("IsInAfterDay")
                @Html.Hidden("IsOutAfterDay")
                @Html.Hidden("RequestTypeId", (byte)RequestType.CheckIn)
            </div>
            <div class="input">
                <input type="submit" value="@Labels.Request" />
                <a href="javascript:;" class="button" id="backPrevious">@Labels.Back</a>
            </div>
        </div>
    }
</div>