@using System.Web.Mvc.Html5
@using Fanex.NexHR.ViewModels.Request
@model CheckInOutRequestViewModel
@{
    ViewBag.Title = Labels.NewCheckInOutRequest;
}
@section css{
    @Url.CombresLink("checkinoutrequestcss")
}
@section js{
    @Url.CombresLink("checkinoutrequestjs")
}
@section Breadcrumb {
    <a class="step">Personal</a> <a class="step" href="@Url.Action("employeeview", "checkinout")">@Labels.MyCheckInOutRequests</a>
    <a class="step">@ViewBag.Title</a>
}
<h2>@ViewBag.Title</h2>
<div class="bunhat container_24">
    @{ Html.EnableClientValidation(false); }
    @using (Html.BeginForm())
    {
        @Html.ValidationSummary()

        if (ViewBag.Requested != null && (bool)ViewBag.Requested)
        {
        <div class="success">@Messages.RequestCreated</div>
        <input type="hidden" id="successed" value="true" />
        <input type="hidden" id="year" value="@ViewBag.Year" />
        }
        
        <div id="model-state-error" class="ui-state-error ui-corner-all">
            @Labels.CannotCreateRequest
        </div>

        if (ViewBag.TotalRequest >= 1)
        {

        <div class="ui-state-error ui-corner-all">
            <p>
                <a href="@Url.Action("EmployeeView")">You've already requested for Check in/out
                    @ViewBag.TotalRequest times since @DateTime.Now.ToString("MMM yyyy")</a>
            </p>
        </div>
        }      
          
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.RefNO)
            </div>
            <div class="input">
                @Html.TextBoxFor(model => model.RefNO)
            </div>
        </div>
        
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.RequestType)
            </div>
            <div class="input">
                @Html.RadioButtonList(model => model.RequestType, Utilities.CheckInOutTypes)
            </div>
        </div>  
        <div class="clear">
        </div>
        <div class="space">
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Employee)*
            </div>
            <div class="input">
                @Html.EditorFor(model => model.Employee)
            </div>
        </div>
        
        <div class="formrow">
            <div class="label">
                Attendant date
            </div>
            <div class="input">
                @Html.DatePickerFor(model => model.AttendantDate, new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(-1), DateTime.Now)
            </div>
        </div>
        <div class="clear">
        </div>
        <div class="space">
        </div>
        <div class="formrow">
            <div class="label">
                @Fanex.NexHR.Resources.Labels.RequestTime
            </div>
            <div class="input">
                @Html.DatePickerFor(model => model.ForDate, new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(-1), DateTime.Now)
                @Html.Html5Number(0, 23, 1, Model.Hour, new { Name = "Hour", MaxLength = "2", id = "Hour" })
                :
                @Html.Html5Number(0, 59, 1, Model.Minute, new { Name = "Minute", MaxLength = "2", id = "Minute" })
            </div>
        </div>
        <div class="clear">
        </div>
        <div class="space">
        </div>
        
        <div class="formrow">
            <div class="label">
                @Labels.Shift
            </div>
            <div class="input">
                <span id="shiftname">@Model.Shift</span> @*<a id="shiftinfo" href="javascript:;" title="@Fanex.NexHR.Resources.Labels.ShiftInfo">
                    <span class="icon shiftinfo"> </span>
                </a>*@
            </div>
            <div class="clear">
            </div>
        </div>
        

        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Verifier)*
            </div>
            <div class="input">
                @if (Model.Verifier.Count() > 1)
                {
                    @Html.DropDownListFor(x => x.VerifierId, Model.Verifier, "--Select a Verifier--", new { @class = "dropdown" })
                }
                else
                {
                    @Html.DropDownListFor(x => x.VerifierId, Model.Verifier, new { @class = "dropdown" })
                }
            </div>
        </div>
        
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Approver)*
            </div>
            <div class="input">
                @if (Model.Approver.Count() > 1)
                {
                    @Html.DropDownListFor(x => x.ApproverId, Model.Approver, "--Select an Approver--", new { @class = "dropdown" })
                }
                else
                {
                    @Html.DropDownListFor(x => x.ApproverId, Model.Approver, new { @class = "dropdown" })
                }
            </div>
        </div>
        
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Remark)
            </div>
            <div class="input">
                @Html.TextAreaFor(model => model.Remark)
            </div>
            <div class="clear">
            </div>
        </div>
        
        <div class="formrow">
            <div class="label">
                @Html.HiddenFor(model => model.EmployeeId)
                @Html.HiddenFor(model => model.Employee)
                @Html.HiddenFor(model => model.Shift)
                @Html.Hidden("InTime")
                @Html.Hidden("OutTime")
                @Html.Hidden("CrossDay")
				@Html.Hidden("IsInAfterDay")
				@Html.Hidden("IsOutAfterDay")
                @Html.Hidden("RequestType", (int)RequestType.CheckIn)
            </div>
            <div class="input">
                <input type="submit" value="@Labels.Request"/>
               @* <a href="~/checkinout/employeeview" class="button">@Labels.Back</a>*@
               <a href="javascript:;" class="button" id="backPrevious">@Labels.Back</a>
            </div>
        </div>
    }
</div>
<div class="hide">
    @RazorHelper.ShiftInfoTable(ViewBag.Shifts)
</div>
