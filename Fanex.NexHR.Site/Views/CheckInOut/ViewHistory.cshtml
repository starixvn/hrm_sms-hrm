@using Fanex.NexHR.Resources
@using Fanex.NexHR.Models.Request
@model IList<CheckInOutModel>
@{
    ViewBag.Title = Labels.RequestHistory;
    Layout = null;
}
@section css{
    @Url.CombresLink("sitecss")
}
@section js{
    @Url.CombresLink("sitejs")
}
@section Breadcrumb {
    <span class="step">@ViewBag.Title</span>
}

    <table class="table table-custom">
        <thead>
            <tr>
                <th>@Labels.SymbolCount</th>
                <th>@Labels.Team</th>
                <th>@Labels.Employee</th>
                <th>@Labels.Request</th>
                <th>@Labels.ScheduleDate</th>
                <th>@Labels.Shift</th>
                <th>@Labels.RequestTime</th>
                <th>@Labels.CreatedDate</th>
                <th>@Labels.Remark</th>
                <th>@Labels.Status</th>
            </tr>
        </thead>
        @if (Model != null && Model.Any())
        {
            <tbody>
                @{int index = 1;}
                @foreach (CheckInOutModel request in Model)
                {
                <tr id="row@(request.RequestId)">
                    <td>@(index++)</td>
                    <td class="tooltip-tipsy" original-title="@request.Employee.Team.Name">
                        @request.Employee.Team.Code
                    </td>
                    <td class="tooltip-tipsy" original-title="@request.Employee.FullName">
                        @request.Employee.NickName
                    </td>
                    <td>
                        @request.RequestTypeName
                    </td>
                    <td class="ddMMyyyyhhmm">
                        @request.OnDate.ToDateMonthYearFormatedDate()
                    </td>
                    <td>
                        @request.ShiftName
                    </td>
                    <td class="ddMMyyyyhhmm">
                        @request.RequestTime.ToShortFormatedDate()
                    </td>
                    <td class="ddMMyyyyhhmm">
                        @request.CreatedDate.ToShortFormatedDate()
                    </td>
                    @if (!string.IsNullOrWhiteSpace(request.Remark))
                    {
                        <td title="@request.Remark">
                            <span class="glyphicon glyphicon-comment tooltip-tipsy icon remark" title="@request.Remark" alt="remark"></span>
                        </td>
                    }
                    else
                    {
                        <td>-</td>
                    }
                    <td>@request.Status.ToString()</td>
                </tr>
                }
            </tbody>
        }
        else
        {
            @RazorHelper.DisplayNoInformation(colspan: 12);
        }
    </table>