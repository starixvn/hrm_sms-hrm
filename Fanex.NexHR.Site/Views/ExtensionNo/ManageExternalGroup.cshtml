@model List<ExtensionNoModel>
@section css{
    @Url.CombresLink("extensionnocss")
}
@section js{
    @Url.CombresLink("extensionnojs")
}
@{
    ViewBag.Title = Labels.ExternalGroup;
}
@section Breadcrumb {
    <a class="step">Company</a>
    <a class="step" href="@Url.Action("index", "ExtensionNo")">Extension Numbers</a>
    <span class="step">@ViewBag.Title</span>
}
<h2>@ViewBag.Title</h2>
<div class="button-icon">
    <span class="icon plus"></span><a href="#" id="btnNewExternalGroup">New External Group</a>
</div>
<table class="data" id="data">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th>@Labels.GroupName</th>
            <th>@Labels.Edit</th>
            <th>@Labels.Delete</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null)
        {
            int index = 1;
            foreach (ExtensionNoModel item in Model)
            {
                <tr id="@item.TeamId">
                    <td>
                        @(index++)
                    </td>
                    <td>
                        <span class="groupName"> @item.TeamName</span>
                    </td>
                    <td>
                        <a href="javascript:;" id="editExternal">
                            <i class="fa fa-pencil fa-lg icon-edit"></i>
                        </a>
                    </td>
                    <td>
                        @if (item.TotalMember > 0)
                        {
                            <a href="#" style="cursor:default">
                                <i class="fa fa-times fa-lg fa-disabled icon-delete"></i>
                            </a>
                        }
                        else
                        {
                            <a href="javascript:;" id="deleteExternal">
                                <i class="fa fa-times fa-lg icon-delete"></i>
                            </a>
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            @RazorHelper.DisplayNoInformation(colspan: 4);
        }
    </tbody>
</table>
<div id="dialog-form" title="Add new External Group" style="display: none">
    <p class="validateTips"></p>
    <form>
        <div class="formrow">
            <div class="label">
                Group Name
            </div>
            <div class="input">
                <input type="text" name="name" id="name" class="text ui-widget-content ui-corner-all" />
                <div class="clear">
                </div>
            </div>
        </div>
    </form>
</div>

<div id="dialog-form_edit" title="Update External Group" style="display: none">
    <p class="validateTips"></p>
    <form>
        <div class="formrow">
            <div class="label">
                Group Name
            </div>
            <div class="input">
                <input type="text" name="name" id="name_edit" class="text ui-widget-content ui-corner-all" />
                <div class="clear">
                </div>
            </div>
        </div>
    </form>
</div>