@using Fanex.NexHR.Resources
@model ExtensionNoModel
@{
    Layout = "~/Views/Shared/_NewLayout.cshtml";
    ViewBag.Title = Labels.Edit;
}
@section css{
    <link href="~/wwwroot/dist/styles/extensionno.create.css" rel="stylesheet" />
}
@section js{
    <script src="~/wwwroot/dist/js/extensionno.create.js"></script>
}
@section Breadcrumb {
    <a class="step">@Labels.CompanySpace</a>
    <a class="step" href="@Url.Action("index", "ExtensionNo")">@Labels.ExtensionNumber</a>
    <span class="step">@ViewBag.Title</span>
}
<h2 class="page-title">@ViewBag.Title</h2>
<div class="card">
    @using (Html.BeginForm())
    {
        @Html.ValidationSummary()
        <div class="form-horizontal">
            @Html.HiddenFor(model => model.EmployeeExtensionId)
            @Html.HiddenFor(model => model.EmpId)
            <div class="form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.IsInternal, new { @class = "control-label" })
                </div>
                <div class="input-form">
                    <div class="checkbox">@Html.CheckBoxCustomFor(model => model.IsInternal)</div>
                </div>
            </div>
            <div class="form-group">
                <div class="label-form">
                    @Html.Label("Group", new { @class = "control-label" })
                </div>
                <div class="select-form">
                    @Html.DropDownListFor(model => model.TeamId, (List<SelectListItem>)ViewBag.Group, new { @class = "form-control" })
                </div>
            </div>
            <div class="form-group" id="EmployeeField">
                <div class="label-form">
                    @Html.LabelFor(model => model.Employee, new { @class = "control-label" })
                </div>
                <div class="input-form">
                    @Html.TextBoxFor(model => model.Employee, new { @class = "form-control" })
                </div>
            </div>
            <div class="form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.FullName, new { @class = "control-label" })
                </div>
                <div class="input-form">
                    @Html.TextBoxFor(model => model.FullName, new { @class = "form-control" })
                </div>
            </div>
            <div class="form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.NickName, new { @class = "control-label" })
                </div>
                <div class="input-form">
                    @Html.TextBoxFor(model => model.NickName, new { @class = "form-control" })
                </div>
            </div>
            <div class="form-group">
                <div class="label-form">
                    @Html.LabelFor(model => model.ExtensionNo, new { @class = "control-label" })
                </div>
                <div class="input-form">
                    @Html.TextBoxFor(model => model.ExtensionNo, new { @class = "form-control" })
                </div>
            </div>
            <div class="form-group">
                <div>
                    <button type="submit" id="btnSubmit" class="btn btn-primary">@Labels.Update</button>
                    <a class="btn btn-default" href="@Url.Action("index", "ExtensionNo")">@Labels.Back</a>
                </div>
            </div>
        </div>
    }
</div>