@using Fanex.NexHR.Resources
@model List<ExtensionNoModel>
@{
    ViewBag.Title = Labels.ExternalGroup;
}
@section css{
    <link href="~/wwwroot/dist/styles/external.group.css" rel="stylesheet" />
}
@section js{
    <script src="~/wwwroot/dist/js/external.group.js"></script>
}
@section Breadcrumb {
    <a class="step">@Labels.CompanySpace</a>
    <a class="step" href="@Url.Action("index", "ExtensionNo")">@Labels.ExtensionNumber</a>
    <span class="step">@ViewBag.Title</span>
}
<h2 class="page-title">@ViewBag.Title</h2>

<div id="index-group-extension"></div>
