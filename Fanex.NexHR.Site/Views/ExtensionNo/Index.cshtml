@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels.ExtensionNumber
@model List<ExtensionNumberViewModel>
@{
    Layout = "~/Views/Shared/_NewLayout.cshtml";
    ViewBag.Title = Labels.ExtensionNumber;
    var hasPermission = (bool)ViewBag.HasPermission;
    var totalColumn = hasPermission ? 6 : 4;
}
@section css{
    <link href="~/wwwroot/dist/styles/extensionno.index.css" rel="stylesheet" />
}
@section js{
    <script src="~/wwwroot/dist/js/extensionno.index.js"></script>
}
@section Breadcrumb {
    <a class="step">@Labels.CompanySpace</a> <span class="step">@ViewBag.Title</span>
}
<h2 class="page-title">@ViewBag.Title</h2>
@if (hasPermission)
{
    <a class="btn btn-request" href="@Url.Action("create", "extensionno")">
        <span class="fa fa-plus"></span> New Extension Number
    </a>
    <a class="btn btn-primary" href="@Url.Action("ExternalGroup", "extensionno")">Manage External Group</a>
}
<table class="table table-custom" id="data">
    <thead>
        <tr>
            <th>@Labels.No</th>
            <th>@Labels.FullName</th>
            <th>@Labels.NickName</th>
            <th>@Labels.ExtensionNumber</th>
            @if (hasPermission)
            {
                <th>@Labels.Edit</th>
                <th>@Labels.Delete</th>
            }
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            int index = 1;
            foreach (ExtensionNumberViewModel item in Model)
            {
                if (item.Extensions.Any())
                {
                    <tr>
                        <td class="rowdivider align-left" colspan="@totalColumn">
                            <b>@item.Name.ToUpper()</b>
                        </td>
                    </tr>
                }
                foreach (ExtensionNoModel ext in item.Extensions)
                {
                    <tr>
                        <td>@(index++)</td>
                        <td class="align-left">@ext.FullName</td>
                        <td>@ext.NickName</td>
                        <td style="color: #0789D1;">@ext.ExtensionNo</td>
                        @if (hasPermission)
                        {
                            <td>
                                <a href="@Url.Action("Edit", "ExtensionNo", new { id = ext.EmployeeExtensionId, isInternal = ext.IsInternal })">
                                    <i class="fa fa-pencil fa-lg icon-edit"></i>
                                </a>
                            </td>
                            <td>
                                <a href="javascript:;" class="delete" data-extension-no-id="@ext.EmployeeExtensionId">
                                    <i class="fa fa-times fa-lg icon-delete"></i>
                                </a>
                            </td>
                        }
                    </tr>
                }

            }

        }
        else
        {
            @RazorHelper.DisplayNoInformation(colspan: totalColumn);
        }
    </tbody>
</table>