@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels.ExtensionNumber
@model bool
@{
    ViewBag.Title = Labels.ExtensionNumber;
}
@section css{
    <link href="~/wwwroot/dist/styles/extensionno.index.css" rel="stylesheet" />
}
@section js{
    <script type="text/javascript">
        window.hasPermission = "@Model";
    </script>
    <script src="~/wwwroot/dist/js/extensionno.home.js"></script>
}
@section Breadcrumb {
    <a class="step">@Labels.CompanySpace</a> <span class="step">@ViewBag.Title</span>
}
<h2 class="page-title">@ViewBag.Title</h2>
<div id="index-extension-no"></div>
