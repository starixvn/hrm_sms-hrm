@using Fanex.NexHR.ViewModels.ExtensionNumber
@model List<ExtensionNumberViewModel>
@section css{
    @Url.CombresLink("extensionnocss")
}
@section js{
    @Url.CombresLink("extensionnojs")
}
@{
    ViewBag.Title = "Extension Numbers";
    var hasPermission = (bool)ViewBag.HasPermission;
}
@section Breadcrumb {
    <a class="step">@Labels.CompanySpace</a> <span class="step">@ViewBag.Title</span>
}
<h2>@ViewBag.Title</h2>
@if (hasPermission)
{
    <div class="button-icon">
        <span class="icon plus"></span>@Html.ActionLink("New Extension Number", "Create")
    </div>
    <div class="button">@Html.ActionLink("Manage External Group", "ManageExternalGroup")</div>
}
<table class="data" id="data">
    <thead>
        <tr>
            <th>
                @Labels.No
            </th>
            <th>
                @Labels.Nick
            </th>
            <th>
                @Labels.FullName
            </th>
            <th>
                Extension Number
            </th>
            @if (hasPermission)
            {
                <th>
                    @Labels.Edit
                </th>
                <th>
                    @Labels.Delete
                </th>
            }
        </tr>
    </thead>
    <tbody>
        @if (Model != null)
        {
            int index = 1;
            foreach (ExtensionNumberViewModel item in Model)
            {
                if (item.Extensions.Count > 0)
                {
                    <tr>
                        <td class="rowdivider highlight left" colspan="19">
                            <b>@item.Name.ToUpper()</b>
                        </td>
                    </tr>
                }
                foreach (ExtensionNoModel ext in item.Extensions)
                {
                    <tr id="@ext.ExtensionNoId">
                        <td>
                            @(index++)
                        </td>
                        <td class="left">
                            @ext.FullName
                        </td>
                        <td>
                            @ext.NickName
                        </td>
                        <td style="color: #0789D1;">
                            @ext.ExtensionNo
                        </td>
                        @if (hasPermission)
                        {
                            <td>
                                <a href="@Url.Action("Edit", "ExtensionNo", new { isInternal = ext.IsInternal, ExtensionNoId = ext.ExtensionNoId })">
                                    <i class="fa fa-pencil fa-lg icon-edit"></i>
                                </a>
                            </td>
                            <td>
                                <a href="javascript:;" id="deleteExt">
                                    <i class="fa fa-times fa-lg icon-delete"></i>
                                </a>
                            </td>
                        }
                    </tr>
                }

            }

        }
        else
        {
            @RazorHelper.DisplayNoInformation(colspan: 5);
        }
    </tbody>
</table>