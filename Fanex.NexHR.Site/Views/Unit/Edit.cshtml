@using Fanex.NexHR.Core
@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels.Unit
@model EditUnitViewModel
@{
    ViewBag.Title = @Labels.EditUnit;
}
@section css{
    <link href="~/wwwroot/dist/styles/unit.create.css" rel="stylesheet" />
}
@section js{
    <script src="~/wwwroot/dist/js/unit.edit.js"></script>
}

@section Breadcrumb {
    <a class="step">@Labels.SASpace</a>
    <a class="step" href="@Url.Action("index", "unit")">@Labels.UnitManagement</a>
    <span class="step">@ViewBag.Title</span>
}
<h2 class="page-title">@Labels.Edit</h2>
@using (Html.BeginForm("Edit", "Unit", FormMethod.Post, new { @class = "form-horizontal", @id = "EditForm" }))
{
    <div class="card">
        @Html.ValidationSummary()
        @Html.HiddenFor(model => model.UnitId)
        <div class="form-group">
            <div class="label-form">
                @Html.LabelFor(model => model.Code, new { @class = "control-label" })
            </div>
            <div class="input-form">
                @Html.TextBoxFor(model => model.Code, new { maxlength = "50", @class = "form-control", @autocomplete = "off" })
            </div>
        </div>
        <div class="form-group">
            <div class="label-form">
                @Html.LabelFor(model => model.Name, new { @class = "control-label" })
            </div>
            <div class="input-form">
                @Html.TextBoxFor(model => model.Name, new { maxlength = "200", @class = "form-control", @autocomplete = "off" })
            </div>
        </div>
        <div class="form-group">
            <div class="label-form">
                @Html.LabelFor(model => model.IsActive, new { @class = "control-label" })
            </div>
            <div class="input-form">
                <div class="checkbox">@Html.CheckBoxCustomFor(model => model.IsActive)</div>
            </div>
        </div>
        <div class="form-group">
            <div>
                <button type="button" class="btn btn-primary" id="btnSubmit">@Labels.Update</button>
                <a href="@Url.Action("index", "unit")" class="btn btn-default">@Labels.Back</a>
            </div>
        </div>
    </div>
}