@using Fanex.NexHR.Resources

@{
    Layout = "~/Views/Shared/_NewLayout.cshtml";
    ViewBag.Title = Labels.ScheduleArrange;
    var isSystemAdmin = (bool)ViewBag.IsSystemAdmin;
}
@section css{
    <link href="~/wwwroot/dist/styles/schedule.arrange.css" rel="stylesheet" />
}
@section js{
    <script src="~/wwwroot/dist/js/schedule.arrange.js"></script>
}
@section Breadcrumb {
    <a class="step">@ViewBag.Title</a>
}

<h2 class="page-title">@ViewBag.Title</h2>
<input type="checkbox" id="IsSystemAdmin" hidden @(isSystemAdmin ? "checked" : string.Empty) />
<div id="schedule-wrapper"></div>