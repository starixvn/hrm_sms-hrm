@using Fanex.NexHR.Core
@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels.Department
@model EditDepartmentViewModel

@{
    Layout = "~/Views/Shared/_NewLayout.cshtml";
    ViewBag.Title = @Labels.EditDivision;
}

@section css{
    <link href="~/wwwroot/dist/styles/department.create.css" rel="stylesheet" />
}
@section Breadcrumb {
    <a class="step">@Labels.SASpace</a>
    <a class="step" href="@Url.Action("index", "department")">@Labels.DepartmentManagement</a>
    <span class="step">@ViewBag.Title</span>
}

<h2 class="page-title">@Labels.Edit</h2>
<div class="card">
    @using (Html.BeginForm("Edit", "department", FormMethod.Post, new { @class = "form-horizontal" }))
    {
        @Html.HiddenFor(model => model.DeprtamentId)

        <div class="form-group">
            <div class="label-form">
                @Html.LabelFor(model => model.Code, new { @class = "control-label" })
            </div>
            <div class="input-form">
                @Html.TextBoxFor(model => model.Code, new { maxlength = "50", @class = "form-control", @autocomplete = "off" })
                @Html.ValidationMessageFor(model => model.Code)
            </div>
        </div>

        <div class="form-group">
            <div class="label-form">
                @Html.LabelFor(model => model.Name, new { @class = "control-label" })
            </div>
            <div class="input-form">
                @Html.TextBoxFor(model => model.Name, new { maxlength = "200", @class = "form-control", @autocomplete = "off" })
                @Html.ValidationMessageFor(model => model.Name)
            </div>
        </div>

        <div class="form-group">
            <div class="label-form">
                @Html.LabelFor(model => model.ParentId, "Parent", new { @class = "control-label" })
            </div>
            <div class="select-form">
                @Html.DropDownListFor(model => model.ParentId, new SelectList(Model.ParentDepartments, "Id", "Name"), string.Empty, new { @class = "form-control" })
            </div>
        </div>

        <div class="form-group">
            <div class="label-form">
                @Html.LabelFor(model => model.Manager, new { @class = "control-label" })
            </div>
            <div class="input-form">
                @Html.TextBox("Manager", Model.Manager, new { @class = "form-control", @autocomplete = "off", placeholder = Messages.SearchEmployeeWatermark })

                @Html.ValidationMessage("Manager")

                @Html.HiddenFor(model => model.Manager)
                @Html.HiddenFor(model => model.ManagerId)
            </div>
        </div>

        <div id="groupHalfDay" class="form-group">
            <div class="label-form">
                @Html.LabelFor(model => model.IsActive, new { @class = "control-label" })
            </div>
            <div class="input-form">
                <div class="checkbox">@Html.CheckBoxCustomFor(model => model.IsActive)</div>
            </div>
        </div>

        <div class="form-group">
            <div>
                <button type="submit" class="btn btn-primary" id="btnSubmit">@Labels.Update</button>
                <button type="button" class="btn btn-default" onclick="window.history.back()">@Labels.Back</button>
            </div>
        </div>
    }
</div>
