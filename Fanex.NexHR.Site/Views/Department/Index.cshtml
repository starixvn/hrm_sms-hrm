@using Fanex.NexHR.Models
@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels.Department
@model DepartmentViewModel
@{
    ViewBag.Title = @Labels.DepartmentManagement;
    var hasPermission = (bool)ViewBag.HasPermission;
    var totalColumn = hasPermission ? 7 : 5;
}
@section css{
    <link href="~/wwwroot/dist/styles/department.index.css" rel="stylesheet" />
}
@section js{
    <script src="~/wwwroot/dist/js/department.index.js"></script>
}
@section Breadcrumb {
    <a class="step">@Labels.SASpace</a><span class="step">@ViewBag.Title</span>
}
<h2 class="page-title">@ViewBag.Title</h2>
@using (Html.BeginForm("index", "department", FormMethod.Get, new { @class = "filter", style = "width: 700px;" }))
{
    var gender = new List<SelectListItem>
{
new SelectListItem() {Text = "All", Value = "", Selected = !Model.IsActive.HasValue },
new SelectListItem() {Text = "Active", Value = "true", Selected = Model.IsActive.HasValue && Model.IsActive.Value},
new SelectListItem() {Text = "Inactive", Value = "false", Selected = Model.IsActive.HasValue  && !Model.IsActive.Value}
};

<div class="form-horizontal clearfix">
    <div class="form-group">
        <div class="label-form label--xs">
            @Html.Label(@Labels.Status, new { @class = "control-label" })
        </div>
        <div class="select-form">
            @Html.DropDownList("IsActive", gender, new { @class = "form-control" })
        </div>
    </div>
    <div class="form-group form-group--m">
        <button type="submit" class="btn btn-primary">@Labels.Search</button>
        @if (hasPermission)
        {
            <a class="btn btn-request" href="@Url.Action("create", "department")">
                <span class="fa fa-plus"></span> @Labels.NewDivision
            </a>
        }
    </div>
</div>
}
<table class="table table-custom" id="data" style="width: auto; min-width: 700px;">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th>@Labels.Code</th>
            <th>@Labels.Department</th>
            <th>@Labels.Manager</th>
            <th>@Labels.Parent</th>
            <th>@Labels.Active</th>
            @if (hasPermission)
            {
                <th>@Labels.Edit</th>
            }
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Departments != null)
        {
            int index = 1;
            foreach (Department department in Model.Departments)
            {
                <tr id="row@(department.Id)">
                    <td>@(index++)</td>
                    <td>@department.Code</td>
                    <td>@department.Name</td>
                    <td>
                        @if (department.Manager != null)
                        {
                            <span class="tooltip-tipsy" title="@department.Manager.FullName">@department.Manager.Nickname</span>
                        }
                    </td>
                    <td>
                        @if (department.Parent != null)
                        {
                            @department.Parent.Name
                        }
                    </td>
                    <td>
                        @if (department.IsActive)
                        {
                            <i class="fa fa-check fa-lg icon-check"></i>
                        }
                    </td>
                    @if (hasPermission)
                    {
                        <td>
                            <a href="@Url.Action("Edit", "Department", new { DepartmentId = department.Id })">
                                <i class="fa fa-pencil fa-lg icon-edit"></i>
                            </a>
                        </td>
                    }
                </tr>
            }
        }
        else
        {
            @RazorHelper.DisplayNoInformation(colspan: totalColumn)
        }
    </tbody>
</table>