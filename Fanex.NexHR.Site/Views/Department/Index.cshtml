@using Fanex.NexHR.Core
@using Fanex.NexHR.Resources
@model DepartmentViewModel
@{
    Layout = "~/Views/Shared/_NewLayout.cshtml";
    ViewBag.Title = @Labels.DepartmentManagement;
    var hasPermission = (bool)ViewBag.HasPermission;
    var totalColumn = hasPermission ? 7 : 5;
}
@section css{
    <link href="~/wwwroot/dist/styles/department.index.css" rel="stylesheet" />
}
@section js{
    @Url.CombresLink("departmentjs")
}
@section Breadcrumb {
    <a class="step">@Labels.SASpace</a><span class="step">@ViewBag.Title</span>
}
<h2 class="page-title">@ViewBag.Title</h2>
@using (Html.BeginForm("index", "department", FormMethod.Get, new { @class = "filter", style = "width: 600px;" }))
{
    var gender = new List<SelectListItem>
{
new SelectListItem() {Text = "All", Value = ""},
new SelectListItem() {Text = "Active", Value = "0"},
new SelectListItem() {Text = "Inactive", Value = "1"}
};

<div class="form-horizontal clearfix">
    <div class="form-group form-group--m">
        <div class="label-form">
            @Html.LabelFor(model => model.IsActive, @Labels.Status, new { @class = "control-label" })
        </div>
        <div class="select-form">
            @Html.DropDownListFor(model => model.IsActive, gender, new { @class = "form-control" })
        </div>
    </div>
    <div class="form-group form-group--m">
        <button type="button" id="submit" class="btn btn-primary">@Labels.Search</button>
        @if (hasPermission)
        {
            <a class="btn btn-request" href="@Url.Action("create", "department")">
                <span class="fa fa-plus"></span> @Labels.NewDivision
            </a>
        }
    </div>
</div>
}
<table class="table table-custom" style="width: auto; min-width: 600px;">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th>@Labels.Code</th>
            <th>@Labels.Department</th>
            <th>@Labels.Manager</th>
            <th>@Labels.Parent</th>
            @if (hasPermission)
            {
                <th>@Labels.Edit</th>
                <th>@Labels.Delete</th>
            }
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Departments != null)
        {
            int index = 1;
            foreach (Department department in Model.Departments)
            {
                <tr id="row@(department.Id)">
                    <td>
                        @(index++)
                    </td>
                    <td>
                        @department.Code
                    </td>
                    <td>
                        @department.Name
                    </td>
                    @if (department.Manager != null)
                    {
                        <td title="@department.Manager.FullName">
                            @department.Manager.NickName
                        </td>
                    }
                    else
                    {
                        <td></td>
                    }
                    @if (department.Parent != null)
                    {
                        <td>@department.Parent.Name</td>
                    }
                    else
                    {
                        <td></td>
                    }
                    @if (hasPermission)
                    {
                        <td class="cmd">
                            <a href="@Url.Action("Edit", "Department", new { DepartmentId = department.Id })">
                                <i class="fa fa-pencil fa-lg icon-edit"></i>
                            </a>
                        </td>
                        <td>
                            <a href="javascript:;" onclick="deleteDepartment(@(department.Id));">
                                <i class="fa fa-times fa-lg icon-delete"></i>
                            </a>
                        </td>
                    }
                </tr>
            }
        }
        else
        {
            @RazorHelper.DisplayNoInformation(colspan: totalColumn)
        }
    </tbody>
</table>
