@model DepartmentViewModel
@{
    ViewBag.Title = @Labels.DepartmentManagement;
    var hasPermission = (bool)ViewBag.HasPermission;
    var totalColumn = hasPermission ? 7 : 5;

}
@section css{
    @Url.CombresLink("departmentcss")
}
@section js{
    @Url.CombresLink("departmentjs")
}
@section Breadcrumb {
    <a class="step">@Labels.SASpace</a><span class="step">@ViewBag.Title</span>
}
<h2>@ViewBag.Title</h2>

@using (Html.BeginForm())
{
    var gender = new List<SelectListItem>
    {
        new SelectListItem() {Text = "All", Value = ""},
        new SelectListItem() {Text = "Active", Value = "0"},
        new SelectListItem() {Text = "Inactive", Value = "1"}
    };

    <div class="container_24 bunhat" style="width: auto; min-width: 480px;">
        <div class="grid_1">
            @Html.LabelFor(model => model.IsActive, @Labels.Status)
        </div>
        <div class="grid_2">
            @Html.DropDownListFor(model => model.IsActive, gender)
        </div>
        <div class="grid_2">
            <input type="button" id="submit" value="@Labels.Submit" class="processing-submit" />
        </div>
        @if (hasPermission)
        {
        <div class="grid_4">
            <div class="button-icon">
                <span class="icon plus"></span>@Html.ActionLink("New Division", "Create")
            </div>
        </div>
        }
    </div>

}
<div class="clear">
</div>
<div class="space">
</div>
<table class="table table-custom" style="width: auto; min-width: 500px;">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th>@Labels.Code</th>
            <th>@Labels.Department</th>
            <th>@Labels.Manager</th>
            <th>@Labels.Parent</th>
            @if (hasPermission)
            {
                <th>@Labels.Edit</th>
                <th>@Labels.Delete</th>
            }
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Departments != null)
        {
            int index = 1;
            foreach (Department department in Model.Departments)
            {
                <tr id="row@(department.Id)">
                    <td>
                        @(index++)
                    </td>
                    <td>
                        @department.Code
                    </td>
                    <td>
                        @department.Name
                    </td>
                    @if (department.Manager != null)
                    {
                        <td class="tooltip" title="@department.Manager.FullName">
                            @department.Manager.NickName
                        </td>
                    }
                    else
                    {
                        <td></td>
                    }
                    @if (department.Parent != null)
                    {
                        <td>@department.Parent.Name</td>
                    }
                    else
                    {
                        <td></td>
                    }
                    @if (hasPermission)
                    {
                        <td class="cmd">
                            <a href="@Url.Action("Edit", "Department", new { DepartmentId = department.Id })">
                                <i class="fa fa-pencil fa-lg icon-edit"></i>
                            </a>
                        </td>
                        <td>
                            <a href="javascript:;" onclick="deleteDepartment(@(department.Id));">
                                <i class="fa fa-times fa-lg icon-delete"></i>
                            </a>
                        </td>
                    }
                </tr>
            }
        }
        else
        {
            @RazorHelper.DisplayNoInformation(colspan: totalColumn)
        }
    </tbody>
</table>