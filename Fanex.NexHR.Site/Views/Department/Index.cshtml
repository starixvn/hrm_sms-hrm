@using Fanex.NexHR.Resources
@using Fanex.NexHR.Models
@model IList<Department>
@{
    ViewBag.Title = @Labels.DepartmentManagement;
    var hasPermission = (bool)ViewBag.HasPermission;
}
@section css{
    <link href="~/wwwroot/dist/styles/department.index.css" rel="stylesheet" />
}
@section js{
    <script src="~/wwwroot/dist/js/department.index.js"></script>
}
@section Breadcrumb {
    <a class="step">@Labels.SASpace</a><span class="step">@ViewBag.Title</span>
}
<h2 class="page-title">@ViewBag.Title</h2>
@using (Html.BeginForm("index", "department", FormMethod.Get, new { @class = "filter", style = "width: 700px;" }))
{
    var status = new List<SelectListItem>
{
new SelectListItem() {Text = "All", Value = ""},
new SelectListItem() {Text = "Active", Value = "true"},
new SelectListItem() {Text = "Inactive", Value = "false"}
};

<div class="form-horizontal clearfix">
    <div class="form-group">
        <div class="label-form label--xs">
            @Html.Label(@Labels.Status, new { @class = "control-label" })
        </div>
        <div class="select-form">
            @Html.DropDownList("IsActive", status, new { @class = "form-control" })
        </div>
    </div>
    <div class="form-group form-group--m">
        <button type="submit" class="btn btn-primary">@Labels.Search</button>
        @if (hasPermission)
        {
            <a class="btn btn-request" href="@Url.Action("create", "department")">
                <span class="fa fa-plus"></span> @Labels.CreateDepartment
            </a>
        }
        </div>
</div>
}
<table class="table table-custom" id="data" style="width: auto; min-width: 700px;">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th>@Labels.Code</th>
            <th>@Labels.Department</th>
            <th>@Labels.Unit</th>
            <th>@Labels.Active</th>
            @if (hasPermission)
            {
                <th>@Labels.Edit</th>
                <th>@Labels.Delete</th>
            }
            </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            int index = 1;
            foreach (Department department in Model)
            {
            <tr id="row@(department.Id)">
                <td>@(index++)</td>
                <td>@department.Code</td>
                <td>@department.Name</td>
                <td>@department.Unit.Name</td>
                <td>
                    @if (department.IsActive)
                    {
                        <i class="fa fa-check fa-lg icon-check"></i>
                    }
                </td>
                    @if (hasPermission)
                    {
                        <td>
                            <a href="@Url.Action("Edit", "Department", new {Id = department.Id })">
                                <i class="fa fa-pencil fa-lg icon-edit"></i>
                            </a>
                        </td>
                        <td>
                            <a href="javascript:;" class="deleteDepartment" data-department-id="@department.Id">
                                <i class="fa fa-times fa-lg icon-delete"></i>
                            </a>
                        </td>
                    }
                    </tr>
                }
            }
        else
        {
            @RazorHelper.DisplayNoInformation(10)
        }
    </tbody>
</table>