@using Fanex.NexHR.Core.Enums;
@using Fanex.NexHR.Core;
@using Fanex.NexHR.Resources;
@using Fanex.NexHR.Models;
@using Fanex.NexHR.Models.Request;

@helper CategoryDropDownList(string id, string classHTML = "", string selectedId = "")
{
    <select id="@id" name="@id" class="@classHTML">
        <option selected=@(string.IsNullOrWhiteSpace(selectedId)) value="@string.Empty">-- All --</option>
        <option selected=@(selectedId == "0") value="0">Expat</option>
        <option selected=@(selectedId == "1") value="1">Local</option>
    </select>
}

@helper DisplayNoInformation(int colspan)
{
    <tr>
        <td colspan="@colspan" rowspan="2">
            @Messages.NoInformation
        </td>
    </tr>
}

@helper StatusDropDownList(int status = (int)CurrentRequestStatus.Pending, bool isShowAll = true, bool isShowPendingAndVerified = true, string controlName = "status", string htmlClass = "")
{
    <select name="@controlName" id="@controlName" class="@htmlClass">
        @if (isShowAll)
        {
            <option selected="@(status == 0)" value="0">All</option>
        }

        @if (isShowPendingAndVerified)
        {
            <option selected="@(status == -1)" value="-1">Pending & Verified</option>
        }
        <option selected="@(status == (byte)CurrentRequestStatus.Pending)" value="@Convert.ToByte(CurrentRequestStatus.Pending)">@Labels.Pending</option>
        <option selected="@(status == (byte)CurrentRequestStatus.Verified)" value="@Convert.ToByte(CurrentRequestStatus.Verified)">@Labels.Verified</option>
        <option selected="@(status == (byte)CurrentRequestStatus.NotVerified)" value="@Convert.ToByte(CurrentRequestStatus.NotVerified)">@Labels.NotVerified</option>
        <option selected="@(status == (byte)CurrentRequestStatus.Approved)" value="@Convert.ToByte(CurrentRequestStatus.Approved)">@Labels.Approved</option>
        <option selected="@(status == (byte)CurrentRequestStatus.Rejected)" value="@Convert.ToByte(CurrentRequestStatus.Rejected)">@Labels.Rejected</option>
        <option selected="@(status == (byte)CurrentRequestStatus.Processed)" value="@Convert.ToByte(CurrentRequestStatus.Processed)">@Labels.Processed</option>
        <option selected="@(status == (byte)CurrentRequestStatus.Void)" value="@Convert.ToByte(CurrentRequestStatus.Void)">@Labels.Void</option>
    </select>
}

@helper LateInEarlyOutTimeFormat(int mins, short type)
{
    if (type == (short)RequestType.LateIn)
    {
        <span>+@mins'</span>
    }
    else
    {
        <span>-@mins'</span>
    }
}

@helper EmployeeProcessMenu()
{
    <ul id="pendingMenu" class="hide">
        <li class="edit">
            <a command="Edit" href="javascript:;">
                <i class="fa fa-pencil fa-lg icon-edit"></i>@Labels.Edit
            </a>
        </li>
        <li class="rejected">
            <a command="Cancel" href="javascript:;">
                <i class="fa fa-times fa-lg icon-delete"></i>@Labels.Cancel
            </a>
        </li>
    </ul>
}

@helper MinTotalLeaveDropDownList(int minTotalLeave, string name = "MinTotalLeave")
{
    <select id="@name" name="@name" class="minWidthDropdown">
        <option selected="@(minTotalLeave == 0)" value="0">All</option>
        @for (int i = 14; i <= 20; i++)
        {
            <option selected="@(i == minTotalLeave)" value="@i">@i</option>
        }
    </select>
}

@helper MessageCategoryDropDownList(short action = 0, string controlName = "", string classObject = "")
{
    <select id="@controlName">
        <option @(action == 0 ? "selected" : "") value="@Convert.ToByte(@MessageCategory.Notification)">@Labels.Notification</option>
        <option @(action == 1 ? "selected" : "") value="@Convert.ToByte(@MessageCategory.Warning)">@Labels.Warning</option>
        <option @(action == 2 ? "selected" : "") value="@Convert.ToByte(@MessageCategory.Violation)">@Labels.Violation</option>
    </select>
}

@helper MessageStatusDropDownList(short action = -1, string controlName = "", string classObject = "")
{
    <select id="@controlName">
        <option @(action == -1 ? "selected" : "") value="">-- All --</option>
        <option @(action == 0 ? "selected" : "") value="0">Active</option>
        <option @(action == 1 ? "selected" : "") value="1">Disabled</option>
    </select>
}

@helper LeaveTypeDropDownList(string id, IList<LeaveType> leaveTypes, string className, int? currentValue)
{
    <select id="@id" class="@className">
        @{
            var value = currentValue != null ? currentValue.ToString() : string.Empty;
        }
        @foreach (var leaveType in leaveTypes)
        {
            <option value="@leaveType.Id" selected="@(leaveType.Id.ToString() == value)" title="@leaveType.Description">@leaveType.Name</option>
        }
    </select>
}

@helper DisplayZeroCell(decimal value)
{
    if (value > 0)
    {
        <span>@value</span>
    }
    else
    {
        <span>-</span>
    }
}

@helper RenderRequestStatus(BaseRequest request)
{
    switch (request.Status.Id)
    {
        case (byte)CurrentRequestStatus.Pending:
            <td>
                <a requestid="@request.RequestId" href="javascript:void(0);" class="tooltip @request.Status.ToString()">@request.Status.ToString()</a>
            </td>
            break;
        case (byte)CurrentRequestStatus.Verified:
        case (byte)CurrentRequestStatus.NotVerified:
            <td>
                <a requestid="@request.RequestId" href="javascript:void(0);" class="tooltip" title="@request.Status.Name by @request.VerifiedBy.NickName (@request.VerifiedDate.ToShortFormatedDate())">@request.Status.ToString()</a>
            </td>
            break;
        case (byte)CurrentRequestStatus.Approved:
        case (byte)CurrentRequestStatus.Rejected:
            <td>
                <a requestid="@request.RequestId" href="javascript:void(0);" class="tooltip" title="@request.Status.Name by @request.ApprovedBy.NickName (@request.ApprovedDate.ToShortFormatedDate())">@request.Status.ToString()</a>
            </td>
            break;

        case (byte)CurrentRequestStatus.Processed:
        case (byte)CurrentRequestStatus.Void:
            <td>
                <a requestid="@request.RequestId" href="javascript:void(0);" class="tooltip" title="@request.Status.Name by @request.ProcessedBy.NickName (@request.ProcessedDate.ToShortFormatedDate())">@request.Status.ToString()</a>
            </td>
            break;
        default:
            <td>
                <a href="javascript:void(0);" class="tooltip">@request.Status.ToString()</a>
            </td>
            break;
    }
}

@helper CheckInOutReasonDropDownList(byte reasonId = (byte)CheckInOutReasons.Forgot, string controlName = "reasonId", string htmlClass = "")
{
    <select name="@controlName" id="@controlName" class="@htmlClass">
        <option selected="@(reasonId == (byte)CheckInOutReasons.VanLate)" value="@Convert.ToByte(CheckInOutReasons.VanLate)">@Labels.VanLate</option>
        <option selected="@(reasonId == (byte)CheckInOutReasons.BusinessTrip)" value="@Convert.ToByte(CheckInOutReasons.BusinessTrip)">@Labels.BusinessTrip</option>
        <option selected="@(reasonId == (byte)CheckInOutReasons.Forgot)" value="@Convert.ToByte(CheckInOutReasons.Forgot)">@Labels.Forgot</option>
        <option selected="@(reasonId == (byte)CheckInOutReasons.Other)" value="@Convert.ToByte(CheckInOutReasons.Other)">@Labels.Other</option>
    </select>
}

@helper LateInEarlyOutReasonDropDownList(byte reasonId = (byte)LateInEarlyOutReasons.Other, string controlName = "reasonId", string htmlClass = "")
{
    <select name="@controlName" id="@controlName" class="@htmlClass">
        <option selected="@(reasonId == (byte)LateInEarlyOutReasons.ManagementAllow)" value="@Convert.ToByte(LateInEarlyOutReasons.ManagementAllow)">@Labels.ManagementAllow</option>
        <option selected="@(reasonId == (byte)LateInEarlyOutReasons.Other)" value="@Convert.ToByte(LateInEarlyOutReasons.Other)">@Labels.Other</option>
    </select>
}