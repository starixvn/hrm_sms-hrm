@using Fanex.NexHR.Core.Enums;
@using Fanex.NexHR.Core;
@using Fanex.NexHR.Resources;

@helper FormatDate(DateTime? date)
{
    <span>
        @if (date.HasValue)
        {
            @date.Value.ToString("MMM dd, yyyy hhH:mm")
        }
    </span>
}
@helper YearDropDownList(int year)
{
    <span style="font-size:12px">Year</span>
    <select id="year" name="year">
        @for (int i = DateTime.Now.Year; i >= 2010; i--)
        {
            var selected = year == i ? "selected='true'" : string.Empty;
            <option @selected value="@i">@i</option>
        }
    </select>
}

@helper CategoryDropDownList(string id, string classHTML = "", string selectedId = "")
{
    <select id="@id" class="@classHTML">
        <option selected=@(string.IsNullOrWhiteSpace(selectedId)) value="@string.Empty">-- All --</option>
        <option selected=@(selectedId == "0") value="0">Expat</option>
        <option selected=@(selectedId == "1") value="1">Local</option>
    </select>
}

@helper DisplayNoInformation(int colspan)
{
    <tr>

        <td colspan="@colspan"></td>
    </tr>
    <tr>

        <td colspan="@colspan" rowspan="2">
            @Messages.NoInformation
        </td>
    </tr>
}
@helper StatusDropDownList(int status = (int)CurrentRequestStatus.Pending, bool isShowAll = true, bool isShowPendingAndVerified = true, string controlName = "status")
{
    <select name="@controlName" id="@controlName">
        @if (isShowAll)
        {
            <option selected="@(status == 0)" value="0">All</option>
        }

        @if (isShowPendingAndVerified)
        {
            <option selected="@(status == -1)" value="-1">Pending & Verified</option>
        }
        <option selected="@(status == (byte)CurrentRequestStatus.Pending)" value="@Convert.ToByte(CurrentRequestStatus.Pending)">@Labels.Pending</option>
        <option selected="@(status == (byte)CurrentRequestStatus.Verified)" value="@Convert.ToByte(CurrentRequestStatus.Verified)">@Labels.Verified</option>
        <option selected="@(status == (byte)CurrentRequestStatus.NotVerified)" value="@Convert.ToByte(CurrentRequestStatus.NotVerified)">@Labels.NotVerified</option>
        <option selected="@(status == (byte)CurrentRequestStatus.Approved)" value="@Convert.ToByte(CurrentRequestStatus.Approved)">@Labels.Approved</option>
        <option selected="@(status == (byte)CurrentRequestStatus.Rejected)" value="@Convert.ToByte(CurrentRequestStatus.Rejected)">@Labels.Rejected</option>
        <option selected="@(status == (byte)CurrentRequestStatus.Processed)" value="@Convert.ToByte(CurrentRequestStatus.Processed)">@Labels.Processed</option>
        <option selected="@(status == (byte)CurrentRequestStatus.Void)" value="@Convert.ToByte(CurrentRequestStatus.Void)">@Labels.Void</option>
    </select>

}
@helper BooleanDropDownList(bool? selectedValue, IList<System.Web.Mvc.SelectListItem> items, string controlName)
{
    <select name="@controlName" id="@controlName">
        @foreach (var item in items)
        {
            <option selected="@(selectedValue.HasValue && item.Value.Equals(selectedValue.ToString(), StringComparison.OrdinalIgnoreCase) || (string.IsNullOrEmpty(item.Value) && !selectedValue.HasValue))" value="@item.Value">@item.Text</option>
        }
    </select>
}
@helper StatusDisplayByHR(long statusId, Fanex.NexHR.Models.Request.RequestStatus status)
{
    if (status.Id != (byte)CurrentRequestStatus.Rejected)
    {
        <td>
            <a requestid="@statusId" href="javascript:;" class="@status.Name tooltip">@status.Name</a>
        </td>
    }
    else
    {
        <td>
            @status.Name
        </td>
    }
}

@helper ModifierDisplay(string nickName, string fullName, DateTime? modifiedDate, long requestId)
{
    if (!string.IsNullOrWhiteSpace(nickName))
    {
        if (modifiedDate > new DateTime(2010, 1, 1))
        {
            <td id="pb@(requestId)">@nickName, @modifiedDate.ToShortFormatedDate()</td>
        }
        else
        {
            <td id="pb@(requestId)">@nickName</td>
        }
    }
    else
    {
        <td id="pb@(requestId)">N/A</td>
    }
}
@helper TeamDropDownList(List<Fanex.NexHR.Models.Team> teamList, string controlName = "team")
{
    <select name="@controlName" id="@controlName">
        @if (teamList != null && teamList.Count > 0)
        {
            foreach (Fanex.NexHR.Models.Team team in teamList)
            {
                <option value="@team.Name">@team.Name</option>
            }
        }
    </select>
}
@helper EmployeeDropDownList(List<string> EmployeeList)
{
    <select id="employee">
        @foreach (string emp in EmployeeList)
        {
            <option value="@emp">@emp</option>
        }
    </select>
}
@helper ShiftInfoTable(dynamic shiftInfoList)
{
    <div id="shifts">
        <table class="shift_table">
            <thead>
                <tr>
                    <th class="left">
                        Shift
                    </th>
                    <th>
                        Checkin time
                    </th>
                    <th>
                        Checkout time
                    </th>
                    <th>
                        Break
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (Fanex.NexHR.Models.Shift item in shiftInfoList)
                {
                    <tr>
                        <td class="left">
                            @item.Name
                        </td>
                        <td>
                            @item.BeginCheckInTime &nbsp;@((item.BeginCheckInTime == item.EndCheckInTime) ? string.Empty : "- " + item.EndCheckInTime)
                        </td>
                        <td>
                            @item.BeginCheckOutTime &nbsp;@((item.BeginCheckOutTime == item.EndCheckOutTime) ? string.Empty : "- " + item.EndCheckOutTime)
                        </td>
                        <td>
                            @((item.BreakTimeMins == 0) ? string.Empty : (item.BeginBreakTime + "' - " + item.EndBreakTime + "'"))
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

}
@helper LateInEarlyOutTimeFormat(int mins, short type)
{
    if (type == (byte)RequestType.LateIn)
    {
        <span>+@mins'</span>
    }
    else
    {
        <span>-@mins'</span>
    }
}
