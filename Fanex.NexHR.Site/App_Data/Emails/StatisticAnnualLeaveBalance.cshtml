<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Document</title>
    </head>
    <body>
        <div>
            <div>
                <strong>Dear {0}</strong>
            </div>
            <p>This is a statistic annual leave balance in your department/section</p>
            <table style="width: 60%; border-collapse: collapse; border: 1px solid; ">
                <thead>
                    <tr style="background-color: yellow;">
                        <th style="border: 1px solid;">Department</th>
                        <th style="border: 1px solid;">Section</th>
                        <th style="border: 1px solid;">Total Staff</th>
                        <th style="border: 1px solid;">AL Balance
                            <span style="color: red;">{1}</span>
                        </th>
                        <th style="border: 1px solid;">Percentage</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td style="border: 1px solid;">{2}</td>
                        <td style="border: 1px solid;">{3}</td>
                        <td style="text-align: center; border: 1px solid;">{4}</td>
                        <td style="text-align: center; border: 1px solid;">{5}</td>
                        <td style="text-align: center; border: 1px solid;">{6}%</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </body>
</html>