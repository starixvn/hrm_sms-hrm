<?xml version="1.0"?>
<configuration>
  <configSections>
    <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection,Fanex.Data"/>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net"/>
  </configSections>
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider,Fanex.Data" resourcePath="SpName.xml" enableWatching="1"/>
    </providers>
  </Fanex.Data.DbSettingProvider>
  <connectionStrings>
    <add name="nexhr" connectionString="packet size=4096; Data Source=CP0081-QUINN\MSSQLSERVER2012;TrustServerCertificate = true;Connect Timeout=60;Asynchronous Processing=true;Initial Catalog=HRMS-HongMa;integrated security=false; user id=sa; password=1234aa;" providerName="System.Data.SqlClient"/>
  </connectionStrings>
  <appSettings>
    <add key="Email.Sender" value="nexhrm@nexcel.vn"/>
    <add key="Email.SenderName" value="SMSHRM"/>
    <add key="app_mail_address" value="net.tcp://10.18.200.209:8787/MailService"/>
    <add key="app_mail_id" value="2"/>
    <add key="ClientSettingsProvider.ServiceUri" value=""/>
    <add key="EmailTemplate" value="emails\\forgetcheckinginout.cshtml"/>
    <add key="TimerInterval" value="60"/>
  </appSettings>
  <startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0"/></startup>
  <log4net debug="true">
    <appender name="RollingLogFileAppender" type="log4net.Appender.RollingFileAppender">
      <file value="Log.txt"/>
      <appendToFile value="true"/>
      <rollingStyle value="Size"/>
      <maxSizeRollBackups value="10"/>
      <maximumFileSize value="10MB"/>
      <staticLogFileName value="true"/>
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%-5p %d %5rms %-22.22c{1} %-18.18M - %m%n"/>
      </layout>
    </appender>

    <root>
      <level value="DEBUG"/>
      <appender-ref ref="RollingLogFileAppender"/>
    </root>
  </log4net>
	<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<dependentAssembly>
				<assemblyIdentity name="NPOI" publicKeyToken="0DF73EC7942B34E1" culture="neutral"/>
				<bindingRedirect oldVersion="0.0.0.0-1.2.5.0" newVersion="1.2.5.0"/>
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Web.Razor" publicKeyToken="31BF3856AD364E35" culture="neutral"/>
				<bindingRedirect oldVersion="0.0.0.0-2.0.0.0" newVersion="2.0.0.0"/>
			</dependentAssembly>
		</assemblyBinding>
	</runtime>
</configuration>
